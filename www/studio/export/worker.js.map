tes)\nfloat sdBox(vec2 p, vec2 b) {\n  vec2 d = abs(p) - b;\n  return length(max(d, 0.0)) + min(max(d.x, d.y), 0.0);\n}\n\n// Parallelogram SDF\nfloat sdParallelogram(vec2 p, float wi, float he, float sk) {\n  vec2 e = vec2(sk, he);\n  p = (p.y < 0.0) ? -p : p;\n  vec2 w = p - e;\n  w.x -= clamp(w.x, -wi, wi);\n  vec2 d = vec2(dot(w, w), -w.y);\n  float s = p.x * e.y - p.y * e.x;\n  p = (s < 0.0) ? -p : p;\n  vec2 v = p - vec2(wi, 0);\n  v -= e * clamp(dot(v, e) / dot(e, e), -1.0, 1.0);\n  d = min(d, vec2(dot(v, v), wi * he - abs(s)));\n  return sqrt(d.x) * sign(-d.y);\n}\n\n// Rhombus / diamond SDF\nfloat sdRhombus(vec2 p, vec2 b) {\n  vec2 q = abs(p);\n  float h = clamp((-2.0 * dot(q, b) + dot(b, b)) / dot(b, b), -1.0, 1.0);\n  float d = length(q - 0.5 * b * vec2(1.0 - h, 1.0 + h));\n  return d * sign(q.x * b.y + q.y * b.x - b.x * b.y);\n}\n\n// Hexagon SDF\nfloat sdHexagon(vec2 p, float r) {\n  vec2 q = abs(p);\n  float d = dot(q, normalize(vec2(1.0, 1.732)));\n  return max(d, q.y) - r;\n}\n\n// Trapezoid SDF\nfloat sdTrapezoid(vec2 p, float r1, float r2, float he) {\n  vec2 k1 = vec2(r2, he);\n  vec2 k2 = vec2(r2 - r1, 2.0 * he);\n  p.x = abs(p.x);\n  vec2 ca = vec2(max(0.0, p.x - ((p.y < 0.0) ? r1 : r2)), abs(p.y) - he);\n  vec2 cb = p - k1 + k2 * clamp(dot(k1 - p, k2) / dot(k2, k2), 0.0, 1.0);\n  float s = (cb.x < 0.0 && ca.y < 0.0) ? -1.0 : 1.0;\n  return s * sqrt(min(dot(ca, ca), dot(cb, cb)));\n}\n\n// ── Shape evaluation ──\n// Returns SDF for shape type 0-4\nfloat evalShape(vec2 p, int type, float scale) {\n  float d = 1e5;\n  if (type == 0) {\n    // Equilateral triangle\n    d = sdTriangle(p, scale * 0.36);\n  } else if (type == 1) {\n    // Wide parallelogram\n    d = sdParallelogram(p, scale * 0.38, scale * 0.14, scale * 0.15);\n  } else if (type == 2) {\n    // Elongated diamond\n    d = sdRhombus(p, vec2(scale * 0.12, scale * 0.40));\n  } else if (type == 3) {\n    // Hexagon segment\n    d = sdHexagon(p, scale * 0.25);\n  } else if (type == 4) {\n    // Trapezoid\n    d = sdTrapezoid(p, scale * 0.15, scale * 0.35, scale * 0.18);\n  }\n  return d;\n}\n\n// ── Color decay sequence ──\n// Maps a decay phase (0=born, 1=gone) to color\nvec3 decayColor(float phase) {\n  // 0.0-0.05: white flash\n  // 0.05-0.25: cyan\n  // 0.25-0.50: electric blue\n  // 0.50-0.75: magenta\n  // 0.75-1.0: deep purple → gone\n  vec3 white    = vec3(1.0, 1.0, 1.0);\n  vec3 cyan     = vec3(0.0, 0.95, 1.0);\n  vec3 blue     = vec3(0.15, 0.4, 1.0);\n  vec3 magenta  = vec3(0.95, 0.1, 0.85);\n  vec3 purple   = vec3(0.35, 0.05, 0.55);\n  vec3 dark     = vec3(0.05, 0.01, 0.1);\n\n  vec3 col = dark;\n  if (phase < 0.05) {\n    col = mix(white, white, phase / 0.05);\n  } else if (phase < 0.20) {\n    col = mix(white, cyan, (phase - 0.05) / 0.15);\n  } else if (phase < 0.40) {\n    col = mix(cyan, blue, (phase - 0.20) / 0.20);\n  } else if (phase < 0.65) {\n    col = mix(blue, magenta, (phase - 0.40) / 0.25);\n  } else if (phase < 0.85) {\n    col = mix(magenta, purple, (phase - 0.65) / 0.20);\n  } else {\n    col = mix(purple, dark, (phase - 0.85) / 0.15);\n  }\n  return col;\n}\n\n// ── Per-shape parameters from hash ──\nstruct ShapeData {\n  vec2 center;\n  float rotation;\n  float scale;\n  int type;\n  float birthTime;\n};\n\nShapeData getShape(int idx, float flashInterval) {\n  ShapeData s;\n\n  float fi = float(idx);\n\n  // Musical timing: strong beat (even idx), weak beat (odd idx)\n  bool isStrong = (mod(fi, 2.0) < 0.5);\n\n  // Hash-based position, rotation, type — changes each cycle\n  float cycleLen = float(MAX_SHAPES) * flashInterval;\n  float cycle = floor(u_time / cycleLen);\n  float seed = fi * 13.37 + cycle * 97.31;\n\n  // Timing jitter: +/-10% humanization on interval\n  float jitter = (hash(seed + 10.0) - 0.5) * 0.2 * flashInterval;\n  s.birthTime = fi * flashInterval + jitter;\n\n  // Position: spread across screen with some randomness\n  vec2 basePos = hash2(seed + 1.0) * 2.0 - 1.0;\n  s.center = basePos * vec2(0.65, 0.50);\n\n  // Rotation: dramatic angles — quantized to bold increments + randomness\n  float baseAngle = floor(hash(seed + 2.0) * 8.0) * (PI / 4.0);\n  float angleJitter = (hash(seed + 5.0) - 0.5) * (PI / 6.0);\n  s.rotation = baseAngle + angleJitter;\n\n  // Scale: wide variety, strong beats are bigger\n  float baseScale = 0.4 + hash(seed + 3.0) * 1.2;\n  s.scale = isStrong ? baseScale * 1.3 : baseScale * 0.7;\n\n  // Shape type\n  s.type = int(mod(hash(seed + 4.0) * 5.0, 5.0));\n\n  return s;\n}\n\nvoid main() {\n  vec2 fragCoord = gl_FragCoord.xy;\n  vec2 uv = fragCoord / u_res;\n  float aspect = u_res.x / u_res.y;\n\n  // Aspect-corrected centered coordinates\n  vec2 mouseShift = vec2(0.0);\n  if (u_mouse.x > 0.0) {\n    vec2 mUV = u_mouse / u_res;\n    mouseShift = -(mUV - 0.5) * 0.15;\n  }\n  vec2 p = (uv - 0.5) * vec2(aspect, 1.0);\n\n  float t = u_time;\n  float flashInterval = u_flashRate;\n  float decayDuration = 4.0;\n  float cycleLen = float(MAX_SHAPES) * flashInterval;\n\n  // Time within the current cycle\n  float cycleTime = mod(t, cycleLen);\n\n  // ── Background ──\n  // Dark blue-purple base with subtle noise texture\n  vec3 bg = vec3(0.015, 0.012, 0.025);\n  float bgNoise = vnoise(p * 3.0 + t * 0.05) * 0.4 + vnoise(p * 7.0 - t * 0.03) * 0.3;\n  bgNoise += vnoise(p * 1.5 + vec2(t * 0.02, -t * 0.01)) * 0.3;\n  bg += vec3(0.008, 0.006, 0.015) * bgNoise;\n\n  // Background pulse: brightens with each new shape (more visible)\n  float currentShapeIdx = floor(cycleTime / flashInterval);\n  float timeSinceLastFlash = cycleTime - currentShapeIdx * flashInterval;\n  bool currentIsStrong = (mod(currentShapeIdx, 2.0) < 0.5);\n  float bgPulseStrength = currentIsStrong ? 0.18 : 0.08;\n  float bgPulse = exp(-timeSinceLastFlash * 6.0) * bgPulseStrength;\n  bg += vec3(0.08, 0.06, 0.12) * bgPulse;\n\n  vec3 col = bg;\n\n  // ── Process each shape ──\n  // We check shapes from two cycles: current and previous,\n  // so fading shapes from the last cycle are still visible\n  for (int ci = 0; ci < 2; ci++) {\n\n    for (int i = 0; i < MAX_SHAPES; i++) {\n      ShapeData shape = getShape(i, flashInterval);\n\n      // For previous cycle, adjust birth times and use previous cycle seed\n      float birthT = shape.birthTime;\n      float fi = float(i);\n      bool isStrong = (mod(fi, 2.0) < 0.5);\n      if (ci == 1) {\n        // Previous cycle shapes — recalculate with previous cycle hash\n        float prevCycle = floor(t / cycleLen) - 1.0;\n        float seed = fi * 13.37 + prevCycle * 97.31;\n        shape.center = (hash2(seed + 1.0) * 2.0 - 1.0) * vec2(0.65, 0.50);\n        float baseAngle = floor(hash(seed + 2.0) * 8.0) * (PI / 4.0);\n        float angleJitter = (hash(seed + 5.0) - 0.5) * (PI / 6.0);\n        shape.rotation = baseAngle + angleJitter;\n        float baseScale = 0.4 + hash(seed + 3.0) * 1.2;\n        shape.scale = isStrong ? baseScale * 1.3 : baseScale * 0.7;\n        shape.type = int(mod(hash(seed + 4.0) * 5.0, 5.0));\n        float jitter = (hash(seed + 10.0) - 0.5) * 0.2 * flashInterval;\n        shape.birthTime = fi * flashInterval + jitter;\n        birthT = shape.birthTime - cycleLen;\n      }\n\n      // Age of this shape\n      float age = cycleTime - birthT;\n      if (ci == 1) age = cycleTime + cycleLen - shape.birthTime;\n\n      // Skip if not born yet or fully faded\n      if (age < 0.0 || age > decayDuration) continue;\n\n      // Decay phase: 0 = just born, 1 = fully gone\n      float phase = age / decayDuration;\n\n      // ── Evaluate SDF (with per-shape parallax depth) ──\n      float depthLayer = 0.5 + float(i) * 0.25;\n      vec2 localP = p - shape.center - mouseShift * depthLayer;\n      localP = rot2(shape.rotation) * localP;\n      float d = evalShape(localP, shape.type, shape.scale);\n\n      // ── Flash moment (first 0.2s) ──\n      float flashPhase = clamp(age / 0.2, 0.0, 1.0);\n      float isFlashing = 1.0 - flashPhase;\n      float beatMul = isStrong ? 1.4 : 0.8;\n\n      // ── Layer 1: Active shape fill (translucent, edge-bright gradient) ──\n      float fillAlpha = smoothstep(0.005, -0.005, d);\n      // Interior gradient: brighter at edges (d near 0), dimmer at center (d very negative)\n      float interiorDist = clamp(-d / (shape.scale * 0.25), 0.0, 1.0);\n      float edgeBrightness = 1.0 - interiorDist * 0.65;\n      float fillFade = exp(-age * 2.5);\n      float flashBright = isFlashing * 2.0 * beatMul + fillFade;\n      vec3 fillColor = decayColor(phase) * flashBright * edgeBrightness;\n\n      // During flash moment, override to white (still with edge gradient)\n      fillColor = mix(fillColor, vec3(2.5) * edgeBrightness, isFlashing * fillAlpha);\n\n      col += fillColor * fillAlpha * (1.0 - phase * phase) * u_glowIntensity * 0.5;\n\n      // ── Layer 2: Shape afterglow outline ──\n      float edgeWidth = 0.006 + 0.003 * (1.0 - phase);\n      float edge = smoothstep(edgeWidth, edgeWidth * 0.3, abs(d));\n      float edgeFade = 1.0 - phase * phase * phase;\n      vec3 edgeColor = decayColor(phase * 0.85) * edgeFade;\n\n      // Edge is brighter than fill\n      col += edgeColor * edge * u_glowIntensity * 1.2;\n\n      // ── Layer 3: Edge bloom (soft glow) ──\n      // Wider and softer during flash, tightens as shape decays\n      float bloomWidthFlash = isStrong ? 0.08 : 0.05;\n      float bloomWidthDecay = 0.015 + 0.015 * (1.0 - phase);\n      float bloomWidth = mix(bloomWidthDecay, bloomWidthFlash, isFlashing);\n      float bloom = exp(-abs(d) / bloomWidth);\n      float bloomIntensity = mix(0.3, 1.8 * beatMul, isFlashing) * (1.0 - phase);\n      vec3 bloomColor = decayColor(phase * 0.7);\n      // Add warm tint to hottest point of bloom\n      vec3 warmBloom = mix(bloomColor, bloomColor + vec3(0.15, 0.1, 0.05), bloom * isFlashing);\n      col += warmBloom * bloom * bloomIntensity * u_glowIntensity * 0.4;\n\n      // Extra hot bloom during flash — warm-tinted white core\n      if (age < 0.25) {\n        float hotBloomWidth = isStrong ? 0.10 : 0.06;\n        float hotBloom = exp(-abs(d) / hotBloomWidth) * isFlashing;\n        col += vec3(0.95, 0.92, 0.85) * hotBloom * u_glowIntensity * 0.7 * beatMul;\n      }\n\n      // ── Layer 4: Chromatic fringe ──\n      // Pronounced RGB split at edges, especially during mid-decay (cyan→magenta)\n      float fringePeak = sin(clamp(phase * PI, 0.0, PI));\n      float fringeAmount = fringePeak * 0.035;\n      if (fringeAmount > 0.001) {\n        vec2 fringeDir = normalize(localP + vec2(0.001));\n        // Wider fringe sampling for more visible separation\n        float dR = evalShape(localP + fringeDir * fringeAmount, shape.type, shape.scale);\n        float dB = evalShape(localP - fringeDir * fringeAmount, shape.type, shape.scale);\n        // Also sample at half-offset for a softer outer halo\n        float dR2 = evalShape(localP + fringeDir * fringeAmount * 0.5, shape.type, shape.scale);\n        float dB2 = evalShape(localP - fringeDir * fringeAmount * 0.5, shape.type, shape.scale);\n        float fringeEdgeW = edgeWidth * 2.0;\n        float edgeR = smoothstep(fringeEdgeW, fringeEdgeW * 0.2, abs(dR));\n        float edgeB = smoothstep(fringeEdgeW, fringeEdgeW * 0.2, abs(dB));\n        float edgeR2 = smoothstep(fringeEdgeW * 1.5, fringeEdgeW * 0.3, abs(dR2));\n        float edgeB2 = smoothstep(fringeEdgeW * 1.5, fringeEdgeW * 0.3, abs(dB2));\n        float fringeFade = edgeFade * 0.8;\n        col.r += (edgeR + edgeR2 * 0.5) * fringeFade * 0.5;\n        col.b += (edgeB + edgeB2 * 0.5) * fringeFade * 0.5;\n      }\n    }\n  }\n\n  // ── Layer 6: Scanline overlay ──\n  float scanline = sin(fragCoord.y * 1.5) * 0.5 + 0.5;\n  scanline = 0.92 + scanline * 0.08;\n  col *= scanline;\n\n  // ── Vignette ──\n  vec2 vc = uv - 0.5;\n  float vig = 1.0 - dot(vc, vc) * 1.8;\n  vig = clamp(vig, 0.0, 1.0);\n  vig = pow(vig, 0.5);\n  col *= vig;\n\n  // ── Film grain ──\n  float grain = (fract(sin(dot(fragCoord, vec2(12.9898, 78.233)) + fract(t * 0.1) * 100.0) * 43758.5453) - 0.5) * 0.025;\n  col += grain;\n\n  // ── ACES tone mapping ──\n  col = ACESFilm(col);\n\n  // ── Gamma correction ──\n  col = pow(max(col, 0.0), vec3(0.95));\n\n  gl_FragColor = vec4(col, 1.0);\n}", "format": "raw", "inputs": [{"name": "u_time", "type": "float", "default": 1}, {"name": "u_res", "type": "vec2", "default": [0.5, 0.5]}, {"name": "u_flashRate", "type": "float", "default": 0.7, "min": 0.3, "max": 2}, {"name": "u_glowIntensity", "type": "float", "default": 1, "min": 0.3, "max": 2}, {"name": "u_mouse", "type": "vec2", "default": [-1, -1]}], "description": "Sharp neon geometric shapes flashing in choreographed sequence with cyan-to-magenta afterglow decay.", "categories": ["fill", "geometric"]}, {"id": "radiant-laser-labyrinth", "name": "Laser Labyrinth", "kind": "generator", "family": "Radiant", "license": "MIT", "sourceUrl": "https://github.com/pbakaus/radiant/blob/59e9f48c0ad9a3db2fbeb8898b4390d5a1eabb40/static/laser-labyrinth.html", "source": "precision highp float;\nuniform float u_time;\nuniform vec2 u_res;\nuniform float u_sweep;\nuniform float u_intensity;\nuniform vec2 u_mouse;\n\n#define PI 3.14159265359\n\n// ── Hash & noise for fog ──\nfloat hash(vec2 p) {\n  return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);\n}\n\nfloat hash3(vec3 p) {\n  return fract(sin(dot(p, vec3(127.1, 311.7, 74.7))) * 43758.5453);\n}\n\n// ── 3D value noise ──\nfloat noise3d(vec3 p) {\n  vec3 i = floor(p);\n  vec3 f = fract(p);\n  f = f * f * (3.0 - 2.0 * f);\n  float n000 = hash3(i);\n  float n100 = hash3(i + vec3(1.0, 0.0, 0.0));\n  float n010 = hash3(i + vec3(0.0, 1.0, 0.0));\n  float n110 = hash3(i + vec3(1.0, 1.0, 0.0));\n  float n001 = hash3(i + vec3(0.0, 0.0, 1.0));\n  float n101 = hash3(i + vec3(1.0, 0.0, 1.0));\n  float n011 = hash3(i + vec3(0.0, 1.0, 1.0));\n  float n111 = hash3(i + vec3(1.0, 1.0, 1.0));\n  float nx00 = mix(n000, n100, f.x);\n  float nx10 = mix(n010, n110, f.x);\n  float nx01 = mix(n001, n101, f.x);\n  float nx11 = mix(n011, n111, f.x);\n  float nxy0 = mix(nx00, nx10, f.y);\n  float nxy1 = mix(nx01, nx11, f.y);\n  return mix(nxy0, nxy1, f.z);\n}\n\n// ── FBM (4 octaves) ──\nfloat fbm(vec3 p) {\n  float v = 0.0;\n  float a = 0.5;\n  vec3 shift = vec3(100.0);\n  for (int i = 0; i < 4; i++) {\n    v += a * noise3d(p);\n    p = p * 2.0 + shift;\n    a *= 0.5;\n  }\n  return v;\n}\n\n// ── Color palette with hue rotation ──\nvec3 coneColor(int idx, float hueShift) {\n  vec3 col;\n  if (idx == 0) col = vec3(1.0, 0.0, 0.5);\n  else if (idx == 1) col = vec3(0.5, 0.05, 1.0);\n  else if (idx == 2) col = vec3(0.1, 0.35, 1.0);\n  else if (idx == 3) col = vec3(0.85, 0.0, 0.85);\n  else if (idx == 4) col = vec3(0.15, 0.2, 1.0);\n  else col = vec3(0.0, 0.8, 0.95);\n\n  // Apply slow hue rotation\n  float angle = hueShift;\n  float cosA = cos(angle);\n  float sinA = sin(angle);\n  // Approximate hue rotation via luminance-preserving rotation\n  float lum = dot(col, vec3(0.299, 0.587, 0.114));\n  vec3 grey = vec3(lum);\n  vec3 diff = col - grey;\n  // Rotate in the plane perpendicular to the luminance axis\n  vec3 axis1 = normalize(vec3(1.0, -1.0, 0.0));\n  vec3 axis2 = normalize(vec3(0.5, 0.5, -1.0));\n  float d1 = dot(diff, axis1);\n  float d2 = dot(diff, axis2);\n  vec3 rotated = grey + axis1 * (d1 * cosA - d2 * sinA) + axis2 * (d1 * sinA + d2 * cosA);\n  return clamp(rotated, 0.0, 1.0);\n}\n\nvoid main() {\n  // UV: 0..1 range, y=0 at bottom, y=1 at top\n  vec2 fragUV = gl_FragCoord.xy / u_res;\n  // Aspect-corrected UV centered at (0.5, 1.0) for top-origin cones\n  float aspect = u_res.x / u_res.y;\n  vec2 uv = fragUV;\n  uv.x = (uv.x - 0.5) * aspect;  // centered horizontally, aspect corrected\n  // uv.y goes 0 (bottom) to 1 (top)\n\n  float t = u_time * u_sweep;\n  float intensity = u_intensity;\n\n  // ── Mouse attraction: bend beams toward cursor ──\n  vec2 mouseUV = vec2(-1.0);\n  if (u_mouse.x > 0.0) {\n    mouseUV = u_mouse / u_res;\n    mouseUV.x = (mouseUV.x - 0.5) * aspect;\n  }\n\n  // ── Fog base: 3D FBM noise drifting slowly ──\n  vec3 fogCoord = vec3(fragUV * 3.0, t * 0.08);\n  fogCoord.y -= t * 0.03;  // slow upward drift\n  fogCoord.x += t * 0.015; // slight sideways drift\n  float fogDensity = fbm(fogCoord);\n\n  // Second fog layer for more detail\n  vec3 fogCoord2 = vec3(fragUV * 6.0 + 50.0, t * 0.12);\n  fogCoord2.y -= t * 0.05;\n  float fogDetail = fbm(fogCoord2);\n  float fog = fogDensity * 0.5 + fogDetail * 0.5;\n  fog = fog * fog * 1.5;  // boost contrast for visible wisps\n\n  // ── Accumulate light from all cones ──\n  vec3 col = vec3(0.0);\n\n  // Bounded hue oscillation (stays in cool/neon range)\n  float hueShift = sin(t * 0.07) * 0.2;\n\n  // Global beat pulse (~1.5 second period)\n  float globalBeat = pow(abs(sin(t * PI / 1.5)), 8.0) * 0.2;\n\n  // ── Far layer: 3 cones (indices 0-2) ──\n  // These are dimmer, move slower, slightly blurred\n  for (int i = 0; i < 3; i++) {\n    float fi = float(i);\n\n    // Origin spread along top edge\n    float originX = (fi - 1.0) * 0.4 * aspect;  // spread across top\n    originX += sin(t * 0.07 + fi * 2.5) * 0.1 * aspect;  // slight drift\n    vec2 origin = vec2(originX, 1.05);  // just above top edge\n\n    // Sweep angle: smooth sinusoidal, slower for far layer\n    float baseAngle = PI * 0.5;  // pointing downward (toward y=0)\n    float sweepAmp = 0.4 + fi * 0.1;\n    float sweepFreq = 0.3 + fi * 0.11;\n    float theta = sin(t * sweepFreq * 0.7 + fi * 1.9) * sweepAmp;\n\n    // Direction of cone center (pointing downward from top)\n    vec2 dir = vec2(sin(theta), -cos(theta));\n\n    // Mouse attraction: smoothly bend beam toward cursor\n    if (mouseUV.x > -0.5) {\n      vec2 toMouse = mouseUV - origin;\n      float mouseAngle = atan(toMouse.x, -toMouse.y);\n      float attraction = 0.3 / (1.0 + length(toMouse) * 2.0);\n      float angleDiff = mouseAngle - theta;\n      // Normalize angle diff to [-PI, PI] to prevent wrapping jumps\n      angleDiff = mod(angleDiff + PI, PI * 2.0) - PI;\n      float blended = theta + angleDiff * attraction;\n      dir = vec2(sin(blended), -cos(blended));\n    }\n\n    // Vector from origin to current pixel\n    vec2 toPixel = uv - origin;\n\n    // Project onto cone axis\n    float along = dot(toPixel, dir);\n\n    // Perpendicular distance from cone axis\n    float perp = abs(toPixel.x * dir.y - toPixel.y * dir.x);\n\n    // Wide cone for far layer\n    float halfWidth = 0.13 + fi * 0.015;\n    float coneWidth = halfWidth * max(along, 0.0) + 0.012;\n\n    // Soft gaussian falloff from center\n    float inCone = exp(-perp * perp / (coneWidth * coneWidth * 0.55));\n\n    // Only illuminate in front of origin (along > 0)\n    inCone *= smoothstep(0.0, 0.08, along);\n\n    // Distance falloff (dimmer farther from source)\n    inCone *= exp(-along * along * 0.15);\n\n    // Fog modulation: light scattering through smoke\n    float fogMod = 0.25 + fog * 0.75;\n    float volumetric = inCone * fogMod;\n\n    // Far layer: reduced brightness and slightly blurred (wider cone)\n    float farOpacity = 0.35;\n\n    vec3 coneCol = coneColor(i, hueShift + fi * 0.15);\n    col += coneCol * volumetric * farOpacity * intensity * (1.0 + globalBeat);\n  }\n\n  // ── Near layer: 3 cones (indices 3-5) ──\n  // Brighter, sharper, faster movement\n  for (int i = 0; i < 3; i++) {\n    float fi = float(i);\n    int colorIdx = i + 3;\n\n    // Origin spread along top edge, offset from far layer\n    float originX = (fi - 1.0) * 0.5 * aspect + 0.15 * aspect;\n    originX += sin(t * 0.1 + fi * 3.1 + 1.0) * 0.08 * aspect;\n    vec2 origin = vec2(originX, 1.02);\n\n    // Sweep angle: smooth sinusoidal + beat snaps\n    float sweepAmp = 0.5 + fi * 0.08;\n    float sweepFreq = 0.4 + fi * 0.13;\n    float theta = sin(t * sweepFreq + fi * 2.3 + 0.7) * sweepAmp;\n\n    // Beat snap: smooth rhythmic accent on 1-2 cones at a time\n    float beatFreq = 1.8 + fi * 0.4;\n    float snap = pow(abs(sin(t * beatFreq)), 6.0);\n    // Smooth gate so snaps fade in/out rather than pop\n    float snapGate = smoothstep(0.5, 0.85, sin(t * 0.7 + fi * 2.094));\n    theta += snap * snapGate * 0.18 * sin(t * beatFreq * 0.5);\n\n    vec2 dir = vec2(sin(theta), -cos(theta));\n\n    // Mouse attraction: smoothly bend beam toward cursor\n    if (mouseUV.x > -0.5) {\n      vec2 toMouse = mouseUV - origin;\n      float mouseAngle = atan(toMouse.x, -toMouse.y);\n      float attraction = 0.4 / (1.0 + length(toMouse) * 2.0);\n      float angleDiff = mouseAngle - theta;\n      angleDiff = mod(angleDiff + PI, PI * 2.0) - PI;\n      float blended = theta + angleDiff * attraction;\n      dir = vec2(sin(blended), -cos(blended));\n    }\n\n    vec2 toPixel = uv - origin;\n    float along = dot(toPixel, dir);\n    float perp = abs(toPixel.x * dir.y - toPixel.y * dir.x);\n\n    // Wider cone for cinematic spotlights\n    float halfWidth = 0.11 + fi * 0.012;\n    float coneWidth = halfWidth * max(along, 0.0) + 0.01;\n\n    // Gaussian falloff with bright core\n    float inCone = exp(-perp * perp / (coneWidth * coneWidth * 0.4));\n    // Bright center line within cone\n    float coreLine = exp(-perp * perp / (coneWidth * coneWidth * 0.04));\n    inCone = inCone + coreLine * 0.4;\n    inCone *= smoothstep(0.0, 0.06, along);\n    inCone *= exp(-along * along * 0.1);\n\n    // Fog modulation\n    float fogMod = 0.2 + fog * 0.8;\n    float volumetric = inCone * fogMod;\n\n    // Near layer: bright\n    float nearOpacity = 0.75;\n\n    vec3 coneCol = coneColor(colorIdx, hueShift + fi * 0.15 + 0.5);\n    col += coneCol * volumetric * nearOpacity * intensity * (1.0 + globalBeat);\n  }\n\n  // ── Intersection bloom: additive blending already handles this ──\n  // Where cones overlap, color adds up. Boost those bright areas toward white.\n  float brightness = dot(col, vec3(0.299, 0.587, 0.114));\n  // Push overlapping areas toward white (desaturate at high brightness)\n  float whiteBlend = smoothstep(0.4, 1.2, brightness);\n  col = mix(col, vec3(brightness * 1.3), whiteBlend * 0.5);\n\n  // ── Ground haze: fog pooling on the dance floor ──\n  float groundHaze = smoothstep(0.2, 0.0, fragUV.y);\n  float hazeFog = fbm(vec3(fragUV.x * 4.0, fragUV.y * 2.0, t * 0.05 + 10.0));\n  col += col * groundHaze * 0.3;\n  // Subtle ambient haze at floor level\n  col += vec3(0.06, 0.03, 0.1) * groundHaze * hazeFog * intensity;\n\n  // ── Exponential tone mapping ──\n  float exposure = 2.0;\n  col = 1.0 - exp(-col * exposure);\n\n  // ── Film grain ──\n  float grain = hash(gl_FragCoord.xy + fract(u_time) * 100.0) * 0.04 - 0.02;\n  col += grain;\n\n  // ── Vignette (corners only) ──\n  vec2 vigUV = fragUV - 0.5;\n  float vigDist = dot(vigUV, vigUV);\n  float vig = 1.0 - vigDist * 0.8;\n  vig = clamp(vig, 0.0, 1.0);\n  col *= vig;\n\n  // Clamp to valid range\n  col = clamp(col, 0.0, 1.0);\n\n  gl_FragColor = vec4(col, 1.0);\n}", "format": "raw", "inputs": [{"name": "u_time", "type": "float", "default": 1}, {"name": "u_res", "type": "vec2", "default": [0.5, 0.5]}, {"name": "u_sweep", "type": "float", "default": 0.5}, {"name": "u_intensity", "type": "float", "default": 1}, {"name": "u_mouse", "type": "vec2", "default": [-1, -1]}], "description": "Volumetric laser beams crossing in a dark void with prismatic colors and intersection flares.", "categories": ["fill", "geometric"]}, {"id": "radiant-bass-ripple", "name": "Bass Ripple", "kind": "generator", "family": "Radiant", "license": "MIT", "sourceUrl": "https://github.com/pbakaus/radiant/blob/59e9f48c0ad9a3db2fbeb8898b4390d5a1eabb40/static/bass-ripple.html", "source": "precision highp float;\nuniform float u_time;\nuniform vec2 u_res;\nuniform float u_bassFreq;\nuniform float u_bassIntensity;\nuniform vec2 u_mouse;\n\n#define PI 3.14159265359\n#define TAU 6.28318530718\n\n// ── Hash / noise ──\nfloat hash(vec2 p) {\n  return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);\n}\n\nfloat hash3(vec3 p) {\n  return fract(sin(dot(p, vec3(127.1, 311.7, 74.7))) * 43758.5453);\n}\n\nfloat noise(vec2 p) {\n  vec2 i = floor(p);\n  vec2 f = fract(p);\n  f = f * f * (3.0 - 2.0 * f);\n  return mix(mix(hash(i), hash(i + vec2(1,0)), f.x),\n             mix(hash(i + vec2(0,1)), hash(i + vec2(1,1)), f.x), f.y);\n}\n\n// ── Rotation ──\nmat2 rot2(float a) {\n  float c = cos(a), s = sin(a);\n  return mat2(c, -s, s, c);\n}\n\n// ── Beat-synced displacement ──\n// Returns height displacement at a mesh point, combining multiple wave modes\nfloat displacement(vec2 p, float t, float bassFreq, float intensity) {\n  float period = 1.0 / max(bassFreq, 0.01);\n  float phase = t / period;\n  float beatFrac = fract(phase);\n\n  // Sharp attack, exponential decay per beat\n  float envelope = exp(-beatFrac * 3.5);\n\n  // Previous beat residue for overlapping waves\n  float prevEnv = exp(-(beatFrac + 1.0) * 3.5);\n  float prevEnv2 = exp(-(beatFrac + 2.0) * 3.5);\n\n  float dist = length(p);\n  float angle = atan(p.y, p.x);\n\n  // Wave mode 1: concentric ripples from center — primary bass hit\n  float wave1 = sin(dist * 14.0 - beatFrac * 22.0) * envelope;\n\n  // Wave mode 2: slower, wider concentric from center (prev beat residue)\n  float wave2 = sin(dist * 9.0 - (beatFrac + 1.0) * 16.0) * prevEnv * 0.6;\n\n  // Wave mode 3: second prev beat — even wider, fainter\n  float wave3 = sin(dist * 6.0 - (beatFrac + 2.0) * 12.0) * prevEnv2 * 0.3;\n\n  // Wave mode 4: standing wave pattern (cross-hatch)\n  float standing = (sin(p.x * 18.0) * sin(p.y * 18.0)) * envelope * 0.3;\n\n  // Wave mode 5: radial drumhead modes (angular patterns)\n  float radialMode = sin(dist * 22.0) * cos(angle * 3.0) * envelope * 0.2;\n  radialMode += sin(dist * 16.0) * cos(angle * 5.0 + 1.0) * prevEnv * 0.1;\n\n  // Wave mode 6: off-center ripple source (drifts slowly)\n  vec2 offCenter = vec2(0.3 * sin(t * 0.2), 0.25 * cos(t * 0.25));\n  float dist2 = length(p - offCenter);\n  float wave6 = sin(dist2 * 12.0 - beatFrac * 18.0) * envelope * 0.35;\n\n  // Mouse ripple origin\n  float mouseWave = 0.0;\n  if (u_mouse.x > 0.0) {\n    vec2 mouseNorm = (u_mouse / u_res - 0.5) * vec2(u_res.x / u_res.y, 1.0);\n    float mouseDist = length(p - mouseNorm);\n    mouseWave = sin(mouseDist * 16.0 - beatFrac * 20.0) * envelope * 0.7;\n    mouseWave += sin(mouseDist * 10.0 - (beatFrac + 1.0) * 14.0) * prevEnv * 0.4;\n    mouseWave *= 1.0 / (1.0 + mouseDist * 3.0);\n  }\n\n  // Low-frequency dome push — the whole mesh pushes out on beat\n  float dome = (1.0 - smoothstep(0.0, 1.0, dist)) * envelope * 0.8;\n\n  float h = (wave1 + wave2 + wave3 + standing + radialMode + wave6 + mouseWave + dome) * intensity;\n\n  // Subtle idle vibration when between beats\n  float idle = sin(dist * 8.0 + t * 3.0) * 0.03 * (1.0 - envelope);\n  idle += sin(dist * 5.0 - t * 1.5) * 0.015 * (1.0 - envelope);\n  h += idle * intensity;\n\n  return h;\n}\n\n// ── Compute normal from displacement via forward differences ──\nvec3 calcNormal(vec2 p, float t, float bassFreq, float intensity, float hc) {\n  float eps = 0.002;\n  float hx = displacement(p + vec2(eps, 0.0), t, bassFreq, intensity);\n  float hy = displacement(p + vec2(0.0, eps), t, bassFreq, intensity);\n  vec3 n = normalize(vec3(-(hx - hc) / eps * 0.35, -(hy - hc) / eps * 0.35, 1.0));\n  return n;\n}\n\n// ── Hexagonal grid distance ──\n// Returns: x = distance to nearest hex edge, y,z = hex cell ID\nvec3 hexGrid(vec2 p, float scale) {\n  p *= scale;\n  vec2 r = vec2(1.0, 1.732);\n  vec2 h = r * 0.5;\n  vec2 a = mod(p, r) - h;\n  vec2 b = mod(p - h, r) - h;\n  vec2 g;\n  if (dot(a, a) < dot(b, b)) {\n    g = a;\n  } else {\n    g = b;\n  }\n  float edgeDist = 0.5 - max(abs(g.x) * 1.0 + abs(g.y) * 0.577, abs(g.y) * 1.155);\n  vec2 cellId = p - g;\n  return vec3(edgeDist, cellId);\n}\n\n// ── Fresnel approximation ──\nfloat fresnel(float cosTheta, float f0) {\n  return f0 + (1.0 - f0) * pow(1.0 - cosTheta, 5.0);\n}\n\nvoid main() {\n  vec2 uv = gl_FragCoord.xy / u_res;\n  float aspect = u_res.x / u_res.y;\n  float t = u_time;\n\n  // Centered UV with aspect correction\n  vec2 cuv = vec2((uv.x - 0.5) * aspect, uv.y - 0.5);\n\n  // ═══════════════════════════════════════════\n  // Camera / view setup — slightly off-axis\n  // ═══════════════════════════════════════════\n  // Subtle camera drift for life\n  float camDriftX = sin(t * 0.15) * 0.03;\n  float camDriftY = cos(t * 0.12) * 0.02;\n\n  // Off-axis tilt: rotate the UV plane to simulate angled view\n  // Perspective foreshortening — compress vertical axis\n  float tiltAngle = 0.35 + camDriftY;\n  float foreshorten = 0.7 + camDriftY * 0.5;\n\n  vec2 meshUV = cuv;\n  meshUV.x += camDriftX;\n  meshUV.y = meshUV.y / foreshorten;\n  meshUV.y += 0.08;\n\n  // Slight rotation for off-axis look\n  meshUV = rot2(0.06 + sin(t * 0.08) * 0.02) * meshUV;\n\n  // ═══════════════════════════════════════════\n  // Displacement — beat-synced wave patterns\n  // ═══════════════════════════════════════════\n  float h = displacement(meshUV, t, u_bassFreq, u_bassIntensity);\n  vec3 N = calcNormal(meshUV, t, u_bassFreq, u_bassIntensity, h);\n\n  // ═══════════════════════════════════════════\n  // Hexagonal mesh pattern\n  // ═══════════════════════════════════════════\n  float meshScale = 45.0;\n  vec3 hex = hexGrid(meshUV + N.xy * 0.003, meshScale);\n  float hexEdge = hex.x;\n\n  // Wire thickness — the metallic wires of the grille\n  float wireWidth = 0.06;\n  float wire = 1.0 - smoothstep(0.0, wireWidth, hexEdge);\n\n  // Inner hole mask — what you see through the grille\n  float hole = smoothstep(wireWidth, wireWidth + 0.02, hexEdge);\n\n  // Fine secondary grid overlaid (cross-hatch detail at micro level)\n  vec2 microGrid = fract(meshUV * meshScale * 3.0 + N.xy * 0.01);\n  float microWire = smoothstep(0.04, 0.0, min(microGrid.x, microGrid.y));\n  microWire += smoothstep(0.04, 0.0, min(1.0 - microGrid.x, 1.0 - microGrid.y));\n  microWire *= 0.15;\n\n  // ═══════════════════════════════════════════\n  // Lighting setup\n  // ═══════════════════════════════════════════\n  // View direction (from camera)\n  vec3 V = normalize(vec3(-cuv.x * 0.3, -cuv.y * 0.3 + 0.2, 1.0));\n\n  // Beat envelope for light modulation\n  float period = 1.0 / max(u_bassFreq, 0.01);\n  float bFrac = fract(t / period);\n  float bEnv = exp(-bFrac * 3.5);\n\n  // Key light — warm amber, sweeps slowly across surface\n  vec3 L1 = normalize(vec3(0.4 + sin(t * 0.25) * 0.4, 0.6 + cos(t * 0.18) * 0.3, 1.0));\n  float NdL1 = max(dot(N, L1), 0.0);\n  vec3 H1 = normalize(L1 + V);\n  float NdH1 = max(dot(N, H1), 0.0);\n  float spec1 = pow(NdH1, 180.0);\n  float spec1med = pow(NdH1, 50.0);\n  float spec1soft = pow(NdH1, 12.0);\n  vec3 lightCol1 = vec3(1.0, 0.82, 0.55);\n\n  // Fill light — deeper copper/bronze, from the left\n  vec3 L2 = normalize(vec3(-0.8 + sin(t * 0.15) * 0.2, 0.4, 0.8));\n  float NdL2 = max(dot(N, L2), 0.0);\n  vec3 H2 = normalize(L2 + V);\n  float NdH2 = max(dot(N, H2), 0.0);\n  float spec2 = pow(NdH2, 120.0);\n  float spec2soft = pow(NdH2, 25.0);\n  vec3 lightCol2 = vec3(0.85, 0.55, 0.3);\n\n  // Accent light — bright gold, moves with beat\n  vec3 L3 = normalize(vec3(0.3 + bEnv * 0.3, -0.6, 0.6));\n  float NdL3 = max(dot(N, L3), 0.0);\n  vec3 H3 = normalize(L3 + V);\n  float NdH3 = max(dot(N, H3), 0.0);\n  float spec3 = pow(NdH3, 90.0);\n  float spec3soft = pow(NdH3, 18.0);\n  vec3 lightCol3 = vec3(1.0, 0.7, 0.25);\n\n  // Top-down fill for overall brightness\n  vec3 L4 = normalize(vec3(0.0, 0.1, 1.0));\n  float NdL4 = max(dot(N, L4), 0.0);\n\n  // Rim/backlight — warm amber edge light\n  float NdV = max(dot(N, V), 0.0);\n  float rim = pow(1.0 - NdV, 4.0);\n  vec3 rimCol = vec3(0.9, 0.55, 0.2);\n\n  // ═══════════════════════════════════════════\n  // Material: metallic gunmetal / brushed chrome\n  // ═══════════════════════════════════════════\n  vec3 baseColor = vec3(0.38, 0.32, 0.25);\n  baseColor += vec3(0.035, 0.025, 0.015) * noise(meshUV * 30.0);\n  baseColor += vec3(0.02, 0.015, 0.01) * noise(meshUV * 80.0 + 5.0);\n\n  // Strong metallic fresnel\n  float f0 = 0.75;\n  float fres = fresnel(NdV, f0);\n\n  // ═══════════════════════════════════════════\n  // Compose wire material\n  // ═══════════════════════════════════════════\n  // Diffuse — generous for visible wire brightness\n  vec3 diffuse = baseColor * (NdL1 * lightCol1 * 1.0 + NdL2 * lightCol2 * 0.5 + NdL3 * lightCol3 * 0.25 + NdL4 * 0.4);\n  // Strong ambient — ensures wires are always clearly visible as metal\n  diffuse += baseColor * 0.18;\n  // Hemisphere ambient — warm amber above, darker below\n  vec3 hemiAmb = mix(vec3(0.04, 0.03, 0.02), vec3(0.08, 0.06, 0.04), N.y * 0.5 + 0.5);\n  diffuse += hemiAmb;\n\n  // Specular — the star of the show\n  vec3 specular = vec3(0.0);\n  // Key: sharp peak + broad medium + very wide bloom\n  specular += spec1 * lightCol1 * 3.5;\n  specular += spec1med * lightCol1 * 1.2;\n  specular += spec1soft * lightCol1 * 0.25;\n  // Fill: sharp + broad\n  specular += spec2 * lightCol2 * 2.5;\n  specular += spec2soft * lightCol2 * 0.5;\n  // Accent: magenta — sharp + broad\n  specular += spec3 * lightCol3 * 3.0;\n  specular += spec3soft * lightCol3 * 0.4;\n  specular *= fres;\n\n  // Beat flare on specular\n  specular *= 1.0 + bEnv * 1.0 * u_bassIntensity;\n\n  // Anisotropic edge highlight on the wire ridge\n  float wireCenter = abs(hexEdge - wireWidth * 0.5) / max(wireWidth, 0.001);\n  float aniso = pow(max(1.0 - wireCenter, 0.0), 3.0);\n  specular += aniso * wire * vec3(0.55, 0.4, 0.2) * fres * 0.5;\n\n  // Wire color composition\n  vec3 wireCol = diffuse + specular;\n  wireCol += rim * rimCol * 0.5;\n\n  // Micro scratches catching light\n  wireCol += microWire * vec3(0.15, 0.1, 0.06) * fres;\n\n  // ═══════════════════════════════════════════\n  // Hole interior — dark void with depth\n  // ═══════════════════════════════════════════\n  vec3 holeCol = vec3(0.015, 0.01, 0.006);\n  // Speaker cone behind the mesh — subtle presence\n  float coneRefl = max(dot(N, vec3(0.0, 0.0, 1.0)), 0.0);\n  holeCol += vec3(0.03, 0.02, 0.01) * coneRefl;\n\n  // Beat pulse visible in holes — cone movement + light leak\n  float conePush = max(h * 0.4, 0.0);\n  holeCol += vec3(0.06, 0.04, 0.02) * conePush;\n  // Warm amber light leaking through grille on beat\n  holeCol += vec3(0.2, 0.12, 0.04) * bEnv * 0.35 * u_bassIntensity;\n  // Copper accent leak\n  holeCol += vec3(0.12, 0.06, 0.02) * bEnv * 0.15 * u_bassIntensity;\n\n  // ═══════════════════════════════════════════\n  // Combine wire + hole\n  // ═══════════════════════════════════════════\n  vec3 col = mix(holeCol, wireCol, wire);\n\n  // Add micro-wire overlay even on holes (very fine secondary mesh)\n  col += microWire * vec3(0.02, 0.018, 0.025) * (1.0 - hole * 0.7);\n\n  // ═══════════════════════════════════════════\n  // Beat-synced global effects\n  // ═══════════════════════════════════════════\n  // Color wash on beat — alternates amber and copper\n  vec3 beatColor = mix(vec3(0.5, 0.3, 0.1), vec3(0.4, 0.2, 0.08), sin(t * 0.4) * 0.5 + 0.5);\n  col += beatColor * bEnv * 0.03 * u_bassIntensity;\n\n  // ═══════════════════════════════════════════\n  // Environment reflection on wire surface\n  // ═══════════════════════════════════════════\n  // Rich fake environment map — studio HDRI-like\n  vec3 refl = reflect(-V, N);\n  vec3 envCol = vec3(0.03, 0.03, 0.06);\n  // Warm overhead gradient\n  envCol += vec3(0.12, 0.08, 0.06) * pow(max(refl.y, 0.0), 2.0);\n  // Warm side gradient\n  envCol += vec3(0.15, 0.08, 0.03) * pow(max(-refl.x, 0.0), 2.0);\n  // Copper accent below\n  envCol += vec3(0.2, 0.1, 0.04) * pow(max(-refl.y, 0.0), 3.0);\n  // Bright studio softbox reflection\n  float softbox = pow(max(dot(refl, normalize(vec3(0.2, 0.8, 0.5))), 0.0), 8.0);\n  envCol += vec3(0.3, 0.28, 0.25) * softbox;\n  // Beat-pulsed environment brightness\n  envCol *= 1.0 + bEnv * 0.5 * u_bassIntensity;\n  col += envCol * fres * wire * 0.5;\n\n  // ═══════════════════════════════════════════\n  // Post processing\n  // ═══════════════════════════════════════════\n  // Vignette — macro lens effect\n  vec2 vc = uv - 0.5;\n  float vig = 1.0 - dot(vc, vc) * 2.0;\n  vig = smoothstep(0.0, 1.0, vig);\n  col *= vig;\n\n  // Subtle depth-of-field blur at edges (darken + desaturate)\n  float dofDist = length(cuv);\n  float dof = smoothstep(0.3, 0.8, dofDist);\n  col = mix(col, col * vec3(0.7, 0.65, 0.75), dof * 0.3);\n\n  // Film grain — macro photography feel\n  float grain = hash(gl_FragCoord.xy + fract(t * 7.3) * 100.0);\n  col += (grain - 0.5) * 0.018;\n\n  // Subtle chromatic aberration at vignette edges\n  float ca = dofDist * 0.003;\n  col.r += (hash(gl_FragCoord.xy * 0.5 + 1.0) - 0.5) * ca;\n  col.b += (hash(gl_FragCoord.xy * 0.5 + 2.0) - 0.5) * ca;\n\n  // Tone mapping — Reinhard with high white point + gentle gamma lift\n  col = col / (col + vec3(1.5));\n  col = pow(max(col, vec3(0.0)), vec3(0.88));\n\n  gl_FragColor = vec4(col, 1.0);\n}", "format": "raw", "inputs": [{"name": "u_time", "type": "float", "default": 1}, {"name": "u_res", "type": "vec2", "default": [0.5, 0.5]}, {"name": "u_bassFreq", "type": "float", "default": 0.4, "min": 0.1, "max": 2}, {"name": "u_bassIntensity", "type": "float", "default": 1, "min": 0.3, "max": 2}, {"name": "u_mouse", "type": "vec2", "default": [-1, -1]}], "description": "Vibrating speaker mesh with beat-synced wave displacement and metallic specular sheen.", "categories": ["fill", "physics"]}, {"id": "radiant-sequin-wave", "name": "Sequin Wave", "kind": "generator", "family": "Radiant", "license": "MIT", "sourceUrl": "https://github.com/pbakaus/radiant/blob/59e9f48c0ad9a3db2fbeb8898b4390d5a1eabb40/static/sequin-wave.html", "source": "precision highp float;\n\nuniform float u_time;\nuniform vec2 u_res;\nuniform float u_waveSpeed;\nuniform float u_sparkle;\nuniform vec2 u_mouse;\n\n#define PI 3.14159265359\n#define TAU 6.28318530718\n#define SQRT3 1.7320508\n\n// ── Hash functions for per-sequin variation ──\nfloat hash21(vec2 p) {\n  p = fract(p * vec2(233.34, 851.73));\n  p += dot(p, p + 23.45);\n  return fract(p.x * p.y);\n}\n\nvec2 hash22(vec2 p) {\n  float n = hash21(p);\n  return vec2(n, hash21(p + n * 47.0));\n}\n\n// ── Hexagonal tiling ──\n// Returns: xy = local coords within hex cell, zw = cell ID\nvec4 hexTile(vec2 p, float scale) {\n  p *= scale;\n  // Two candidate grids offset by half a cell\n  vec2 s = vec2(1.0, SQRT3);\n  vec2 halfS = s * 0.5;\n\n  // Grid A\n  vec2 aBase = floor(p / s);\n  vec2 aLocal = mod(p, s) - halfS;\n\n  // Grid B (offset)\n  vec2 pOff = p - halfS;\n  vec2 bBase = floor(pOff / s);\n  vec2 bLocal = mod(pOff, s) - halfS;\n\n  // Pick nearest center\n  float dA = dot(aLocal, aLocal);\n  float dB = dot(bLocal, bLocal);\n\n  // Use step to avoid branching\n  float pick = step(dA, dB);\n  vec2 localCoord = mix(bLocal, aLocal, pick);\n  vec2 cellId = mix(bBase + vec2(0.5), aBase, pick);\n\n  return vec4(localCoord, cellId);\n}\n\n// ── Wave field: multiple interfering wave sources ──\nfloat waveField(vec2 cellPos, float t) {\n  float w = 0.0;\n\n  // Wave 1: diagonal sweep\n  w += sin(dot(cellPos, vec2(0.7, 0.5)) * 3.5 - t * 2.8) * 0.35;\n\n  // Wave 2: horizontal ripple\n  w += sin(cellPos.x * 4.2 + t * 1.9) * 0.25;\n\n  // Wave 3: radial pulse from offset center\n  float r1 = length(cellPos - vec2(-0.3, 0.2));\n  w += sin(r1 * 6.0 - t * 3.2) * 0.2 * smoothstep(1.2, 0.0, r1);\n\n  // Wave 4: slower diagonal from opposite direction\n  w += sin(dot(cellPos, vec2(-0.4, 0.8)) * 2.8 - t * 1.5) * 0.2;\n\n  // Wave 5: secondary radial from other side\n  float r2 = length(cellPos - vec2(0.4, -0.3));\n  w += sin(r2 * 5.0 - t * 2.4) * 0.15 * smoothstep(1.0, 0.0, r2);\n\n  return w;\n}\n\n// ── Specular calculation for a tilted sequin disc ──\n// tiltAngle: how much the sequin is tilted by the wave\n// tiltDir: direction of the tilt (2D angle)\n// Returns specular intensity\nfloat sequinSpecular(float tiltAngle, float tiltDir, vec2 uv) {\n  // Sequin normal: starts as (0,0,1), tilted by wave\n  float ct = cos(tiltAngle);\n  float st = sin(tiltAngle);\n  float cd = cos(tiltDir);\n  float sd = sin(tiltDir);\n\n  // Normal of tilted disc\n  vec3 N = vec3(st * cd, st * sd, ct);\n\n  // Light direction (from upper-right, slightly behind camera)\n  vec3 L = normalize(vec3(0.4, 0.6, 0.9));\n\n  // View direction (straight on)\n  vec3 V = vec3(0.0, 0.0, 1.0);\n\n  // Reflection of light off sequin surface\n  vec3 R = reflect(-L, N);\n\n  // Specular: how well reflection aligns with view\n  float spec = max(dot(R, V), 0.0);\n\n  // Very tight specular for mirror-like sequins\n  spec = pow(spec, 48.0);\n\n  // Secondary broader highlight for ambient sheen\n  float sheen = pow(max(dot(R, V), 0.0), 8.0) * 0.15;\n\n  return spec + sheen;\n}\n\nvoid main() {\n  vec2 uv = (gl_FragCoord.xy - u_res * 0.5) / min(u_res.x, u_res.y);\n  float t = u_time * u_waveSpeed;\n\n  // ── Hexagonal grid of sequins ──\n  float sequinScale = 38.0; // density of sequins\n  vec4 hex = hexTile(uv, sequinScale);\n  vec2 localPos = hex.xy;  // position within cell\n  vec2 cellId = hex.zw;    // which cell\n\n  // ── Per-sequin random variation ──\n  vec2 rnd = hash22(cellId);\n  float sizeVar = 0.85 + rnd.x * 0.3;       // size variation\n  float baseTilt = (rnd.y - 0.5) * 0.15;     // resting tilt offset\n  float reflVar = 0.7 + rnd.x * 0.3;         // reflectivity variation\n  float phaseOff = rnd.y * TAU;               // phase offset for shimmer\n\n  // ── Sequin disc shape ──\n  float discRadius = 0.42 * sizeVar;\n  float dist = length(localPos);\n  float disc = smoothstep(discRadius, discRadius - 0.06, dist);\n\n  // Subtle edge bevel highlight\n  float bevel = smoothstep(discRadius, discRadius - 0.04, dist)\n              - smoothstep(discRadius - 0.04, discRadius - 0.08, dist);\n\n  // ── World position of this sequin (for wave sampling) ──\n  vec2 worldPos = cellId / sequinScale;\n\n  // ── Wave-driven tilt ──\n  float wave = waveField(worldPos, t);\n\n  // Add subtle individual shimmer\n  float shimmer = sin(t * 3.0 + phaseOff) * 0.04;\n\n  // Tilt angle from wave + individual variation\n  float tiltAngle = wave * 0.85 + baseTilt + shimmer;\n\n  // Tilt direction: follows the wave gradient\n  // Approximate gradient with offset samples\n  float waveH = waveField(worldPos + vec2(0.01, 0.0), t);\n  float waveV = waveField(worldPos + vec2(0.0, 0.01), t);\n  float tiltDir = atan(waveV - wave, waveH - wave);\n\n  // ── Mouse light source: extra specular from cursor ──\n  float mouseSpec = 0.0;\n  if (u_mouse.x > 0.0) {\n    vec2 mUV = (u_mouse - u_res * 0.5) / min(u_res.x, u_res.y);\n    float mDist = length(worldPos - mUV);\n    float mInfluence = exp(-mDist * mDist * 6.0);\n    // Light from mouse position\n    vec3 mLightDir = normalize(vec3(mUV.x - worldPos.x, mUV.y - worldPos.y, 0.5));\n    float ct = cos(tiltAngle);\n    float st2 = sin(tiltAngle);\n    float cd = cos(tiltDir);\n    float sd = sin(tiltDir);\n    vec3 mN = vec3(st2 * cd, st2 * sd, ct);\n    vec3 mR = reflect(-mLightDir, mN);\n    float mS = pow(max(dot(mR, vec3(0.0, 0.0, 1.0)), 0.0), 32.0);\n    mouseSpec = mS * mInfluence * 1.5;\n  }\n\n  // ── Specular flash ──\n  float spec = sequinSpecular(tiltAngle, tiltDir, uv);\n  spec *= reflVar * u_sparkle;\n  spec += mouseSpec * reflVar;\n\n  // ── Color composition ──\n  // Dark base: sequin that is tilted away from light\n  vec3 darkSequin = vec3(0.02, 0.015, 0.01);\n\n  // Mid-tone: ambient copper reflection\n  vec3 copperMid = vec3(0.78, 0.58, 0.42);\n\n  // Bright flash: hot amber/gold when specular aligns\n  vec3 amberFlash = vec3(1.0, 0.82, 0.55);\n\n  // Hot white-gold for peak brightness\n  vec3 hotGold = vec3(1.0, 0.92, 0.72);\n\n  // Base sequin color depends on tilt (how much it faces camera)\n  float facing = cos(tiltAngle) * 0.5 + 0.5;\n  facing = clamp(facing, 0.0, 1.0);\n\n  // Warm ambient: even dark sequins have a hint of warmth\n  vec3 ambient = mix(darkSequin, vec3(0.05, 0.035, 0.02), facing * 0.6);\n\n  // Build up the specular flash in layers\n  vec3 sequinColor = ambient;\n\n  // Broad warm sheen\n  float sheenAmount = pow(max(facing, 0.0), 3.0) * 0.2 * reflVar;\n  sequinColor += copperMid * sheenAmount;\n\n  // Specular flash\n  float flashLow = smoothstep(0.0, 0.3, spec);\n  float flashHigh = smoothstep(0.3, 0.8, spec);\n  float flashPeak = smoothstep(0.7, 1.0, spec);\n  sequinColor += copperMid * flashLow * 0.5;\n  sequinColor += amberFlash * flashHigh * 0.8;\n  sequinColor += hotGold * flashPeak * 1.2;\n\n  // Bevel edge catches light differently\n  sequinColor += copperMid * bevel * facing * 0.3;\n\n  // ── Background between sequins ──\n  // Dark gap with very subtle warm tone\n  vec3 bgColor = vec3(0.012, 0.008, 0.005);\n\n  // ── Final mix: disc mask selects sequin vs gap ──\n  vec3 col = mix(bgColor, sequinColor, disc);\n\n  // ── Global lighting: subtle gradient from light direction ──\n  vec2 uvSafe = uv + vec2(0.0001);\n  float globalLight = 0.85 + 0.15 * dot(normalize(uvSafe), vec2(0.4, 0.6));\n  col *= globalLight;\n\n  // ── Vignette ──\n  float vig = 1.0 - smoothstep(0.4, 1.3, length(uv));\n  col *= 0.6 + 0.4 * vig;\n\n  // ── Warm gamma correction ──\n  col = pow(max(col, vec3(0.0)), vec3(0.93, 0.97, 1.04));\n\n  gl_FragColor = vec4(clamp(col, 0.0, 1.0), 1.0);\n}", "format": "raw", "inputs": [{"name": "u_time", "type": "float", "default": 1}, {"name": "u_res", "type": "vec2", "default": [0.5, 0.5]}, {"name": "u_waveSpeed", "type": "float", "default": 0.8, "min": 0.1, "max": 2}, {"name": "u_sparkle", "type": "float", "default": 1}, {"name": "u_mouse", "type": "vec2", "default": [-1, -1]}], "description": "Grid of metallic sequin discs catching sweeping light with specular reflections and warm shimmer.", "categories": ["fill", "geometric"]}, {"id": "radiant-gilt-mosaic", "name": "Gilt Mosaic", "kind": "generator", "family": "Radiant", "license": "MIT", "sourceUrl": "https://github.com/pbakaus/radiant/blob/59e9f48c0ad9a3db2fbeb8898b4390d5a1eabb40/static/gilt-mosaic.html", "source": "precision highp float;\nuniform float u_time;\nuniform vec2 u_res;\nuniform float u_lightSpeed;\nuniform float u_tileScale;\nuniform float u_animMode;\nuniform float u_waveSpeed;\nuniform float u_waveDelay;\nuniform float u_waveDir;\nuniform vec2 u_mouse;\nuniform vec2 u_click;\nuniform float u_clickTime;\n\n#define PI 3.14159265359\n#define TAU 6.28318530718\n\n// ── Pseudo-random hash ──\nfloat hash(vec2 p) {\n  return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);\n}\n\nvec2 hash2(vec2 p) {\n  return vec2(\n    fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453),\n    fract(sin(dot(p, vec2(269.5, 183.3))) * 43758.5453)\n  );\n}\n\n// ── Smooth value noise ──\nfloat noise(vec2 p) {\n  vec2 i = floor(p);\n  vec2 f = fract(p);\n  f = f * f * (3.0 - 2.0 * f);\n  float a = hash(i);\n  float b = hash(i + vec2(1.0, 0.0));\n  float c = hash(i + vec2(0.0, 1.0));\n  float d = hash(i + vec2(1.0, 1.0));\n  return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);\n}\n\n// ── Tile grid with jitter ──\n// Returns: xy = local coord within tile, zw = tile ID\nvec4 tileGrid(vec2 p, float scale) {\n  vec2 sp = p * scale;\n  vec2 id = floor(sp);\n  vec2 f = fract(sp);\n\n  // Jitter tile boundaries slightly for organic look\n  vec2 jitter = hash2(id) * 0.12 - 0.06;\n  f -= jitter;\n\n  return vec4(f, id);\n}\n\n// ── Per-tile normal (tilted surface) ──\nvec3 tileNormal(vec2 id) {\n  float h1 = hash(id * 1.731 + 17.3);\n  float h2 = hash(id * 2.419 + 31.7);\n\n  // Slight random tilt - each tile angled differently\n  float tiltX = (h1 - 0.5) * 0.35;\n  float tiltY = (h2 - 0.5) * 0.35;\n\n  return normalize(vec3(tiltX, tiltY, 1.0));\n}\n\n// ── Grout detection ──\nfloat groutMask(vec2 f, float groutWidth) {\n  vec2 edge = smoothstep(vec2(0.0), vec2(groutWidth), f) *\n              smoothstep(vec2(0.0), vec2(groutWidth), vec2(1.0) - f);\n  return edge.x * edge.y;\n}\n\n// ── Surface micro-roughness within a tile ──\nfloat tileRoughness(vec2 f, vec2 id) {\n  // Subtle bumps on tile surface (faceted glass / tesserae)\n  float h = hash(id + 99.0);\n  float n1 = noise(f * 8.0 + id * 3.7);\n  float n2 = noise(f * 16.0 + id * 7.1 + 50.0);\n  return n1 * 0.6 + n2 * 0.4;\n}\n\n// ── Wave flip: configurable direction, speed, delay ──\n// dir: 0=left-to-right, 1=right-to-left, 2=top-to-bottom, 3=bottom-to-top\nvec2 waveFlip(vec2 tileCenter, float rawTime, vec2 aspect) {\n  float sweepDur = u_waveSpeed;\n  float cycleDur = sweepDur + u_waveDelay;\n  float cycleT = mod(rawTime, cycleDur);\n  float waveCount = floor(rawTime / cycleDur);\n  float isOddWave = mod(waveCount, 2.0);\n  \n  // Ease-in-out cubic for smooth sweep\n  float sweepRaw = clamp(cycleT / sweepDur, 0.0, 1.0);\n  float sweep = sweepRaw * sweepRaw * (3.0 - 2.0 * sweepRaw);\n  \n  // Direction: project tile position onto wave axis\n  float dir = floor(u_waveDir + 0.5);\n  float axisLen = aspect.x;\n  float tilePos = tileCenter.x;\n  if (dir == 1.0) { tilePos = aspect.x - tileCenter.x; }\n  else if (dir == 2.0) { tilePos = 1.0 - tileCenter.y; axisLen = 1.0; }\n  else if (dir == 3.0) { tilePos = tileCenter.y; axisLen = 1.0; }\n  \n  float waveX = sweep * (axisLen + 0.6) - 0.3;\n  \n  // Per-tile stagger\n  float tileRand = hash(tileCenter * 31.7 + vec2(17.3, 59.1));\n  float stagger = tileRand * 0.06;\n  float dist = tilePos - waveX + stagger;\n  \n  // Wide wave front\n  float flipProgress = smoothstep(0.5, -0.3, dist);\n  float flipAngle = (isOddWave + flipProgress) * PI;\n  \n  // Transition intensity\n  float inTransition = smoothstep(0.6, 0.0, abs(dist + 0.1));\n  return vec2(flipAngle, inTransition);\n}\n\nvoid main() {\n  vec2 uv = gl_FragCoord.xy / u_res;\n  vec2 aspect = vec2(u_res.x / u_res.y, 1.0);\n  vec2 p = uv * aspect;\n  float t = u_time * u_lightSpeed;\n\n  // ── Tile grid ──\n  float scale = 18.0 * u_tileScale;\n  vec4 tile = tileGrid(p, scale);\n  vec2 f = tile.xy;\n  vec2 id = tile.zw;\n\n  // ── Grout ──\n  float groutW = 0.06;\n  float tMask = groutMask(f, groutW);\n\n  // ── Per-tile properties ──\n  float tileHash = hash(id);\n  float tileHash2 = hash(id + 200.0);\n  float tileHash3 = hash(id + 400.0);\n  vec3 N = tileNormal(id);\n\n  // Add micro-surface variation within tile\n  float roughness = tileRoughness(f, id);\n  N = normalize(N + vec3(\n    (roughness - 0.5) * 0.12,\n    (noise(f * 12.0 + id * 5.3) - 0.5) * 0.12,\n    0.0\n  ));\n\n  // ── Wave flip animation with 3D perspective ──\n  vec2 tileCenter = (id + 0.5) / scale;\n  vec2 flipData = waveFlip(tileCenter, u_time, aspect);\n  float flipAngle = flipData.x * u_animMode;\n  float inTransition = flipData.y * u_animMode;\n\n  // Click-triggered radial flip wave (use raw pixel position for distance)\n  if (u_clickTime > 0.0) {\n    vec2 clickP = u_click / u_res * aspect;\n    vec2 pixelP = gl_FragCoord.xy / u_res * aspect;\n    float clickAge = u_time - u_clickTime;\n    float radDist = length(pixelP - clickP);\n    float waveFront = clickAge * 1.2;\n    float inWave = smoothstep(waveFront + 0.15, waveFront - 0.1, radDist);\n    inWave *= smoothstep(0.0, 0.1, clickAge) * smoothstep(3.0, 1.5, clickAge);\n    float clickFlip = inWave * PI;\n    flipAngle += clickFlip;\n    inTransition = max(inTransition, inWave);\n  }\n\n  float cosFlip = cos(flipAngle);\n  float abscos = abs(cosFlip);\n  float dir = floor(u_waveDir + 0.5);\n  bool flipVertical = (dir == 2.0 || dir == 3.0);\n\n  // 3D perspective: compress tile along flip axis\n  if (flipVertical) {\n    f.y = (f.y - 0.5) / max(abscos, 0.04) + 0.5;\n  } else {\n    f.x = (f.x - 0.5) / max(abscos, 0.04) + 0.5;\n  }\n  float inBounds = step(0.0, f.x) * step(f.x, 1.0) * step(0.0, f.y) * step(f.y, 1.0);\n  tMask *= inBounds;\n\n  // Back side: cosFlip < 0\n  float isBack = step(cosFlip, 0.0);\n\n  // Rotate normal around flip axis (Y for horizontal, X for vertical)\n  float sinFlip = sin(flipAngle);\n  vec3 flippedN;\n  if (flipVertical) {\n    flippedN = vec3(N.x, N.y * cosFlip + N.z * sinFlip, -N.y * sinFlip + N.z * cosFlip);\n  } else {\n    flippedN = vec3(N.x * cosFlip + N.z * sinFlip, N.y, -N.x * sinFlip + N.z * cosFlip);\n  }\n  N = normalize(mix(N, flippedN, u_animMode));\n\n  // Back side: generate fresh normal facing camera with different variation\n  if (isBack > 0.5) {\n    vec3 backN = tileNormal(id + 500.0);\n    float backRough = tileRoughness(f, id + 500.0);\n    backN = normalize(backN + vec3(\n      (backRough - 0.5) * 0.15,\n      (noise(f * 14.0 + id * 3.7) - 0.5) * 0.15,\n      0.0\n    ));\n    N = backN;\n    roughness = backRough;\n  }\n\n  // ── Moving light sources ──\n  // Light 1: main overhead sweep (slow figure-eight)\n  vec3 light1Pos = vec3(\n    aspect.x * 0.5 + sin(t * 0.7) * aspect.x * 0.4,\n    0.5 + cos(t * 0.53) * 0.4,\n    0.8 + sin(t * 0.31) * 0.15\n  );\n\n  // Light 2: secondary, slower, offset orbit\n  vec3 light2Pos = vec3(\n    aspect.x * 0.5 + cos(t * 0.43 + 2.0) * aspect.x * 0.35,\n    0.5 + sin(t * 0.37 + 1.5) * 0.35,\n    0.7 + cos(t * 0.29) * 0.1\n  );\n\n  // Light 3: gentle background fill, very slow\n  vec3 light3Pos = vec3(\n    aspect.x * 0.5 + sin(t * 0.19 + 4.0) * aspect.x * 0.25,\n    0.5 + cos(t * 0.23 + 3.0) * 0.25,\n    1.2\n  );\n\n  // ── Per-tile specular calculation ──\n  vec3 tileWorldPos = vec3(p, 0.0);\n  vec3 viewDir = normalize(vec3(aspect.x * 0.5, 0.5, 1.5) - tileWorldPos);\n\n  // Light 1 specular\n  vec3 L1 = normalize(light1Pos - tileWorldPos);\n  vec3 H1 = normalize(L1 + viewDir);\n  float NdotH1 = max(dot(N, H1), 0.0);\n  float spec1 = pow(NdotH1, 80.0 + tileHash * 60.0);\n  float diff1 = max(dot(N, L1), 0.0);\n\n  // Light 2 specular\n  vec3 L2 = normalize(light2Pos - tileWorldPos);\n  vec3 H2 = normalize(L2 + viewDir);\n  float NdotH2 = max(dot(N, H2), 0.0);\n  float spec2 = pow(NdotH2, 60.0 + tileHash2 * 80.0);\n  float diff2 = max(dot(N, L2), 0.0);\n\n  // Light 3 specular (broader, softer)\n  vec3 L3 = normalize(light3Pos - tileWorldPos);\n  vec3 H3 = normalize(L3 + viewDir);\n  float NdotH3 = max(dot(N, H3), 0.0);\n  float spec3 = pow(NdotH3, 30.0 + tileHash3 * 20.0);\n  float diff3 = max(dot(N, L3), 0.0);\n\n  // Combined specular\n  float specTotal = spec1 * 1.2 + spec2 * 0.9 + spec3 * 0.4;\n  float diffTotal = diff1 * 0.5 + diff2 * 0.35 + diff3 * 0.25;\n\n  // ── Slow breathing / pulsing ──\n  float breathe = 1.0 + sin(t * 0.6) * 0.08 + sin(t * 0.37 + 1.0) * 0.05;\n  specTotal *= breathe;\n  diffTotal *= breathe;\n\n  // ── Wave flip: 3D shading + golden flash on back side ──\n  float flipFlash = isBack * smoothstep(0.3, 0.7, inTransition);\n  float flipGlow = inTransition * inTransition * 0.3;\n\n  // ── Per-tile shimmer (individual tiles catch light at random moments) ──\n  float shimmerPhase = tileHash * TAU + t * (0.8 + tileHash2 * 1.5);\n  float shimmer = pow(max(sin(shimmerPhase), 0.0), 16.0);\n  // Second shimmer layer for more organic feel\n  float shimmer2Phase = tileHash3 * TAU + t * (0.5 + tileHash * 0.7) + 2.0;\n  float shimmer2 = pow(max(sin(shimmer2Phase), 0.0), 24.0);\n  // Blend shimmer: reduce original shimmer when in wave flip mode\n  float shimmerBlend = 1.0 - u_animMode;\n  float shimmerTotal = (shimmer * 0.6 + shimmer2 * 0.4) * shimmerBlend;\n\n  // ── Gold color palette ──\n  vec3 groutColor = vec3(0.03, 0.02, 0.01);\n  vec3 darkGold   = vec3(0.12, 0.09, 0.05);\n  vec3 medGold    = vec3(0.45, 0.32, 0.14);\n  vec3 brightGold = vec3(0.78, 0.58, 0.24);\n  vec3 flashGold  = vec3(1.0, 0.85, 0.55);\n  vec3 hotGold    = vec3(1.0, 0.95, 0.80);\n\n  // ── Per-tile base color variation ──\n  // Each tile has a slightly different base tone\n  float baseVar = tileHash;\n  vec3 tileBase = mix(darkGold, medGold, smoothstep(0.0, 0.5, baseVar));\n  tileBase = mix(tileBase, brightGold, smoothstep(0.5, 0.85, baseVar));\n\n  // Subtle warm/cool variation per tile\n  tileBase *= 0.9 + tileHash2 * 0.2;\n\n  // ── Build tile color with lighting ──\n  vec3 tileColor = tileBase;\n\n  // Diffuse lighting adds warmth\n  tileColor += tileBase * diffTotal * 0.6;\n\n  // Specular highlights: gold to white-hot\n  vec3 specColor = mix(brightGold, flashGold, smoothstep(0.0, 0.5, specTotal));\n  specColor = mix(specColor, hotGold, smoothstep(0.5, 1.0, specTotal));\n  tileColor += specColor * specTotal * 1.4;\n\n  // Shimmer flashes (brief bright catches)\n  vec3 shimmerColor = mix(flashGold, hotGold, shimmerTotal);\n  tileColor += shimmerColor * shimmerTotal * 0.7;\n\n  // ── Wave flip: 3D depth shading ──\n  float flipShade = mix(1.0, abscos * 0.7 + 0.3, inTransition);\n  tileColor *= flipShade;\n  // Back side: warmer golden tint to differentiate front/back\n  tileColor = mix(tileColor, tileColor * vec3(1.2, 1.05, 0.85), isBack * 0.6);\n  // Edge-on glow (thin bright line at the moment of flip)\n  float edgeOnGlow = pow(1.0 - abscos, 4.0) * inTransition;\n  tileColor += medGold * edgeOnGlow * 0.25 * u_animMode;\n\n  // ── Micro-facet sparkle within tiles ──\n  // Small bright point when roughness noise aligns with light\n  float microSpec = pow(roughness, 4.0) * specTotal * 3.0;\n  tileColor += flashGold * microSpec * 0.3;\n\n  // ── Edge highlighting: tiles catch more light at beveled edges ──\n  float edgeDist = min(min(f.x, 1.0 - f.x), min(f.y, 1.0 - f.y));\n  float edgeHighlight = smoothstep(0.15, 0.05, edgeDist);\n  tileColor += brightGold * edgeHighlight * (diffTotal + specTotal * 0.5) * 0.15;\n\n  // ── Composite: tile or grout ──\n  vec3 col = mix(groutColor, tileColor, tMask);\n\n  // ── Subtle grout depth: darker where grout is deeper ──\n  float groutDepth = 1.0 - tMask;\n  col -= vec3(0.01, 0.008, 0.005) * groutDepth * (1.0 - smoothstep(0.0, 0.03, edgeDist));\n\n  // ── Global warm glow: light pools that move across the wall ──\n  float glow1 = smoothstep(0.7, 0.0, length(p - light1Pos.xy));\n  float glow2 = smoothstep(0.6, 0.0, length(p - light2Pos.xy));\n  col += medGold * glow1 * 0.06;\n  col += medGold * glow2 * 0.04;\n\n  // ── Vignette for depth and focus ──\n  vec2 vigUv = uv * 2.0 - 1.0;\n  float vig = 1.0 - dot(vigUv, vigUv) * 0.35;\n  vig = max(vig, 0.0);\n  vig = smoothstep(0.0, 1.0, vig);\n  col *= 0.5 + vig * 0.5;\n\n  // ── Tone mapping (ACES-like for rich highlights) ──\n  col = col * (2.51 * col + 0.03) / (col * (2.43 * col + 0.59) + 0.14);\n\n  // ── Slight warmth push ──\n  col = pow(col, vec3(0.95, 1.0, 1.1));\n\n  gl_FragColor = vec4(col, 1.0);\n}", "format": "raw", "inputs": [{"name": "u_time", "type": "float", "default": 1}, {"name": "u_res", "type": "vec2", "default": [0.5, 0.5]}, {"name": "u_lightSpeed", "type": "float", "default": 0.4}, {"name": "u_tileScale", "type": "float", "default": 1, "min": 0.3, "max": 2}, {"name": "u_animMode", "type": "float", "default": 1, "min": 0, "max": 1}, {"name": "u_waveSpeed", "type": "float", "default": 4, "min": 0.5, "max": 6}, {"name": "u_waveDelay", "type": "float", "default": 1.5, "min": 0.5, "max": 4}, {"name": "u_waveDir", "type": "float", "default": 0, "min": 0, "max": 3}, {"name": "u_mouse", "type": "vec2", "default": [-1, -1]}, {"name": "u_click", "type": "vec2", "default": [0, 0]}, {"name": "u_clickTime", "type": "float", "default": -10}], "description": "Byzantine golden mosaic wall with individually shimmering tiles catching candlelight.", "categories": ["fill", "geometric"]}, {"id": "radiant-gilded-fracture", "name": "Gilded Fracture", "kind": "generator", "family": "Radiant", "license": "MIT", "sourceUrl": "https://github.com/pbakaus/radiant/blob/59e9f48c0ad9a3db2fbeb8898b4390d5a1eabb40/static/gilded-fracture.html", "source": "precision highp float;\nuniform float u_time;\nuniform vec2 u_res;\nuniform float u_crackSpeed;\nuniform float u_glowIntensity;\nuniform vec2 u_mouse;\n\n#define PI 3.14159265359\n\n// ── Hash primitives ──\nfloat hash(vec2 p) {\n  return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);\n}\n\nvec2 hash2(vec2 p) {\n  return vec2(\n    fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453),\n    fract(sin(dot(p, vec2(269.5, 183.3))) * 43758.5453)\n  );\n}\n\n// ── Smooth value noise ──\nfloat noise(vec2 p) {\n  vec2 i = floor(p);\n  vec2 f = fract(p);\n  f = f * f * (3.0 - 2.0 * f);\n  float a = hash(i);\n  float b = hash(i + vec2(1.0, 0.0));\n  float c = hash(i + vec2(0.0, 1.0));\n  float d = hash(i + vec2(1.0, 1.0));\n  return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);\n}\n\n// ── FBM ──\nfloat fbm(vec2 p) {\n  float val = 0.0;\n  float amp = 0.5;\n  float freq = 1.0;\n  for (int i = 0; i < 5; i++) {\n    val += amp * noise(p * freq);\n    freq *= 2.03;\n    amp *= 0.49;\n    p += vec2(1.7, 9.2);\n  }\n  return val;\n}\n\n// ── Domain-warped Voronoi ──\n// Returns: x = dist to nearest, y = edge dist (2nd - 1st), z = cell hash\n// Neighbor loop unrolled manually to avoid variable array indexing\nvec3 kintsugiVoronoi(vec2 p, float t, float warpAmt) {\n  // Domain warp the input coordinates\n  vec2 warp = vec2(\n    fbm(p * 0.8 + t * 0.05),\n    fbm(p * 0.8 + vec2(5.2, 1.3) + t * 0.04)\n  );\n  p += warp * warpAmt;\n\n  vec2 i = floor(p);\n  vec2 f = fract(p);\n  float minDist = 10.0;\n  float secondDist = 10.0;\n  vec2 nearestCell = vec2(0.0);\n\n  // Unrolled 5x5 neighbor search for organic crack shapes\n  // Row -2\n  { vec2 nb = vec2(-2.0, -2.0); vec2 cid = i + nb; vec2 h = hash2(cid); vec2 pt = nb + h * 0.85 + 0.075; pt.x += sin(t * 0.07 + h.x * 20.0) * 0.06; pt.y += cos(t * 0.06 + h.y * 20.0) * 0.06; float d = dot(pt - f, pt - f); if (d < minDist) { secondDist = minDist; minDist = d; nearestCell = cid; } else if (d < secondDist) { secondDist = d; } }\n  { vec2 nb = vec2(-1.0, -2.0); vec2 cid = i + nb; vec2 h = hash2(cid); vec2 pt = nb + h * 0.85 + 0.075; pt.x += sin(t * 0.07 + h.x * 20.0) * 0.06; pt.y += cos(t * 0.06 + h.y * 20.0) * 0.06; float d = dot(pt - f, pt - f); if (d < minDist) { secondDist = minDist; minDist = d; nearestCell = cid; } else if (d < secondDist) { secondDist = d; } }\n  { vec2 nb = vec2( 0.0, -2.0); vec2 cid = i + nb; vec2 h = hash2(cid); vec2 pt = nb + h * 0.85 + 0.075; pt.x += sin(t * 0.07 + h.x * 20.0) * 0.06; pt.y += cos(t * 0.06 + h.y * 20.0) * 0.06; float d = dot(pt - f, pt - f); if (d < minDist) { secondDist = minDist; minDist = d; nearestCell = cid; } else if (d < secondDist) { secondDist = d; } }\n  { vec2 nb = vec2( 1.0, -2.0); vec2 cid = i + nb; vec2 h = hash2(cid); vec2 pt = nb + h * 0.85 + 0.075; pt.x += sin(t * 0.07 + h.x * 20.0) * 0.06; pt.y += cos(t * 0.06 + h.y * 20.0) * 0.06; float d = dot(pt - f, pt - f); if (d < minDist) { secondDist = minDist; minDist = d; nearestCell = cid; } else if (d < secondDist) { secondDist = d; } }\n  { vec2 nb = vec2( 2.0, -2.0); vec2 cid = i + nb; vec2 h = hash2(cid); vec2 pt = nb + h * 0.85 + 0.075; pt.x += sin(t * 0.07 + h.x * 20.0) * 0.06; pt.y += cos(t * 0.06 + h.y * 20.0) * 0.06; float d = dot(pt - f, pt - f); if (d < minDist) { secondDist = minDist; minDist = d; nearestCell = cid; } else if (d < secondDist) { secondDist = d; } }\n  // Row -1\n  { vec2 nb = vec2(-2.0, -1.0); vec2 cid = i + nb; vec2 h = hash2(cid); vec2 pt = nb + h * 0.85 + 0.075; pt.x += sin(t * 0.07 + h.x * 20.0) * 0.06; pt.y += cos(t * 0.06 + h.y * 20.0) * 0.06; float d = dot(pt - f, pt - f); if (d < minDist) { secondDist = minDist; minDist = d; nearestCell = cid; } else if (d < secondDist) { secondDist = d; } }\n  { vec2 nb = vec2(-1.0, -1.0); vec2 cid = i + nb; vec2 h = hash2(cid); vec2 pt = nb + h * 0.85 + 0.075; pt.x += sin(t * 0.07 + h.x * 20.0) * 0.06; pt.y += cos(t * 0.06 + h.y * 20.0) * 0.06; float d = dot(pt - f, pt - f); if (d < minDist) { secondDist = minDist; minDist = d; nearestCell = cid; } else if (d < secondDist) { secondDist = d; } }\n  { vec2 nb = vec2( 0.0, -1.0); vec2 cid = i + nb; vec2 h = hash2(cid); vec2 pt = nb + h * 0.85 + 0.075; pt.x += sin(t * 0.07 + h.x * 20.0) * 0.06; pt.y += cos(t * 0.06 + h.y * 20.0) * 0.06; float d = dot(pt - f, pt - f); if (d < minDist) { secondDist = minDist; minDist = d; nearestCell = cid; } else if (d < secondDist) { secondDist = d; } }\n  { vec2 nb = vec2( 1.0, -1.0); vec2 cid = i + nb; vec2 h = hash2(cid); vec2 pt = nb + h * 0.85 + 