0.0) * 0.03; pt.y += cos(t * 0.025 + h.y * 10.0) * 0.03; float d = dot(pt - f, pt - f); if (d < minDist) { secondDist = minDist; minDist = d; nearestCell = cid; } else if (d < secondDist) { secondDist = d; } }\n  { vec2 nb = vec2( 0.0, -1.0); vec2 cid = i + nb; vec2 h = hash2(cid + vec2(200.0)); vec2 pt = nb + h * 0.75 + 0.125; pt.x += sin(t * 0.03 + h.x * 10.0) * 0.03; pt.y += cos(t * 0.025 + h.y * 10.0) * 0.03; float d = dot(pt - f, pt - f); if (d < minDist) { secondDist = minDist; minDist = d; nearestCell = cid; } else if (d < secondDist) { secondDist = d; } }\n  { vec2 nb = vec2( 1.0, -1.0); vec2 cid = i + nb; vec2 h = hash2(cid + vec2(200.0)); vec2 pt = nb + h * 0.75 + 0.125; pt.x += sin(t * 0.03 + h.x * 10.0) * 0.03; pt.y += cos(t * 0.025 + h.y * 10.0) * 0.03; float d = dot(pt - f, pt - f); if (d < minDist) { secondDist = minDist; minDist = d; nearestCell = cid; } else if (d < secondDist) { secondDist = d; } }\n  { vec2 nb = vec2(-1.0,  0.0); vec2 cid = i + nb; vec2 h = hash2(cid + vec2(200.0)); vec2 pt = nb + h * 0.75 + 0.125; pt.x += sin(t * 0.03 + h.x * 10.0) * 0.03; pt.y += cos(t * 0.025 + h.y * 10.0) * 0.03; float d = dot(pt - f, pt - f); if (d < minDist) { secondDist = minDist; minDist = d; nearestCell = cid; } else if (d < secondDist) { secondDist = d; } }\n  { vec2 nb = vec2( 0.0,  0.0); vec2 cid = i + nb; vec2 h = hash2(cid + vec2(200.0)); vec2 pt = nb + h * 0.75 + 0.125; pt.x += sin(t * 0.03 + h.x * 10.0) * 0.03; pt.y += cos(t * 0.025 + h.y * 10.0) * 0.03; float d = dot(pt - f, pt - f); if (d < minDist) { secondDist = minDist; minDist = d; nearestCell = cid; } else if (d < secondDist) { secondDist = d; } }\n  { vec2 nb = vec2( 1.0,  0.0); vec2 cid = i + nb; vec2 h = hash2(cid + vec2(200.0)); vec2 pt = nb + h * 0.75 + 0.125; pt.x += sin(t * 0.03 + h.x * 10.0) * 0.03; pt.y += cos(t * 0.025 + h.y * 10.0) * 0.03; float d = dot(pt - f, pt - f); if (d < minDist) { secondDist = minDist; minDist = d; nearestCell = cid; } else if (d < secondDist) { secondDist = d; } }\n  { vec2 nb = vec2(-1.0,  1.0); vec2 cid = i + nb; vec2 h = hash2(cid + vec2(200.0)); vec2 pt = nb + h * 0.75 + 0.125; pt.x += sin(t * 0.03 + h.x * 10.0) * 0.03; pt.y += cos(t * 0.025 + h.y * 10.0) * 0.03; float d = dot(pt - f, pt - f); if (d < minDist) { secondDist = minDist; minDist = d; nearestCell = cid; } else if (d < secondDist) { secondDist = d; } }\n  { vec2 nb = vec2( 0.0,  1.0); vec2 cid = i + nb; vec2 h = hash2(cid + vec2(200.0)); vec2 pt = nb + h * 0.75 + 0.125; pt.x += sin(t * 0.03 + h.x * 10.0) * 0.03; pt.y += cos(t * 0.025 + h.y * 10.0) * 0.03; float d = dot(pt - f, pt - f); if (d < minDist) { secondDist = minDist; minDist = d; nearestCell = cid; } else if (d < secondDist) { secondDist = d; } }\n  { vec2 nb = vec2( 1.0,  1.0); vec2 cid = i + nb; vec2 h = hash2(cid + vec2(200.0)); vec2 pt = nb + h * 0.75 + 0.125; pt.x += sin(t * 0.03 + h.x * 10.0) * 0.03; pt.y += cos(t * 0.025 + h.y * 10.0) * 0.03; float d = dot(pt - f, pt - f); if (d < minDist) { secondDist = minDist; minDist = d; nearestCell = cid; } else if (d < secondDist) { secondDist = d; } }\n\n  float edge = sqrt(secondDist) - sqrt(minDist);\n  return vec3(sqrt(minDist), edge, hash(nearestCell + vec2(200.0)));\n}\n\n// ── Kintsugi crack reveal — cracks appear, glow, heal, new ones form ──\nfloat crackReveal(float cellHash, float t) {\n  // Each crack region has its own phase\n  float phase = cellHash * PI * 2.0;\n  float cycle = t * 0.12;\n  // Slow breathing: cracks brighten and dim on overlapping cycles\n  float reveal = sin(cycle + phase) * 0.5 + 0.5;\n  reveal *= sin(cycle * 0.7 + phase * 1.3) * 0.3 + 0.7;\n  // Sharpen the reveal curve — more defined on/off\n  reveal = smoothstep(0.15, 0.65, reveal);\n  return reveal;\n}\n\n// ── Gold dust particles near cracks ──\nfloat goldDust(vec2 p, float t, float crackProximity) {\n  float dust = 0.0;\n  // Layer 1: small particles\n  vec2 dp1 = p * 30.0 + vec2(t * 0.2, t * 0.15);\n  float d1 = noise(dp1);\n  d1 = smoothstep(0.72, 0.78, d1);\n  dust += d1 * 0.6;\n  // Layer 2: tinier sparkles\n  vec2 dp2 = p * 55.0 + vec2(-t * 0.3, t * 0.25);\n  float d2 = noise(dp2);\n  d2 = smoothstep(0.78, 0.82, d2);\n  dust += d2 * 0.4;\n  // Layer 3: rare bright motes\n  vec2 dp3 = p * 18.0 + vec2(t * 0.08, -t * 0.12);\n  float d3 = noise(dp3);\n  d3 = smoothstep(0.82, 0.86, d3);\n  // Pulsing brightness\n  d3 *= 0.5 + 0.5 * sin(t * 2.0 + d3 * 20.0);\n  dust += d3 * 0.8;\n  // Particles only appear near cracks\n  dust *= crackProximity;\n  return dust;\n}\n\nvoid main() {\n  vec2 fragCoord = gl_FragCoord.xy;\n  vec2 p = (fragCoord - u_res * 0.5) / min(u_res.x, u_res.y);\n  vec2 mouseShift = vec2(0.0);\n  if (u_mouse.x > 0.0) {\n    vec2 mNorm = (u_mouse / u_res - 0.5);\n    mouseShift = -mNorm * 0.12;\n  }\n  float t = u_time * u_crackSpeed;\n\n  // ────────────────────────────────────────────\n  // 1. MULTI-SCALE VORONOI CRACK NETWORK\n  //    Each layer shifts differently for parallax depth\n  // ────────────────────────────────────────────\n\n  // Large primary cracks — foreground, least shift\n  vec3 coarse = kintsugiVoronoi((p + mouseShift * 0.8) * 2.5, t, 0.6);\n  float coarseEdge = coarse.y;\n  float coarseCellHash = coarse.z;\n\n  // Medium secondary cracks — middle depth\n  vec3 medium = fineVoronoi((p + mouseShift * 1.8) * 5.5, t);\n  float mediumEdge = medium.y;\n  float mediumCellHash = medium.z;\n\n  // Fine hairline cracks — deepest, most shift\n  vec3 micro = microVoronoi((p + mouseShift * 3.0) * 14.0, t);\n  float microEdge = micro.y;\n\n  // ────────────────────────────────────────────\n  // 2. CRACK REVEAL ANIMATION\n  // Cracks appear, glow bright, then heal away\n  // ────────────────────────────────────────────\n\n  float coarseReveal = crackReveal(coarseCellHash, t);\n  float mediumReveal = crackReveal(mediumCellHash, t * 1.3 + 1.0);\n  // Micro-cracks follow the coarse ones\n  float microReveal = mix(coarseReveal, mediumReveal, 0.5);\n\n  // ────────────────────────────────────────────\n  // 3. CRACK LINE INTENSITIES\n  // Narrow bright core + wide soft glow falloff\n  // ────────────────────────────────────────────\n\n  // Coarse cracks: widest gold lines\n  float coarseCrack = smoothstep(0.08, 0.0, coarseEdge) * coarseReveal;\n  float coarseGlow  = smoothstep(0.22, 0.0, coarseEdge) * coarseReveal;\n  float coarseBloom = smoothstep(0.45, 0.0, coarseEdge) * coarseReveal;\n\n  // Medium cracks: thinner, subtler\n  float medCrack = smoothstep(0.06, 0.0, mediumEdge) * mediumReveal * 0.7;\n  float medGlow  = smoothstep(0.16, 0.0, mediumEdge) * mediumReveal * 0.5;\n\n  // Micro-cracks: hairline, very subtle\n  float microCrack = smoothstep(0.04, 0.0, microEdge) * microReveal * 0.25;\n  float microGlow  = smoothstep(0.10, 0.0, microEdge) * microReveal * 0.15;\n\n  // Combined crack intensities\n  float crackCore = max(coarseCrack, max(medCrack, microCrack));\n  float crackGlow = max(coarseGlow, max(medGlow, microGlow));\n  float crackBloom = coarseBloom;\n\n  // ────────────────────────────────────────────\n  // 4. DARK CERAMIC SURFACE\n  // Subtle texture on the plates between cracks\n  // ────────────────────────────────────────────\n\n  // Base dark surface color\n  vec3 darkBase = vec3(0.03, 0.025, 0.02);\n  vec3 darkTex  = vec3(0.06, 0.045, 0.03);\n\n  // Subtle ceramic grain per Voronoi cell\n  float grain = fbm(p * 8.0 + coarseCellHash * 40.0);\n  float fineGrain = noise(p * 30.0 + mediumCellHash * 60.0) * 0.5;\n\n  // Surface varies subtly per plate\n  float plateTone = 0.3 + grain * 0.4 + fineGrain * 0.3;\n  vec3 surface = mix(darkBase, darkTex, plateTone);\n\n  // Plate edge highlight — subtle depth cue\n  vec3 plateHighlight = vec3(0.10, 0.07, 0.04);\n  float edgeHighlight = smoothstep(0.5, 0.15, coarse.x) * 0.3;\n  surface += plateHighlight * edgeHighlight;\n\n  // ────────────────────────────────────────────\n  // 5. GOLDEN CRACK COLORING\n  // Bright molten gold core, warm amber falloff\n  // ────────────────────────────────────────────\n\n  vec3 goldCore   = vec3(1.0, 0.82, 0.55);\n  vec3 goldEdge   = vec3(0.78, 0.58, 0.24);\n  vec3 goldHot    = vec3(1.0, 0.92, 0.72);\n\n  // Molten gold flowing along cracks — turbulence texture\n  float flowTurb = fbm(p * 6.0 + t * vec2(0.08, -0.06));\n  float flowTurb2 = fbm(p * 10.0 + t * vec2(-0.05, 0.07) + vec2(30.0));\n  float moltenFlow = flowTurb * 0.6 + flowTurb2 * 0.4;\n\n  // Gold temperature varies along the crack\n  float goldTemp = crackCore * (0.6 + moltenFlow * 0.4);\n  goldTemp = clamp(goldTemp, 0.0, 1.0);\n\n  // Gold color gradient: edge -> core -> hot center\n  vec3 goldColor = mix(goldEdge, goldCore, smoothstep(0.2, 0.6, goldTemp));\n  goldColor = mix(goldColor, goldHot, smoothstep(0.6, 1.0, goldTemp));\n\n  // Emissive brightness for the crack core\n  float emissive = smoothstep(0.3, 1.0, crackCore);\n  goldColor += goldHot * emissive * emissive * 0.5;\n\n  // ────────────────────────────────────────────\n  // 6. COMPOSITE: SURFACE + GOLD\n  // ────────────────────────────────────────────\n\n  // Warm glow cast onto surface near cracks\n  vec3 warmCast = goldEdge * crackGlow * 0.4 * u_glowIntensity;\n  surface += warmCast;\n\n  // Wider bloom — very subtle amber haze near cracks\n  surface += vec3(0.12, 0.08, 0.03) * crackBloom * 0.25 * u_glowIntensity;\n\n  // Blend gold into surface where cracks exist\n  float blendFactor = smoothstep(0.0, 0.12, crackCore);\n  vec3 col = mix(surface, goldColor, blendFactor);\n\n  // Additional glow layer on top (additive)\n  col += goldEdge * crackGlow * 0.3 * u_glowIntensity;\n\n  // ────────────────────────────────────────────\n  // 7. GOLD DUST PARTICLES\n  // Tiny floating motes near crack lines\n  // ────────────────────────────────────────────\n\n  float crackProximity = smoothstep(0.5, 0.0, coarseEdge) * coarseReveal;\n  crackProximity = max(crackProximity, smoothstep(0.3, 0.0, mediumEdge) * mediumReveal * 0.5);\n  float dust = goldDust(p, u_time, crackProximity);\n  col += goldHot * dust * 0.35 * u_glowIntensity;\n\n  // ────────────────────────────────────────────\n  // 8. SUBSURFACE WARMTH\n  // Faint gold glow beneath the surface even where cracks are fading\n  // ────────────────────────────────────────────\n\n  float subsurface = crackBloom * 0.15 * u_glowIntensity;\n  col += vec3(0.08, 0.05, 0.02) * subsurface;\n\n  // Slow global breathing — the gold pulses gently\n  float breathe = sin(u_time * 0.15) * 0.08 + 0.92;\n  col *= breathe;\n\n  // ────────────────────────────────────────────\n  // 9. VIGNETTE\n  // ────────────────────────────────────────────\n\n  float edgeDist = length(p * vec2(1.0, 1.1));\n  float vignette = 1.0 - smoothstep(0.4, 1.3, edgeDist);\n  col *= 0.5 + vignette * 0.5;\n\n  // ────────────────────────────────────────────\n  // 10. TONE MAPPING + COLOR GRADING\n  // ────────────────────────────────────────────\n\n  // Soft tone map to preserve dark mood\n  col = col / (1.0 + col * 0.15);\n\n  // Push warm — darks stay neutral, golds stay rich\n  col = pow(col, vec3(0.95, 1.0, 1.1));\n\n  // Slight contrast enhancement\n  col = clamp(col, 0.0, 1.0);\n  col = col * col * (3.0 - 2.0 * col) * 0.7 + col * 0.3;\n\n  gl_FragColor = vec4(col, 1.0);\n}", "format": "raw", "inputs": [{"name": "u_time", "type": "float", "default": 1}, {"name": "u_res", "type": "vec2", "default": [0.5, 0.5]}, {"name": "u_crackSpeed", "type": "float", "default": 0.3, "min": 0.05, "max": 1}, {"name": "u_glowIntensity", "type": "float", "default": 1, "min": 0.3, "max": 2}, {"name": "u_mouse", "type": "vec2", "default": [-1, -1]}], "description": "Kintsugi-inspired golden cracks spreading across dark surface with molten gold light bleeding through.", "categories": ["fill", "noise", "organic"]}, {"id": "radiant-golden-throne", "name": "Golden Throne", "kind": "generator", "family": "Radiant", "license": "MIT", "sourceUrl": "https://github.com/pbakaus/radiant/blob/59e9f48c0ad9a3db2fbeb8898b4390d5a1eabb40/static/golden-throne.html", "source": "precision highp float;\nuniform float u_time;\nuniform vec2 u_res;\nuniform float u_rotationSpeed;\nuniform float u_complexity;\nuniform vec2 u_mouse;\n\n#define PI 3.14159265359\n#define TAU 6.28318530718\n#define PHI 1.6180339887\n\n// ── Rotation matrix ──\nmat2 rot(float a) {\n  float c = cos(a), s = sin(a);\n  return mat2(c, -s, s, c);\n}\n\n// ── Golden color palette ──\nvec3 gold(float t) {\n  vec3 a = vec3(0.45, 0.32, 0.14);\n  vec3 b = vec3(0.45, 0.35, 0.2);\n  vec3 c = vec3(1.0, 0.8, 0.5);\n  vec3 d = vec3(0.0, 0.1, 0.25);\n  return a + b * cos(TAU * (c * t + d));\n}\n\n// ── Smooth repetition for SDF ──\nfloat smin(float a, float b, float k) {\n  float h = clamp(0.5 + 0.5 * (b - a) / k, 0.0, 1.0);\n  return mix(b, a, h) - k * h * (1.0 - h);\n}\n\n// ── Hexagonal distance ──\nfloat hexDist(vec2 p) {\n  p = abs(p);\n  return max(p.x + p.y * 0.577350269, p.y * 1.154700538);\n}\n\n// ── Triangle distance ──\nfloat triDist(vec2 p) {\n  float k = sqrt(3.0);\n  p.x = abs(p.x) - 1.0;\n  p.y = p.y + 1.0 / k;\n  if (p.x + k * p.y > 0.0) p = vec2(p.x - k * p.y, -k * p.x - p.y) / 2.0;\n  p.x -= clamp(p.x, -2.0, 0.0);\n  return -length(p) * sign(p.y);\n}\n\n// ── Flower of Life petal ──\nfloat flowerPetal(vec2 p, float r) {\n  float d = 1e9;\n  for (int i = 0; i < 6; i++) {\n    float a = float(i) * TAU / 6.0;\n    vec2 c = vec2(cos(a), sin(a)) * r;\n    d = min(d, length(p - c) - r);\n  }\n  return d;\n}\n\n// ── Star polygon ──\nfloat starDist(vec2 p, float r, int n, float inset) {\n  float an = PI / float(n);\n  float en = PI / float(n);\n  vec2 acs = vec2(cos(an), sin(an));\n  vec2 ecs = vec2(cos(en), sin(en));\n  float bn = mod(atan(p.x, p.y), 2.0 * an) - an;\n  p = length(p) * vec2(cos(bn), abs(sin(bn)));\n  p -= r * acs;\n  p += ecs * clamp(-dot(p, ecs), 0.0, r * acs.y / ecs.y);\n  return length(p) * sign(p.x);\n}\n\n// ── Sacred geometry layer compositing ──\nfloat sacredRing(vec2 p, float radius, float width) {\n  return abs(length(p) - radius) - width;\n}\n\n// ── Mandala layer ──\nfloat mandalaLayer(vec2 uv, float time, float layer, float totalLayers) {\n  float t = layer / totalLayers;\n  float radius = 0.08 + t * 0.38;\n  \n  // Differential rotation — inner faster, outer slower, some counter-rotating\n  float speed = u_rotationSpeed * (1.5 - t * 1.2);\n  float direction = mod(layer, 2.0) < 1.0 ? 1.0 : -1.0;\n  float rot_angle = time * speed * direction + layer * PHI;\n  vec2 p = rot(rot_angle) * uv;\n\n  float d = 1e9;\n  float symmetry = 6.0 + floor(layer * 1.5);\n\n  // Angular repetition for symmetry\n  float angle = atan(p.y, p.x);\n  float r = length(p);\n  float sector = TAU / symmetry;\n  float a = mod(angle + sector * 0.5, sector) - sector * 0.5;\n  vec2 sp = vec2(cos(a), sin(a)) * r;\n\n  // ── Concentric ring ──\n  float ring = abs(r - radius) - 0.003 * (1.0 + t);\n  d = min(d, ring);\n\n  // ── Petal arcs (flower of life inspiration) ──\n  float petalR = radius * 0.35 / PHI;\n  vec2 petalCenter = vec2(radius, 0.0);\n  float petal = abs(length(sp - petalCenter) - petalR) - 0.002;\n  d = min(d, petal);\n\n  // ── Inner petal arc ──\n  vec2 innerPetalCenter = vec2(radius * 0.65, 0.0);\n  float innerPetalR = radius * 0.25;\n  float innerPetal = abs(length(sp - innerPetalCenter) - innerPetalR) - 0.0015;\n  d = min(d, innerPetal);\n\n  // ── Radial spokes ──\n  float spoke = abs(sp.y) - 0.001;\n  float spokeMask = smoothstep(radius - 0.05, radius - 0.01, r) * smoothstep(radius + 0.05, radius + 0.01, r);\n  d = min(d, spoke / max(spokeMask, 0.001));\n\n  // ── Hexagonal elements at intersections ──\n  float hexR = 0.012 + t * 0.008;\n  vec2 hexPos = vec2(radius, 0.0);\n  float hex = hexDist(sp - hexPos) - hexR;\n  d = min(d, hex);\n\n  // ── Diamond/triangular detail at half-radius ──\n  if (layer > 1.0) {\n    vec2 triPos = vec2(radius * 0.5, 0.0);\n    vec2 tp = (sp - triPos) * 60.0;\n    float tri = triDist(tp) / 60.0;\n    d = min(d, tri);\n  }\n\n  return d;\n}\n\n// ── Spiral arms based on golden ratio ──\nfloat goldenSpiral(vec2 uv, float time) {\n  float r = length(uv);\n  float a = atan(uv.y, uv.x);\n  \n  // Golden spiral: r = PHI^(2*theta/PI)\n  float spiralPhase = log(max(r, 0.001)) / log(PHI) * PI * 0.5;\n  float spiralD = abs(mod(a - spiralPhase + time * u_rotationSpeed * 0.2 + PI, TAU) - PI);\n  spiralD = min(spiralD, abs(mod(a - spiralPhase + time * u_rotationSpeed * 0.2 + PI + PI, TAU) - PI));\n\n  // Fade spiral intensity with radius\n  float fade = smoothstep(0.0, 0.05, r) * smoothstep(0.5, 0.35, r);\n  return spiralD * fade + (1.0 - fade);\n}\n\n// ── Fractal detail — repeating at smaller scales ──\nfloat fractalDetail(vec2 uv, float time) {\n  float d = 1e9;\n  float scale = 1.0;\n  float intensity = 0.0;\n  \n  for (int i = 0; i < 4; i++) {\n    float fi = float(i);\n    vec2 p = uv * scale;\n    p = rot(time * u_rotationSpeed * (0.1 + fi * 0.05) * (mod(fi, 2.0) < 1.0 ? 1.0 : -1.0)) * p;\n    \n    // Hexagonal tiling at this scale\n    float hexSize = 0.15 / scale;\n    vec2 hexUV = p;\n    float hx = hexDist(mod(hexUV + hexSize, hexSize * 2.0) - hexSize);\n    float hexLine = abs(hx - hexSize * 0.4) - 0.001 * scale;\n    intensity += smoothstep(0.003, 0.0, hexLine) * (0.15 / (1.0 + fi));\n    \n    scale *= PHI;\n  }\n  return intensity;\n}\n\nvoid main() {\n  vec2 uv = (gl_FragCoord.xy - u_res * 0.5) / min(u_res.x, u_res.y);\n  uv = rot(u_mouse.x) * uv;\n  float t = u_time;\n  float complexity = u_complexity;\n  \n  // ── Accumulated glow ──\n  vec3 col = vec3(0.0);\n  float r = length(uv);\n  \n  // ── Object mask — keep mandala centered with dark surround ──\n  float objectRadius = 0.48;\n  float objectFade = smoothstep(objectRadius, objectRadius * 0.7, r);\n\n  // ── Build sacred geometry mandala layers ──\n  float totalGlow = 0.0;\n  \n  for (int i = 0; i < 8; i++) {\n    if (float(i) >= complexity) break;\n    float fi = float(i);\n    float layerD = mandalaLayer(uv, t, fi, complexity);\n    \n    // Convert SDF to glow — sharp lines with soft bloom\n    float lineGlow = 0.0025 / (abs(layerD) + 0.0025);\n    float bloom = 0.008 / (abs(layerD) + 0.008) * 0.3;\n    float layerIntensity = (lineGlow + bloom);\n    \n    // Color varies per layer — golden gradient from warm amber to bright gold\n    float colorT = fi / complexity + t * 0.02;\n    vec3 layerColor = gold(colorT);\n    \n    // Inner layers are brighter\n    float brightness = 1.0 - fi / complexity * 0.5;\n    \n    col += layerColor * layerIntensity * brightness * 0.6;\n    totalGlow += layerIntensity * brightness;\n  }\n\n  // ── Golden ratio spiral arms ──\n  float spiral = goldenSpiral(uv, t);\n  float spiralGlow = 0.015 / (spiral + 0.015);\n  col += gold(0.7 + t * 0.01) * spiralGlow * 0.25;\n\n  // ── Fractal hexagonal detail overlay ──\n  float fractal = fractalDetail(uv, t);\n  col += gold(0.3 + t * 0.03) * fractal * 0.4;\n\n  // ── Central glowing point — pulses subtly ──\n  float centerPulse = 0.8 + 0.2 * sin(t * 1.5);\n  float centerGlow = 0.01 / (r * r + 0.01) * centerPulse;\n  vec3 centerColor = vec3(1.0, 0.92, 0.7); // bright white-gold\n  col += centerColor * centerGlow * 0.08;\n\n  // ── Secondary center ring pulse ──\n  float ringPulse = 0.9 + 0.1 * sin(t * 2.3 + 1.0);\n  float innerRing = abs(r - 0.03 * ringPulse) - 0.002;\n  float innerRingGlow = 0.003 / (abs(innerRing) + 0.003);\n  col += vec3(1.0, 0.88, 0.6) * innerRingGlow * 0.3;\n\n  // ── Outer boundary ring — ornate edge ──\n  float outerRing = abs(r - objectRadius + 0.01) - 0.003;\n  float outerGlow = 0.004 / (abs(outerRing) + 0.004);\n  col += gold(0.5 + t * 0.015) * outerGlow * 0.35;\n\n  // ── Second outer ring — slightly inside ──\n  float outerRing2 = abs(r - objectRadius + 0.035) - 0.002;\n  float outerGlow2 = 0.003 / (abs(outerRing2) + 0.003);\n  col += gold(0.6) * outerGlow2 * 0.2;\n\n  // ── Decorative dots at outer ring intersections ──\n  float dotAngle = atan(uv.y, uv.x);\n  float dotSymmetry = 12.0;\n  float dotA = mod(dotAngle + PI / dotSymmetry, TAU / dotSymmetry) - PI / dotSymmetry;\n  vec2 dotP = vec2(cos(dotA), sin(dotA)) * r;\n  vec2 dotCenter = vec2(objectRadius - 0.01, 0.0);\n  float dot = length(dotP - dotCenter) - 0.008;\n  float dotGlow = 0.004 / (abs(dot) + 0.004);\n  col += vec3(1.0, 0.9, 0.65) * dotGlow * 0.3;\n\n  // ── Apply object mask ──\n  col *= objectFade;\n\n  // ── Subtle warm ambient radial glow behind the mandala ──\n  float ambientGlow = exp(-r * r * 6.0) * 0.06;\n  col += vec3(0.3, 0.2, 0.08) * ambientGlow;\n\n  // ── Tone mapping ──\n  col = col / (1.0 + col * 0.4);\n\n  // ── Slight warmth boost ──\n  col = pow(col, vec3(0.95, 0.98, 1.05));\n\n  gl_FragColor = vec4(col, 1.0);\n}", "format": "raw", "inputs": [{"name": "u_time", "type": "float", "default": 1}, {"name": "u_res", "type": "vec2", "default": [0.5, 0.5]}, {"name": "u_rotationSpeed", "type": "float", "default": 0.3, "min": 0, "max": 1}, {"name": "u_complexity", "type": "float", "default": 5, "min": 2, "max": 8}, {"name": "u_mouse", "type": "vec2", "default": [0, 0]}], "description": "Sacred geometry mandala with golden ratio spirals and counter-rotating layers.", "categories": ["object", "geometric"]}, {"id": "radiant-neon-drip", "name": "Neon Drip", "kind": "generator", "family": "Radiant", "license": "MIT", "sourceUrl": "https://github.com/pbakaus/radiant/blob/59e9f48c0ad9a3db2fbeb8898b4390d5a1eabb40/static/neon-drip.html", "source": "precision highp float;\nuniform float u_time;\nuniform vec2 u_res;\nuniform float u_dripSpeed;\nuniform float u_blobCount;\nuniform vec2 u_mouse;\n\n#define PI 3.14159265359\n#define MAX_BLOBS 12\n\n// ── Hash for noise / grain ──\nfloat hash(vec2 p) {\n  vec3 p3 = fract(vec3(p.xyx) * 0.1031);\n  p3 += dot(p3, p3.yzx + 33.33);\n  return fract((p3.x + p3.y) * p3.z);\n}\n\n// ── Value noise ──\nfloat vnoise(vec2 p) {\n  vec2 i = floor(p);\n  vec2 f = fract(p);\n  f = f * f * (3.0 - 2.0 * f);\n  return mix(\n    mix(hash(i), hash(i + vec2(1.0, 0.0)), f.x),\n    mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), f.x),\n    f.y\n  );\n}\n\n// ── Smooth min for metaball blending (polynomial) ──\n// k controls how smoothly the surfaces merge\nfloat smin(float a, float b, float k) {\n  float h = clamp(0.5 + 0.5 * (b - a) / k, 0.0, 1.0);\n  return mix(b, a, h) - k * h * (1.0 - h);\n}\n\n// ── Metaball field evaluation ──\n// Returns the combined metaball field value at point p\n// Uses inverse-distance \"energy\" formulation for classic metaball look\nfloat metaballField(vec2 p, float t, float speed, float count) {\n  float energy = 0.0;\n  float numBlobs = 4.0 + count * 8.0; // 4 to 12 blobs\n\n  // ── Emitter group 1: Rising blobs from bottom-left ──\n  for (int i = 0; i < MAX_BLOBS; i++) {\n    if (float(i) >= numBlobs) break;\n    float fi = float(i);\n    float phase = fi * 1.618 + fi * fi * 0.13; // golden-ratio spacing\n\n    // Base position: spread across bottom, rise upward\n    float riseSpeed = (0.3 + 0.4 * fract(fi * 0.618)) * speed;\n    float riseCycle = mod(t * riseSpeed + phase * 0.7, 3.5) - 1.0;\n\n    // X position: oscillate laterally as they rise\n    float xBase = sin(phase * 2.39996) * 0.45;\n    float xWobble = sin(t * speed * 0.8 + phase * 3.1) * 0.12;\n    float xDrift = sin(riseCycle * 2.0 + phase) * 0.08;\n    float bx = xBase + xWobble + xDrift;\n\n    // Y position: rise from bottom, wrap around\n    float by = -0.7 + riseCycle * 0.9;\n\n    // Size varies per blob and pulses gently\n    float baseSize = 0.04 + 0.03 * fract(phase * 0.317);\n    float pulse = 1.0 + 0.15 * sin(t * speed * 1.5 + phase * 4.7);\n    float radius = baseSize * pulse;\n\n    // Metaball contribution: r^2 / d^2 formulation\n    float d = length(p - vec2(bx, by));\n    energy += (radius * radius) / (d * d + 0.0001);\n  }\n\n  return energy;\n}\n\n// ── Tendril field: stretched vertical noise that creates trailing wisps ──\nfloat tendrilField(vec2 p, float t, float speed) {\n  // Vertically stretched noise for upward-dripping feel\n  float n1 = vnoise(vec2(p.x * 6.0, p.y * 2.0 - t * speed * 0.6) + 10.0);\n  float n2 = vnoise(vec2(p.x * 12.0 + 3.7, p.y * 4.0 - t * speed * 0.8) + 20.0);\n  float n3 = vnoise(vec2(p.x * 3.0 + 7.1, p.y * 1.5 - t * speed * 0.4));\n\n  // Combine: large tendril shapes + fine detail\n  float tendrils = n1 * 0.5 + n2 * 0.3 + n3 * 0.2;\n\n  // Sharpen into tendril-like strands\n  tendrils = smoothstep(0.35, 0.65, tendrils);\n\n  // Fade tendrils toward top (they dissipate)\n  tendrils *= smoothstep(0.6, -0.3, p.y);\n\n  // Stronger at bottom where \"drips\" originate\n  tendrils *= 0.6 + 0.4 * smoothstep(0.0, -0.5, p.y);\n\n  return tendrils;\n}\n\n// ── Vignette ──\nfloat vignette(vec2 uv) {\n  float d = length(uv * vec2(0.9, 1.0));\n  return smoothstep(1.3, 0.4, d);\n}\n\nvoid main() {\n  vec2 uv = (gl_FragCoord.xy - u_res * 0.5) / u_res.y;\n  float aspect = u_res.x / u_res.y;\n  float t = u_time;\n  float speed = u_dripSpeed;\n  float count = u_blobCount;\n\n  // ── Background: deep dark with subtle warm radial gradient ──\n  float bgDist = length(uv * vec2(0.8, 1.0));\n  vec3 col = vec3(0.025, 0.018, 0.015) * (1.0 - bgDist * 0.3);\n  col = max(col, vec3(0.0));\n\n  // ── Mouse-driven drip source ──\n  float mouseField = 0.0;\n  if (u_mouse.x > 0.0) {\n    vec2 mUV = (u_mouse - u_res * 0.5) / u_res.y;\n    float mr = 0.06;\n    float md = length(uv - mUV);\n    mouseField = (mr * mr) / (md * md + 0.0001);\n    // Add smaller orbiting blobs around mouse\n    for (int i = 0; i < 3; i++) {\n      float fi = float(i);\n      float angle = t * speed * 1.5 + fi * 2.094;\n      vec2 offset = vec2(cos(angle), sin(angle)) * 0.08;\n      float smr = 0.03;\n      float smd = length(uv - mUV - offset);\n      mouseField += (smr * smr) / (smd * smd + 0.0001);\n    }\n  }\n\n  // ── Evaluate metaball field ──\n  float field = metaballField(uv, t, speed, count) + mouseField;\n\n  // ── Tendril contribution: adds to the field ──\n  float tendrils = tendrilField(uv, t, speed);\n\n  // Combine: metaballs are the main blobs, tendrils add trailing wisps\n  // tendrils contribute a fraction of metaball energy\n  float combinedField = field + tendrils * 0.6;\n\n  // ── Isosurface thresholds for layered coloring ──\n  // The metaball \"surface\" is where field crosses a threshold\n  float threshold = 1.0;\n\n  // Outer glow: neon halo around the blob surfaces\n  float outerGlow = smoothstep(threshold * 0.15, threshold * 0.5, combinedField);\n\n  // Surface: sharper blob boundary for neon look\n  float surface = smoothstep(threshold * 0.4, threshold * 0.7, combinedField);\n\n  // Inner: brighter core inside the blobs\n  float inner = smoothstep(threshold * 0.8, threshold * 1.8, combinedField);\n\n  // Hot core: brightest center\n  float core = smoothstep(threshold * 2.0, threshold * 4.0, combinedField);\n\n  // ── Color palette: vibrant neon amber (HDR values > 1.0 for bloom) ──\n  // Deep amber glow (outermost)\n  vec3 glowColor = vec3(1.2, 0.55, 0.10);\n\n  // Bright neon surface\n  vec3 surfaceColor = vec3(2.5, 1.3, 0.40);\n\n  // Intense inner\n  vec3 innerColor = vec3(3.5, 2.0, 0.70);\n\n  // White-hot core\n  vec3 coreColor = vec3(5.0, 4.0, 2.5);\n\n  // ── Compose the blob color ──\n  // Start with glow — push hard for neon effect\n  vec3 blobCol = glowColor * outerGlow * 1.0;\n\n  // Add surface color\n  blobCol = mix(blobCol, surfaceColor, surface * 0.95);\n\n  // Brighten inner areas\n  blobCol = mix(blobCol, innerColor, inner * 0.95);\n\n  // Hot core highlights\n  blobCol = mix(blobCol, coreColor, core * 1.0);\n\n  // ── Surface edge highlight: rim lighting effect ──\n  // Brighter at the edge of the surface (where gradient is steep)\n  float edgeBand = surface * (1.0 - inner);\n  blobCol += vec3(1.8, 1.0, 0.3) * edgeBand * 0.8;\n\n  // ── Tendril coloring: slightly different from main blobs ──\n  float tendrilVis = tendrils * (1.0 - surface * 0.5);\n  vec3 tendrilColor = vec3(1.4, 0.7, 0.20) * tendrilVis * 0.7;\n  blobCol += tendrilColor;\n\n  // ── Add blob color to scene ──\n  col += blobCol;\n\n  // ── Ambient upward-flowing noise: background movement ──\n  float ambientFlow = vnoise(vec2(uv.x * 3.0, uv.y * 1.5 - t * speed * 0.2) + 50.0);\n  ambientFlow = smoothstep(0.4, 0.6, ambientFlow) * 0.06;\n  col += vec3(0.2, 0.12, 0.06) * ambientFlow;\n\n  // ── Subtle secondary blobs: small, fast, for liveliness ──\n  float microField = 0.0;\n  for (int i = 0; i < 5; i++) {\n    float fi = float(i);\n    float phase = fi * 2.39996 + 100.0;\n    float mSpeed = (0.5 + 0.3 * fract(phase * 0.618)) * speed;\n    float mCycle = mod(t * mSpeed + phase, 2.8) - 0.8;\n    float mx = sin(phase * 1.7) * 0.5 + sin(t * speed + phase * 2.3) * 0.1;\n    float my = -0.6 + mCycle * 0.8;\n    float mr = 0.015 + 0.01 * sin(t * speed * 2.0 + phase);\n    float md = length(uv - vec2(mx, my));\n    microField += (mr * mr) / (md * md + 0.0001);\n  }\n  float microSurface = smoothstep(0.8, 1.5, microField);\n  float microCore = smoothstep(1.5, 3.0, microField);\n  col += vec3(1.8, 1.0, 0.30) * microSurface * 0.7;\n  col += vec3(3.0, 2.2, 1.0) * microCore * 0.8;\n\n  // ── Film grain ──\n  float grain = (hash(gl_FragCoord.xy + fract(t * 43.758) * 1000.0) - 0.5) * 0.025;\n  col += grain;\n\n  // ── Vignette ──\n  col *= vignette(uv);\n\n  // ── Tone mapping: ACES filmic (preserves bright neon punch) ──\n  col = max(col, vec3(0.0));\n  col = col * (2.51 * col + 0.03) / (col * (2.43 * col + 0.59) + 0.14);\n  col = pow(col, vec3(0.90));\n\n  // ── Warm shadow push ──\n  float lum = dot(col, vec3(0.299, 0.587, 0.114));\n  col = mix(col, col * vec3(1.06, 0.97, 0.90), smoothstep(0.05, 0.0, lum) * 0.3);\n\n  gl_FragColor = vec4(col, 1.0);\n}", "format": "raw", "inputs": [{"name": "u_time", "type": "float", "default": 1}, {"name": "u_res", "type": "vec2", "default": [0.5, 0.5]}, {"name": "u_dripSpeed", "type": "float", "default": 0.5, "min": 0.1, "max": 1.5}, {"name": "u_blobCount", "type": "float", "default": 1, "min": 0.3, "max": 2}, {"name": "u_mouse", "type": "vec2", "default": [-1, -1]}], "description": "Metaball blobs dripping upward with surface tension physics and trailing tendrils.", "categories": ["fill", "organic"]}, {"id": "radiant-moonlit-ripple", "name": "Moonlit Ripple", "kind": "generator", "family": "Radiant", "license": "MIT", "sourceUrl": "https://github.com/pbakaus/radiant/blob/59e9f48c0ad9a3db2fbeb8898b4390d5a1eabb40/static/moonlit-ripple.html", "source": "precision highp float;\nuniform float u_time;\nuniform vec2 u_res;\nuniform float u_rippleSpeed;\nuniform float u_moonGlow;\nuniform vec2 u_mouse;\nuniform float u_tilt;\nuniform float u_waves;\n\n#define PI 3.14159265359\n#define WAVE_LAYERS 7\n\n// ── Multi-directional waves with analytical normals ──\nvec4 sea(vec2 p, float t) {\n  float h = 0.0;\n  vec2 dh = vec2(0.0);\n  float freq = 1.0;\n  float baseAmp = 0.2 * u_waves;\n  // Higher intensity = slower amplitude decay = more high-freq energy (choppier)\n  float decay = mix(0.55, 0.38, clamp(u_waves / 3.0, 0.0, 1.0));\n  float amp = baseAmp;\n  float angle = 0.0;\n  for (int i = 0; i < WAVE_LAYERS; i++) {\n    float c = cos(angle);\n    float s = sin(angle);\n    // Rotate sampling position per layer (breaks alignment)\n    vec2 pp = vec2(c * p.x + s * p.y, -s * p.x + c * p.y);\n    float fi = float(i);\n    float spd = sqrt(freq) * 0.8;\n    // Sample along y of rotated space + per-layer offset\n    float phase = (pp.y + fi) * freq - t * spd;\n    float sn = sin(phase);\n    float cn = cos(phase);\n    h += sn * amp;\n    // Derivative in rotated space, then rotate back\n    float dy = freq * amp * cn;\n    dh += vec2(-s * dy, c * dy);\n    angle += fi + 1.2;\n    freq *= 1.3;\n    amp *= decay;\n  }\n  vec3 N = normalize(vec3(-dh.x, 1.0, -dh.y));\n  return vec4(h, N);\n}\n\n// ── Moon direction in 3D ──\nvec3 moonDir() {\n  return normalize(vec3(0.15, 0.35, 1.0));\n}\n\n// Simple hash for moon texture\nfloat hash(vec2 p) {\n  return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);\n}\n\n// ── Night sky color with textured moon disc ──\nvec3 skyColor(vec3 rd) {\n  vec3 md = moonDir();\n  // Warm base tones — blue scheme hue-rotates these to cool moonlit blue\n  vec3 skyDark = vec3(0.06, 0.03, 0.02);\n  vec3 skyHoriz = vec3(0.09, 0.05, 0.04);\n  vec3 sky = mix(skyHoriz, skyDark, max(rd.y, 0.0));\n  vec3 moonCol = vec3(0.98, 0.92, 0.85);\n  float moonDot = max(dot(rd, md), 0.0);\n  float moonAngle = acos(clamp(moonDot, 0.0, 1.0));\n  float moonRadius = 0.04;\n  float disc = smoothstep(moonRadius, moonRadius * 0.7, moonAngle);\n  // Crater texture — project rd onto moon-tangent plane\n  if (disc > 0.0) {\n    vec3 up = vec3(0.0, 1.0, 0.0);\n    vec3 right = normalize(cross(up, md));\n    vec3 mup = cross(md, right);\n    vec2 muv = vec2(dot(rd - md, right), dot(rd - md, mup)) * 25.0;\n    float crater = hash(floor(muv * 2.0)) * 0.25;\n    crater += hash(floor(muv * 4.0)) * 0.15;\n    float darkening = 1.0 - crater * smoothstep(moonRadius * 0.9, moonRadius * 0.4, moonAngle);\n    // Slight limb darkening\n    float limb = smoothstep(0.0, moonRadius, moonAngle);\n    darkening *= mix(1.0, 0.7, limb * limb);\n    sky += moonCol * disc * 0.85 * darkening;\n  }\n  // Bloom (scales with moonGlow, disc does not)\n  sky += moonCol * 0.25 * pow(moonDot, 40.0) * u_moonGlow;\n  sky += moonCol * 1.2 * pow(moonDot, 400.0) * u_moonGlow;\n  return sky;\n}\n\nvoid main() {\n  float aspect = u_res.x / u_res.y;\n  vec2 uv = -1.0 + 2.0 * gl_FragCoord.xy / u_res;\n  uv.x *= aspect;\n  float t = u_time * u_rippleSpeed;\n\n  // ── 3D Camera — tilt: 0=horizontal, 0.5=default, 1=top-down ──\n  float tiltRad = u_tilt * 0.7;\n  vec3 ro = vec3(0.0, 8.0, 0.0);\n  vec3 ww = normalize(vec3(0.0, -sin(tiltRad), cos(tiltRad)));\n  vec3 uu = normalize(cross(vec3(0.0, 1.0, 0.0), ww));\n  vec3 vv = normalize(cross(ww, uu));\n  vec3 rd = normalize(uv.x * uu + uv.y * vv + 2.5 * ww);\n\n  vec3 md = moonDir();\n  vec3 moonCol = vec3(0.98, 0.92, 0.85);\n\n  // ── Sky (above horizon) ──\n  vec3 sky = skyColor(rd);\n  vec3 col = sky;\n\n  // ── Ray-plane intersection (water at y=0) ──\n  float dsea = -ro.y / rd.y;\n\n  if (dsea > 0.0) {\n    vec3 wp = ro + dsea * rd;\n\n    // ── Sample waves ──\n    vec4 s = sea(wp.xz, t);\n    float h = s.x;\n    vec3 nor = s.yzw;\n\n    // ── Mouse ripple — concentric rings that affect normals ──\n    if (u_mouse.x > 0.0) {\n      vec2 mUV = -1.0 + 2.0 * u_mouse / u_res;\n      mUV.x *= aspect;\n      vec3 mrd = normalize(mUV.x * uu + mUV.y * vv + 2.5 * ww);\n      float mdsea = -ro.y / mrd.y;\n      if (mdsea > 0.0) {\n        vec3 mwp = ro + mdsea * mrd;\n        vec2 mdelta = wp.xz - mwp.xz;\n        float md2 = length(mdelta);\n        float mfreq = 4.0;\n        float mphase = md2 * mfreq - t * 5.0;\n        float mamp = exp(-md2 * 0.15) * 0.4 * u_waves;\n        h += sin(mphase) * mamp;\n        // Analytical normal contribution from mouse ripple\n        float mcos = cos(mphase) * mamp * mfreq;\n        vec2 mgrad = md2 > 0.01 ? (mdelta / md2) * mcos : vec2(0.0);\n        nor = normalize(nor + vec3(-mgrad.x, 0.0, -mgrad.y) * 2.0);\n      }\n    }\n    // Flatten normal with distance (perspective detail fade)\n    nor = mix(nor, vec3(0.0, 1.0, 0.0), smoothstep(0.0, 300.0, dsea));\n\n    // ── Fresnel ──\n    float fre = clamp(1.0 - dot(-nor, rd), 0.0, 1.0);\n    fre = pow(fre, 3.0);\n\n    // ── Diffuse moonlight ──\n    float dif = mix(0.25, 1.0, max(dot(nor, md), 0.0));\n\n    // ── Reflection & refraction ──\n    vec3 refl = skyColor(reflect(rd, nor));\n    vec3 seaCol1 = vec3(0.05, 0.02, 0.01);\n    vec3 seaCol2 = vec3(0.10, 0.06, 0.04);\n    vec3 refr = seaCol1 + dif * moonCol * seaCol2 * 0.15 * u_moonGlow;\n\n    col = mix(refr, 0.9 * refl, fre);\n\n    // ── Wave crest highlight ──\n    float atten = max(1.0 - dsea * dsea * 0.0005, 0.0);\n    col += seaCol2 * (wp.y - h) * 1.5 * atten;\n\n    // ── Distance fog (fade to sky at horizon) ──\n    col = mix(col, sky, 1.0 - exp(-0.008 * dsea));\n  }\n\n  // ── Gamma ──\n  col = pow(max(col, vec3(0.0)), vec3(0.85));\n\n  gl_FragColor = vec4(col, 1.0);\n}", "format": "raw", "inputs": [{"name": "u_time", "type": "float", "default": 1}, {"name": "u_res", "type": "vec2", "default": [0.5, 0.5]}, {"name": "u_rippleSpeed", "type": "float", "default": 0.5, "min": 0.1, "max": 1.5}, {"name": "u_moonGlow", "type": "float", "default": 1, "min": 0.3, "max": 2}, {"name": "u_mouse", "type": "vec2", "default": [-1, -1]}, {"name": "u_tilt", "type": "float", "default": 0.15}, {"name": "u_waves", "type": "float", "default": 1}], "description": "Moon reflection on dark water with multi-directional waves, Fresnel reflection, and 3D perspective.", "categories": ["fill", "noise"]}, {"id": "radiant-eclipse-glow", "name": "Eclipse Glow", "kind": "generator", "family": "Radiant", "license": "MIT", "sourceUrl": "https://github.com/pbakaus/radiant/blob/59e9f48c0ad9a3db2fbeb8898b4390d5a1eabb40/static/eclipse-glow.html", "source": "precision highp float;\nuniform float u_time;\nuniform vec2 u_res;\nuniform float u_coronaSize;\nuniform float u_rayIntensity;\nuniform vec2 u_mouse;\n\n#define PI 3.14159265359\n#define TAU 6.28318530718\n\n// ── Hash for star field and grain ──\nfloat hash(vec2 p) {\n  vec3 p3 = fract(vec3(p.xyx) * 0.1031);\n  p3 += dot(p3, p3.yzx + 33.33);\n  return fract((p3.x + p3.y) * p3.z);\n}\n\n// ── Value noise ──\nfloat vnoise(vec2 p) {\n  vec2 i = floor(p);\n  vec2 f = fract(p);\n  f = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);\n  return mix(\n    mix(hash(i), hash(i + vec2(1.0, 0.0)), f.x),\n    mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), f.x),\n    f.y\n  );\n}\n\n// ── FBM for corona rays (3 octaves, cheap) ──\nfloat fbm3(vec2 p) {\n  float v = 0.0, a = 0.5;\n  mat2 rot = mat2(0.8, 0.6, -0.6, 0.8);\n  for (int i = 0; i < 3; i++) {\n    v += a * vnoise(p);\n    p = rot * p * 2.1 + vec2(1.7, 9.2);\n    a *= 0.5;\n  }\n  return v;\n}\n\n// ── FBM 4 octaves for finer detail ──\nfloat fbm4(vec2 p) {\n  float v = 0.0, a = 0.5;\n  mat2 rot = mat2(0.866, 0.5, -0.5, 0.866);\n  for (int i = 0; i < 4; i++) {\n    v += a * vnoise(p);\n    p = rot * p * 2.05 + vec2(3.1, 7.4);\n    a *= 0.48;\n  }\n  return v;\n}\n\nvoid main() {\n  vec2 uv = (gl_FragCoord.xy - u_res * 0.5) / min(u_res.x, u_res.y);\n  float t = u_time;\n  float coronaSize = u_coronaSize;\n  float rayIntensity = u_rayIntensity;\n\n  // ── Polar coordinates ──\n  float r = length(uv);\n  float a = atan(uv.y, uv.x);\n\n  // ── Background: deep space ──\n  vec3 col = vec3(0.005, 0.003, 0.008);\n\n  // ── Star field — sparse hash-based points ──\n  vec2 starGrid = floor(gl_FragCoord.xy / 3.0);\n  float starHash = hash(starGrid * 0.73 + vec2(13.7, 29.3));\n  float starBright = step(0.997, starHash);\n  // Twinkle\n  float twinkle = sin(t * 1.5 + starHash * 100.0) * 0.4 + 0.6;\n  starBright *= twinkle * hash(starGrid * 1.31 + vec2(7.1, 3.9));\n  // Fade stars near corona\n  starBright *= smoothstep(0.15, 0.45, r);\n  col += vec3(0.7, 0.75, 0.9) * starBright * 0.6;\n\n  // ── Eclipse disc parameters ──\n  float discRadius = 0.15;\n  float chromoRadius = discRadius + 0.008;\n\n  // ── Slow corona rotation ──\n  float rotAngle = a + t * 0.05;\n\n  // ── Corona ray noise — multiple octaves at different speeds ──\n  // Octave 1: broad rays, slow\n  float ray1 = fbm3(vec2(rotAngle * 3.0, r * 4.0 - t * 0.08));\n  // Octave 2: medium detail, medium speed\n  float ray2 = fbm3(vec2(rotAngle * 7.0 + 5.0, r * 6.0 - t * 0.12));\n  // Octave 3: fine streaks, faster\n  float ray3 = fbm4(vec2(rotAngle * 13.0 + 10.0, r * 8.0 - t * 0.18));\n\n  // Combine rays with weighting\n  float rays = ray1 * 0.5 + ray2 * 0.3 + ray3 * 0.2;\n\n  // ── Angular asymmetry — corona streamers vary in length ──\n  float asymmetry = 0.7 + 0.3 * sin(a * 2.0 + 0.5) * sin(a * 3.0 + t * 0.02);\n  asymmetry += 0.15 * sin(a * 5.0 + 1.7);\n  rays *= asymmetry;\n\n  // ── Radial falloff for corona ──\n  float coronaOuter = discRadius + 0.35 * coronaSize;\n  float radialFalloff = smoothstep(coronaOuter, discRadius + 0.02, r);\n  radialFalloff *= smoothstep(discRadius - 0.01, discRadius + 0.03, r);\n\n  // ── Extended ray reach — rays extend further than base corona ──\n  float rayReach = discRadius + 0.6 * coronaSize;\n  float rayFalloff = smoothstep(rayReach, discRadius + 0.03, r);\n  rayFalloff *= smoothstep(discRadius - 0.01, discRadius + 0.03, r);\n\n  // ── Corona color gradient: warm amber inner to deep orange outer ──\n  float colorMix = smoothstep(discRadius, coronaOuter, r);\n  vec3 innerColor = vec3(1.0, 0.75, 0.30);\n  vec3 outerColor = vec3(0.8, 0.35, 0.08);\n  vec3 coronaColor = mix(innerColor, outerColor, colorMix);\n\n  // ── Apply corona base glow ──\n  float coronaGlow = radialFalloff * (0.4 + rays * 0.6);\n  col += coronaColor * coronaGlow * 1.2 * rayIntensity;\n\n  // ── Apply extended ray streaks ──\n  float rayStreak = rayFalloff * pow(rays, 1.5) * 0.8;\n  col += mix(coronaColor, outerColor, 0.5) * rayStreak * rayIntensity;\n\n  // ── Bright inner corona ring (chromosphere) ──\n  float chromoDist = abs(r - chromoRadius);\n  float chromo = exp(-chromoDist * chromoDist / 0.00008);\n  // Modulate with subtle noise for unevenness\n  float chromoNoise = fbm3(vec2(rotAngle * 10.0, t * 0.2));\n  chromo *= 0.7 + chromoNoise * 0.5;\n  vec3 chromoColor = vec3(1.0, 0.85, 0.5);\n  col += chromoColor * chromo * 2.5 * rayIntensity;\n\n  // ── Hot inner edge — very tight bright ring ──\n  float innerEdge = exp(-pow((r - discRadius) * 80.0, 2.0));\n  innerEdge *= smoothstep(discRadius - 0.02, discRadius + 0.005, r);\n  col += vec3(1.0, 0.95, 0.8) * innerEdge * 3.0;\n\n  // ── Solar wind — fine radial streaks via cheap hash ──\n  float windA = floor((a + t * 0.02) * 80.0);\n  float windR2 = floor((r - t * 0.06) * 100.0);\n  float wind = hash(vec2(windA, windR2));\n  wind = smoothstep(0.95, 1.0, wind);\n  float windFade = smoothstep(discRadius, discRadius + 0.05, r);\n  windFade *= smoothstep(rayReach + 0.08, discRadius + 0.06, r);\n  col += vec3(1.0, 0.85, 0.55) * wind * windFade * 0.06 * rayIntensity;\n\n  // ── Bloom / lens flare ──\n  // Soft wide glow around the corona\n  float bloomDist = max(r - discRadius, 0.0);\n  float bloom = exp(-bloomDist * 2.5);\n  bloom *= smoothstep(discRadius - 0.05, discRadius + 0.01, r);\n  col += vec3(0.4, 0.25, 0.1) * bloom * 0.25 * rayIntensity;\n\n  // Very wide subtle bloom\n  float wideBloom = exp(-r * 1.2) * 0.15;\n  col += vec3(0.3, 0.18, 0.06) * wideBloom * rayIntensity;\n\n  // Horizontal lens streak — soft and wide, not a sharp line\n  float streak = exp(-uv.y * uv.y * 80.0) * exp(-abs(r - discRadius) * 5.0);\n  streak *= smoothstep(discRadius - 0.02, discRadius + 0.05, r);\n  col += vec3(0.6, 0.4, 0.2) * streak * 0.08 * rayIntensity;\n\n  // ── Dark moon disc ──\n  float disc = smoothstep(discRadius + 0.003, discRadius - 0.003, r);\n  col *= 1.0 - disc;\n  // Very faint lunar surface noise\n  float lunarNoise = vnoise(uv * 40.0) * 0.008;\n  col += vec3(lunarNoise * 0.5, lunarNoise * 0.4, lunarNoise * 0.3) * disc;\n\n  // ── Diamond ring effect — follows cursor when active ──\n  float diamondAngle = sin(t * 0.02) * PI;\n  if (u_mouse.x > 0.0) {\n    vec2 mUV = (u_mouse - u_res * 0.5) / min(u_res.x, u_res.y);\n    diamondAngle = atan(mUV.y, mUV.x);\n  }\n  vec2 diamondDir = vec2(cos(diamondAngle), sin(diamondAngle));\n  float diamondDot = dot(normalize(uv), diamondDir);\n  float diamond = smoothstep(0.96, 1.0, diamondDot);\n  float diamondR = smoothstep(discRadius + 0.025, discRadius, r);\n  diamondR *= smoothstep(discRadius - 0.015, discRadius, r);\n  float diamondGlow = diamond * diamondR;\n  float diamondBoost = u_mouse.x > 0.0 ? 2.5 : 1.5;\n  col += vec3(1.0, 0.95, 0.8) * diamondGlow * diamondBoost * rayIntensity;\n  // Diamond bloom — soft radial spread\n  float dBloomR = exp(-pow((r - discRadius) * 20.0, 2.0));\n  float dBloomA = smoothstep(0.92, 1.0, diamondDot);\n  col += vec3(0.5, 0.35, 0.15) * dBloomR * dBloomA * (diamondBoost * 0.4) * rayIntensity;\n\n  // ── Mouse: corona brightens toward cursor direction ──\n  if (u_mouse.x > 0.0) {\n    float angleToCursor = dot(normalize(uv), diamondDir);\n    float coronaPull = smoothstep(0.3, 1.0, angleToCursor);\n    coronaPull *= smoothstep(discRadius, discRadius + 0.25, r);\n    coronaPull *= smoothstep(0.6, discRadius + 0.05, r);\n    col += vec3(0.8, 0.55, 0.25) * coronaPull * 0.15 * rayIntensity;\n  }\n\n  // ── Film grain ──\n  float grain = (hash(gl_FragCoord.xy + fract(t * 43.0) * 1000.0) - 0.5) * 0.015;\n  col += grain;\n\n  // ── Vignette — darker sky away from corona ──\n  float vig = 1.0 - smoothstep(0.3, 1.1, r);\n  col *= 0.7 + 0.3 * vig;\n\n  // ── Tone mapping — keep blacks deep ──\n  col = max(col, vec3(0.0));\n  // Soft highlight compression\n  col = col / (1.0 + col * 0.3);\n  // Slight warm push in shadows\n  float lum = dot(col, vec3(0.299, 0.587, 0.114));\n  col = mix(col, col * vec3(1.06, 0.97, 0.90), smoothstep(0.05, 0.0, lum) * 0.2);\n\n  gl_FragColor = vec4(col, 1.0);\n}", "format": "raw", "inputs": [{"name": "u_time", "type": "float", "default": 1}, {"name": "u_res", "type": "vec2", "default": [0.5, 0.5]}, {"name": "u_coronaSize", "type": "float", "default": 1, "min": 0.3, "max": 2}, {"name": "u_rayIntensity", "type": "float", "default": 1, "min": 0.3, "max": 2}, {"name": "u_mouse", "type": "vec2", "default": [-1, -1]}], "description": "Solar eclipse corona with radial noise rays, diamond ring effect, and streaming solar wind.", "categories": ["object", "noise"]}, {"id": "radiant-diamond-caustics", "name": "Diamond Caustics", "kind": "generator", "family": "Radiant", "license": "MIT", "sourceUrl": "https://github.com/pbakaus/radiant/blob/59e9f48c0ad9a3db2fbeb8898b4390d5a1eabb40/static/diamond-caustics.html", "source": "precision highp float;\nuniform float u_time;\nuniform vec2 u_res;\nuniform float u_rotationSpeed;\nuniform float u_brilliance;\nuniform vec2 u_mouse;\n\n#define PI 3.14159265359\n#define TAU 6.28318530718\n\n// ── Rotation matrix ──\nmat2 rot(float a) {\n  float c = cos(a), s = sin(a);\n  return mat2(c, -s, s, c);\n}\n\n// ── Hash for randomness ──\nfloat hash(vec2 p) {\n  p = fract(p * vec2(443.897, 441.423));\n  p += dot(p, p.yx + 19.19);\n  return fract((p.x + p.y) * p.x);\n}\n\n// ── Smooth noise ──\nfloat noise(vec2 p) {\n  vec2 i = floor(p);\n  vec2 f = fract(p);\n  f = f * f * (3.0 - 2.0 * f);\n  float a = hash(i);\n  float b = hash(i + vec2(1.0, 0.0));\n  float c = hash(i + vec2(0.0, 1.0));\n  float d = hash(i + vec2(1.0, 1.0));\n  return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);\n}\n\n// ── Hexagonal distance field ──\n// Returns (cell center distance, cell ID) for Voronoi-like facets\nvec4 hexGrid(vec2 p) {\n  // Hexagonal grid constants\n  vec2 s = vec2(1.0, 1.7320508); // 1, sqrt(3)\n  vec2 h = s * 0.5;\n  \n  // Two offset grids\n  vec2 a = mod(p, s) - h;\n  vec2 b = mod(p - h, s) - h;\n  \n  // Pick closest center\n  vec2 ga = dot(a, a) < dot(b, b) ? a : b;\n  vec2 cellId = p - ga;\n  \n  // Hex distance\n  vec2 ab = abs(ga);\n  float hexDist = max(dot(ab, normalize(vec2(1.0, 1.7320508))), ab.x);\n  \n  return vec4(ga, hexDist, hash(cellId));\n}\n\n// ── Triangular grid for facet patterns ──\nfloat triGrid(vec2 p) {\n  vec2 q = vec2(p.x + p.y * 0.57735, p.y * 1.1547);\n  vec2 i = floor(q);\n  vec2 f = fract(q);\n  float triId = step(f.x + f.y, 1.0);\n  float edge = min(min(f.x, f.y), abs(1.0 - f.x - f.y));\n  return edge;\n}\n\n// ── Diamond facet SDF — brilliant cut top-down view ──\n// Concentric facet rings like a real brilliant-cut diamond\nfloat brilliantFacets(vec2 uv, float time) {\n  float r = length(uv);\n  float a = atan(uv.y, uv.x);\n  \n  // Table facet (center octagon)\n  float table = smoothstep(0.12, 0.11, r);\n  \n  // Star facets (8-fold, inner ring)\n  float starAngle = mod(a + PI / 8.0, PI / 4.0) - PI / 8.0;\n  float starR = r - 0.18;\n  float star = abs(starAngle) * 8.0 / PI;\n  float starEdge = smoothstep(0.01, 0.0, abs(starR) - star * 0.08);\n  \n  // Kite facets (8-fold, main crown)\n  float kiteAngle = mod(a, PI / 4.0) - PI / 8.0;\n  float kiteEdge = smoothstep(0.01, 0.0, abs(kiteAngle) * r * 6.0 - 0.02);\n  float kiteRing = smoothstep(0.01, 0.0, abs(r - 0.28) - 0.005);\n  \n  // Upper girdle facets (16-fold)\n  float ugAngle = mod(a, PI / 8.0) - PI / 16.0;\n  float ugEdge = smoothstep(0.01, 0.0, abs(ugAngle) * r * 10.0 - 0.02);\n  float ugRing = smoothstep(0.01, 0.0, abs(r - 0.38) - 0.005);\n  \n  // Girdle outline\n  float girdle = smoothstep(0.01, 0.0, abs(r - 0.45) - 0.008);\n  \n  // Combine facet edges\n  float edges = max(max(starEdge, kiteEdge), max(ugEdge, girdle));\n  edges = max(edges, kiteRing);\n  edges = max(edges, ugRing);\n  \n  // Radial lines every 22.5 degrees (16-fold symmetry)\n  float radial16 = mod(a, PI / 8.0) - PI / 16.0;\n  float radLine16 = smoothstep(0.008, 0.0, abs(radial16) * r * 4.0 - 0.004);\n  radLine16 *= step(0.12, r) * step(r, 0.46);\n  \n  // Radial lines every 45 degrees (8-fold)\n  float radial8 = mod(a + PI / 8.0, PI / 4.0) - PI / 8.0;\n  float radLine8 = smoothstep(0.006, 0.0, abs(radial8) * r * 5.0 - 0.003);\n  radLine8 *= step(0.12, r) * step(r, 0.46);\n  \n  edges = max(edges, max(radLine16 * 0.5, radLine8));\n  \n  return edges;\n}\n\n// ── Prismatic spectral color from wavelength ──\n// More physically-based spectral mapping for diamond fire\nvec3 spectral(float t) {\n  t = fract(t);\n  vec3 c = vec3(0.0);\n  // Red\n  c.r = smoothstep(0.0, 0.15, t) - smoothstep(0.35, 0.5, t);\n  c.r += smoothstep(0.8, 0.95, t);\n  // Green\n  c.g = smoothstep(0.15, 0.35, t) - smoothstep(0.55, 0.75, t);\n  // Blue\n  c.b = smoothstep(0.4, 0.6, t) - smoothstep(0.75, 0.95, t);\n  // Boost intensity — vivid saturated spectral fire\n  c = pow(c, vec3(0.6));\n  return c * 3.0;\n}\n\n// ── Diamond caustic: light concentration through faceted refraction ──\nfloat diamondCaustic(vec2 uv, float time, float scale, float rotation) {\n  vec2 p = rot(rotation) * uv * scale;\n  \n  // Hexagonal Voronoi for facet structure\n  vec4 hex = hexGrid(p);\n  float cellRand = hex.w;\n  \n  // Each facet refracts light at its own angle\n  // The refraction angle changes slowly as the diamond \"rotates\"\n  float facetAngle = cellRand * TAU + time * 0.3;\n  vec2 refract = vec2(cos(facetAngle), sin(facetAngle)) * 0.3;\n  \n  // Displaced coordinates — where light ends up after refraction\n  vec2 displaced = p + refract * (1.0 + 0.5 * sin(time * 0.7 + cellRand * 10.0));\n  \n  // Second layer of facet structure on displaced coords\n  vec4 hex2 = hexGrid(displaced * 1.5);\n  \n  // Caustic brightness = how much the mapping compresses space\n  // Bright where multiple input rays converge to same output point\n  float edgeDist = hex.z;\n  float caustic = 1.0 - smoothstep(0.0, 0.4, edgeDist);\n  \n  // Sharp bright folds from displaced field\n  float fold = 1.0 - smoothstep(0.0, 0.25, hex2.z);\n  fold = pow(fold, 2.0);\n  \n  // Interference between original and refracted patterns\n  float interference = sin(displaced.x * 8.0 + time * 0.5) * sin(displaced.y * 8.0 - time * 0.4);\n  interference = pow(abs(interference), 1.5) * 0.5;\n  \n  return caustic * 0.3 + fold * 0.5 + interference * 0.2;\n}\n\n// ── Scintillation: the sparkle flashes of a diamond ──\nfloat scintillation(vec2 uv, float time) {\n  float sparkle = 0.0;\n  \n  // Multiple scales of sparkle points\n  for (float i = 0.0; i < 3.0; i++) {\n    float sc = 5.0 + i * 4.0;\n    vec2 grid = floor(uv * sc);\n    vec2 f = fract(uv * sc) - 0.5;\n    \n    float h = hash(grid + i * 100.0);\n    float phase = h * TAU + time * (1.5 + h * 2.0);\n    \n    // Sharp, brief flashes — like catching light on a facet edge\n    float flash = pow(max(sin(phase), 0.0), 48.0);\n    \n    // Only at the cell center\n    float dist = length(f);\n    float point = smoothstep(0.15, 0.0, dist);\n    \n    sparkle += flash * point * (1.0 - i * 0.25);\n  }\n  \n  return sparkle;\n}\n\n// ── Star burst for bright sparkle highlights ──\nfloat starBurst(vec2 uv, float time) {\n  float r = length(uv);\n  float a = atan(uv.y, uv.x);\n  \n  // 4-point star\n  float star4 = pow(abs(cos(a * 2.0)), 64.0) / (r * 20.0 + 1.0);\n  // 6-point star\n  float star6 = pow(abs(cos(a * 3.0)), 64.0) / (r * 25.0 + 1.0);\n  \n  return (star4 + star6 * 0.5) * smoothstep(0.5, 0.0, r);\n}\n\nvoid main() {\n  vec2 uv = (gl_FragCoord.xy - u_res * 0.5) / min(u_res.x, u_res.y);\n  if (u_mouse.x > 0.0) {\n    vec2 mNorm = (u_mouse - u_res * 0.5) / min(u_res.x, u_res.y);\n    uv += (mNorm - uv) * 0.2;\n  }\n  float t = u_time;\n  float rotSpeed = u_rotationSpeed;\n  float brilliance = u_brilliance;\n  \n  // ── Gentle overall rotation to simulate diamond turning in light ──\n  float globalRot = t * rotSpeed * 0.1;\n  vec2 uvRot = rot(globalRot) * uv;\n  \n  // ════════════════════════════════════════════\n  // LAYER 1: Faceted crystalline geometry\n  // The underlying diamond structure\n  // ════════════════════════════════════════════\n  \n  // Brilliant-cut facet pattern (subtle structural overlay)\n  float facetPattern = brilliantFacets(uvRot * 2.2, t);\n  \n  // Triangular facet grid at multiple scales\n  float tri1 = triGrid(rot(t * 0.05) * uv * 8.0);\n  float tri2 = triGrid(rot(-t * 0.07 + 1.0) * uv * 12.0);\n  float triEdges = smoothstep(0.04, 0.0, tri1) * 0.3 + smoothstep(0.03, 0.0, tri2) * 0.15;\n  \n  // Hexagonal facet structure — very subtle, just edge hints\n  vec4 mainHex = hexGrid(rot(t * 0.06) * uv * 6.0);\n  float hexEdges = smoothstep(0.44, 0.40, mainHex.z) - smoothstep(0.40, 0.36, mainHex.z);\n  float hexOutline = smoothstep(0.45, 0.43, mainHex.z) - smoothstep(0.43, 0.41, mainHex.z);\n  \n  // ════════════════════════════════════════════\n  // LAYER 2: Caustic light patterns — the \"fire\"\n  // Light concentrating through faceted refraction\n  // ════════════════════════════════════════════\n  \n  // Multiple caustic layers at different scales and rotations\n  // Simulates light from crown facets, pavilion facets, and girdle\n  float c1 = diamondCaustic(uv, t, 3.0, t * rotSpeed * 0.15);\n  float c2 = diamondCaustic(uv, t * 1.1 + 10.0, 5.0, -t * rotSpeed * 0.12 + PI * 0.3);\n  float c3 = diamondCaustic(uv, t * 0.9 + 20.0, 8.0, t * rotSpeed * 0.08 + PI * 0.7);\n  \n  float caustics = c1 * 0.5 + c2 * 0.3 + c3 * 0.2;\n  caustics = pow(caustics, 1.3) * 3.5;\n  \n  // ════════════════════════════════════════════\n  // LAYER 3: Chromatic dispersion — prismatic rainbow\n  // Each wavelength refracts at a different angle\n  // ════════════════════════════════════════════\n  \n  // Sample caustics with wavelength-dependent offsets\n  // This creates the rainbow fringing that diamonds are famous for\n  float dispersion = 0.018 * (1.0 + caustics * 0.3);\n  float dispAngle = t * rotSpeed * 0.3 + atan(uv.y, uv.x) * 0.5;\n  \n  // Red channel — longest wavelength, least refraction\n  vec2 rOff = vec2(cos(dispAngle), sin(dispAngle)) * dispersion;\n  float cR = diamondCaustic(uv + rOff, t, 3.0, t * rotSpeed * 0.15);\n  cR += diamondCaustic(uv + rOff, t * 1.1 + 10.0, 5.0, -t * rotSpeed * 0.12 + PI * 0.3) * 0.6;\n  \n  // Green channel — middle wavelength\n  vec2 gOff = vec2(cos(dispAngle + TAU / 3.0), sin(dispAngle + TAU / 3.0)) * dispersion;\n  float cG = diamondCaustic(uv + gOff, t, 3.0, t * rotSpeed * 0.15);\n  cG += diamondCaustic(uv + gOff, t * 1.1 + 10.0, 5.0, -t * rotSpeed * 0.12 + PI * 0.3) * 0.6;\n  \n  // Blue channel — shortest wavelength, most refraction\n  vec2 bOff = vec2(cos(dispAngle + TAU * 2.0 / 3.0), sin(dispAngle + TAU * 2.0 / 3.0)) * dispersion;\n  float cB = diamondCaustic(uv + bOff, t, 3.0, t * rotSpeed * 0.15);\n  cB += diamondCaustic(uv + bOff, t * 1.1 + 10.0, 5.0, -t * rotSpeed * 0.12 + PI * 0.3) * 0.6;\n  \n  // Chromatic difference — where colors separate, we see rainbow\n  vec3 chromatic = vec3(cR, cG, cB);\n  float chrDiff = abs(cR - cG) + abs(cG - cB) + abs(cB - cR);\n  \n  // ════════════════════════════════════════════\n  // LAYER 4: Spectral fire — the colored flashes\n  // ════════════════════════════════════════════\n  \n  // Phase-based spectral color at each point\n  float specPhase = atan(cR - cG, cG - cB) / TAU + 0.5;\n  specPhase += t * 0.03 + length(uv) * 0.5;\n  vec3 fireColor = spectral(specPhase);\n  \n  // Second spectral layer — broader patches of color\n  float specPhase2 = noise(uvRot * 3.0 + t * 0.2) + t * 0.05;\n  vec3 fireColor2 = spectral(specPhase2);\n  \n  // ════════════════════════════════════════════\n  // LAYER 5: Scintillation — point sparkles\n  // ════════════════════════════════════════════\n  \n  float sparkle = scintillation(uvRot, t * rotSpeed);\n  \n  // Star bursts at bright caustic nodes\n  float starTotal = 0.0;\n  for (float i = 0.0; i < 4.0; i++) {\n    float sc = 4.0 + i * 3.0;\n    vec2 grid = floor(rot(i * 0.7 + t * 0.03) * uv * sc);\n    vec2 center = (grid + 0.5) / sc;\n    center = rot(-i * 0.7 - t * 0.03) * center;\n    float h = hash(grid + i * 77.0);\n    float phase = h * TAU + t * (1.0 + h);\n    float flash = pow(max(sin(phase), 0.0), 24.0);\n    float star = starBurst((uv - center) * sc * 0.8, t) * flash;\n    starTotal += star * 0.35;\n  }\n  \n  // ════════════════════════════════════════════\n  // COMPOSITING — build the final diamond look\n  // ════════════════════════════════════════════\n  \n  vec3 col = vec3(0.0);\n  \n  // Base: cool white caustic light (diamond brilliance)\n  vec3 whiteLight = vec3(0.92, 0.95, 1.0);\n  col += whiteLight * caustics * 1.2;\n  \n  // Chromatic caustics — subtle separation gives depth\n  col += chromatic * 0.5 * brilliance;\n  \n  // Prismatic fire — rainbow colors at edges of caustic folds\n  float fireMask = smoothstep(0.03, 0.25, chrDiff) * caustics;\n  col += fireColor * fireMask * 2.5 * brilliance;\n  col += fireColor2 * caustics * 0.6 * brilliance;\n  \n  // Facet geometry overlay — ghost-like structural hints visible only in bright areas\n  vec3 facetColor = vec3(0.7, 0.75, 0.85);\n  float structureMask = smoothstep(0.1, 0.5, caustics);\n  col += facetColor * facetPattern * 0.04 * structureMask;\n  col += facetColor * triEdges * hexEdges * 0.03 * (0.3 + structureMask * 0.7);\n  col += vec3(0.8, 0.85, 0.95) * hexOutline * 0.025 * (0.2 + structureMask * 0.8);\n  \n  // Scintillation sparkles — bright white flashes\n  vec3 sparkleColor = vec3(1.0, 0.98, 0.95);\n  col += sparkleColor * sparkle * 3.5 * brilliance;\n  \n  // Star bursts with spectral color\n  float starSpec = fract(t * 0.15 + starTotal * 2.0);\n  col += mix(vec3(1.0, 0.97, 0.92), spectral(starSpec), 0.5) * starTotal * 2.5 * brilliance;\n  \n  // ── Warm amber base tone — consistent with gallery palette ──\n  vec3 amber = vec3(0.78, 0.58, 0.42);\n  col += amber * caustics * 0.08;\n  \n  // ── Center diamond brilliance — brighter toward center ──\n  float centerGlow = smoothstep(0.6, 0.0, length(uv));\n  col *= 0.8 + centerGlow * 0.8;\n  \n  // ── Occasional intense fire flash — \"hearts and arrows\" ──\n  float flashPhase = sin(t * rotSpeed * 1.7 + uvRot.x * 4.0) *\n                     cos(t * rotSpeed * 2.3 + uvRot.y * 3.0);\n  float intenseFlash = pow(max(flashPhase, 0.0), 10.0) * 3.5;\n  float flashSpec = fract(t * 0.2 + atan(uvRot.y, uvRot.x) / TAU);\n  col += spectral(flashSpec) * intenseFlash * centerGlow * brilliance;\n  \n  // ── Subtle animated prismatic sweep — light moving across diamond ──\n  float sweep = sin(uv.x * 3.0 + uv.y * 2.0 + t * rotSpeed * 0.5);\n  sweep = pow(max(sweep, 0.0), 4.0) * 0.35;\n  col += spectral(t * 0.1 + uv.x * 0.3) * sweep * brilliance;\n  \n  // ── Vignette — darker at edges ──\n  float vig = 1.0 - dot(uv, uv) * 0.35;\n  vig = max(vig, 0.0);\n  col *= vig;\n  \n  // ── Tone mapping — ACES filmic, preserves sparkle peaks and saturation ──\n  col *= 2.2;\n  col = col * (2.51 * col + 0.03) / (col * (2.43 * col + 0.59) + 0.14);\n  \n  // ── Slight cool-warm contrast ──\n  col = pow(col, vec3(0.97, 0.98, 1.03));\n  \n  // ── Minimum ambient so dark areas read as very dark, not pure black ──\n  col += vec3(0.008, 0.008, 0.012);\n  \n  gl_FragColor = vec4(col, 1.0);\n}", "format": "raw", "inputs": [{"name": "u_time", "type": "float", "default": 1}, {"name": "u_res", "type": "vec2", "default": [0.5, 0.5]}, {"name": "u_rotationSpeed", "type": "float", "default": 0.5, "min": 0.1, "max": 2}, {"name": "u_brilliance", "type": "float", "default": 1, "min": 0.3, "max": 2}, {"name": "u_mouse", "type": "vec2", "default": [-1, -1]}], "description": "Light refracting through rotating diamond facets casting prismatic caustic patterns.", "categories": ["fill", "geometric"]}, {"id": "radiant-metamorphosis", "name": "Metamorphosis", "kind": "generator", "family": "Radiant", "license": "MIT", "sourceUrl": "https://github.com/pbakaus/radiant/blob/59e9f48c0ad9a3db2fbeb8898b4390d5a1eabb40/static/metamorphosis.html", "source": "precision highp float;\nuniform float u_time;\nuniform vec2 u_res;\nuniform float u_morphSpeed;\nuniform float u_blobCount;\nuniform vec2 u_mouse;\n\n#define PI 3.14159265359\n#define TAU 6.28318530718\n#define MAX_STEPS 48\n#define MAX_DIST 20.0\n#define SURF_DIST 0.002\n#define BLOB_MAX 6\n\n// Precomputed blob data — set once per pixel in main(),\n// read many times in scene(). Avoids redundant trig across\n// ~120 scene() calls per hit pixel (march + normal + shadow + AO).\nvec3 g_pos[BLOB_MAX];\nvec3 g_radStretch[BLOB_MAX];\nmat2 g_rotXY[BLOB_MAX];\nmat2 g_rotYZ[BLOB_MAX];\nint g_count;\n\nfloat smin(float a, float b, float k) {\n  float h = clamp(0.5 + 0.5 * (b - a) / k, 0.0, 1.0);\n  return mix(b, a, h) - k * h * (1.0 - h);\n}\n\nfloat sdEllipsoid(vec3 p, vec3 r) {\n  float k0 = length(p / r);\n  float k1 = length(p / (r * r));\n  return k0 * (k0 - 1.0) / k1;\n}\n\nfloat scene(vec3 p) {\n  float d = MAX_DIST;\n  for (int i = 0; i < BLOB_MAX; i++) {\n    if (i >= g_count) break;\n    vec3 q = p - g_pos[i];\n    q = vec3(g_rotXY[i] * q.xy, q.z);\n    q = vec3(q.x, g_rotYZ[i] * q.yz);\n    d = smin(d, sdEllipsoid(q, g_radStretch[i]), 0.6);\n  }\n  return d;\n}\n\n// Tetrahedron normal — 4 scene evals instead of 6\nvec3 calcNormal(vec3 p) {\n  vec2 e = vec2(0.002, -0.002);\n  return normalize(\n    e.xyy * scene(p + e.xyy) +\n    e.yyx * scene(p + e.yyx) +\n    e.yxy * scene(p + e.yxy) +\n    e.xxx * scene(p + e.xxx)\n  );\n}\n\nfloat softShadow(vec3 ro, vec3 rd, float mint, float maxt, float k) {\n  float res = 1.0;\n  float ph = 1e10;\n  float t = mint;\n  for (int i = 0; i < 16; i++) {\n    float h = scene(ro + rd * t);\n    if (h < 0.001) return 0.0;\n    float y = h * h / (2.0 * ph);\n    float d = sqrt(h * h - y * y);\n    res = min(res, k * d / max(0.0, t - y));\n    ph = h;\n    t += h;\n    if (t > maxt) break;\n  }\n  return clamp(res, 0.0, 1.0);\n}\n\nfloat calcAO(vec3 p, vec3 n) {\n  float occ = 0.0;\n  float sca = 1.0;\n  for (int i = 0; i < 3; i++) {\n    float h = 0.01 + 0.12 * float(i) / 2.0;\n    float d = scene(p + h * n);\n    occ += (h - d) * sca;\n    sca *= 0.95;\n  }\n  return clamp(1.0 - 3.0 * occ, 0.0, 1.0);\n}\n\nfloat fresnel(float cosTheta, float f0) {\n  return f0 + (1.0 - f0) * pow(1.0 - cosTheta, 5.0);\n}\n\nvec3 envMap(vec3 rd) {\n  float y = rd.y * 0.5 + 0.5;\n  vec3 sky = mix(\n    vec3(0.02, 0.015, 0.01),\n    vec3(0.08, 0.05, 0.03),\n    y\n  );\n  float sun = pow(max(dot(rd, normalize(vec3(2.0, 3.0, 1.0))), 0.0), 32.0);\n  sky += vec3(1.0, 0.85, 0.6) * sun * 0.5;\n  float fill = pow(max(dot(rd, normalize(vec3(-2.0, 1.0, -1.0))), 0.0), 8.0);\n  sky += vec3(0.6, 0.35, 0.3) * fill * 0.15;\n  float rim = pow(max(dot(rd, normalize(vec3(0.0, 0.5, -2.0))), 0.0), 16.0);\n  sky += vec3(0.8, 0.5, 0.25) * rim * 0.2;\n  return sky;\n}\n\nvoid main() {\n  vec2 uv = (gl_FragCoord.xy - u_res * 0.5) / min(u_res.x, u_res.y);\n  float t = u_time;\n  float speed = t * u_morphSpeed;\n\n  // Precompute all blob data once (positions, radii, rotations)\n  g_count = int(u_blobCount);\n  for (int i = 0; i < BLOB_MAX; i++) {\n    if (i >= g_count) break;\n    float fi = float(i);\n    float phase = fi * TAU / 6.0;\n    g_pos[i] = vec3(\n      sin(speed * 0.7 + phase) * 0.8 + sin(speed * 0.3 + phase * 2.3) * 0.3,\n      cos(speed * 0.5 + phase * 1.4) * 0.6 + sin(speed * 0.8 + phase * 0.7) * 0.25,\n      sin(speed * 0.6 + phase * 1.8) * 0.5 + cos(speed * 0.4 + phase * 2.1) * 0.2\n    );\n    float base = 0.45 + fi * 0.03;\n    float pulse = sin(speed * 1.2 + fi * 1.7) * 0.08 + sin(speed * 0.5 + fi * 3.1) * 0.05;\n    float r = base + pulse;\n    float sx = 1.0 + sin(speed * 0.9 + fi * 2.3) * 0.25;\n    float sy = 1.0 + cos(speed * 0.7 + fi * 1.9) * 0.2;\n    float sz = 1.0 + sin(speed * 1.1 + fi * 2.7) * 0.2;\n    float norm = pow(1.0 / (sx * sy * sz), 0.333);\n    g_radStretch[i] = vec3(r) * vec3(sx, sy, sz) * norm;\n    float ca = cos(speed * 0.3 + fi * 1.1), sa = sin(speed * 0.3 + fi * 1.1);\n    g_rotXY[i] = mat2(ca, -sa, sa, ca);\n    float cb = cos(speed * 0.2 + fi * 0.9), sb = sin(speed * 0.2 + fi * 0.9);\n    g_rotYZ[i] = mat2(cb, -sb, sb, cb);\n  }\n\n  // ── Mouse: attract blobs toward cursor (per-blob, distance-based) ──\n  if (u_mouse.x > 0.0) {\n    vec2 mUV = (u_mouse - u_res * 0.5) / min(u_res.x, u_res.y);\n    vec3 mouseWorld = vec3(mUV.x * 3.0, mUV.y * 3.0, 0.5);\n    for (int i = 0; i < BLOB_MAX; i++) {\n      if (i >= g_count) break;\n      vec3 toMouse = mouseWorld - g_pos[i];\n      float mDist = length(toMouse);\n      float pull = 0.6 / (1.0 + mDist * mDist * 2.0);\n      g_pos[i] += toMouse * pull;\n    }\n  }\n\n  vec3 ro = vec3(0.0, 0.3, 3.8);\n  vec3 target = vec3(0.0);\n  vec3 fwd = normalize(target - ro);\n  vec3 right = normalize(cross(fwd, vec3(0.0, 1.0, 0.0)));\n  vec3 up = cross(right, fwd);\n  vec3 rd = normalize(fwd * 1.5 + right * uv.x + up * uv.y);\n\n  // Bounding sphere early-out — skip raymarch for rays that miss entirely\n  float bsB = dot(ro, rd);\n  float bsC = dot(ro, ro) - 6.25;\n  float bsDisc = bsB * bsB - bsC;\n\n  float totalDist = 0.0;\n  float dist;\n  vec3 p;\n  bool hit = false;\n\n  if (bsDisc > 0.0) {\n    float sqrtDisc = sqrt(bsDisc);\n    float t0 = -bsB - sqrtDisc;\n    float t1 = -bsB + sqrtDisc;\n    if (t1 > 0.0) {\n      totalDist = max(t0, 0.0);\n      float marchLimit = min(t1, MAX_DIST);\n      for (int i = 0; i < MAX_STEPS; i++) {\n        p = ro + rd * totalDist;\n        dist = scene(p);\n        if (dist < SURF_DIST) { hit = true; break; }\n        if (totalDist > marchLimit) break;\n        totalDist += dist;\n      }\n    }\n  }\n\n  vec3 col = vec3(0.0);\n\n  if (hit) {\n    vec3 n = calcNormal(p);\n    vec3 v = normalize(ro - p);\n\n    float surfaceVar = sin(p.x * 5.0 + t * 0.3) * sin(p.y * 7.0 + t * 0.2) * sin(p.z * 6.0 + t * 0.4);\n    vec3 baseColor = vec3(0.85, 0.65, 0.3);\n    vec3 roseColor = vec3(0.8, 0.5, 0.45);\n    vec3 copperColor = vec3(0.75, 0.45, 0.25);\n\n    float colorMix1 = sin(p.x * 3.0 + p.z * 2.0 + t * u_morphSpeed * 0.4) * 0.5 + 0.5;\n    float colorMix2 = sin(p.y * 4.0 - p.x * 2.5 + t * u_morphSpeed * 0.3) * 0.5 + 0.5;\n    vec3 albedo = mix(baseColor, roseColor, colorMix1 * 0.3);\n    albedo = mix(albedo, copperColor, colorMix2 * 0.25);\n\n    float metallic = 0.9;\n    float roughness = 0.15;\n\n    vec3 lightDir1 = normalize(vec3(2.0, 3.0, 1.5));\n    vec3 lightCol1 = vec3(1.0, 0.9, 0.75) * 1.6;\n    vec3 lightDir2 = normalize(vec3(-2.0, 1.0, -1.0));\n    vec3 lightCol2 = vec3(0.7, 0.4, 0.35) * 0.6;\n    vec3 lightDir3 = normalize(vec3(0.0, 0.5, -2.0));\n    vec3 lightCol3 = vec3(0.9, 0.6, 0.3) * 0.8;\n\n    float diff1 = max(dot(n, lightDir1), 0.0);\n    float diff2 = max(dot(n, lightDir2), 0.0);\n    float diff3 = max(dot(n, lightDir3), 0.0);\n\n    float specPow = mix(256.0, 32.0, roughness);\n    vec3 h1 = normalize(lightDir1 + v);\n    vec3 h2 = normalize(lightDir2 + v);\n    vec3 h3 = normalize(lightDir3 + v);\n    float spec1 = pow(max(dot(n, h1), 0.0), specPow);\n    float spec2 = pow(max(dot(n, h2), 0.0), specPow);\n    float spec3 = pow(max(dot(n, h3), 0.0), specPow);\n\n    float NdotV = max(dot(n, v), 0.0);\n    float fres = fresnel(NdotV, 0.04 + metallic * 0.76);\n\n    float shadow = softShadow(p + n * 0.01, lightDir1, 0.02, 5.0, 16.0);\n    float ao = calcAO(p, n);\n\n    vec3 diffuse = albedo * (1.0 - metallic) * (\n      lightCol1 * diff1 * shadow +\n      lightCol2 * diff2 +\n      lightCol3 * diff3\n    );\n\n    vec3 specColor = mix(vec3(0.04), albedo, metallic);\n    vec3 specular = specColor * (\n      lightCol1 * spec1 * shadow * 1.5 +\n      lightCol2 * spec2 * 0.8 +\n      lightCol3 * spec3 * 1.0\n    );\n\n    vec3 reflDir = reflect(-v, n);\n    vec3 envRefl = envMap(reflDir);\n    vec3 envContrib = envRefl * mix(vec3(0.04), albedo, metallic) * fres;\n\n    float rimFactor = pow(1.0 - NdotV, 4.0);\n    vec3 rimColor = vec3(0.9, 0.6, 0.35) * rimFactor * 0.8;\n\n    float subsurface = pow(max(dot(-v, lightDir1), 0.0), 3.0) * (1.0 - metallic) * 0.2;\n    vec3 sssColor = vec3(1.0, 0.7, 0.4) * subsurface;\n\n    col = diffuse + specular + envContrib + rimColor + sssColor;\n    col *= ao;\n\n    float topSpec = pow(max(dot(n, h1), 0.0), 512.0) * shadow;\n    col += vec3(1.0, 0.98, 0.92) * topSpec * 2.0;\n\n  } else {\n    col = vec3(0.012, 0.01, 0.008);\n  }\n\n  float floorY = -1.2;\n  if (rd.y < 0.0) {\n    float floorT = (floorY - ro.y) / rd.y;\n    if (floorT > 0.0 && floorT < MAX_DIST && !hit) {\n      vec3 floorP = ro + rd * floorT;\n      float floorDist = length(floorP.xz);\n      float glow = exp(-floorDist * floorDist * 1.5) * 0.15;\n      glow *= 0.8 + 0.2 * sin(t * u_morphSpeed * 0.5);\n      vec3 glowColor = vec3(0.6, 0.4, 0.2) * glow;\n      float caustic = sin(floorP.x * 8.0 + t * 0.5) * sin(floorP.z * 8.0 + t * 0.7);\n      caustic = caustic * caustic;\n      glowColor += vec3(0.4, 0.25, 0.1) * caustic * glow * 2.0;\n      col += glowColor;\n    }\n  }\n\n  if (!hit) {\n    float closestT = max(-dot(ro, rd), 0.0);\n    vec3 closestP = ro + rd * closestT;\n    float closestDist = length(closestP);\n    float atmosGlow = exp(-closestDist * closestDist * 0.8) * 0.08;\n    col += vec3(0.5, 0.35, 0.15) * atmosGlow;\n  }\n\n  col = col * (2.51 * col + 0.03) / (col * (2.43 * col + 0.59) + 0.14);\n  col = pow(col, vec3(0.95, 0.98, 1.04));\n  float vig = 1.0 - dot(uv, uv) * 0.25;\n  col *= vig;\n\n  gl_FragColor = vec4(col, 1.0);\n}", "format": "raw", "inputs": [{"name": "u_time", "type": "float", "default": 1}, {"name": "u_res", "type": "vec2", "default": [0.5, 0.5]}, {"name": "u_morphSpeed", "type": "float", "default": 0.5, "min": 0.1, "max": 2}, {"name": "u_blobCount", "type": "float", "default": 4, "min": 2, "max": 6}, {"name": "u_mouse", "type": "vec2", "default": [-1, -1]}], "description": "Raymarched metaballs continuously merging and splitting with liquid-metal surface.", "categories": ["object", "organic"]}, {"id": "radiant-silk-groove", "name": "Silk Groove", "kind": "generator", "family": "Radiant", "license": "MIT", "sourceUrl": "https://github.com/pbakaus/radiant/blob/59e9f48c0ad9a3db2fbeb8898b4390d5a1eabb40/static/silk-groove.html", "source": "precision highp float;\nuniform float u_time;\nuniform vec2 u_res;\nuniform float u_flowSpeed;\nuniform float u_foldDepth;\nuniform vec2 u_mouse;\n\n// --- Simplex noise ---\nvec3 mod289(vec3 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }\nvec2 mod289v2(vec2 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }\nvec3 permute(vec3 x) { return mod289(((x * 34.0) + 1.0) * x); }\n\nfloat snoise(vec2 v) {\n  const vec4 C = vec4(0.211324865405187, 0.366025403784439,\n                     -0.577350269189626, 0.024390243902439);\n  vec2 i = floor(v + dot(v, C.yy));\n  vec2 x0 = v - i + dot(i, C.xx);\n  vec2 i1 = (x0.x > x0.y) ? vec2(1.0, 0.0) : vec2(0.0, 1.0);\n  vec4 x12 = x0.xyxy + C.xxzz;\n  x12.xy -= i1;\n  i = mod289v2(i);\n  vec3 p = permute(permute(i.y + vec3(0.0, i1.y, 1.0)) + i.x + vec3(0.0, i1.x, 1.0));\n  vec3 m = max(0.5 - vec3(dot(x0, x0), dot(x12.xy, x12.xy), dot(x12.zw, x12.zw)), 0.0);\n  m = m * m;\n  m = m * m;\n  vec3 x = 2.0 * fract(p * C.www) - 1.0;\n  vec3 h = abs(x) - 0.5;\n  vec3 ox = floor(x + 0.5);\n  vec3 a0 = x - ox;\n  m *= 1.79284291400159 - 0.85373472095314 * (a0 * a0 + h * h);\n  vec3 g;\n  g.x = a0.x * x0.x + h.x * x0.y;\n  g.yz = a0.yz * x12.xz + h.yz * x12.yw;\n  return 130.0 * dot(m, g);\n}\n\n// Smooth FBM — 3 octaves for organic warping\nfloat smoothFbm(vec2 p, float t) {\n  float val = 0.0;\n  float amp = 0.55;\n  mat2 rot = mat2(0.8, 0.6, -0.6, 0.8);\n  for (int i = 0; i < 3; i++) {\n    val += amp * snoise(p + t * 0.1);\n    p = rot * p * 1.9;\n    amp *= 0.42;\n  }\n  return val;\n}\n\n// Silk fabric height field\n// Folds run predominantly along one direction (like draped fabric)\n// with gentle cross-folds and organic variation\nfloat silkHeight(vec2 uv, float t) {\n  // Rotate into fabric-aligned coordinates — folds run diagonally\n  float angle = 0.45;\n  float ca = cos(angle); float sa = sin(angle);\n  vec2 fuv = vec2(ca * uv.x + sa * uv.y, -sa * uv.x + ca * uv.y);\n\n  // Primary folds — long parallel ridges across the fabric\n  // These are the dominant feature of draped silk\n  float folds = sin(fuv.y * 4.0 + t * 0.3) * 0.30;\n  folds += sin(fuv.y * 6.5 + t * 0.45 + 1.0) * 0.16;\n  folds += sin(fuv.y * 10.0 + t * 0.55 + 2.5) * 0.07;\n  folds += sin(fuv.y * 14.0 + t * 0.7 + 4.0) * 0.03;\n\n  // Slow modulation along the fold direction — folds gather and spread\n  float gather = sin(fuv.x * 0.8 + t * 0.15) * 0.4 + 0.6;\n  folds *= gather;\n\n  // Gentle cross-folds (much weaker than main folds)\n  float cross = sin(fuv.x * 2.0 + fuv.y * 0.5 + t * 0.25 + 3.0) * 0.06;\n  cross += sin(fuv.x * 3.5 - fuv.y * 0.8 + t * 0.35 + 5.0) * 0.04;\n\n  // Large billowing motion — the whole fabric breathes\n  float billow = sin(uv.x * 0.9 + uv.y * 0.6 + t * 0.2) * 0.15;\n  billow += sin(uv.x * 0.5 - uv.y * 1.1 + t * 0.18 + 2.0) * 0.12;\n\n  // Organic noise — very low frequency for natural drape variation\n  float organic = smoothFbm(uv * 0.3, t * 0.4) * 0.1;\n\n  return folds + cross + billow + organic;\n}\n\n// Surface normal via central differences\nvec3 silkNormal(vec2 uv, float t) {\n  float eps = 0.003;\n  float hC = silkHeight(uv, t);\n  float hR = silkHeight(uv + vec2(eps, 0.0), t);\n  float hU = silkHeight(uv + vec2(0.0, eps), t);\n  // The z-component controls how steep the normals feel\n  // Lower = sharper highlights, higher = softer\n  return normalize(vec3(hC - hR, hC - hU, eps * 1.0));\n}\n\nvoid main() {\n  vec2 uv = gl_FragCoord.xy / u_res;\n  float aspect = u_res.x / u_res.y;\n  vec2 p = vec2((uv.x - 0.5) * aspect, uv.y - 0.5) * 3.2;\n\n  float t = u_time * u_flowSpeed;\n\n  // Gentle domain warp for organic movement\n  vec2 warp = vec2(\n    snoise(p * 0.18 + t * 0.05 + vec2(0.0, 4.7)),\n    snoise(p * 0.18 + t * 0.04 + vec2(8.3, 0.0))\n  ) * 0.25;\n  vec2 sp = p + warp;\n\n  // Height and normal of the silk surface\n  float h = silkHeight(sp, t) * u_foldDepth;\n  vec3 N = silkNormal(sp, t);\n\n  // ── Lighting — warm two-point setup ──\n  // Mouse controls light direction for shimmering silk highlights\n  vec3 L1 = normalize(vec3(0.3, 0.5, 0.75));\n  if (u_mouse.x > 0.0) {\n    vec2 mUV = u_mouse / u_res - 0.5;\n    L1 = normalize(vec3(mUV.x * 1.5, mUV.y * 1.5, 0.75));\n  }\n  vec3 L2 = normalize(vec3(-0.5, -0.3, 0.65));\n  vec3 V = vec3(0.0, 0.0, 1.0);\n\n  // Diffuse\n  float d1 = max(dot(N, L1), 0.0);\n  float d2 = max(dot(N, L2), 0.0);\n\n  // Wrapped diffuse for softer fill\n  float wd1 = max(0.0, (dot(N, L1) + 0.3) / 1.3);\n\n  // Specular lobes — silk has broad sheen + sharp glint\n  vec3 H1 = normalize(L1 + V);\n  vec3 H2 = normalize(L2 + V);\n\n  // Broad silk sheen\n  float sheen1 = pow(max(dot(N, H1), 0.0), 3.0) * 0.4;\n  float sheen2 = pow(max(dot(N, H2), 0.0), 4.0) * 0.2;\n\n  // Medium specular\n  float spec1 = pow(max(dot(N, H1), 0.0), 18.0);\n  float spec2 = pow(max(dot(N, H2), 0.0), 22.0);\n\n  // Sharp glint on fold peaks\n  float spark = pow(max(dot(N, H1), 0.0), 90.0);\n\n  // Fresnel rim\n  float fresnel = pow(1.0 - max(dot(N, V), 0.0), 3.0);\n\n  // ── Color palette — luxurious warm silk ──\n  vec3 deepAmber    = vec3(0.45, 0.22, 0.08);\n  vec3 richGold     = vec3(0.70, 0.50, 0.16);\n  vec3 warmBurgundy = vec3(0.32, 0.07, 0.09);\n  vec3 deepRose     = vec3(0.48, 0.16, 0.14);\n  vec3 lightSilk    = vec3(1.0, 0.88, 0.55);\n  vec3 pearlHL      = vec3(1.0, 0.94, 0.75);\n\n  // Smoothly varying base color across fabric\n  float cm1 = smoothstep(-0.3, 0.4, h);\n  float cm2 = snoise(sp * 0.25 + t * 0.02 + vec2(13.0, 7.0)) * 0.5 + 0.5;\n  float cm3 = snoise(sp * 0.15 + vec2(3.0, 11.0)) * 0.5 + 0.5;\n\n  vec3 baseColor = mix(warmBurgundy, deepAmber, cm1);\n  baseColor = mix(baseColor, richGold, cm2 * 0.5);\n  baseColor = mix(baseColor, deepRose, cm3 * 0.2);\n\n  // ── Compose final color ──\n  vec3 col = baseColor * 0.15; // ambient\n\n  // Primary warm key light\n  vec3 lc1 = vec3(1.0, 0.87, 0.58);\n  col += baseColor * wd1 * 0.5 * lc1;\n  col += baseColor * sheen1 * lc1;\n  col += lightSilk * spec1 * 0.6;\n  col += pearlHL * spark * 0.5;\n\n  // Secondary cooler fill\n  vec3 lc2 = vec3(0.6, 0.5, 0.72);\n  col += baseColor * d2 * 0.18 * lc2;\n  col += baseColor * sheen2 * lc2;\n  col += vec3(0.75, 0.65, 0.85) * spec2 * 0.2;\n\n  // Fresnel edge glow\n  col += pearlHL * fresnel * 0.1;\n\n  // ── Traveling shimmer along fold ridges ──\n  float angle2 = 0.45;\n  float ca2 = cos(angle2); float sa2 = sin(angle2);\n  float foldDir = ca2 * sp.x + sa2 * sp.y;\n  float shim = sin(foldDir * 4.0 - t * 1.5) * 0.5 + 0.5;\n  shim = pow(shim, 18.0);\n  col += pearlHL * shim * (spec1 + sheen1 * 0.3) * 0.5;\n\n  // ── Fold shadows — darken valleys ──\n  float valley = smoothstep(0.05, -0.25, h);\n  col *= 1.0 - valley * 0.5;\n\n  // Deep shadow in lowest folds\n  float deepSh = smoothstep(-0.1, -0.45, h);\n  col = mix(col, vec3(0.05, 0.02, 0.025), deepSh * 0.45);\n\n  // ── Subtle iridescence ──\n  col.r += fresnel * 0.06;\n  col.b += fresnel * 0.03;\n\n  // ── Vignette ──\n  vec2 vc = uv - 0.5;\n  float vig = 1.0 - dot(vc, vc) * 1.4;\n  vig = smoothstep(0.0, 1.0, vig);\n  col *= vig;\n\n  // Tone mapping + gamma\n  col = col / (col + vec3(0.6));\n  col = pow(col, vec3(0.9));\n\n  // Floor to near-black\n  col = max(col, vec3(0.018, 0.015, 0.013));\n\n  gl_FragColor = vec4(col, 1.0);\n}", "format": "raw", "inputs": [{"name": "u_time", "type": "float", "default": 1}, {"name": "u_res", "type": "vec2", "default": [0.5, 0.5]}, {"name": "u_flowSpeed", "type": "float", "default": 0.8, "min": 0.2, "max": 2}, {"name": "u_foldDepth", "type": "float", "default": 1}, {"name": "u_mouse", "type": "vec2", "default": [-1, -1]}], "description": "Flowing silk ribbons with specular highlights and cloth-like wave animation.", "categories": ["fill", "organic"]}, {"id": "radiant-event-horizon", "name": "Event Horizon", "kind": "generator", "family": "Radiant", "license": "MIT", "sourceUrl": "https://github.com/pbakaus/radiant/blob/59e9f48c0ad9a3db2fbeb8898b4390d5a1eabb40/static/event-horizon.html", "source": "\nprecision highp float;\nuniform float u_time;\nuniform vec2 u_res;\nuniform float u_rotationSpeed;\nuniform float u_diskIntensity;\nuniform float u_starsOnly;\nuniform float u_tilt;\nuniform float u_rotate;\nuniform vec2 u_bhCenter;\nuniform float u_bhScale;\nuniform float u_chromatic;\n\n// ──── Constants ────\nconst float PI = 3.14159265359;\nconst float TAU = 6.28318530718;\nconst float RS = 1.0;        // Schwarzschild radius\nconst float ISCO = 3.0;      // Innermost stable circular orbit\nconst float DISK_IN = 2.2;   // Inner glow edge (infalling material)\nconst float DISK_OUT = 14.0;  // Outer disk edge\n\n// ──────────────────────────────────────────\n// Hash — PCG-inspired, no sin()\n// ──────────────────────────────────────────\nfloat hash(vec2 p) {\n    vec3 p3 = fract(vec3(p.xyx) * 0.1031);\n    p3 += dot(p3, p3.yzx + 33.33);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\n// ──────────────────────────────────────────\n// Gradient noise with quintic interpolation\n// ──────────────────────────────────────────\nfloat gNoise(vec2 p) {\n    vec2 i = floor(p), f = fract(p);\n    vec2 u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);\n    return mix(\n        mix(hash(i), hash(i + vec2(1, 0)), u.x),\n        mix(hash(i + vec2(0, 1)), hash(i + vec2(1, 1)), u.x),\n        u.y\n    );\n}\n\n// ──────────────────────────────────────────\n// FBM with domain rotation (reduces grid artifacts)\n// ──────────────────────────────────────────\nfloat fbm(vec2 p) {\n    float v = 0.0, a = 0.5;\n    mat2 rot = mat2(0.866, 0.5, -0.5, 0.866); // 30 deg rotation\n    for (int i = 0; i < 4; i++) {\n        v += a * gNoise(p);\n        p = rot * p * 2.03 + vec2(47.0, 13.0);\n        a *= 0.49;\n    }\n    return v;\n}\n// Lightweight 2-octave noise for subtle effects (nebula etc.)\nfloat fbmLite(vec2 p) {\n    float v = 0.5 * gNoise(p);\n    p = mat2(0.866, 0.5, -0.5, 0.866) * p * 2.03 + vec2(47.0, 13.0);\n    v += 0.25 * gNoise(p);\n    return v;\n}\n\n// ──────────────────────────────────────────\n// Star field — cell-based with spherical UV\n// ──────────────────────────────────────────\nvec3 starField(vec3 rd) {\n    float u = atan(rd.z, rd.x) / TAU + 0.5;\n    float v = asin(clamp(rd.y, -0.999, 0.999)) / PI + 0.5;\n    vec3 col = vec3(0.0);\n\n    // Bright sparse stars\n    {\n        vec2 cell = floor(vec2(u, v) * 55.0);\n        vec2 f = fract(vec2(u, v) * 55.0);\n        vec2 r = vec2(hash(cell), hash(cell + 127.1));\n        float d = length(f - r);\n        float b = pow(r.x, 10.0) * exp(-d * d * 500.0);\n        col += mix(vec3(1.0, 0.65, 0.35), vec3(0.55, 0.75, 1.0), r.y) * b * 4.0;\n    }\n    // Medium density stars\n    {\n        vec2 cell = floor(vec2(u, v) * 170.0);\n        vec2 f = fract(vec2(u, v) * 170.0);\n        vec2 r = vec2(hash(cell + 43.0), hash(cell + 91.0));\n        float d = length(f - r);\n        float b = pow(r.x, 18.0) * exp(-d * d * 1000.0);\n        col += vec3(0.85, 0.88, 1.0) * b * 2.0;\n    }\n    // Subtle nebula (lite noise — pow(3) crushes detail anyway)\n    float n = fbmLite(vec2(u, v) * 3.0) * fbmLite(vec2(u, v) * 5.5 + 10.0);\n    col += vec3(0.10, 0.04, 0.14) * pow(n, 3.0);\n\n    return col;\n}\n\n// ──────────────────────────────────────────\n// Blackbody color (physically motivated)\n// ──────────────────────────────────────────\nvec3 bbColor(float t) {\n    t = clamp(t, 0.0, 2.5);\n    vec3 lo = vec3(1.0, 0.18, 0.0);    // deep red     (~1500K)\n    vec3 mi = vec3(1.0, 0.55, 0.12);   // orange       (~3500K)\n    vec3 hi = vec3(1.0, 0.93, 0.82);   // warm white   (~8000K)\n    vec3 hot = vec3(0.65, 0.82, 1.0);  // cool blue-wh (~15000K)\n    vec3 c = mix(lo, mi, smoothstep(0.0, 0.3, t));\n    c = mix(c, hi, smoothstep(0.3, 0.8, t));\n    return mix(c, hot, smoothstep(0.8, 1.8, t));\n}\n\n// ──────────────────────────────────────────\n// Accretion disk shading\n//   Novikov-Thorne temperature profile\n//   FBM turbulence + spiral arms\n//   Doppler beaming + gravitational redshift\n// ──────────────────────────────────────────\nvec4 shadeDisk(vec3 hit, vec3 vel, float time) {\n    float r = length(hit.xz);\n    if (r < DISK_IN * 0.5 || r > DISK_OUT * 1.05) return vec4(0.0);\n\n    // Novikov-Thorne: T proportional to r^-3/4 (1 - sqrt(r_isco/r))^1/4\n    float xr = ISCO / r;\n    float tProfile = pow(ISCO / r, 0.75) * pow(max(0.001, 1.0 - sqrt(xr)), 0.25);\n\n    // Gravitational redshift: observed temp = emitted * sqrt(1 - RS/r)\n    float gRedshift = sqrt(max(0.01, 1.0 - RS / r));\n    tProfile *= gRedshift;\n\n    // Disk texture with Keplerian differential rotation\n    float phi = atan(hit.z, hit.x);\n    float lr = log2(max(r, 0.1));\n\n    // Keplerian angular velocity with a floor so outer disk still moves\n    float keplerOmega = sqrt(0.5 * RS / (r * r * r));\n    float baseOmega = 0.04; // minimum rotation for outer rings\n    float omega = max(keplerOmega, baseOmega) * 10.0;\n    float rotAngle = time * omega;\n    float ca = cos(rotAngle), sa = sin(rotAngle);\n    vec2 rotXZ = vec2(hit.x * ca - hit.z * sa, hit.x * sa + hit.z * ca);\n\n    // FBM turbulence — the primary texture, gives cloudy organic feel\n    // Sampled at Keplerian-rotated coords for orbital flow\n    float turb = fbm(rotXZ * 1.2 + vec2(lr * 3.0));\n    turb = 0.25 + 0.75 * turb;\n\n    // Time-evolving detail layer — single noise call (subtle contribution)\n    float timeShift = time * 0.15;\n    float detail = gNoise(rotXZ * 3.5 + vec2(100.0 + timeShift, timeShift * 0.7));\n    turb *= 0.7 + 0.3 * detail;\n\n    // Concentric ring modulation — visible structure within the clouds\n    float ringPhase1 = sin(r * 10.0 + rotAngle * r * 0.3) * 0.5 + 0.5;\n    float ringPhase2 = sin(r * 20.0 - rotAngle * r * 0.15) * 0.5 + 0.5;\n    float rings = ringPhase1 * 0.55 + ringPhase2 * 0.45;\n    rings = 0.5 + 0.5 * rings;\n    turb *= rings;\n\n    // Doppler beaming from Keplerian orbital motion\n    // Reduced from 3.0 to 2.0 so the receding side stays visible\n    float orbSpeed = sqrt(0.5 * RS / max(r, DISK_IN));\n    vec3 orbDir = normalize(vec3(-hit.z, 0.0, hit.x));\n    float dopplerFactor = 1.0 + 2.0 * dot(normalize(vel), orbDir) * orbSpeed;\n    dopplerFactor = max(0.15, dopplerFactor);\n    float dopplerBoost = dopplerFactor * dopplerFactor * dopplerFactor;\n\n    // Intensity\n    float I = tProfile * turb * 6.0;\n\n    // Edge fades\n    float innerFade = smoothstep(DISK_IN * 0.7, DISK_IN * 1.2, r);\n    // ISCO fade — emission ramps up beyond ISCO\n    float iscoFade = 0.35 + 0.65 * smoothstep(ISCO * 0.85, ISCO * 1.2, r);\n    float outerFade = 1.0 - smoothstep(DISK_OUT * 0.55, DISK_OUT, r);\n    I *= innerFade * iscoFade * outerFade;\n\n    // Color: temperature + Doppler frequency shift\n    // Approaching side: blue-shifted (higher temp), receding: red-shifted (lower temp)\n    float colorTemp = tProfile * pow(dopplerFactor, 1.8) * 1.2;\n    vec3 col = bbColor(colorTemp) * I * dopplerBoost;\n\n    // Chromatic dispersion: each ring band gets a spectral hue\n    if (u_chromatic > 0.01) {\n        // Smooth spectral mapping based on radius\n        // Uses the actual ring structure phase for band-coherent coloring\n        float spectralR = (r - DISK_IN) / (DISK_OUT - DISK_IN);\n        float ringP = ringPhase1; // from the ring structure above\n\n        // Combine radial position and ring phase for spectral position\n        // This ensures each bright ring band has its own distinct hue\n        float hue = spectralR * 0.8 + ringP * 0.4;\n\n        // Full visible spectrum: red → orange → yellow → green → cyan → blue\n        vec3 spectrum;\n        // Red channel: strong at low hue, returns at high hue (wraps around)\n        spectrum.r = (1.0 - smoothstep(0.0, 0.35, hue))  // red at start\n                   + smoothstep(0.25, 0.45, hue) * (1.0 - smoothstep(0.55, 0.7, hue)) * 0.7  // orange/yellow\n                   + smoothstep(0.85, 1.1, hue) * 0.4; // faint return\n        // Green channel: broad peak in the middle (yellow → green → cyan)\n        spectrum.g = smoothstep(0.15, 0.4, hue) * (1.0 - smoothstep(0.7, 0.95, hue));\n        // Blue channel: peaks at high hue (cyan → blue)\n        spectrum.b = smoothstep(0.5, 0.8, hue)\n                   + smoothstep(0.85, 1.1, hue) * 0.3; // violet hint\n        spectrum = max(spectrum, 0.05);\n\n        // Preserve luminance from the original color\n        float luma = dot(col, vec3(0.3, 0.5, 0.2));\n        vec3 chromaCol = spectrum * luma * 2.0;\n\n        col = mix(col, chromaCol, u_chromatic * 0.75);\n    }\n\n    float alpha = clamp(I * 1.3, 0.0, 0.96);\n    return vec4(col, alpha);\n}\n\n// ──────────────────────────────────────────\n// Main — Schwarzschild geodesic ray tracer\n// Uses velocity-Verlet integration of:\n//   d²x/dλ² = -1.5 · RS · L² / r⁵ · x\n// where L² = |x × v|² is the conserved angular momentum\n// ──────────────────────────────────────────\nvoid main() {\n    vec2 fc = gl_FragCoord.xy;\n    vec2 ctr = (u_bhScale > 0.0 ? u_bhCenter : vec2(0.5)) * u_res;\n    float sc = u_bhScale > 0.0 ? u_bhScale : 1.0;\n    vec2 uv = (fc - ctr) * sc / u_res.x;\n\n    // Orbital camera\n    float camR = 28.0;\n    float orbit = u_time * 0.055 * u_rotationSpeed;\n    float tilt = 0.25 + u_tilt;\n\n    vec3 eye = vec3(\n        camR * cos(orbit) * cos(tilt),\n        camR * sin(tilt),\n        camR * sin(orbit) * cos(tilt)\n    );\n\n    // Look-at basis\n    vec3 fwd = normalize(-eye);\n    vec3 rt = normalize(cross(fwd, vec3(0.0, 1.0, 0.0)));\n    vec3 up = cross(rt, fwd);\n\n    // Roll rotation\n    float cr = cos(u_rotate), sr = sin(u_rotate);\n    vec3 rr = cr * rt + sr * up;\n    vec3 ru = -sr * rt + cr * up;\n\n    vec3 rd = normalize(fwd + uv.x * rr + uv.y * ru);\n\n    // Stars-only bypass\n    if (u_starsOnly > 0.5) {\n        vec3 s = starField(rd);\n        gl_FragColor = vec4(pow(s, vec3(0.45)), 1.0);\n        return;\n    }\n\n    // ──── Geodesic integration ────\n    vec3 pos = eye;\n    vec3 vel = rd;\n\n    // Angular momentum (conserved along Schwarzschild geodesic)\n    vec3 Lvec = cross(pos, vel);\n    float L2 = dot(Lvec, Lvec);\n\n    vec4 diskAccum = vec4(0.0);\n    vec3 glow = vec3(0.0);\n    bool absorbed = false;\n    int diskCrossings = 0;\n    float minR = 1000.0; // track closest approach for photon ring\n\n    // Pre-compute loop invariant\n    float gravCoeff = -1.5 * RS * L2;\n\n    for (int i = 0; i < 200; i++) {\n        float r = length(pos);\n\n        // Adaptive step: fine near BH, coarse far away\n        float h = 0.16 * clamp(r - 0.4 * RS, 0.06, 3.5);\n\n        // Schwarzschild geodesic: a = -1.5·RS·L²/r⁵ · x\n        float invR2 = 1.0 / (r * r);\n        float invR5 = invR2 * invR2 / r;\n        vec3 acc = (gravCoeff * invR5) * pos;\n\n        // Velocity-Verlet integration (symplectic, energy-preserving)\n        vec3 p1 = pos + vel * h + 0.5 * acc * h * h;\n        float r1 = length(p1);\n        float invR12 = 1.0 / (r1 * r1);\n        float invR15 = invR12 * invR12 / r1;\n        vec3 acc1 = (gravCoeff * invR15) * p1;\n        vec3 v1 = vel + 0.5 * (acc + acc1) * h;\n\n        // Track closest approach\n        minR = min(minR, r1);\n\n        // ── Disk crossing detection (y=0 plane) ──\n        if (pos.y * p1.y < 0.0 && diskAccum.a < 0.97) {\n            float t = pos.y / (pos.y - p1.y);\n            vec3 hit = mix(pos, p1, t);\n            vec4 dc = shadeDisk(hit, vel, u_time * u_rotationSpeed);\n            dc.rgb *= u_diskIntensity;\n            // 1st & 2nd crossings: full (primary disk + secondary image)\n            // 3rd+ crossings: heavily attenuated (these create the crispy 1px photon ring)\n            if (diskCrossings >= 2) {\n                dc.rgb *= 0.15;\n                dc.a *= 0.15;\n            }\n            // Alpha-over compositing\n            diskAccum.rgb += dc.rgb * dc.a * (1.0 - diskAccum.a);\n            diskAccum.a += dc.a * (1.0 - diskAccum.a);\n            // Bloom spillover: bright disk regions bleed glow\n            float diskBright = dot(dc.rgb, vec3(0.3, 0.5, 0.2)) * dc.a;\n            glow += dc.rgb * 0.04 * max(diskBright - 0.3, 0.0);\n            diskCrossings++;\n        }\n\n        // ── Glow calculations only when close to BH (negligible contribution beyond r=6) ──\n        if (r1 < 6.0) {\n            // Soft ambient glow near BH (very diffuse, no sharp peak)\n            float pDist = abs(r1 - 1.5 * RS);\n            float psGlow = 1.0 / (1.0 + pDist * pDist * 20.0) * h * 0.001 / max(r1 * r1, 0.2);\n            glow += vec3(0.8, 0.6, 0.35) * psGlow;\n\n            // Event horizon proximity glow\n            float hzGlow = exp(-(r1 - RS) * 3.5) * h * 0.003;\n            glow += vec3(0.5, 0.25, 0.08) * max(hzGlow, 0.0);\n        }\n\n        // ── Termination ──\n        if (r1 < RS * 0.35) { absorbed = true; break; }\n        // Early escape: ray moving outward past disk range, deflection negligible\n        if (r1 > 25.0 && r1 > r) break;\n        if (r1 > 55.0) break;\n\n        pos = p1;\n        vel = v1;\n    }\n\n    // ──── Final compositing ────\n    vec3 col = vec3(0.0);\n    if (!absorbed) {\n        col = starField(normalize(vel));\n    }\n    // Disk over background\n    col = col * (1.0 - diskAccum.a) + diskAccum.rgb;\n\n    // ── Shadow-edge chromatic fringe ──\n    // Replaces the old sharp 1px ring with smooth, wide RGB separation\n    float ringDist = abs(minR - 1.5 * RS);\n    float chromo = u_chromatic;\n\n    // Soft wide chromatic bands: red/orange outside, blue inside\n    // No center \"white ring\" — purely spectral separation\n    float baseChroma = 0.1 + 0.5 * chromo;\n    float spread = 0.08 + 0.18 * chromo;\n    float falloff = 20.0 + 15.0 * (1.0 - chromo); // wider/softer bands\n    float rRing = exp(-(ringDist + spread) * (ringDist + spread) * falloff);\n    float bRing = exp(-(ringDist - spread) * (ringDist - spread) * falloff);\n    col.r += rRing * 0.3 * baseChroma;\n    col.b += bRing * 0.35 * baseChroma;\n\n    // Glow additive\n    col += glow;\n\n    // Filmic tone mapping (ACES-inspired) + contrast\n    col *= 1.4;\n    vec3 a = col * (col + 0.0245786) - 0.000090537;\n    vec3 b = col * (0.983729 * col + 0.4329510) + 0.238081;\n    col = a / b;\n\n    col = smoothstep(0.0, 1.0, col);\n    col = pow(max(col, 0.0), vec3(0.92));\n\n    gl_FragColor = vec4(clamp(col, 0.0, 1.0), 1.0);\n}\n", "format": "raw", "inputs": [{"name": "u_time", "type": "float", "default": 1}, {"name": "u_res", "type": "vec2", "default": [0.5, 0.5]}, {"name": "u_rotationSpeed", "type": "float", "default": 0.3, "min": 0.05, "max": 1}, {"name": "u_diskIntensity", "type": "float", "default": 1, "min": 0.3, "max": 2}, {"name": "u_starsOnly", "type": "float", "default": 0}, {"name": "u_tilt", "type": "float", "default": 0, "min": -1.5, "max": 1.5}, {"name": "u_rotate", "type": "float", "default": 0, "min": -3.14, "max": 3.14}, {"name": "u_bhCenter", "type": "vec2", "default": [0, 0]}, {"name": "u_bhScale", "type": "float", "default": 0}, {"name": "u_chromatic", "type": "float", "default": 0, "min": 0, "max": 1}], "description": "Physics-based black hole with raytraced gravitational lensing, volumetric accretion disk, and Doppler beaming.", "categories": ["object", "physics"]}, {"id": "radiant-vertigo", "name": "Vertigo", "kind": "generator", "family": "Radiant", "license": "MIT", "sourceUrl": "https://github.com/pbakaus/radiant/blob/59e9f48c0ad9a3db2fbeb8898b4390d5a1eabb40/static/vertigo.html", "source": "precision highp float;\nuniform float u_time;\nuniform vec2 u_res;\nuniform float u_tunnelSpeed;\nuniform float u_spiralIntensity;\nuniform vec2 u_mouse;\n\n#define PI 3.14159265359\n#define TAU 6.28318530718\n\n// ── Hash for noise ──\nfloat hash(vec2 p) {\n  return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);\n}\n\n// ── Value noise ──\nfloat vnoise(vec2 p) {\n  vec2 i = floor(p);\n  vec2 f = fract(p);\n  f = f * f * (3.0 - 2.0 * f);\n  float a = hash(i);\n  float b = hash(i + vec2(1.0, 0.0));\n  float c = hash(i + vec2(0.0, 1.0));\n  float d = hash(i + vec2(1.0, 1.0));\n  return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);\n}\n\nvoid main() {\n  vec2 uv = gl_FragCoord.xy / u_res;\n  float aspect = u_res.x / u_res.y;\n\n  // Center UV, correct aspect\n  vec2 p = (uv - 0.5) * vec2(aspect, 1.0);\n\n  float t = u_time;\n  float scrollSpeed = u_tunnelSpeed;\n\n  // ── Polar coordinates ──\n  float r = length(p);\n  float theta = atan(p.y, p.x);\n\n  // ── Steady tunnel depth — NO dolly-zoom, fixed FOV ──\n  float depth = 1.0 / (r + 0.04);\n\n  // ── Rotation: auto drift + mouse drag offset ──\n  float rotAngle = t * 0.02 + sin(t * 0.07) * 0.15 + u_mouse.x;\n  float thetaRot = theta + rotAngle;\n\n  // ── Tunnel texture coordinates ──\n  // u = angle (wrapping), v = depth (scrolling forward steadily)\n  float tu = thetaRot / TAU;\n  float tv = depth - t * scrollSpeed;\n\n  // ── Ring segments ──\n  float ringFreq = 10.0;\n  float ringCoord = tv * ringFreq / TAU;\n  float ringPhase = fract(ringCoord);\n  float ringId = floor(ringCoord);\n\n  // Primary rings — clean sharp edges\n  float ring = smoothstep(0.0, 0.06, ringPhase) * smoothstep(0.5, 0.44, ringPhase);\n\n  // Secondary thinner accent rings between primaries\n  float ringPhase2 = fract(ringCoord * 2.0);\n  float ring2 = smoothstep(0.0, 0.03, ringPhase2) * smoothstep(0.5, 0.47, ringPhase2);\n\n  // ── Angular segments (line divisions around the tunnel) ──\n  float angSegments = 16.0;\n  float angPhase = fract(tu * angSegments);\n  float angLine = smoothstep(0.0, 0.025, angPhase) * smoothstep(1.0, 0.975, angPhase);\n\n  // ── Combine into tunnel structure ──\n  float structure = ring * angLine;\n  // Add thin rings as subtle accent\n  structure = max(structure, ring2 * 0.25 * angLine);\n\n  // ── Wave-based ring illumination ──\n  // Multiple slow waves propagating outward at different speeds\n  // Wave 1: primary outward pulse\n  float wave1 = sin(ringId * 0.5 - t * 0.8) * 0.5 + 0.5;\n  wave1 = pow(wave1, 3.0);\n\n  // Wave 2: slower, wider inward pulse (counter-direction)\n  float wave2 = sin(ringId * 0.3 + t * 0.5) * 0.5 + 0.5;\n  wave2 = pow(wave2, 4.0);\n\n  // Wave 3: very slow breathing that lights groups of rings\n  float wave3 = sin(ringId * 0.15 - t * 0.35) * 0.5 + 0.5;\n  wave3 = pow(wave3, 2.0);\n\n  // Compose ring brightness from overlapping waves\n  float ringBrightness = 0.15 + wave1 * 0.5 + wave2 * 0.35 + wave3 * 0.25;\n  ringBrightness = clamp(ringBrightness, 0.0, 1.5);\n\n  // Occasional bright flash on specific rings (sparse)\n  float flash = pow(max(0.0, sin(ringId * 7.3 - t * 1.2)), 12.0);\n  ringBrightness += flash * 0.8;\n\n  structure *= ringBrightness;\n\n  // ── Depth fog: fade rings into void at distance ──\n  float depthFade = exp(-r * 3.0);\n  // Near the center (deep void), fade to black\n  float voidFade = smoothstep(0.0, 0.12, r);\n  structure *= depthFade * voidFade;\n\n  // ── Neon edge highlights on ring edges ──\n  float edgeHighlight = smoothstep(0.06, 0.02, abs(ringPhase - 0.01));\n  edgeHighlight += smoothstep(0.06, 0.02, abs(ringPhase - 0.48));\n  edgeHighlight *= angLine * depthFade * voidFade;\n\n  // ── Color scheme — richer palette ──\n  // Deep crimson base\n  vec3 crimson = vec3(0.80, 0.067, 0.20);\n  // Dark purple\n  vec3 darkPurple = vec3(0.133, 0.0, 0.20);\n  // Neon red accent\n  vec3 neonRed = vec3(1.0, 0.133, 0.267);\n  // Warm amber highlight\n  vec3 amber = vec3(0.784, 0.584, 0.424);\n  // Deep magenta for variety\n  vec3 magenta = vec3(0.6, 0.05, 0.35);\n  // Burnt orange for warm accents\n  vec3 burntOrange = vec3(0.85, 0.35, 0.1);\n\n  // ── Per-ring color variation ──\n  // Each ring gets a slightly different hue based on its ID\n  float colorSel = fract(ringId * 0.618033); // golden ratio spacing\n  float colorShift = sin(ringId * 1.7 + t * 0.2) * 0.5 + 0.5;\n\n  // Base tunnel color blends crimson and purple by radius\n  float colorDepth = smoothstep(0.0, 0.5, r);\n  vec3 tunnelColor = mix(darkPurple, crimson, colorDepth);\n\n  // Vary individual ring colors\n  tunnelColor = mix(tunnelColor, magenta, colorSel * 0.3);\n  tunnelColor = mix(tunnelColor, crimson * 1.3, colorShift * 0.25);\n\n  // Amber tint on wave-lit rings\n  float amberAmount = wave1 * wave3;\n  tunnelColor = mix(tunnelColor, amber * 0.8, amberAmount * 0.3);\n\n  // Burnt orange on flash rings\n  tunnelColor = mix(tunnelColor, burntOrange, flash * 0.5);\n\n  // ── Edge highlight color varies too ──\n  vec3 edgeColor = mix(neonRed, amber, wave2 * 0.4);\n  edgeColor = mix(edgeColor, magenta * 1.5, flash * 0.3);\n\n  // ── Composite ──\n  vec3 col = vec3(0.0);\n\n  // Base tunnel structure\n  col += tunnelColor * structure;\n\n  // Edge highlights with varied color\n  col += edgeColor * edgeHighlight * 0.5;\n\n  // Amber glow on bright pulsing rings\n  col += amber * wave1 * structure * 0.3;\n\n  // Flash rings get a bright white-amber spike\n  col += mix(amber, vec3(1.0, 0.9, 0.7), 0.5) * flash * structure * 0.5;\n\n  // ── Subtle ambient glow from the tunnel void ──\n  float ambientGlow = exp(-r * 5.0) * (1.0 - smoothstep(0.0, 0.08, r));\n  col += darkPurple * ambientGlow * 0.08;\n\n  // ── Very faint atmospheric haze deeper in tunnel ──\n  float haze = exp(-r * 6.0) * 0.02;\n  col += mix(darkPurple, crimson * 0.5, 0.3) * haze;\n\n  // ── Vignette ──\n  float vig = 1.0 - smoothstep(0.3, 1.1, r);\n  col *= 0.55 + 0.45 * vig;\n\n  // ── Film grain ──\n  float grain = (fract(sin(dot(gl_FragCoord.xy, vec2(12.9898, 78.233)) + fract(u_time * 0.1) * 100.0) * 43758.5453) - 0.5) * 0.02;\n  col += grain;\n\n  gl_FragColor = vec4(clamp(col, 0.0, 1.0), 1.0);\n}", "format": "raw", "inputs": [{"name": "u_time", "type": "float", "default": 1}, {"name": "u_res", "type": "vec2", "default": [0.5, 0.5]}, {"name": "u_tunnelSpeed", "type": "float", "default": 0.15, "min": 0.1, "max": 1.5}, {"name": "u_spiralIntensity", "type": "float", "default": 0, "min": 0.3, "max": 2}, {"name": "u_mouse", "type": "vec2", "default": [0, 0]}], "description": "Slow hypnotic tunnel with crimson ring segments, wave-based illumination, and dark void center.", "categories": ["fill", "geometric"]}, {"id": "radiant-silk-cascade", "name": "Silk Cascade", "kind": "generator", "family": "Radiant", "license": "MIT", "sourceUrl": "https://github.com/pbakaus/radiant/blob/59e9f48c0ad9a3db2fbeb8898b4390d5a1eabb40/static/silk-cascade.html", "source": "precision highp float;\nuniform float u_time;\nuniform vec2 u_res;\nuniform float u_flowSpeed;\nuniform float u_sheenIntensity;\nuniform vec2 u_mouse;\n\n#define PI 3.14159265359\n\nfloat hash12(vec2 p){\n  vec3 p3=fract(vec3(p.xyx)*0.1031);\n  p3+=dot(p3,p3.yzx+33.33);\n  return fract((p3.x+p3.y)*p3.z);\n}\n\nfloat vnoise(vec2 p){\n  vec2 i=floor(p);\n  vec2 f=fract(p);\n  f=f*f*(3.0-2.0*f);\n  float a=hash12(i);\n  float b=hash12(i+vec2(1.0,0.0));\n  float c=hash12(i+vec2(0.0,1.0));\n  float d=hash12(i+vec2(1.0,1.0));\n  return mix(mix(a,b,f.x),mix(c,d,f.x),f.y);\n}\n\nfloat fbm3(vec2 p){\n  float v=0.0, a=0.5;\n  mat2 rot=mat2(0.8,-0.6,0.6,0.8);\n  for(int i=0;i<3;i++){\n    v+=a*vnoise(p);\n    p=rot*p*2.0;\n    a*=0.5;\n  }\n  return v;\n}\n\n// 2-octave fbm for back layers (cheaper)\nfloat fbm2(vec2 p){\n  float v=0.5*vnoise(p);\n  p=mat2(0.8,-0.6,0.6,0.8)*p*2.0;\n  v+=0.25*vnoise(p);\n  return v;\n}\n\nvec2 domainWarp(vec2 p, float t, float scale, float seed){\n  return vec2(\n    fbm3(p*scale+vec2(1.7+seed,9.2)+t*0.15),\n    fbm3(p*scale+vec2(8.3,2.8+seed)-t*0.12)\n  );\n}\n\n// Cheaper warp for back layers\nvec2 domainWarpLite(vec2 p, float t, float scale, float seed){\n  return vec2(\n    fbm2(p*scale+vec2(1.7+seed,9.2)+t*0.15),\n    fbm2(p*scale+vec2(8.3,2.8+seed)-t*0.12)\n  );\n}\n\n// Per-layer fold: returns vec3(height, gradient.xy)\nvec3 fabricFold(vec2 p, float t, float seed, float freq, float flow){\n  float ts=t*flow;\n  vec2 warp=domainWarp(p+seed*3.7, ts, 1.2, seed);\n  vec2 wp=p+warp*0.55;\n  float h=0.0; vec2 g=vec2(0.0);\n\n  float f1x=freq*0.7, f1y=freq*0.4;\n  float ph1=wp.x*f1x+wp.y*f1y+ts*0.3+seed*2.1;\n  h+=sin(ph1)*0.35; g+=cos(ph1)*0.35*vec2(f1x,f1y);\n\n  float f2x=-freq*0.3, f2y=freq*0.9;\n  float ph2=wp.x*f2x+wp.y*f2y+ts*0.25+seed*1.3;\n  h+=sin(ph2)*0.25; g+=cos(ph2)*0.25*vec2(f2x,f2y);\n\n  float f3=freq*0.6;\n  float ph3=(wp.x+wp.y)*f3+ts*0.2+seed*4.5;\n  h+=sin(ph3)*0.18; g+=cos(ph3)*0.18*vec2(f3,f3);\n\n  float f4x=freq*1.8, f4y=freq*1.2;\n  float ph4=wp.x*f4x+wp.y*f4y-ts*0.35+seed*0.7;\n  h+=sin(ph4)*0.08; g+=cos(ph4)*0.08*vec2(f4x,f4y);\n\n  h+=vnoise(wp*freq*0.9+seed*10.0+ts*0.04)*0.12-0.06;\n  return vec3(h, g);\n}\n\n// Lighter fold for back layers (no 5th wave, no vnoise detail, cheaper warp)\nvec3 fabricFoldLite(vec2 p, float t, float seed, float freq, float flow){\n  float ts=t*flow;\n  vec2 warp=domainWarpLite(p+seed*3.7, ts, 1.2, seed);\n  vec2 wp=p+warp*0.55;\n  float h=0.0; vec2 g=vec2(0.0);\n  float f1x=freq*0.7, f1y=freq*0.4;\n  float ph1=wp.x*f1x+wp.y*f1y+ts*0.3+seed*2.1;\n  h+=sin(ph1)*0.35; g+=cos(ph1)*0.35*vec2(f1x,f1y);\n  float f2x=-freq*0.3, f2y=freq*0.9;\n  float ph2=wp.x*f2x+wp.y*f2y+ts*0.25+seed*1.3;\n  h+=sin(ph2)*0.25; g+=cos(ph2)*0.25*vec2(f2x,f2y);\n  float f3=freq*0.6;\n  float ph3=(wp.x+wp.y)*f3+ts*0.2+seed*4.5;\n  h+=sin(ph3)*0.18; g+=cos(ph3)*0.18*vec2(f3,f3);\n  float f4x=freq*1.8, f4y=freq*1.2;\n  float ph4=wp.x*f4x+wp.y*f4y-ts*0.35+seed*0.7;\n  h+=sin(ph4)*0.08; g+=cos(ph4)*0.08*vec2(f4x,f4y);\n  return vec3(h, g);\n}\n\n// Kajiya-Kay anisotropic specular\nfloat kajiyaSpec(vec2 grad, vec3 L, vec3 V, float shine){\n  float gl2=dot(grad,grad);\n  if(gl2<0.0001) return 0.0;\n  vec2 tg=vec2(-grad.y, grad.x)/sqrt(gl2);\n  vec3 T=normalize(vec3(tg, 0.0));\n  vec3 H=normalize(L+V);\n  float TdH=dot(T,H);\n  return pow(sqrt(max(1.0-TdH*TdH, 0.0)), shine);\n}\n\n// Shade one fabric layer\nvec4 shadeLayer(\n  vec2 p, float t,\n  float seed, float freq, float flow,\n  vec3 darkCol, vec3 midCol, vec3 brightCol, vec3 specCol,\n  float opacity, float shine,\n  vec3 L1, vec3 L2, vec3 V,\n  float sheenMul\n){\n  vec3 fold=opacity<0.35 ? fabricFoldLite(p, t, seed, freq, flow) : fabricFold(p, t, seed, freq, flow);\n  float h=fold.x;\n  vec2 grad=fold.yz;\n  vec3 N=normalize(vec3(-grad*1.8, 1.0));\n\n  // Lighting — strong directional contrast\n  float NdL1=max(dot(N, L1), 0.0);\n  float NdL2=max(dot(N, L2), 0.0);\n  float lit=NdL1*0.75+NdL2*0.12;\n\n  // Fold depth\n  float depth=smoothstep(-0.8, 0.4, h);\n\n  // Three-tone fabric shading: dark valleys -> mid -> bright lit peaks\n  float shade=lit*depth;\n  float midBlend=smoothstep(0.0, 0.35, shade);\n  float brightBlend=smoothstep(0.25, 0.7, shade);\n  vec3 fabric=mix(darkCol, midCol, midBlend);\n  fabric=mix(fabric, brightCol, brightBlend*0.5);\n\n  // Anisotropic specular streaks — sharp silk sheen\n  float sp=kajiyaSpec(grad, L1, V, shine)*0.9;\n  sp+=kajiyaSpec(grad, L2, V, shine*0.6)*0.15;\n  sp*=sheenMul;\n  float specPow=sp*sp*sp;\n  fabric+=specCol*specPow*0.9;\n\n  // Translucent backlight at peaks\n  float trans=smoothstep(0.3, 0.9, depth)*lit*0.08;\n  fabric+=vec3(0.45, 0.28, 0.15)*trans;\n\n  // Sparkle — extremely rare, only where specular is strong\n  float sparkle=hash12(floor(p*500.0+t*0.7));\n  sparkle=step(0.9992, sparkle)*specPow*20.0*sheenMul;\n  fabric+=specCol*min(sparkle, 2.0);\n\n  // Alpha: opaque in valleys, can thin at bright peaks\n  float alpha=opacity*(0.65+depth*0.35);\n  return vec4(fabric, alpha);\n}\n\nvoid main(){\n  vec2 uv=gl_FragCoord.xy/u_res;\n  float aspect=u_res.x/u_res.y;\n  vec2 p=(uv-0.5)*vec2(aspect, 1.0);\n\n\n  float t=u_time*u_flowSpeed;\n\n  // Primary light — follows cursor for shimmering highlights\n  vec3 L1=normalize(vec3(\n    0.4+sin(t*0.07)*0.3,\n    0.9+cos(t*0.09)*0.15,\n    0.8\n  ));\n  if (u_mouse.x > 0.0) {\n    vec2 mUV = u_mouse / u_res - 0.5;\n    L1 = normalize(vec3(mUV.x * 2.0, mUV.y * 2.0 + 0.5, 0.8));\n  }\n  vec3 L2=normalize(vec3(\n    -0.7+cos(t*0.06)*0.2,\n    -0.3+sin(t*0.08)*0.15,\n    0.6\n  ));\n  vec3 V=vec3(0.0, 0.0, 1.0);\n\n  // Background — deep dark with purple tint\n  float bgD=length(p);\n  vec3 bg=mix(\n    vec3(0.055, 0.03, 0.075),\n    vec3(0.012, 0.006, 0.02),\n    smoothstep(0.0, 1.0, bgD)\n  );\n  bg+=vec3(0.025, 0.012, 0.035)*exp(-bgD*bgD*2.0);\n\n  // Layer 1: Deep — warm gold/champagne (slowest, most transparent)\n  vec4 ly1=shadeLayer(\n    p*0.8+vec2(0.15, t*0.015), t,\n    0.0, 2.0, 0.5,\n    vec3(0.10, 0.06, 0.02),\n    vec3(0.50, 0.38, 0.15),\n    vec3(0.80, 0.65, 0.32),\n    vec3(1.0, 0.92, 0.65),\n    0.30, 26.0,\n    L1, L2, V,\n    u_sheenIntensity*0.7\n  );\n\n  // Layer 2: Middle — rose pink\n  vec4 ly2=shadeLayer(\n    p*1.0+vec2(t*0.012, -0.1), t,\n    1.0, 3.2, 0.75,\n    vec3(0.08, 0.03, 0.04),\n    vec3(0.42, 0.18, 0.22),\n    vec3(0.72, 0.38, 0.42),\n    vec3(1.0, 0.82, 0.86),\n    0.38, 40.0,\n    L1, L2, V,\n    u_sheenIntensity*0.9\n  );\n\n  // Layer 3: Front — soft lavender (fastest, most opaque)\n  vec4 ly3=shadeLayer(\n    p*1.2+vec2(-t*0.008, t*0.02), t,\n    2.0, 4.5, 1.0,\n    vec3(0.06, 0.04, 0.10),\n    vec3(0.30, 0.22, 0.45),\n    vec3(0.58, 0.48, 0.72),\n    vec3(1.0, 0.90, 0.97),\n    0.50, 55.0,\n    L1, L2, V,\n    u_sheenIntensity\n  );\n\n  // Composite back-to-front\n  vec3 col=bg;\n  col=mix(col, ly1.rgb, ly1.a);\n  col+=vec3(0.35, 0.18, 0.08)*ly1.a*ly2.a*0.08;\n  col=mix(col, ly2.rgb, ly2.a);\n  col+=vec3(0.30, 0.15, 0.25)*ly2.a*ly3.a*0.06;\n  col+=vec3(0.40, 0.25, 0.12)*ly1.a*ly2.a*ly3.a*0.04;\n  col=mix(col, ly3.rgb, ly3.a);\n\n  // Subtle backlight glow\n  float cov=(ly1.a+ly2.a+ly3.a)*0.333;\n  col+=vec3(0.35, 0.20, 0.12)*cov*0.04;\n\n  // Vignette\n  float vig=1.0-smoothstep(0.25, 1.15, length(p*vec2(0.85,1.0)));\n  col*=0.6+0.4*vig;\n\n  // Saturation boost\n  float lum=dot(col, vec3(0.299, 0.587, 0.114));\n  col=mix(vec3(lum), col, 1.35);\n\n  // Tone mapping (ACES)\n  col=col*(2.51*col+0.03)/(col*(2.43*col+0.59)+0.14);\n\n  // Gamma\n  col=pow(max(col,0.0), vec3(0.4545));\n\n  // Film grain\n  float grain=hash12(gl_FragCoord.xy+fract(u_time*7.13)*100.0);\n  col+=(grain-0.5)*0.015;\n\n  gl_FragColor=vec4(clamp(col,0.0,1.0), 1.0);\n}", "format": "raw", "inputs": [{"name": "u_time", "type": "float", "default": 1}, {"name": "u_res", "type": "vec2", "default": [0.5, 0.5]}, {"name": "u_flowSpeed", "type": "float", "default": 0.4, "min": 0.1, "max": 1.5}, {"name": "u_sheenIntensity", "type": "float", "default": 1, "min": 0.3, "max": 2}, {"name": "u_mouse", "type": "vec2", "default": [-1, -1]}], "description": "Flowing layered silk fabric with anisotropic specular highlights, parallax depth, and warm translucent overlap.", "categories": ["fill", "organic", "noise"]}, {"id": "radiant-smolder", "name": "Smolder", "kind": "generator", "family": "Radiant", "license": "MIT", "sourceUrl": "https://github.com/pbakaus/radiant/blob/59e9f48c0ad9a3db2fbeb8898b4390d5a1eabb40/static/smolder.html", "source": "precision highp float;\nuniform float u_time;\nuniform vec2 u_res;\nuniform float u_heat;\nuniform float u_turbulence;\nuniform vec2 u_center;\nuniform float u_scale;\nuniform vec2 u_mouse;\n\n#define PI 3.14159265359\n#define TAU 6.28318530718\n\n// ── Hash functions ──\nfloat hash(vec2 p) {\n  vec3 p3 = fract(vec3(p.xyx) * 0.1031);\n  p3 += dot(p3, p3.yzx + 33.33);\n  return fract((p3.x + p3.y) * p3.z);\n}\n\nvec2 hash2(vec2 p) {\n  vec3 p3 = fract(vec3(p.xyx) * vec3(0.1031, 0.1030, 0.0973));\n  p3 += dot(p3, p3.yzx + 33.33);\n  return fract((p3.xx + p3.yz) * p3.zy);\n}\n\n// ── Smooth value noise ──\nfloat vnoise(vec2 p) {\n  vec2 i = floor(p);\n  vec2 f = fract(p);\n  f = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);\n  return mix(\n    mix(hash(i), hash(i + vec2(1.0, 0.0)), f.x),\n    mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), f.x),\n    f.y\n  );\n}\n\n// ── Gradient noise (returns value + analytical derivatives) ──\nvec3 noised(vec2 p) {\n  vec2 i = floor(p);\n  vec2 f = fract(p);\n  vec2 u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);\n  vec2 du = 30.0 * f * f * (f * (f - 2.0) + 1.0);\n  float a = hash(i);\n  float b = hash(i + vec2(1.0, 0.0));\n  float c = hash(i + vec2(0.0, 1.0));\n  float d = hash(i + vec2(1.0, 1.0));\n  float val = a + (b - a) * u.x + (c - a) * u.y + (a - b - c + d) * u.x * u.y;\n  vec2 deriv = du * (vec2(b - a + (a - b - c + d) * u.y, c - a + (a - b - c + d) * u.x));\n  return vec3(val, deriv);\n}\n\n// ── FBM with rotation between octaves ──\nfloat fbm(vec2 p, int octaves) {\n  float v = 0.0, a = 0.5;\n  mat2 rot = mat2(0.8, 0.6, -0.6, 0.8);\n  for (int i = 0; i < 8; i++) {\n    if (i >= octaves) break;\n    v += a * vnoise(p);\n    p = rot * p * 2.05 + vec2(1.7, 9.2);\n    a *= 0.5;\n  }\n  return v;\n}\n\n// ── FBM with derivatives for distortion ──\nvec3 fbmd(vec2 p, int octaves) {\n  float v = 0.0, a = 0.5;\n  vec2 d = vec2(0.0);\n  mat2 rot = mat2(0.8, 0.6, -0.6, 0.8);\n  for (int i = 0; i < 8; i++) {\n    if (i >= octaves) break;\n    vec3 n = noised(p);\n    v += a * n.x;\n    d += a * n.yz;\n    p = rot * p * 2.05 + vec2(1.7, 9.2);\n    a *= 0.5;\n  }\n  return vec3(v, d);\n}\n\n// ── Ridged noise for veins ──\nfloat ridged(vec2 p, int octaves) {\n  float v = 0.0, a = 0.5;\n  mat2 rot = mat2(0.8, 0.6, -0.6, 0.8);\n  for (int i = 0; i < 6; i++) {\n    if (i >= octaves) break;\n    float n = vnoise(p);\n    n = 1.0 - abs(n * 2.0 - 1.0);\n    n = n * n;\n    v += a * n;\n    p = rot * p * 2.1 + vec2(3.2, 1.3);\n    a *= 0.5;\n  }\n  return v;\n}\n\n// ── Temperature color mapping ──\n// Maps a 0-1 temperature value to a rich color palette:\n// cool charcoal -> slate blue -> burnt sienna -> deep copper -> bright amber -> white-hot core\nvec3 tempColor(float temp, float luminosityVar) {\n  // Deep charcoal base\n  vec3 c0 = vec3(0.04, 0.04, 0.055);\n  // Cool slate blue\n  vec3 c1 = vec3(0.08, 0.09, 0.14);\n  // Neutral dark warm\n  vec3 c2 = vec3(0.18, 0.12, 0.10);\n  // Burnt sienna — brighter\n  vec3 c3 = vec3(0.70, 0.28, 0.10);\n  // Deep copper — bright\n  vec3 c4 = vec3(1.2, 0.55, 0.14);\n  // Warm amber — bright HDR\n  vec3 c5 = vec3(1.8, 1.0, 0.25);\n  // Bright amber — very bright HDR\n  vec3 c6 = vec3(2.5, 1.6, 0.6);\n  // White-hot core — very bright HDR\n  vec3 c7 = vec3(3.5, 3.0, 2.5);\n\n  vec3 col;\n  if (temp < 0.12) {\n    col = mix(c0, c1, temp / 0.12);\n  } else if (temp < 0.25) {\n    col = mix(c1, c2, (temp - 0.12) / 0.13);\n  } else if (temp < 0.38) {\n    col = mix(c2, c3, (temp - 0.25) / 0.13);\n  } else if (temp < 0.52) {\n    col = mix(c3, c4, (temp - 0.38) / 0.14);\n  } else if (temp < 0.68) {\n    col = mix(c4, c5, (temp - 0.52) / 0.16);\n  } else if (temp < 0.85) {\n    col = mix(c5, c6, (temp - 0.68) / 0.17);\n  } else {\n    col = mix(c6, c7, (temp - 0.85) / 0.15);\n  }\n\n  // Luminosity variation — brightness modulation\n  col *= 1.0 + luminosityVar * 0.25;\n\n  return col;\n}\n\nvoid main() {\n  vec2 origin = u_scale > 0.0 ? u_center : vec2(0.5);\n  float sc = u_scale > 0.0 ? u_scale : 1.0;\n  vec2 uv = (gl_FragCoord.xy - u_res * origin) / (min(u_res.x, u_res.y) * sc);\n  float t = u_time;\n  float heat = u_heat;\n  float turb = u_turbulence;\n\n  // Aspect-corrected radial distance from center\n  float dist = length(uv);\n\n  // Mouse: creates a secondary heat source at cursor\n  float mouseHeat = 0.0;\n  if (u_mouse.x > 0.0) {\n    vec2 mUV = (u_mouse - u_res * origin) / (min(u_res.x, u_res.y) * sc);\n    float mDist = length(uv - mUV);\n    mouseHeat = exp(-mDist * mDist * 4.0);\n  }\n\n  // ──────────────────────────────────────────\n  // Layer 1: Base temperature field\n  // Radial gradient from hot center to cool edges\n  // with heavily animated turbulent noise deforming the boundary\n  // ──────────────────────────────────────────\n\n  // Multi-scale turbulence applied to the radial distance\n  // Use cos/sin of angle instead of raw angle to avoid atan discontinuity seam\n  float angle = atan(uv.y, uv.x);\n  float ca = cos(angle);\n  float sa = sin(angle);\n\n  // Large-scale turbulence — slow breathing of the boundary\n  float turb1 = fbm(vec2(ca * 1.5 + sa * 0.7 + t * 0.08, dist * 2.0 - t * 0.05) * 1.8, 5) * turb;\n\n  // Medium-scale turbulence — faster, more detail\n  float turb2 = fbm(vec2(ca * 3.0 - sa * 1.5 - t * 0.12, dist * 3.5 + t * 0.07) * 2.5 + vec2(50.0, 30.0), 4) * turb;\n\n  // Fine-scale turbulence — rapid small variations\n  float turb3 = fbm(vec2(ca * 5.0 + sa * 2.5 + t * 0.2, dist * 5.0 - t * 0.15) * 3.0 + vec2(100.0, 70.0), 3) * turb;\n\n  // Combine turbulence at different scales\n  float turbTotal = turb1 * 0.45 + turb2 * 0.35 + turb3 * 0.2;\n\n  // Deform the radial distance with turbulence\n  // The deformation is stronger at medium distances (the transition zone)\n  float deformStrength = smoothstep(0.0, 0.3, dist) * smoothstep(0.9, 0.4, dist);\n  float deformedDist = dist + (turbTotal - 0.5) * 0.35 * deformStrength;\n\n  // Slow pulsation of the overall hot zone size\n  float pulse = sin(t * 0.15) * 0.04 + sin(t * 0.23 + 1.7) * 0.03 + sin(t * 0.37 + 3.1) * 0.02;\n  deformedDist -= pulse * heat;\n\n  // Map deformed distance to temperature (0 = cool edge, 1 = hot center)\n  float tempRange = 0.65 / heat;\n  float temp = 1.0 - smoothstep(0.0, tempRange, deformedDist);\n  // Add a sharper core\n  float coreBoost = (1.0 - smoothstep(0.0, 0.15 / heat, deformedDist));\n  temp = temp * 0.7 + coreBoost * 0.3;\n  // Mouse heat source: boost temperature at cursor\n  temp += mouseHeat * 0.6;\n  temp = clamp(temp, 0.0, 1.0);\n\n  // ──────────────────────────────────────────\n  // Layer 2: Color mapping with luminosity variation\n  // ──────────────────────────────────────────\n\n  // Luminosity variation from noise — adds color richness\n  float lumVar = fbm(uv * 4.0 + t * 0.06, 3) * 2.0 - 1.0;\n\n  vec3 col = tempColor(temp, lumVar);\n\n  // ──────────────────────────────────────────\n  // Layer 3: Heat shimmer (UV distortion)\n  // Distort the color field based on animated noise derivatives.\n  // Strongest in the hot areas, zero at the cool edges.\n  // ──────────────────────────────────────────\n\n  // Heat shimmer — distort color using noise derivatives (no re-sampling)\n  vec3 shimmerNoise = fbmd(uv * 8.0 + vec2(t * 0.3, t * 0.25), 4);\n  float shimmerWave = shimmerNoise.x;\n  vec2 shimmerDir = shimmerNoise.yz;\n\n  // Shimmer creates bright/dark ripples in hot areas\n  float shimmerStrength = temp * temp * turb;\n  float shimmerRipple = dot(shimmerDir, vec2(0.7, 0.7));\n  shimmerRipple = shimmerRipple * shimmerRipple * shimmerStrength;\n  col += col * shimmerRipple * 0.4;\n\n  // Extra shimmer highlights\n  float shimmerHighlight = pow(max(shimmerWave, 0.0), 4.0) * temp * temp;\n  col += vec3(1.0, 0.8, 0.4) * shimmerHighlight * 0.2 * heat;\n\n  // ──────────────────────────────────────────\n  // Layer 4: Turbulent veins (ridged noise convection currents)\n  // Bright amber-gold filaments visible within the hot zone\n  // ──────────────────────────────────────────\n\n  // Primary vein network\n  float veins1 = ridged(uv * 5.0 + vec2(t * 0.06, -t * 0.04), 4);\n  // Secondary vein network at different scale/angle\n  float veins2 = ridged(uv * 8.0 + vec2(-t * 0.08, t * 0.05) + vec2(20.0, 40.0), 3);\n  // Tertiary fine detail\n  float veins3 = ridged(uv * 13.0 + vec2(t * 0.1, t * 0.07) + vec2(60.0, 90.0), 2);\n\n  float veins = veins1 * 0.5 + veins2 * 0.35 + veins3 * 0.15;\n\n  // Sharpen the veins into filaments\n  veins = smoothstep(0.3, 0.75, veins);\n  veins = pow(veins, 2.0);\n\n  // Veins only visible in the hot zone\n  float veinMask = smoothstep(0.15, 0.5, temp) * smoothstep(1.0, 0.7, temp);\n  float veinIntensity = veins * veinMask * 0.7 * heat;\n\n  // Vein color — brighter amber-gold against the copper background\n  vec3 veinColor = vec3(1.0, 0.72, 0.22);\n  // Add slight color variation along the veins\n  veinColor = mix(veinColor, vec3(1.0, 0.58, 0.15), veins2);\n  col += veinColor * veinIntensity;\n\n  // ──────────────────────────────────────────\n  // Layer 5: Ember particles\n  // Sparse bright points drifting upward in the hot zone.\n  // Computed in the fragment shader using grid-based hashing.\n  // ──────────────────────────────────────────\n\n  // Grid for ember placement\n  float emberScale = 18.0;\n  vec2 emberUV = uv * emberScale;\n  // Slow upward drift\n  emberUV.y -= t * 0.4;\n  // Very slight horizontal wander\n  emberUV.x += sin(t * 0.3 + uv.y * 4.0) * 0.15;\n\n  vec2 emberId = floor(emberUV);\n  vec2 emberF = fract(emberUV) - 0.5;\n\n  float embers = 0.0;\n  // Check 3x3 neighborhood for sub-pixel positioning\n  for (int ey = -1; ey <= 1; ey++) {\n    for (int ex = -1; ex <= 1; ex++) {\n      vec2 neighbor = vec2(float(ex), float(ey));\n      vec2 cellId = emberId + neighbor;\n      vec2 rnd = hash2(cellId);\n\n      // Sparse: only ~8% of cells have an ember\n      if (rnd.x > 0.08) continue;\n\n      // Random position within cell\n      vec2 emberPos = neighbor + rnd - 0.5;\n      float emberDist = length(emberF - emberPos);\n\n      // Animated brightness — embers flicker and fade in/out\n      float phase = hash(cellId + vec2(77.0, 33.0));\n      float life = fract(phase + t * 0.08);\n      float brightness = sin(life * PI) * sin(life * PI);\n      // Extra flicker\n      brightness *= 0.5 + 0.5 * sin(t * 5.0 + phase * TAU);\n\n      // Ember glow (very small, bright)\n      float glow = smoothstep(0.08, 0.0, emberDist);\n      // Tiny bright core\n      float core = smoothstep(0.025, 0.0, emberDist) * 2.0;\n\n      embers += (glow + core) * brightness;\n    }\n  }\n\n  // Map ember grid back to world space for temperature masking\n  float emberTemp = temp;\n  // Embers only in hot zone\n  float emberMask = smoothstep(0.2, 0.5, emberTemp);\n  embers *= emberMask;\n\n  // Ember color — bright amber-white\n  vec3 emberColor = vec3(1.0, 0.85, 0.5);\n  col += emberColor * embers * 0.12 * heat;\n\n  // ──────────────────────────────────────────\n  // Layer 6: Film grain\n  // Warm-toned noise, denser in the transition zone\n  // ──────────────────────────────────────────\n\n  float grainSeed = hash(gl_FragCoord.xy + fract(t * 43.758) * 1000.0);\n  float grain = (grainSeed - 0.5);\n\n  // Grain density higher in the transition zone\n  float transitionMask = smoothstep(0.1, 0.35, temp) * smoothstep(0.7, 0.35, temp);\n  float grainStrength = 0.012 + transitionMask * 0.018;\n\n  // Warm tint to the grain\n  vec3 grainColor = vec3(grain * 1.1, grain * 0.95, grain * 0.75);\n  col += grainColor * grainStrength;\n\n  // ──────────────────────────────────────────\n  // Final adjustments\n  // ──────────────────────────────────────────\n\n  // Subtle vignette to deepen the edges further\n  float vig = length(uv * 1.1);\n  float vignette = 1.0 - smoothstep(0.5, 1.3, vig) * 0.3;\n  col *= vignette;\n\n  // ACES filmic tone mapping — preserves bright highlights\n  col = col * (2.51 * col + 0.03) / (col * (2.43 * col + 0.59) + 0.14);\n\n  // Ensure no negative values\n  col = max(col, vec3(0.0));\n\n  gl_FragColor = vec4(col, 1.0);\n}", "format": "raw", "inputs": [{"name": "u_time", "type": "float", "default": 1}, {"name": "u_res", "type": "vec2", "default": [0.5, 0.5]}, {"name": "u_heat", "type": "float", "default": 1}, {"name": "u_turbulence", "type": "float", "default": 1, "min": 0.3, "max": 2}, {"name": "u_center", "type": "vec2", "default": [0, 0]}, {"name": "u_scale", "type": "float", "default": 0}, {"name": "u_mouse", "type": "vec2", "default": [-1, -1]}], "description": "Radial warmth radiating through animated turbulence with heat shimmer, ember particles, and cool blue edges.", "categories": ["fill", "noise"]}, {"id": "radiant-magma-core", "name": "Magma Core", "kind": "generator", "family": "Radiant", "license": "MIT", "sourceUrl": "https://github.com/pbakaus/radiant/blob/59e9f48c0ad9a3db2fbeb8898b4390d5a1eabb40/static/magma-core.html", "source": "precision highp float;\nuniform float u_time;\nuniform vec2 u_res;\nuniform float u_intensity;\nuniform float u_crustAmount;\nuniform vec2 u_mouse;\n\n#define PI 3.14159265359\n\n// ── Hash & noise primitives ──\nfloat hash(vec2 p) {\n  return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);\n}\n\nfloat hash1(float n) {\n  return fract(sin(n) * 43758.5453123);\n}\n\nvec2 hash2(vec2 p) {\n  return vec2(\n    fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453),\n    fract(sin(dot(p, vec2(269.5, 183.3))) * 43758.5453)\n  );\n}\n\n// Smooth value noise\nfloat noise(vec2 p) {\n  vec2 i = floor(p);\n  vec2 f = fract(p);\n  f = f * f * (3.0 - 2.0 * f);\n  float a = hash(i);\n  float b = hash(i + vec2(1.0, 0.0));\n  float c = hash(i + vec2(0.0, 1.0));\n  float d = hash(i + vec2(1.0, 1.0));\n  return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);\n}\n\n// FBM — fractal Brownian motion\nfloat fbm(vec2 p, int octaves) {\n  float val = 0.0;\n  float amp = 0.5;\n  float freq = 1.0;\n  for (int i = 0; i < 8; i++) {\n    if (i >= octaves) break;\n    val += amp * noise(p * freq);\n    freq *= 2.03;\n    amp *= 0.49;\n    p += vec2(1.7, 9.2);\n  }\n  return val;\n}\n\n// Ridged noise — great for crack-like structures\nfloat ridgedNoise(vec2 p) {\n  return 1.0 - abs(noise(p) * 2.0 - 1.0);\n}\n\n// Ridged FBM for crack networks\nfloat ridgedFBM(vec2 p, int octaves) {\n  float val = 0.0;\n  float amp = 0.5;\n  float freq = 1.0;\n  float prev = 1.0;\n  for (int i = 0; i < 6; i++) {\n    if (i >= octaves) break;\n    float n = ridgedNoise(p * freq);\n    n = n * n;\n    val += n * amp * prev;\n    prev = n;\n    freq *= 2.2;\n    amp *= 0.5;\n    p += vec2(1.3, 7.1);\n  }\n  return val;\n}\n\n// Voronoi for crust plate boundaries\nfloat voronoi(vec2 p, out vec2 cellCenter) {\n  vec2 i = floor(p);\n  vec2 f = fract(p);\n  float minDist = 1.0;\n  float secondDist = 1.0;\n  cellCenter = vec2(0.0);\n  for (int y = -1; y <= 1; y++) {\n    for (int x = -1; x <= 1; x++) {\n      vec2 neighbor = vec2(float(x), float(y));\n      vec2 point = hash2(i + neighbor);\n      vec2 diff = neighbor + point - f;\n      float d = dot(diff, diff);\n      if (d < minDist) {\n        secondDist = minDist;\n        minDist = d;\n        cellCenter = i + neighbor + point;\n      } else if (d < secondDist) {\n        secondDist = d;\n      }\n    }\n  }\n  return sqrt(secondDist) - sqrt(minDist);\n}\n\n// ── Domain warping for fluid magma motion ──\nvec2 warpDomain(vec2 p, float t) {\n  // Two layers of warping create churning fluid motion\n  vec2 q = vec2(\n    fbm(p + vec2(0.0, 0.0) + t * vec2(0.12, -0.08), 5),\n    fbm(p + vec2(5.2, 1.3) + t * vec2(-0.09, 0.14), 5)\n  );\n  vec2 r = vec2(\n    fbm(p + 3.5 * q + vec2(1.7, 9.2) + t * vec2(0.06, 0.05), 5),\n    fbm(p + 3.5 * q + vec2(8.3, 2.8) + t * vec2(-0.07, 0.08), 5)\n  );\n  return p + 2.5 * r;\n}\n\n// ── Thermal color mapping ──\n// Maps temperature 0..1 to magma colors:\n// black -> deep red -> orange -> yellow -> white-hot\nvec3 magmaColor(float temp) {\n  // Use smooth curves for natural-looking thermal gradient\n  vec3 c;\n  if (temp < 0.15) {\n    // Nearly cooled — very dark red/black\n    float t = temp / 0.15;\n    c = mix(vec3(0.02, 0.005, 0.0), vec3(0.15, 0.02, 0.005), t);\n  } else if (temp < 0.35) {\n    // Dark red glow\n    float t = (temp - 0.15) / 0.2;\n    c = mix(vec3(0.15, 0.02, 0.005), vec3(0.55, 0.08, 0.01), t * t);\n  } else if (temp < 0.55) {\n    // Red to orange\n    float t = (temp - 0.35) / 0.2;\n    c = mix(vec3(0.55, 0.08, 0.01), vec3(0.9, 0.3, 0.02), t);\n  } else if (temp < 0.72) {\n    // Orange to bright yellow-orange\n    float t = (temp - 0.55) / 0.17;\n    c = mix(vec3(0.9, 0.3, 0.02), vec3(1.0, 0.65, 0.08), t);\n  } else if (temp < 0.88) {\n    // Bright yellow\n    float t = (temp - 0.72) / 0.16;\n    c = mix(vec3(1.0, 0.65, 0.08), vec3(1.0, 0.9, 0.4), t);\n  } else {\n    // White-hot\n    float t = (temp - 0.88) / 0.12;\n    c = mix(vec3(1.0, 0.9, 0.4), vec3(1.0, 1.0, 0.85), t);\n  }\n  return c;\n}\n\nvoid main() {\n  vec2 fragCoord = gl_FragCoord.xy;\n  vec2 uv = fragCoord / u_res;\n  // Aspect-corrected coordinates centered at origin\n  float aspect = u_res.x / u_res.y;\n  vec2 p = (fragCoord - u_res * 0.5) / min(u_res.x, u_res.y);\n\n  float t = u_time;\n\n  // Mouse: compute heat eruption at cursor\n  float mouseHeat = 0.0;\n  if (u_mouse.x > 0.0) {\n    vec2 mPos = (u_mouse - u_res * 0.5) / min(u_res.x, u_res.y);\n    float mDist = length(p - mPos);\n    mouseHeat = exp(-mDist * mDist * 6.0);\n  }\n\n  // ────────────────────────────────────────────\n  // UNIFIED MAGMA MATERIAL\n  // Everything is computed from the same base field\n  // ────────────────────────────────────────────\n\n  // Scale for the magma surface — controls how zoomed in we are\n  vec2 magmaUV = p * 3.0;\n\n  // ── 1. Base convection flow ──\n  // Domain-warped noise creates the churning fluid motion\n  vec2 warped = warpDomain(magmaUV, t * 0.4);\n  float baseFlow = fbm(warped, 7);\n\n  // Second warp layer for extra turbulence at different scale\n  vec2 warped2 = warpDomain(magmaUV * 1.3 + vec2(50.0), t * 0.35);\n  float flow2 = fbm(warped2, 6);\n\n  // Combine flows — this is the main convection pattern\n  float convection = baseFlow * 0.6 + flow2 * 0.4;\n\n  // ── 2. Crust formation from Voronoi cells ──\n  // The crust forms naturally where the convection cools\n  // Moving the voronoi field slowly creates drifting plates\n  vec2 crustUV = magmaUV * 0.8 + t * vec2(0.03, -0.02);\n  // Warp the crust coordinates by the convection flow itself\n  // so the crust moves WITH the magma — unified motion\n  crustUV += vec2(baseFlow, flow2) * 0.6;\n\n  vec2 cellCenter;\n  float crustEdge = voronoi(crustUV, cellCenter);\n\n  // Second voronoi at different scale for subcracks\n  vec2 cellCenter2;\n  float subCracks = voronoi(crustUV * 2.5 + vec2(30.0), cellCenter2);\n\n  // ── 3. Temperature field ──\n  // This is the master field that controls everything\n  // High temp = glowing magma, low temp = dark crust\n\n  // Start with convection as base temperature\n  float temp = convection;\n\n  // The cracks (voronoi edges) are WHERE the hot magma shows through\n  // Thin edges = bright cracks, wide cells = cooled crust\n  float crackGlow = smoothstep(0.12 * u_crustAmount, 0.0, crustEdge);\n  float subCrackGlow = smoothstep(0.08 * u_crustAmount, 0.0, subCracks) * 0.4;\n\n  // Crust cools the surface\n  float crustMask = smoothstep(0.0, 0.15 * u_crustAmount, crustEdge);\n  // Each cell has a slightly different cooling rate\n  float cellCool = hash(floor(cellCenter * 100.0)) * 0.3 + 0.5;\n  float crustCooling = crustMask * cellCool * u_crustAmount;\n\n  // Apply cooling — crust darkens the temperature\n  temp = temp - crustCooling * 0.6;\n\n  // But cracks reveal hot magma beneath\n  temp = max(temp, crackGlow * 0.85);\n  temp = max(temp, subCrackGlow * 0.5 + temp * 0.5);\n\n  // ── 4. Hot spots — convection upwellings ──\n  // These pulse and drift with the flow\n  float hotSpotNoise = fbm(magmaUV * 0.5 + t * vec2(0.08, -0.06), 4);\n  float hotSpots = smoothstep(0.55, 0.85, hotSpotNoise);\n  // Hot spots push temperature up and eat through crust\n  temp += hotSpots * 0.35 * u_intensity;\n\n  // Slow, large pulsation — breathing of the lava lake\n  float breathe = sin(t * 0.6) * 0.5 + 0.5;\n  float breathe2 = sin(t * 0.37 + 2.0) * 0.5 + 0.5;\n  temp += breathe * 0.08 + breathe2 * 0.05;\n\n  // ── 5. Ridged detail for a natural look ──\n  // Fine ridged noise adds those thin bright veins that lava has\n  float veins = ridgedFBM(warped * 1.5 + t * 0.1, 5);\n  // Veins are most visible in medium-temperature regions\n  float veinMask = smoothstep(0.2, 0.4, temp) * smoothstep(0.8, 0.5, temp);\n  temp += veins * veinMask * 0.15;\n\n  // ── 6. Localized brightening events ──\n  // Occasional bright flare-ups where crust breaks apart\n  float flareNoise = noise(magmaUV * 1.2 + t * vec2(0.3, -0.2));\n  float flare = pow(max(flareNoise - 0.65, 0.0) / 0.35, 3.0);\n  temp += flare * 0.25 * u_intensity;\n\n  // ── Mouse eruption: boost temperature at cursor ──\n  temp += mouseHeat * 0.7;\n\n  // ── Clamp temperature ──\n  temp = clamp(temp * u_intensity, 0.0, 1.0);\n\n  // ── 7. Convert temperature to color ──\n  vec3 col = magmaColor(temp);\n\n  // ── 8. Emissive glow for very hot areas ──\n  // Hot regions cast light that brightens nearby pixels\n  // (simulated by a soft bloom on high-temp areas)\n  float glow = smoothstep(0.6, 1.0, temp);\n  col += vec3(0.3, 0.08, 0.01) * glow * glow * 0.5;\n\n  // ── 9. Crust surface texture ──\n  // Cooled crust has subtle surface bumpiness\n  float crustDetail = fbm(magmaUV * 8.0 + vec2(cellCool * 20.0), 4);\n  float crustShade = crustMask * (0.8 + crustDetail * 0.4);\n  // Darken the crust slightly with texture\n  col *= mix(1.0, 0.7 + crustDetail * 0.3, crustMask * u_crustAmount * 0.5);\n\n  // ── 10. Heat haze / atmospheric distortion ──\n  // Subtle color shift simulating heat shimmer above surface\n  float haze = fbm(p * 2.0 + t * vec2(0.15, 0.4), 3);\n  float hazeStrength = smoothstep(0.5, 1.0, temp) * 0.08;\n  col += vec3(0.15, 0.04, 0.0) * haze * hazeStrength;\n\n  // ── 11. Very subtle cool ambient at edges ──\n  // The edge of the \"view\" into the lava lake darkens slightly\n  float edgeDist = length(p * vec2(1.0, 1.3));\n  float edgeFade = smoothstep(0.7, 1.4, edgeDist);\n  // Edges cool more — thicker crust at the rim\n  float edgeCool = edgeFade * 0.3;\n  col = mix(col, col * vec3(0.3, 0.1, 0.08), edgeCool);\n\n  // ── 12. Vignette ──\n  float vignette = 1.0 - smoothstep(0.5, 1.5, edgeDist);\n  col *= 0.65 + vignette * 0.35;\n\n  // ── 13. Tone mapping — prevent harsh clipping ──\n  col = col / (1.0 + col * 0.15);\n\n  // ── 14. Final color grading ──\n  // Slight push toward warm amber in the midtones\n  col = pow(col, vec3(0.95, 1.0, 1.1));\n\n  gl_FragColor = vec4(col, 1.0);\n}", "format": "raw", "inputs": [{"name": "u_time", "type": "float", "default": 1}, {"name": "u_res", "type": "vec2", "default": [0.5, 0.5]}, {"name": "u_intensity", "type": "float", "default": 1}, {"name": "u_crustAmount", "type": "float", "default": 1}, {"name": "u_mouse", "type": "vec2", "default": [-1, -1]}], "description": "Volcanic eruption with thermal lava particles, cooling physics, and magma pool.", "categories": ["object", "particles", "physics"]}, {"id": "radiant-shifting-veils", "name": "Shifting Veils", "kind": "generator", "family": "Radiant", "license": "MIT", "sourceUrl": "https://github.com/pbakaus/radiant/blob/59e9f48c0ad9a3db2fbeb8898b4390d5a1eabb40/static/shifting-veils.html", "source": "precision highp float;\nuniform float u_time;\nuniform vec2 u_res;\nuniform float u_layerSpeed;\nuniform float u_layerCount;\nuniform vec2 u_mouse;\n\n#define PI 3.14159265359\n#define TAU 6.28318530718\n\n// ── Hash functions for noise ──\nfloat hash(vec2 p) {\n  return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);\n}\n\nfloat hash3(vec3 p) {\n  return fract(sin(dot(p, vec3(127.1, 311.7, 74.7))) * 43758.5453123);\n}\n\n// ── Smooth 2D value noise ──\nfloat vnoise(vec2 p) {\n  vec2 i = floor(p);\n  vec2 f = fract(p);\n  f = f * f * (3.0 - 2.0 * f);\n  float a = hash(i);\n  float b = hash(i + vec2(1.0, 0.0));\n  float c = hash(i + vec2(0.0, 1.0));\n  float d = hash(i + vec2(1.0, 1.0));\n  return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);\n}\n\n// ── FBM (fractal Brownian motion) ──\nfloat fbm(vec2 p) {\n  float val = 0.0;\n  float amp = 0.5;\n  float freq = 1.0;\n  for (int i = 0; i < 5; i++) {\n    val += amp * vnoise(p * freq);\n    freq *= 2.0;\n    amp *= 0.5;\n  }\n  return val;\n}\n\n// ── Domain-warped noise for organic flowing shapes ──\nfloat warpedNoise(vec2 p, float t, float seed) {\n  vec2 q = vec2(\n    fbm(p + vec2(seed * 1.7, seed * 2.3) + t * 0.15),\n    fbm(p + vec2(seed * 3.1 + 5.2, seed * 1.3 + 1.3) + t * 0.12)\n  );\n  vec2 r = vec2(\n    fbm(p + 4.0 * q + vec2(1.7, 9.2) + t * 0.08),\n    fbm(p + 4.0 * q + vec2(8.3, 2.8) + t * 0.1)\n  );\n  return fbm(p + 3.5 * r);\n}\n\n// ── Rotation matrix ──\nmat2 rot2(float a) {\n  float c = cos(a), s = sin(a);\n  return mat2(c, -s, s, c);\n}\n\nvoid main() {\n  vec2 uv = gl_FragCoord.xy / u_res;\n  vec2 aspect = vec2(u_res.x / u_res.y, 1.0);\n  vec2 p = uv * aspect;\n  float t = u_time * u_layerSpeed;\n\n  // Mouse-driven veil shift\n  vec2 mouseShift = vec2(0.0);\n  if (u_mouse.x > 0.0) {\n    vec2 mUV = u_mouse / u_res;\n    mouseShift = (mUV - 0.5) * aspect * 0.3;\n  }\n\n  // ── Warm amber palette colors per layer ──\n  // From deepest (darkest) to frontmost (brightest)\n  // Layer 0: deep sepia\n  // Layer 1: warm brown\n  // Layer 2: copper\n  // Layer 3: amber gold\n  // Layer 4: bright amber\n  // Layer 5: pale gold\n  // Layer 6: warm cream\n\n  // ── Accumulate color from back to front ──\n  vec3 col = vec3(0.012, 0.01, 0.008); // Dark background base\n\n  int maxLayers = 7;\n\n  for (int i = 0; i < 7; i++) {\n    if (float(i) >= u_layerCount) break;\n\n    float fi = float(i);\n    float layerFrac = fi / max(u_layerCount - 1.0, 1.0);\n\n    // ── Each layer has unique movement ──\n    // Different speed, direction, and scale per layer\n    float speed = 0.3 + fi * 0.12;\n    float scale = 1.8 + fi * 0.7;\n    float angle = fi * 0.7 + 0.3;\n\n    // Parallax offset — deeper layers move slower\n    float parallax = 0.3 + layerFrac * 0.7;\n\n    // Direction of drift per layer\n    vec2 drift = vec2(\n      cos(angle) * speed * t * parallax,\n      sin(angle) * speed * t * parallax * 0.7\n    );\n\n    // Rotate coordinates slightly per layer for variety\n    vec2 lp = (p - 0.5 * aspect + mouseShift * (0.5 + layerFrac * 0.5)) * rot2(fi * 0.4 + t * 0.02 * (fi - 2.5)) + 0.5 * aspect;\n    lp = lp * scale + drift;\n\n    // ── Domain-warped noise for flowing veil shape ──\n    float n = warpedNoise(lp, t * (0.8 + fi * 0.15), fi * 3.7 + 1.0);\n\n    // ── Shape the veil: soft edges, flowing contours ──\n    // Use smoothstep to create soft, curtain-like regions\n    float veil = smoothstep(0.25, 0.55, n);\n    veil *= smoothstep(0.85, 0.6, n);\n    // Broaden some veils for variety\n    float broad = smoothstep(0.2, 0.7, n) * 0.5;\n    veil = max(veil, broad);\n\n    // ── Occasional transparency fade — reveals deeper layers ──\n    // Each layer periodically becomes more transparent\n    float fadePhase = t * 0.15 + fi * 1.3;\n    float fadeCycle = sin(fadePhase) * 0.5 + 0.5;\n    // Occasionally dip to near-zero opacity\n    float reveal = smoothstep(0.0, 0.3, fadeCycle);\n    // Mix between partial and full transparency\n    float opacity = mix(0.08, 0.55, reveal);\n\n    // Deeper layers slightly more opaque to build depth\n    opacity *= (0.6 + 0.4 * (1.0 - layerFrac));\n\n    // ── Layer color from the warm amber family ──\n    vec3 layerColor;\n    if (i == 0) {\n      layerColor = vec3(0.12, 0.07, 0.04); // deep sepia\n    } else if (i == 1) {\n      layerColor = vec3(0.22, 0.12, 0.06); // warm brown\n    } else if (i == 2) {\n      layerColor = vec3(0.45, 0.25, 0.12); // copper\n    } else if (i == 3) {\n      layerColor = vec3(0.65, 0.42, 0.15); // amber gold\n    } else if (i == 4) {\n      layerColor = vec3(0.78, 0.55, 0.22); // bright amber\n    } else if (i == 5) {\n      layerColor = vec3(0.85, 0.65, 0.35); // pale gold\n    } else {\n      layerColor = vec3(0.9, 0.75, 0.5); // warm cream\n    }\n\n    // ── Subtle color variation within each layer ──\n    float colorShift = sin(n * 6.0 + t * 0.3 + fi * 2.0) * 0.05;\n    layerColor += colorShift;\n\n    // ── Add subtle inner glow at veil edges ──\n    float edgeGlow = smoothstep(0.0, 0.15, veil) * smoothstep(0.5, 0.25, veil);\n    vec3 glowColor = layerColor * 1.4 + vec3(0.1, 0.06, 0.02);\n    layerColor = mix(layerColor, glowColor, edgeGlow * 0.5);\n\n    // ── Composite this layer over the accumulated color ──\n    float alpha = veil * opacity;\n    col = mix(col, layerColor, alpha);\n  }\n\n  // ── Subtle overall atmospheric glow ──\n  // Warm center glow to add depth\n  vec2 center = (uv - 0.5) * aspect;\n  float centerDist = length(center);\n  float atmosGlow = exp(-centerDist * centerDist * 2.0) * 0.04;\n  col += vec3(0.6, 0.4, 0.2) * atmosGlow;\n\n  // ── Subtle breathing pulse on the whole image ──\n  float breathe = sin(u_time * 0.2) * 0.02 + 1.0;\n  col *= breathe;\n\n  // ── Tone mapping (subtle, keep the dark mood) ──\n  col = col / (col + 0.5) * 1.1;\n\n  // ── Slight warmth push ──\n  col = pow(col, vec3(0.95, 0.98, 1.05));\n\n  // ── Soft vignette ──\n  float vig = 1.0 - dot(center / aspect, center / aspect) * 0.6;\n  vig = smoothstep(0.0, 1.0, vig);\n  col *= vig;\n\n  gl_FragColor = vec4(col, 1.0);\n}", "format": "raw", "inputs": [{"name": "u_time", "type": "float", "default": 1}, {"name": "u_res", "type": "vec2", "default": [0.5, 0.5]}, {"name": "u_layerSpeed", "type": "float", "default": 0.5, "min": 0.1, "max": 1.5}, {"name": "u_layerCount", "type": "float", "default": 5, "min": 3, "max": 7}, {"name": "u_mouse", "type": "vec2", "default": [-1, -1]}], "description": "Layered translucent noise curtains that morph and reveal patterns underneath.", "categories": ["fill", "noise", "organic"]}, {"id": "radiant-kaleidoscope-runway", "name": "Kaleidoscope Runway", "kind": "generator", "family": "Radiant", "license": "MIT", "sourceUrl": "https://github.com/pbakaus/radiant/blob/59e9f48c0ad9a3db2fbeb8898b4390d5a1eabb40/static/kaleidoscope-runway.html", "source": "precision highp float;\nuniform float u_time;\nuniform vec2 u_res;\nuniform float u_symmetry;\nuniform float u_patternSpeed;\nuniform vec2 u_mouse;\n\n#define PI 3.14159265359\n#define TAU 6.28318530718\n\n// ── Rotation matrix ──\nmat2 rot(float a) {\n  float c = cos(a), s = sin(a);\n  return mat2(c, -s, s, c);\n}\n\n// ── Hash for pseudo-random values ──\nfloat hash(vec2 p) {\n  return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);\n}\n\n// ── Smooth noise ──\nfloat noise(vec2 p) {\n  vec2 i = floor(p);\n  vec2 f = fract(p);\n  f = f * f * (3.0 - 2.0 * f);\n  float a = hash(i);\n  float b = hash(i + vec2(1.0, 0.0));\n  float c = hash(i + vec2(0.0, 1.0));\n  float d = hash(i + vec2(1.0, 1.0));\n  return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);\n}\n\n// ── Kaleidoscope UV folding ──\n// Folds the UV space into N symmetric mirror segments\nvec2 kaleidoscope(vec2 uv, float segments) {\n  float angle = atan(uv.y, uv.x);\n  float r = length(uv);\n  // Fold into segment\n  float segAngle = TAU / segments;\n  angle = mod(angle, segAngle);\n  // Mirror alternate segments for true kaleidoscope\n  angle = abs(angle - segAngle * 0.5);\n  return vec2(cos(angle), sin(angle)) * r;\n}\n\n// ── Sharp geometric stripe pattern ──\nfloat stripePattern(vec2 p, float t) {\n  float s1 = step(0.5, fract(p.x * 3.0 + t * 0.3));\n  float s2 = step(0.5, fract(p.y * 4.0 - t * 0.2));\n  return s1 * 0.5 + s2 * 0.5;\n}\n\n// ── Chevron / herringbone pattern ──\nfloat chevronPattern(vec2 p, float t) {\n  float y = p.y + t * 0.15;\n  float chevron = abs(fract(p.x * 2.0) - 0.5) * 2.0;\n  chevron = abs(fract(chevron + y * 3.0) - 0.5) * 2.0;\n  return smoothstep(0.3, 0.35, chevron);\n}\n\n// ── Diamond / rhombus pattern ──\nfloat diamondPattern(vec2 p, float t) {\n  vec2 q = rot(PI * 0.25) * p;\n  float d = abs(fract(q.x * 2.5 + t * 0.1) - 0.5) + abs(fract(q.y * 2.5 - t * 0.08) - 0.5);\n  return smoothstep(0.4, 0.42, d);\n}\n\n// ── Triangle grid pattern ──\nfloat trianglePattern(vec2 p, float t) {\n  vec2 q = p * 3.0;\n  q.x += floor(q.y) * 0.5;\n  vec2 f = fract(q) - 0.5;\n  float tri = abs(f.x) + abs(f.y);\n  float anim = sin(t * 0.4 + floor(q.x) * 1.3 + floor(q.y) * 0.7) * 0.15;\n  return smoothstep(0.45 + anim, 0.47 + anim, tri);\n}\n\n// ── Palette: warm gold, deep amber, bright copper, hot pink ──\nvec3 palette(float t, float patIdx) {\n  // Five key colors that cycle\n  vec3 c0 = vec3(0.85, 0.65, 0.15);  // warm gold\n  vec3 c1 = vec3(0.60, 0.30, 0.08);  // deep amber\n  vec3 c2 = vec3(0.90, 0.50, 0.18);  // bright copper\n  vec3 c3 = vec3(0.92, 0.25, 0.45);  // hot pink\n  vec3 c4 = vec3(1.00, 0.78, 0.30);  // bright gold\n  \n  float phase = fract(t + patIdx * 0.2);\n  vec3 col;\n  if (phase < 0.2) {\n    col = mix(c0, c1, phase / 0.2);\n  } else if (phase < 0.4) {\n    col = mix(c1, c2, (phase - 0.2) / 0.2);\n  } else if (phase < 0.6) {\n    col = mix(c2, c3, (phase - 0.4) / 0.2);\n  } else if (phase < 0.8) {\n    col = mix(c3, c4, (phase - 0.6) / 0.2);\n  } else {\n    col = mix(c4, c0, (phase - 0.8) / 0.2);\n  }\n  return col;\n}\n\nvoid main() {\n  vec2 uv = (gl_FragCoord.xy - u_res * 0.5) / min(u_res.x, u_res.y);\n  float t = u_time * u_patternSpeed;\n  float segments = u_symmetry;\n  \n  // ── Rotation: auto + drag offset ──\n  float globalRot = t * 0.12 + u_mouse.x;\n  uv = rot(globalRot) * uv;\n  \n  float r = length(uv);\n  \n  // ── Apply kaleidoscope folding ──\n  vec2 kuv = kaleidoscope(uv, segments);\n  \n  // ── Animate the pattern space ──\n  // Radial zoom that breathes in and out\n  float zoomPulse = 1.0 + sin(t * 0.35) * 0.15;\n  kuv *= zoomPulse;\n  \n  // Slowly drift the pattern origin for evolution\n  kuv += vec2(t * 0.05, t * 0.03);\n  \n  // ── Layer 1: Chevron textile pattern ──\n  float chev = chevronPattern(kuv * 1.2, t);\n  \n  // ── Layer 2: Diamond facets ──\n  float diam = diamondPattern(kuv * 0.8 + vec2(t * 0.02), t * 1.2);\n  \n  // ── Layer 3: Stripes (fashion runway stripes) ──\n  vec2 stripeUV = rot(t * 0.08) * kuv;\n  float stripe = stripePattern(stripeUV * 1.5, t);\n  \n  // ── Layer 4: Triangle tessellation ──\n  float tri = trianglePattern(kuv * 0.9 + vec2(sin(t * 0.2) * 0.3), t);\n  \n  // ── Morph between patterns over time ──\n  // Smoothly crossfade between the four pattern layers\n  float morphPhase = fract(t * 0.06);\n  float m0 = smoothstep(0.0, 0.1, morphPhase) * smoothstep(0.35, 0.25, morphPhase);\n  float m1 = smoothstep(0.2, 0.3, morphPhase) * smoothstep(0.55, 0.45, morphPhase);\n  float m2 = smoothstep(0.4, 0.5, morphPhase) * smoothstep(0.75, 0.65, morphPhase);\n  float m3 = smoothstep(0.6, 0.7, morphPhase) * smoothstep(0.95, 0.85, morphPhase);\n  // Ensure there is always something visible\n  float mSum = m0 + m1 + m2 + m3;\n  if (mSum < 0.3) {\n    m0 = max(m0, 0.3);\n    m1 = max(m1, 0.2);\n  }\n  \n  float pattern = chev * m0 + diam * m1 + stripe * m2 + tri * m3;\n  // Add a persistent base layer so patterns never fully vanish\n  float basePat = diamondPattern(kuv * 1.1, t * 0.7) * 0.35;\n  pattern = max(pattern, basePat);\n  \n  // ── Second kaleidoscope fold at different scale for depth ──\n  vec2 kuv2 = kaleidoscope(uv * 1.3, segments + 2.0);\n  kuv2 *= 1.0 + sin(t * 0.25) * 0.1;\n  kuv2 += vec2(t * 0.03, -t * 0.04);\n  float innerPattern = chevronPattern(kuv2, t * 0.8) * 0.4;\n  innerPattern += trianglePattern(kuv2 * 1.2, t * 0.6) * 0.3;\n  \n  // ── Color assignment ──\n  // Primary pattern color shifts over time\n  float colorPhase = t * 0.04 + r * 0.5;\n  vec3 col1 = palette(colorPhase, 0.0);\n  vec3 col2 = palette(colorPhase + 0.3, 1.0);\n  vec3 col3 = palette(colorPhase + 0.6, 2.0);\n  \n  // Build the color from pattern layers\n  vec3 col = vec3(0.02, 0.015, 0.01); // Dark base\n  \n  // Primary kaleidoscope pattern\n  col = mix(col, col1 * 1.1, pattern * 0.7);\n  \n  // Inner detail pattern with second color\n  col = mix(col, col2, innerPattern * 0.5);\n  \n  // ── Geometric edge highlights ──\n  // Emphasize the fold lines of the kaleidoscope\n  float foldAngle = atan(uv.y, uv.x);\n  float segAngle = TAU / segments;\n  float foldDist = abs(sin(foldAngle * segments * 0.5));\n  float foldLine = smoothstep(0.02, 0.0, 1.0 - foldDist) * 0.6;\n  // Animate the fold brightness\n  foldLine *= 0.5 + 0.5 * sin(t * 0.5 + r * 4.0);\n  col += col3 * foldLine;\n  \n  // ── Radial gradient layers for depth ──\n  // Concentric rings that pulse\n  float rings = sin(r * 12.0 - t * 1.5) * 0.5 + 0.5;\n  rings = smoothstep(0.4, 0.6, rings) * 0.15;\n  col += palette(colorPhase + 0.5, 3.0) * rings * (1.0 - r);\n  \n  // ── Bright center focal point ──\n  float centerGlow = exp(-r * r * 8.0);\n  vec3 centerColor = mix(\n    vec3(1.0, 0.85, 0.45),  // bright gold\n    vec3(1.0, 0.55, 0.65),  // warm pink-gold\n    sin(t * 0.3) * 0.5 + 0.5\n  );\n  col += centerColor * centerGlow * 0.7;\n  \n  // ── Secondary center detail — mandala star ──\n  float starAngle = atan(uv.y, uv.x);\n  float star = abs(sin(starAngle * segments * 0.5 + t * 0.4));\n  star = pow(star, 8.0) * exp(-r * 3.0);\n  col += vec3(1.0, 0.9, 0.6) * star * 0.4;\n  \n  // ── Hot pink accent flashes ──\n  // Fashion-bold color pops that appear and disappear\n  float pinkFlash = sin(t * 0.7 + r * 6.0) * cos(foldAngle * 3.0 + t * 0.4);\n  pinkFlash = pow(max(pinkFlash, 0.0), 6.0) * 0.8;\n  col += vec3(0.95, 0.2, 0.5) * pinkFlash * (1.0 - r * 0.5);\n  \n  // ── Outer fade — mandala dissolves at edges ──\n  float edgeFade = smoothstep(0.9, 0.5, r);\n  col *= edgeFade;\n  \n  // ── Subtle noise texture for fabric feel ──\n  float tex = noise(gl_FragCoord.xy * 0.5) * 0.04 - 0.02;\n  col += tex;\n  \n  // ── Tone mapping ──\n  col = col / (1.0 + col * 0.3);\n  \n  // ── Warmth push ──\n  col = pow(max(col, vec3(0.0)), vec3(0.92, 0.96, 1.06));\n  \n  // ── Vignette ──\n  float vig = 1.0 - dot(uv, uv) * 0.4;\n  col *= max(vig, 0.0);\n  \n  gl_FragColor = vec4(col, 1.0);\n}", "format": "raw", "inputs": [{"name": "u_time", "type": "float", "default": 1}, {"name": "u_res", "type": "vec2", "default": [0.5, 0.5]}, {"name": "u_symmetry", "type": "float", "default": 8, "min": 4, "max": 16}, {"name": "u_patternSpeed", "type": "float", "default": 0.5, "min": 0.1, "max": 1.5}, {"name": "u_mouse", "type": "vec2", "default": [0, 0]}], "description": "Fashion-inspired kaleidoscopic tessellations with symmetric mirror segments.", "categories": ["fill", "geometric"]}, {"id": "radiant-neon-drive", "name": "Neon Drive", "kind": "generator", "family": "Radiant", "license": "MIT", "sourceUrl": "https://github.com/pbakaus/radiant/blob/59e9f48c0ad9a3db2fbeb8898b4390d5a1eabb40/static/neon-drive.html", "source": "precision highp float;\nuniform float u_time;\nuniform vec2 u_res;\nuniform float u_speed;\nuniform float u_glow;\nuniform vec2 u_mouse;\n\n// ── Horizon position ──\nconst float HORIZON = 0.38;\n\n// ── Hash / noise helpers ──\nfloat hash(vec2 p) {\n  return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);\n}\n\nfloat noise(vec2 p) {\n  vec2 i = floor(p);\n  vec2 f = fract(p);\n  f = f * f * (3.0 - 2.0 * f);\n  float a = hash(i);\n  float b = hash(i + vec2(1.0, 0.0));\n  float c = hash(i + vec2(0.0, 1.0));\n  float d = hash(i + vec2(1.0, 1.0));\n  return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);\n}\n\n// ── Sun shape with layered glow ──\nvec3 sun(vec2 uv, float t) {\n  vec2 sunPos = vec2(0.0, HORIZON + 0.18);\n  float sunRadius = 0.12;\n  float d = length(uv - sunPos);\n\n  // Horizontal scanlines through the sun\n  float scanline = 0.0;\n  if (uv.y < sunPos.y && uv.y > sunPos.y - sunRadius) {\n    float band = (sunPos.y - uv.y) / sunRadius;\n    float lineSpacing = 0.028 + band * 0.06;\n    float lineY = mod(uv.y + 0.001, lineSpacing);\n    scanline = smoothstep(0.0, 0.003, lineY) * smoothstep(lineSpacing, lineSpacing - 0.003, lineY);\n    scanline *= smoothstep(0.0, 0.4, band);\n  }\n\n  // Sun disc with gradient\n  float sunMask = smoothstep(sunRadius + 0.003, sunRadius - 0.003, d);\n  vec3 sunColorTop = vec3(1.0, 0.85, 0.1);\n  vec3 sunColorBot = vec3(1.0, 0.15, 0.4);\n  float sunGradient = smoothstep(sunPos.y + sunRadius, sunPos.y - sunRadius, uv.y);\n  vec3 sunCol = mix(sunColorTop, sunColorBot, sunGradient);\n  sunCol *= sunMask;\n\n  // Cut out scanline bands from lower half of sun\n  sunCol *= mix(1.0, scanline, smoothstep(sunPos.y, sunPos.y - sunRadius, uv.y) * 0.85);\n\n  // Multi-layered glow around the sun\n  float glow1 = exp(-d * 4.0) * 0.5;\n  float glow2 = exp(-d * 10.0) * 0.3;\n  float glow3 = exp(-d * 25.0) * 0.2;\n  vec3 glowCol = vec3(1.0, 0.3, 0.5) * glow1 +\n                 vec3(1.0, 0.6, 0.2) * glow2 +\n                 vec3(1.0, 0.9, 0.5) * glow3;\n\n  return sunCol + glowCol;\n}\n\n// ── Sky gradient with stars ──\nvec3 sky(vec2 uv, float t) {\n  // Deep purple to hot pink to orange gradient\n  float skyY = (uv.y - HORIZON) / (1.0 - HORIZON);\n  skyY = clamp(skyY, 0.0, 1.0);\n\n  vec3 colBot = vec3(0.6, 0.05, 0.3);   // hot pink at horizon\n  vec3 colMid = vec3(0.25, 0.02, 0.35);  // deep purple\n  vec3 colTop = vec3(0.02, 0.01, 0.08);  // near black\n\n  vec3 col = mix(colBot, colMid, smoothstep(0.0, 0.35, skyY));\n  col = mix(col, colTop, smoothstep(0.25, 0.85, skyY));\n\n  // Horizon haze — warm orange glow right at the horizon\n  float hazeStrength = exp(-skyY * 8.0) * 0.7;\n  col += vec3(1.0, 0.4, 0.1) * hazeStrength;\n\n  // Stars\n  float starField = hash(floor(uv * 200.0));\n  float starMask = smoothstep(0.3, 0.9, skyY);\n  float twinkle = sin(t * 2.0 + starField * 50.0) * 0.5 + 0.5;\n  float star = smoothstep(0.992, 0.999, starField) * starMask * (0.5 + 0.5 * twinkle);\n  col += vec3(0.8, 0.7, 1.0) * star;\n\n  // Add sun\n  col += sun(uv, t);\n\n  return col;\n}\n\n// ── Perspective grid road ──\nvec3 grid(vec2 uv, float t) {\n  // Road below horizon\n  float roadY = HORIZON - uv.y;\n  if (roadY <= 0.0) return vec3(0.0);\n\n  // Perspective projection: map screen Y to world Z\n  // Higher constant = more grid cells visible = denser grid\n  float perspective = 1.5 / roadY;\n  float worldX = uv.x * perspective;\n  float worldZ = perspective;\n\n  // Forward motion\n  float speed = t * u_speed * 3.0;\n  worldZ += speed;\n\n  // ── Grid lines ──\n\n  // Z lines (horizontal in perspective, running left-right)\n  float zLine = abs(fract(worldZ * 0.5) - 0.5);\n  float zLineWidth = clamp(perspective * 0.001, 0.01, 0.12);\n  float zGrid = smoothstep(zLineWidth, 0.0, zLine);\n\n  // X lines (vertical in perspective, running into distance)\n  float xLine = abs(fract(worldX * 0.25) - 0.5);\n  float xLineWidth = clamp(perspective * 0.0005, 0.006, 0.08);\n  float xGrid = smoothstep(xLineWidth, 0.0, xLine);\n\n  float gridVal = max(zGrid, xGrid);\n\n  // Distance fade — fade in from horizon, stay visible to camera\n  float fadeIn = smoothstep(0.0, 0.05, roadY);\n\n  // Brightness increases slightly near camera for depth cue\n  float proxBright = 0.5 + 0.5 * smoothstep(0.0, 0.4, roadY);\n\n  // Grid colors: main neon pink/magenta, with cyan accents\n  vec3 gridColor = vec3(0.9, 0.1, 0.6);\n\n  // Accent every 4th line with cyan\n  float zMajor = abs(fract(worldZ * 0.125) - 0.5);\n  float zMajorLine = smoothstep(zLineWidth * 0.5, 0.0, zMajor);\n  float xMajor = abs(fract(worldX * 0.0625) - 0.5);\n  float xMajorLine = smoothstep(xLineWidth * 0.5, 0.0, xMajor);\n  float majorGrid = max(zMajorLine, xMajorLine);\n\n  vec3 accentColor = vec3(0.1, 0.6, 1.0);\n  gridColor = mix(gridColor, accentColor, majorGrid * 0.4);\n\n  // Grid glow — soft bloom around grid lines\n  float zGlow = exp(-zLine * 20.0) * 0.25;\n  float xGlow = exp(-xLine * 20.0) * 0.2;\n  float gridGlow = max(zGlow, xGlow);\n\n  vec3 col = gridColor * gridVal * proxBright * fadeIn;\n  col += gridColor * gridGlow * fadeIn * 0.7;\n\n  // Ground base color — very dark with slight purple tint\n  vec3 groundColor = vec3(0.02, 0.01, 0.04);\n  col += groundColor;\n\n  // Horizon fog glow — warm/pink mist at the horizon\n  float fogBand = exp(-roadY * 10.0);\n  col += vec3(0.5, 0.1, 0.35) * fogBand * 0.5;\n\n  return col;\n}\n\n// ── Side terrain / mountains ──\nvec3 mountains(vec2 uv, float t) {\n  if (uv.y < HORIZON) return vec3(0.0);\n\n  float mountainY = HORIZON;\n  float au = abs(uv.x);\n\n  // Mountain silhouette using layered noise\n  float m1 = noise(vec2(au * 3.0, 0.0)) * 0.08;\n  float m2 = noise(vec2(au * 8.0, 1.0)) * 0.03;\n  float m3 = noise(vec2(au * 20.0, 2.0)) * 0.01;\n  float mountainHeight = m1 + m2 + m3;\n\n  // Only show mountains on the sides\n  float sideMask = smoothstep(0.15, 0.5, au);\n  mountainHeight *= sideMask;\n\n  float mountainTop = HORIZON + mountainHeight;\n  float mountainMask = smoothstep(mountainTop + 0.005, mountainTop - 0.002, uv.y);\n\n  // Dark silhouette with subtle purple edge light\n  vec3 col = vec3(0.015, 0.005, 0.03) * mountainMask;\n\n  // Edge glow along the mountain ridge\n  float edgeDist = abs(uv.y - mountainTop);\n  float edgeGlow = exp(-edgeDist * 200.0) * sideMask;\n  col += vec3(0.6, 0.1, 0.5) * edgeGlow * 0.3;\n\n  return col;\n}\n\n// ── Side grid (ground extending beyond the road) ──\nvec3 sideGrid(vec2 uv, float t) {\n  float roadY = HORIZON - uv.y;\n  if (roadY <= 0.0) return vec3(0.0);\n\n  float perspective = 1.5 / roadY;\n  float worldX = uv.x * perspective;\n  float worldZ = perspective + t * u_speed * 3.0;\n\n  // Same grid density as the road\n  float zLine = abs(fract(worldZ * 0.5) - 0.5);\n  float xLine = abs(fract(worldX * 0.25) - 0.5);\n\n  float zLineWidth = clamp(perspective * 0.0008, 0.008, 0.08);\n  float xLineWidth = clamp(perspective * 0.0004, 0.004, 0.06);\n\n  float zGrid = smoothstep(zLineWidth, 0.0, zLine);\n  float xGrid = smoothstep(xLineWidth, 0.0, xLine);\n  float gridVal = max(zGrid, xGrid);\n\n  float fadeIn = smoothstep(0.0, 0.05, roadY);\n\n  // Slightly different color for side terrain grid — purple\n  vec3 sideColor = vec3(0.4, 0.05, 0.6);\n  return sideColor * gridVal * fadeIn * 0.35;\n}\n\n// ── Sun reflection on road ──\nvec3 sunReflection(vec2 uv, float t) {\n  float roadY = HORIZON - uv.y;\n  if (roadY <= 0.0) return vec3(0.0);\n\n  // Reflection of the sun centered on the road\n  float reflectWidth = 0.15 / (roadY * 3.0 + 0.3);\n  float xDist = abs(uv.x);\n  float reflStrength = exp(-xDist * xDist / (reflectWidth * reflectWidth * 0.02));\n\n  // Shimmer effect\n  float perspective = 1.5 / roadY;\n  float worldZ = perspective + t * u_speed * 3.0;\n  float shimmer = noise(vec2(uv.x * 30.0, worldZ * 2.0)) * 0.5 + 0.5;\n\n  // Color gradient from warm to pink\n  float gradT = smoothstep(0.0, 0.25, roadY);\n  vec3 reflColor = mix(vec3(1.0, 0.5, 0.2), vec3(1.0, 0.15, 0.4), gradT);\n\n  float fadeNear = smoothstep(0.35, 0.05, roadY);\n  float fadeFar = smoothstep(0.0, 0.01, roadY);\n\n  return reflColor * reflStrength * shimmer * fadeNear * fadeFar * 0.15;\n}\n\n// ── Center road line ──\nvec3 centerLine(vec2 uv, float t) {\n  float roadY = HORIZON - uv.y;\n  if (roadY <= 0.0) return vec3(0.0);\n\n  float perspective = 1.5 / roadY;\n  float worldZ = perspective + t * u_speed * 3.0;\n\n  // Dashed center line\n  float dashPattern = step(0.5, fract(worldZ * 0.12));\n\n  // Line width in screen space narrows toward horizon\n  float lineWidth = 0.003 / (perspective * 0.05 + 0.1);\n  lineWidth = clamp(lineWidth, 0.0005, 0.01);\n\n  float lineMask = smoothstep(lineWidth, 0.0, abs(uv.x));\n  float distFade = smoothstep(0.0, 0.02, roadY) * smoothstep(0.35, 0.05, roadY);\n\n  return vec3(0.9, 0.8, 0.6) * lineMask * dashPattern * distFade * 0.5;\n}\n\n// ── Road edge glow lines ──\nvec3 roadEdges(vec2 uv, float t) {\n  float roadY = HORIZON - uv.y;\n  if (roadY <= 0.0) return vec3(0.0);\n\n  // Road edges converge toward center at horizon\n  float roadHalfWidth = roadY * 0.8 + 0.001;\n\n  float leftEdge = abs(uv.x + roadHalfWidth);\n  float rightEdge = abs(uv.x - roadHalfWidth);\n  float edgeDist = min(leftEdge, rightEdge);\n\n  float lineWidth = 0.002;\n  float edgeLine = smoothstep(lineWidth, 0.0, edgeDist);\n  float edgeGlow = exp(-edgeDist * 300.0) * 0.4;\n\n  float distFade = smoothstep(0.0, 0.015, roadY) * smoothstep(0.35, 0.02, roadY);\n\n  vec3 edgeColor = vec3(0.1, 0.7, 1.0);\n  return edgeColor * (edgeLine + edgeGlow) * distFade;\n}\n\n// ── Atmospheric haze particles ──\nfloat haze(vec2 uv, float t) {\n  float n1 = noise(uv * 3.0 + vec2(t * 0.1, 0.0));\n  float n2 = noise(uv * 7.0 + vec2(0.0, t * 0.15));\n  float n3 = noise(uv * 15.0 + vec2(t * 0.05, t * 0.08));\n  return (n1 * 0.5 + n2 * 0.3 + n3 * 0.2);\n}\n\n// ── Vignette ──\nfloat vignette(vec2 uv) {\n  float d = length(uv * vec2(0.8, 1.0));\n  return smoothstep(1.2, 0.4, d);\n}\n\n// ── CRT scanline effect (subtle) ──\nfloat scanlines(vec2 fragCoord) {\n  return 0.95 + 0.05 * sin(fragCoord.y * 3.14159 * 1.5);\n}\n\nvoid main() {\n  // ── Mouse: shift vanishing point ──\n  vec2 vpShift = vec2(0.0);\n  if (u_mouse.x > 0.0) {\n    vec2 mNorm = u_mouse / u_res;\n    vpShift = (mNorm - 0.5) * vec2(0.3, 0.15);\n  }\n  vec2 uv = (gl_FragCoord.xy - u_res * 0.5) / u_res.y - vpShift;\n  vec2 screenUV = gl_FragCoord.xy / u_res;\n  float t = u_time;\n\n  vec3 col = vec3(0.0);\n\n  // Sky above horizon\n  if (uv.y >= HORIZON) {\n    col = sky(uv, t);\n\n    // Mountain silhouettes\n    vec3 mtn = mountains(uv, t);\n    // Mountains are dark, so they replace sky where present\n    float mtnMask = step(0.001, mtn.r + mtn.g + mtn.b);\n    col = mix(col, mtn, mtnMask * 0.7);\n    // Add mountain edge glow on top\n    col += mtn * 2.0 * (1.0 - mtnMask);\n  }\n\n  // Grid road below horizon\n  col += grid(uv, t);\n\n  // Side grid\n  col += sideGrid(uv, t);\n\n  // Sun reflection on road surface\n  col += sunReflection(uv, t);\n\n  // Road edge glow\n  col += roadEdges(uv, t);\n\n  // Center dashed line\n  col += centerLine(uv, t);\n\n  // Atmospheric haze near horizon\n  float horizonDist = abs(uv.y - HORIZON);\n  float hazeMask = exp(-horizonDist * 15.0);\n  float hazeVal = haze(uv, t);\n  col += vec3(0.5, 0.15, 0.4) * hazeVal * hazeMask * 0.15;\n\n  // Global glow control\n  col *= u_glow;\n\n  // Vignette\n  col *= vignette(uv);\n\n  // Subtle scanlines for CRT feel\n  col *= scanlines(gl_FragCoord.xy);\n\n  // Tone mapping — slight S-curve for richer darks\n  col = col / (col + vec3(0.8));\n  col = pow(col, vec3(0.95));\n\n  // Very slight chromatic shift at edges\n  float chromDist = length(uv * vec2(0.5, 0.7));\n  float chromShift = chromDist * 0.003;\n  vec3 finalCol;\n  vec2 uvR = (gl_FragCoord.xy + vec2(chromShift * u_res.y, 0.0) - u_res * 0.5) / u_res.y;\n  vec2 uvB = (gl_FragCoord.xy - vec2(chromShift * u_res.y, 0.0) - u_res * 0.5) / u_res.y;\n\n  // Only apply chroma to the final composite for performance\n  finalCol.r = col.r * (1.0 + chromShift * 2.0);\n  finalCol.g = col.g;\n  finalCol.b = col.b * (1.0 + chromShift * 2.0);\n\n  gl_FragColor = vec4(finalCol, 1.0);\n}", "format": "raw", "inputs": [{"name": "u_time", "type": "float", "default": 1}, {"name": "u_res", "type": "vec2", "default": [0.5, 0.5]}, {"name": "u_speed", "type": "float", "default": 1}, {"name": "u_glow", "type": "float", "default": 1}, {"name": "u_mouse", "type": "vec2", "default": [-1, -1]}], "description": "Rain-slicked neon road stretching to a vanishing point with approaching headlights.", "categories": ["fill", "particles"]}, {"id": "radiant-liquid-gold", "name": "Liquid Gold", "kind": "generator", "family": "Radiant", "license": "MIT", "sourceUrl": "https://github.com/pbakaus/radiant/blob/59e9f48c0ad9a3db2fbeb8898b4390d5a1eabb40/static/liquid-gold.html", "source": "precision highp float;\nuniform float u_time;\nuniform vec2 u_res;\nuniform float u_flowSpeed;\nuniform float u_viscosity;\nuniform vec2 u_mouse;\n\n#define PI 3.14159265359\n\n// ── Hash for pseudo-random ──\nfloat hash(vec2 p) {\n  return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);\n}\n\n// ── Smooth value noise ──\nfloat noise(vec2 p) {\n  vec2 i = floor(p);\n  vec2 f = fract(p);\n  f = f * f * (3.0 - 2.0 * f);\n  float a = hash(i);\n  float b = hash(i + vec2(1.0, 0.0));\n  float c = hash(i + vec2(0.0, 1.0));\n  float d = hash(i + vec2(1.0, 1.0));\n  return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);\n}\n\n// ── FBM with viscosity-controlled octave decay ──\nfloat fbm(vec2 p, float t, float visc) {\n  float val = 0.0;\n  float amp = 0.5;\n  float freq = 1.0;\n  float decay = 0.45 + visc * 0.2;\n  for (int i = 0; i < 6; i++) {\n    val += amp * noise(p * freq + t);\n    freq *= 2.0 + visc * 0.3;\n    amp *= decay;\n    p += vec2(1.7, 9.2);\n  }\n  return val;\n}\n\n// ── Domain warping for viscous flow ──\nfloat warpedField(vec2 p, float t, float visc) {\n  // First warp layer — large slow currents\n  vec2 q = vec2(\n    fbm(p + vec2(0.0, 0.0), t * 0.5, visc),\n    fbm(p + vec2(5.2, 1.3), t * 0.5, visc)\n  );\n  \n  // Second warp — medium flow detail\n  vec2 r = vec2(\n    fbm(p + 3.0 * q + vec2(1.7, 9.2), t * 0.7, visc),\n    fbm(p + 3.0 * q + vec2(8.3, 2.8), t * 0.7, visc)\n  );\n  \n  // Third warp — fine ripples and tension effects\n  float f = fbm(p + 2.5 * r, t * 0.4, visc);\n  \n  // Combine warp magnitudes for surface detail\n  return f + length(q) * 0.4 + length(r) * 0.3;\n}\n\n// ── Metaball-like surface bumps ──\nfloat metaballs(vec2 p, float t) {\n  float val = 0.0;\n  for (int i = 0; i < 7; i++) {\n    float fi = float(i);\n    vec2 center = vec2(\n      sin(t * 0.3 + fi * 2.1) * 0.6 + cos(t * 0.2 + fi * 1.3) * 0.3,\n      cos(t * 0.25 + fi * 1.7) * 0.6 + sin(t * 0.15 + fi * 2.5) * 0.3\n    );\n    float radius = 0.15 + 0.1 * sin(t * 0.4 + fi * 3.0);\n    float d = length(p - center);\n    val += radius / (d + 0.05);\n  }\n  return val;\n}\n\n// ── Surface normal estimation for lighting ──\nvec3 getNormal(vec2 p, float t, float visc, float warpCenter) {\n  float eps = 0.005;\n  float hC = warpCenter + metaballs(p, t) * 0.08;\n  float hR = warpedField(p + vec2(eps, 0.0), t, visc) + metaballs(p + vec2(eps, 0.0), t) * 0.08;\n  float hU = warpedField(p + vec2(0.0, eps), t, visc) + metaballs(p + vec2(0.0, eps), t) * 0.08;\n  \n  vec3 n = normalize(vec3(\n    (hC - hR) / eps,\n    (hC - hU) / eps,\n    1.0\n  ));\n  return n;\n}\n\n// ── Fresnel approximation ──\nfloat fresnel(float cosTheta, float f0) {\n  return f0 + (1.0 - f0) * pow(1.0 - cosTheta, 5.0);\n}\n\nvoid main() {\n  vec2 uv = (gl_FragCoord.xy - u_res * 0.5) / min(u_res.x, u_res.y);\n  vec2 screenUv = gl_FragCoord.xy / u_res;\n  float t = u_time * u_flowSpeed;\n  float visc = u_viscosity;\n  \n  // ── Compute the height field (domain-warped + metaballs) ──\n  float field = warpedField(uv * 2.0, t, visc);\n  float meta = metaballs(uv, t);\n  \n  // Surface height — combines warped noise and metaball bulges\n  float height = field + meta * 0.08;\n  \n  // ── Surface normal for lighting ──\n  vec3 normal = getNormal(uv * 2.0, t, visc, field);\n  \n  // ── View and light setup — mouse controls primary light direction ──\n  vec3 viewDir = normalize(vec3(0.0, 0.0, 1.0));\n  vec3 lightDir1 = normalize(vec3(0.4, 0.5, 0.9));\n  vec3 lightDir2 = normalize(vec3(-0.6, -0.3, 0.7));\n  vec3 lightDir3 = normalize(vec3(0.0, 0.8, 0.5));\n  // Mouse creates a visible bump/dent in the gold surface\n  if (u_mouse.x > 0.0) {\n    vec2 mUV = (u_mouse - u_res * 0.5) / min(u_res.x, u_res.y);\n    vec2 toMouse = uv - mUV;\n    float md = length(toMouse);\n    float bump = exp(-md * md * 25.0);\n    // Strong normal perturbation — creates bright specular ring\n    normal = normalize(normal + vec3(toMouse * bump * 12.0, 0.0));\n    // Also dimple the height to affect the field-based coloring\n    height += bump * 0.3;\n  }\n  \n  // ── Gold material properties ──\n  vec3 goldBase = vec3(0.83, 0.61, 0.22);\n  vec3 goldBright = vec3(1.0, 0.84, 0.45);\n  vec3 goldDeep = vec3(0.55, 0.35, 0.08);\n  vec3 goldShadow = vec3(0.18, 0.10, 0.02);\n  vec3 whiteHot = vec3(1.0, 0.97, 0.88);\n  \n  // Gold F0 (metallic reflectance at normal incidence)\n  float f0 = 0.8;\n  \n  // ── Diffuse-like term (metallic surfaces color their reflections) ──\n  float NdotL1 = max(dot(normal, lightDir1), 0.0);\n  float NdotL2 = max(dot(normal, lightDir2), 0.0);\n  float NdotL3 = max(dot(normal, lightDir3), 0.0);\n  \n  // ── Specular highlights (Blinn-Phong for each light) ──\n  vec3 halfVec1 = normalize(lightDir1 + viewDir);\n  vec3 halfVec2 = normalize(lightDir2 + viewDir);\n  vec3 halfVec3 = normalize(lightDir3 + viewDir);\n  \n  float spec1 = pow(max(dot(normal, halfVec1), 0.0), 120.0);\n  float spec2 = pow(max(dot(normal, halfVec2), 0.0), 80.0);\n  float spec3 = pow(max(dot(normal, halfVec3), 0.0), 200.0);\n  \n  // ── Fresnel ──\n  float NdotV = max(dot(normal, viewDir), 0.0);\n  float fres = fresnel(NdotV, f0);\n  \n  // ── Build the color ──\n  \n  // Base gold tone varies with the surface field\n  float fieldNorm = smoothstep(0.3, 1.8, field);\n  vec3 baseColor = mix(goldShadow, goldDeep, smoothstep(0.0, 0.3, fieldNorm));\n  baseColor = mix(baseColor, goldBase, smoothstep(0.3, 0.6, fieldNorm));\n  baseColor = mix(baseColor, goldBright, smoothstep(0.6, 0.9, fieldNorm));\n  \n  // Metallic diffuse: gold-tinted light response\n  vec3 diffuse = baseColor * (NdotL1 * 0.5 + NdotL2 * 0.3 + NdotL3 * 0.2);\n  \n  // Metallic specular: gold-tinted highlights with white-hot peaks\n  vec3 specColor1 = mix(goldBright, whiteHot, spec1);\n  vec3 specColor2 = mix(goldBright, whiteHot, spec2 * 0.5);\n  vec3 specColor3 = mix(goldBright, whiteHot, spec3);\n  \n  vec3 specular = specColor1 * spec1 * 1.2\n                + specColor2 * spec2 * 0.6\n                + specColor3 * spec3 * 1.5;\n  \n  // ── Fake environment reflection ──\n  // Gradient-based: reflects a warm gradient from a fake environment\n  vec2 reflUv = normal.xy * 0.5 + 0.5;\n  vec3 envRefl = mix(\n    vec3(0.12, 0.07, 0.02),\n    vec3(0.45, 0.30, 0.12),\n    reflUv.y\n  );\n  envRefl = mix(envRefl, vec3(0.7, 0.55, 0.25), smoothstep(0.6, 1.0, reflUv.y));\n  \n  // ── Combine lighting ──\n  vec3 col = diffuse * 0.4 + specular * fres + envRefl * fres * 0.5;\n  \n  // ── Ambient: warm gold fill light ──\n  col += baseColor * 0.12;\n  \n  // ── Surface tension ripples: bright edges where metaballs meet ──\n  float metaGrad = abs(meta - 3.5);\n  float tensionLine = smoothstep(0.5, 0.0, metaGrad) * 0.3;\n  col += goldBright * tensionLine;\n  \n  // ── Subtle ripple highlights from fine noise ──\n  float ripple = noise(uv * 15.0 + t * 2.0);\n  ripple = ripple * ripple;\n  float rippleHighlight = smoothstep(0.6, 0.9, ripple) * 0.08;\n  col += whiteHot * rippleHighlight * fres;\n  \n  // ── Radial vignette: dark edges where gold thins, bright center ──\n  float dist = length(uv);\n  float vignette = 1.0 - smoothstep(0.3, 1.2, dist);\n  col *= 0.35 + vignette * 0.65;\n  \n  // ── Central pooling glow ──\n  float poolGlow = smoothstep(0.8, 0.0, dist) * 0.15;\n  col += goldBright * poolGlow;\n  \n  // ── Tone mapping (ACES-like) ──\n  col = col * (2.51 * col + 0.03) / (col * (2.43 * col + 0.59) + 0.14);\n  \n  // ── Slight warmth push ──\n  col = pow(col, vec3(0.95, 1.0, 1.08));\n  \n  gl_FragColor = vec4(col, 1.0);\n}", "format": "raw", "inputs": [{"name": "u_time", "type": "float", "default": 1}, {"name": "u_res", "type": "vec2", "default": [0.5, 0.5]}, {"name": "u_flowSpeed", "type": "float", "default": 0.4, "min": 0.1, "max": 1.5}, {"name": "u_viscosity", "type": "float", "default": 0.6, "min": 0.2, "max": 1}, {"name": "u_mouse", "type": "vec2", "default": [-1, -1]}], "description": "Molten metal flow with surface tension, metallic PBR shading, and golden reflections.", "categories": ["fill", "noise", "organic"]}, {"id": "radiant-aurora-veil", "name": "Aurora Veil", "kind": "generator", "family": "Radiant", "license": "MIT", "sourceUrl": "https://github.com/pbakaus/radiant/blob/59e9f48c0ad9a3db2fbeb8898b4390d5a1eabb40/static/aurora-veil.html", "source": "precision highp float;\nuniform float u_time;\nuniform vec2 u_res;\nuniform float u_auroraSpeed;\nuniform float u_auroraIntensity;\nuniform vec2 u_mouse;\n\n#define PI 3.14159265359\n#define NUM_BG_STARS 120\n\n// ── Hash functions ──\nfloat hash(vec2 p) {\n  return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);\n}\n\nfloat hash1(float n) {\n  return fract(sin(n) * 43758.5453123);\n}\n\n// ── Smooth value noise ──\nfloat noise(vec2 p) {\n  vec2 i = floor(p);\n  vec2 f = fract(p);\n  f = f * f * (3.0 - 2.0 * f);\n  float a = hash(i);\n  float b = hash(i + vec2(1.0, 0.0));\n  float c = hash(i + vec2(0.0, 1.0));\n  float d = hash(i + vec2(1.0, 1.0));\n  return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);\n}\n\n// ── FBM ──\nfloat fbm(vec2 p, float t, int octaves) {\n  float val = 0.0;\n  float amp = 0.5;\n  float freq = 1.0;\n  for (int i = 0; i < 6; i++) {\n    if (i >= octaves) break;\n    val += amp * noise(p * freq + t * 0.1);\n    freq *= 2.1;\n    amp *= 0.48;\n    p += vec2(1.7, 9.2);\n  }\n  return val;\n}\n\n// ── Aurora ribbon function ──\nfloat auroraRibbon(vec2 uv, float t, float ribbonX, float ribbonWidth, float waveFreq, float waveAmp, float phase) {\n  // Horizontal position of the ribbon center, slowly drifting\n  float centerX = ribbonX + sin(t * 0.15 + phase) * 0.25;\n\n  // The ribbon undulates with wide, dramatic flowing motion\n  float wave1 = sin(uv.y * waveFreq + t * 0.9 + phase) * waveAmp;\n  float wave2 = sin(uv.y * waveFreq * 2.3 + t * 1.3 + phase * 1.7) * waveAmp * 0.5;\n  float wave3 = sin(uv.y * waveFreq * 0.4 + t * 0.35 + phase * 0.6) * waveAmp * 1.2;\n  float wave4 = sin(uv.y * waveFreq * 3.7 + t * 1.8 + phase * 2.3) * waveAmp * 0.2;\n  float waveOffset = wave1 + wave2 + wave3 + wave4;\n\n  // Distance from ribbon center\n  float dx = uv.x - (centerX + waveOffset);\n\n  // Ribbon profile — wide gaussian falloff\n  float ribbon = exp(-dx * dx / (ribbonWidth * ribbonWidth));\n\n  // Brightness varies along the ribbon vertically — shimmer and pulse\n  float brightBand = 0.5 + 0.5 * sin(uv.y * 2.5 + t * 0.7 + phase * 2.0);\n  brightBand *= 0.5 + 0.5 * sin(uv.y * 5.0 - t * 0.9 + phase);\n\n  // Pulsing shimmer effect\n  float shimmer = 0.7 + 0.3 * sin(t * 2.5 + phase * 3.0 + uv.y * 8.0);\n  shimmer *= 0.8 + 0.2 * sin(t * 1.7 + phase * 1.1 + uv.x * 6.0);\n\n  // Vertical fade: aurora fills the upper half of the sky\n  // Strong presence from y=0.0 up to y=0.7, gentle fade at edges\n  float verticalFade = smoothstep(-0.35, -0.05, uv.y) * smoothstep(0.75, 0.35, uv.y);\n\n  // Add fine detail using noise\n  float detail = noise(vec2(uv.x * 6.0, uv.y * 10.0 + t * 0.5 + phase));\n  detail = 0.6 + 0.4 * detail;\n\n  return ribbon * brightBand * verticalFade * detail * shimmer;\n}\n\n// ── Background stars ──\nfloat bgStars(vec2 uv, float t) {\n  float stars = 0.0;\n  for (int i = 0; i < NUM_BG_STARS; i++) {\n    float fi = float(i);\n    vec2 pos = vec2(\n      hash1(fi * 17.31 + 100.0) * 2.8 - 1.4,\n      hash1(fi * 11.97 + 200.0) * 1.4 - 0.3\n    );\n    float d = length(uv - pos);\n    // Twinkling with varied speeds\n    float twinkleSpeed = 0.5 + hash1(fi * 3.3 + 300.0) * 2.0;\n    float twinkle = 0.3 + 0.7 * sin(t * twinkleSpeed + fi * 2.7);\n    twinkle = max(twinkle, 0.0);\n    twinkle *= twinkle;\n    float size = 0.0008 + hash1(fi * 5.5 + 400.0) * 0.002;\n    // Brighter stars\n    float brightness = 0.4 + hash1(fi * 7.7 + 500.0) * 0.6;\n    stars += smoothstep(size, 0.0, d) * twinkle * brightness;\n    // Add subtle glow around brighter stars\n    if (brightness > 0.7) {\n      stars += smoothstep(size * 5.0, 0.0, d) * twinkle * 0.08;\n    }\n  }\n  return stars;\n}\n\n// ── Ice crystal pattern (hexagonal frost) ──\nfloat hexDist(vec2 p) {\n  p = abs(p);\n  return max(p.x + p.y * 0.577350269, p.y * 1.154700538);\n}\n\nfloat crystalPattern(vec2 uv, float t) {\n  float scale = 12.0;\n  vec2 p = uv * scale;\n  vec2 r = vec2(1.0, 1.732);\n  vec2 h = r * 0.5;\n  vec2 a = mod(p, r) - h;\n  vec2 b = mod(p - h, r) - h;\n  vec2 gv = (dot(a, a) < dot(b, b)) ? a : b;\n  float hd = hexDist(gv);\n  float edge = smoothstep(0.45, 0.40, hd) - smoothstep(0.40, 0.35, hd);\n  float angle = atan(gv.y, gv.x);\n  float branch = abs(sin(angle * 3.0));\n  float branchLine = smoothstep(0.04, 0.0, abs(branch - 0.5) * hd);\n  branchLine *= smoothstep(0.0, 0.15, hd) * smoothstep(0.45, 0.25, hd);\n  float subBranch = abs(sin(angle * 6.0));\n  float subLine = smoothstep(0.03, 0.0, abs(subBranch - 0.5) * hd);\n  subLine *= smoothstep(0.1, 0.2, hd) * smoothstep(0.4, 0.3, hd);\n  float crystal = edge * 0.6 + branchLine * 0.4 + subLine * 0.2;\n  float shimmer = 0.7 + 0.3 * sin(t * 0.2 + hash(floor(p / r)) * 6.28);\n  crystal *= shimmer;\n  return crystal;\n}\n\nvoid main() {\n  vec2 uv = (gl_FragCoord.xy - u_res * 0.5) / min(u_res.x, u_res.y);\n  if (u_mouse.x > 0.0) {\n    vec2 mNorm = (u_mouse - u_res * 0.5) / min(u_res.x, u_res.y);\n    uv += (mNorm - uv) * 0.25;\n  }\n  vec2 screenUV = gl_FragCoord.xy / u_res;\n  float t = u_time * u_auroraSpeed;\n\n  // ── Dark sky background ──\n  vec3 col = vec3(0.012, 0.010, 0.022);\n  // Slight gradient — lighter near horizon\n  col += vec3(0.012, 0.010, 0.018) * smoothstep(0.5, -0.3, uv.y);\n\n  // ── Background stars ──\n  float starField = bgStars(uv, u_time);\n  vec3 starColor = vec3(0.9, 0.88, 0.8);\n  col += starColor * starField;\n\n  // ── Aurora ribbons — 7 layers for visual richness ──\n\n  // Ribbon 1: dominant green curtain, wide and bright\n  float r1 = auroraRibbon(uv, t, 0.0, 0.22, 2.5, 0.28, 0.0);\n  vec3 r1color = mix(\n    vec3(0.15, 0.95, 0.35),\n    vec3(0.10, 0.75, 0.55),\n    0.5 + 0.5 * sin(uv.y * 3.5 + t * 0.3)\n  );\n  // Purple at the top edges\n  r1color = mix(r1color, vec3(0.55, 0.20, 0.80), smoothstep(0.25, 0.65, uv.y) * 0.4);\n\n  // Ribbon 2: secondary green, offset to the right\n  float r2 = auroraRibbon(uv, t * 0.9, 0.35, 0.18, 2.8, 0.24, 2.1);\n  vec3 r2color = mix(\n    vec3(0.20, 0.90, 0.30),\n    vec3(0.30, 0.80, 0.25),\n    0.5 + 0.5 * sin(uv.y * 4.0 - t * 0.4 + 1.0)\n  );\n  r2color = mix(r2color, vec3(0.65, 0.25, 0.75), smoothstep(0.3, 0.6, uv.y) * 0.35);\n\n  // Ribbon 3: purple-magenta curtain on the left\n  float r3 = auroraRibbon(uv, t * 0.75, -0.30, 0.16, 3.0, 0.22, 4.3);\n  vec3 r3color = mix(\n    vec3(0.60, 0.15, 0.70),\n    vec3(0.80, 0.20, 0.55),\n    0.5 + 0.5 * sin(uv.y * 5.0 + t * 0.2 + 2.0)\n  );\n  r3color = mix(r3color, vec3(0.20, 0.70, 0.40), smoothstep(0.1, -0.1, uv.y) * 0.3);\n\n  // Ribbon 4: wide background green wash\n  float r4 = auroraRibbon(uv, t * 0.6, 0.15, 0.30, 1.8, 0.35, 1.0);\n  vec3 r4color = mix(\n    vec3(0.10, 0.65, 0.25),\n    vec3(0.05, 0.50, 0.35),\n    0.5 + 0.5 * sin(uv.y * 2.0 + t * 0.15)\n  );\n\n  // Ribbon 5: thin bright accent ribbon\n  float r5 = auroraRibbon(uv, t * 1.1, -0.10, 0.10, 3.5, 0.18, 5.7);\n  vec3 r5color = mix(\n    vec3(0.30, 1.0, 0.50),\n    vec3(0.50, 0.30, 0.90),\n    0.5 + 0.5 * sin(uv.y * 6.0 + t * 0.5 + 3.0)\n  );\n\n  // Ribbon 6: far right purple veil\n  float r6 = auroraRibbon(uv, t * 0.65, 0.55, 0.14, 2.2, 0.20, 3.5);\n  vec3 r6color = mix(\n    vec3(0.45, 0.10, 0.65),\n    vec3(0.70, 0.15, 0.50),\n    0.5 + 0.5 * sin(uv.y * 3.0 - t * 0.3 + 1.5)\n  );\n\n  // Ribbon 7: wide subtle green base layer\n  float r7 = auroraRibbon(uv, t * 0.5, -0.20, 0.35, 1.5, 0.30, 6.2);\n  vec3 r7color = mix(\n    vec3(0.08, 0.55, 0.20),\n    vec3(0.12, 0.45, 0.30),\n    0.5 + 0.5 * sin(uv.y * 2.5 + t * 0.1 + 4.0)\n  );\n\n  // Depth-based intensity layering\n  float i1 = r1 * 1.4 * u_auroraIntensity;\n  float i2 = r2 * 1.1 * u_auroraIntensity;\n  float i3 = r3 * 0.9 * u_auroraIntensity;\n  float i4 = r4 * 0.5 * u_auroraIntensity;\n  float i5 = r5 * 0.8 * u_auroraIntensity;\n  float i6 = r6 * 0.6 * u_auroraIntensity;\n  float i7 = r7 * 0.35 * u_auroraIntensity;\n\n  // Additive blending of all aurora light\n  vec3 auroraLight = r1color * i1 + r2color * i2 + r3color * i3\n                   + r4color * i4 + r5color * i5 + r6color * i6 + r7color * i7;\n\n  // Global pulsing intensity — aurora shimmers and breathes\n  float pulse = 0.85 + 0.15 * sin(t * 0.8) * sin(t * 0.53 + 1.0);\n  auroraLight *= pulse;\n\n  // Add atmospheric glow around the aurora\n  float glowY = smoothstep(-0.3, 0.0, uv.y) * smoothstep(0.75, 0.25, uv.y);\n  float totalAurora = i1 + i2 + i3 + i4 + i5 + i6 + i7;\n  vec3 atmosphericGlow = mix(\n    vec3(0.06, 0.15, 0.06),\n    vec3(0.10, 0.05, 0.12),\n    0.5 + 0.5 * sin(t * 0.15)\n  ) * glowY * min(totalAurora, 2.5) * 0.4;\n\n  col += auroraLight + atmosphericGlow;\n\n  // ── Stars dimmed by aurora light ──\n  col -= starColor * starField * clamp(totalAurora * 0.5, 0.0, 1.0);\n\n  // ── Ice crystal ground plane (lower portion) ──\n  float groundLine = -0.35;\n  float groundFade = smoothstep(groundLine + 0.05, groundLine - 0.15, uv.y);\n\n  if (groundFade > 0.001) {\n    float perspY = max(0.001, groundLine - uv.y);\n    vec2 crystalUV = vec2(uv.x / (perspY * 2.0 + 0.5), 1.0 / (perspY * 3.0));\n    crystalUV.x += t * 0.02;\n    float crystal = crystalPattern(crystalUV, u_time);\n    vec3 iceColor = vec3(0.06, 0.08, 0.12);\n    vec3 iceCrystalColor = vec3(0.18, 0.22, 0.32);\n    vec3 iceSurface = mix(iceColor, iceCrystalColor, crystal * 0.5);\n\n    // ── Aurora reflection on ice ──\n    vec2 reflUV = vec2(uv.x, -uv.y - groundLine * 2.0);\n    float rr1 = auroraRibbon(reflUV, t, 0.0, 0.25, 2.5, 0.28, 0.0) * 0.3;\n    float rr2 = auroraRibbon(reflUV, t * 0.9, 0.35, 0.20, 2.8, 0.24, 2.1) * 0.2;\n    float rr3 = auroraRibbon(reflUV, t * 0.75, -0.30, 0.18, 3.0, 0.22, 4.3) * 0.15;\n    vec3 reflectionColor = r1color * rr1 + r2color * rr2 + r3color * rr3;\n    reflectionColor *= u_auroraIntensity * pulse;\n    float reflStrength = smoothstep(0.25, 0.0, perspY) * 0.6;\n    float sparkle = pow(crystal, 3.0) * reflStrength;\n    vec3 sparkleColor = vec3(0.9, 0.85, 0.7) * sparkle * 0.3;\n    iceSurface += reflectionColor * reflStrength + sparkleColor;\n    col = mix(col, iceSurface, groundFade);\n  }\n\n  // ── Horizon glow where sky meets ice ──\n  float horizonDist = abs(uv.y - groundLine);\n  float horizonGlow = exp(-horizonDist * horizonDist / 0.003);\n  vec3 horizonColor = mix(\n    vec3(0.10, 0.20, 0.08),\n    vec3(0.12, 0.08, 0.18),\n    0.5 + 0.5 * sin(t * 0.2)\n  ) * min(totalAurora, 3.0) * 0.35 + vec3(0.02, 0.03, 0.04);\n  col += horizonColor * horizonGlow;\n\n  // ── Vignette ──\n  float dist = length(uv * vec2(0.7, 0.9));\n  float vignette = 1.0 - smoothstep(0.5, 1.5, dist);\n  col *= 0.7 + vignette * 0.3;\n\n  // ── Ensure no negatives ──\n  col = max(col, vec3(0.0));\n\n  // ── Subtle tone curve — boost saturation slightly ──\n  col = pow(col, vec3(0.92, 0.95, 0.98));\n\n  gl_FragColor = vec4(col, 1.0);\n}", "format": "raw", "inputs": [{"name": "u_time", "type": "float", "default": 1}, {"name": "u_res", "type": "vec2", "default": [0.5, 0.5]}, {"name": "u_auroraSpeed", "type": "float", "default": 0.5, "min": 0.1, "max": 1.5}, {"name": "u_auroraIntensity", "type": "float", "default": 1, "min": 0.3, "max": 2}, {"name": "u_mouse", "type": "vec2", "default": [-1, -1]}], "description": "Northern lights ribbons flowing above hexagonal ice crystal formations.", "categories": ["fill", "noise", "organic"]}, {"id": "radiant-bioluminescence", "name": "Bioluminescence", "kind": "generator", "family": "Radiant", "license": "MIT", "sourceUrl": "https://github.com/pbakaus/radiant/blob/59e9f48c0ad9a3db2fbeb8898b4390d5a1eabb40/static/bioluminescence.html", "source": "precision highp float;\nuniform float u_time;\nuniform vec2 u_res;\nuniform float u_glowIntensity;\nuniform float u_waveSpeed;\nuniform vec2 u_mouse;\n\n#define PI 3.14159265359\n#define TAU 6.28318530718\n\n// ── Hash & noise primitives ──\nfloat hash(vec2 p) {\n  return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);\n}\n\nfloat hash1(float n) {\n  return fract(sin(n) * 43758.5453123);\n}\n\nfloat noise(vec2 p) {\n  vec2 i = floor(p);\n  vec2 f = fract(p);\n  f = f * f * (3.0 - 2.0 * f);\n  float a = hash(i);\n  float b = hash(i + vec2(1.0, 0.0));\n  float c = hash(i + vec2(0.0, 1.0));\n  float d = hash(i + vec2(1.0, 1.0));\n  return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);\n}\n\n// ── FBM for layered detail ──\nfloat fbm(vec2 p, int octaves) {\n  float val = 0.0;\n  float amp = 0.5;\n  float freq = 1.0;\n  for (int i = 0; i < 8; i++) {\n    if (i >= octaves) break;\n    val += amp * noise(p * freq);\n    freq *= 2.03;\n    amp *= 0.49;\n    p += vec2(1.7, 9.2);\n  }\n  return val;\n}\n\n// ── Domain-warped noise for organic flow ──\nfloat warpedNoise(vec2 p, float t) {\n  vec2 q = vec2(\n    fbm(p + vec2(0.0, 0.0) + t * 0.04, 4),\n    fbm(p + vec2(5.2, 1.3) + t * 0.03, 4)\n  );\n  vec2 r = vec2(\n    fbm(p + 3.0 * q + vec2(1.7, 9.2) + t * 0.05, 4),\n    fbm(p + 3.0 * q + vec2(8.3, 2.8) + t * 0.04, 4)\n  );\n  return fbm(p + 2.5 * r, 5);\n}\n\n// ── Ocean wave height field ──\n// Returns a wave height and derivative-like value for foam/disturbance\nvec2 oceanWaves(vec2 p, float t) {\n  float h = 0.0;\n  float d = 0.0;\n  float amp = 1.0;\n  float freq = 1.0;\n\n  // Layer multiple wave directions for realistic ocean\n  for (int i = 0; i < 6; i++) {\n    float fi = float(i);\n    float angle = fi * 0.7 + 0.3;\n    vec2 dir = vec2(cos(angle), sin(angle));\n    float phase = dot(p * freq, dir) + t * (0.6 + fi * 0.15);\n    float wave = sin(phase) * 0.5 + 0.5;\n    // Sharp crests via pow\n    float sharpWave = pow(wave, 1.5);\n    h += sharpWave * amp;\n    // Disturbance is highest at wave crests\n    d += pow(wave, 3.0) * amp;\n    amp *= 0.55;\n    freq *= 1.8;\n  }\n  return vec2(h, d);\n}\n\n// ── Breaking wave / foam line detection ──\nfloat waveBreak(vec2 uv, float t) {\n  float breaks = 0.0;\n  for (int i = 0; i < 4; i++) {\n    float fi = float(i);\n    float y_center = 0.1 + fi * 0.22;\n    float wave_x = uv.x * (2.0 + fi * 0.8) + t * (0.15 + fi * 0.05);\n    float undulation = sin(wave_x) * 0.03 + sin(wave_x * 2.3 + fi) * 0.015;\n    float dist_to_wave = abs(uv.y - y_center - undulation);\n    float breakLine = smoothstep(0.03, 0.0, dist_to_wave);\n    // Modulate along the wave — some sections break, others don't\n    float modulation = noise(vec2(uv.x * 3.0 + fi * 10.0, t * 0.2 + fi));\n    modulation = smoothstep(0.35, 0.7, modulation);\n    breaks += breakLine * modulation * (1.0 - fi * 0.2);\n  }\n  return breaks;\n}\n\n// ── Bioluminescent glow patterns ──\n// Organisms glow when disturbed by wave motion\nfloat bioGlow(vec2 uv, float t) {\n  float glow = 0.0;\n\n  // Large-scale wave disturbance triggering glow\n  vec2 wv = oceanWaves(uv * 3.0, t * 0.8);\n  float disturbance = wv.y;\n\n  // Domain-warped organic glow patterns\n  float organic1 = warpedNoise(uv * 4.0 + vec2(t * 0.06, t * 0.04), t * 0.5);\n  float organic2 = warpedNoise(uv * 6.0 + vec2(-t * 0.05, t * 0.07), t * 0.4);\n\n  // Glow is triggered where waves disturb the water\n  glow += organic1 * disturbance * 0.8;\n  glow += organic2 * pow(disturbance, 2.0) * 0.5;\n\n  // Swirling tendrils of light — eddies and currents\n  vec2 eddy_uv = uv * 5.0 + vec2(t * 0.08, t * 0.05);\n  float eddy = fbm(eddy_uv, 6);\n  float eddy_curl = abs(eddy - fbm(eddy_uv + vec2(0.01, 0.0), 6)) * 80.0;\n  glow += eddy_curl * disturbance * 0.3;\n\n  // Scattered bright plankton clusters\n  for (int i = 0; i < 5; i++) {\n    float fi = float(i);\n    vec2 center = vec2(\n      hash1(fi * 13.7 + 1.0) * 1.6 - 0.3,\n      hash1(fi * 7.3 + 2.0) * 1.2 - 0.1\n    );\n    // Drift with current\n    center.x += sin(t * 0.05 + fi * 2.0) * 0.15;\n    center.y += cos(t * 0.04 + fi * 1.5) * 0.08;\n    float d = length(uv - center);\n    float cluster = exp(-d * d / (0.015 + hash1(fi * 3.1) * 0.02));\n    // Pulse and breathe\n    float pulse = sin(t * (0.3 + fi * 0.1) + fi * 4.0) * 0.5 + 0.5;\n    glow += cluster * pulse * disturbance * 1.5;\n  }\n\n  return glow;\n}\n\n// ── Individual bright plankton sparks ──\nfloat planktonSparks(vec2 uv, float t, float disturbance) {\n  float sparks = 0.0;\n  for (int i = 0; i < 25; i++) {\n    float fi = float(i);\n    vec2 pos = vec2(\n      hash1(fi * 17.3 + 100.0),\n      hash1(fi * 11.9 + 200.0)\n    );\n    // Drift in current\n    pos.x = fract(pos.x + t * (0.01 + hash1(fi * 5.1 + 300.0) * 0.02));\n    pos.y = fract(pos.y + sin(t * 0.3 + fi) * 0.02);\n\n    float d = length(uv - pos);\n    float size = 0.001 + hash1(fi * 3.7 + 400.0) * 0.003;\n    float spark = smoothstep(size, 0.0, d);\n\n    // Use pre-computed disturbance instead of per-spark wave calc\n    float trigger = smoothstep(0.2, 0.6, disturbance);\n\n    // Twinkle\n    float twinkle = sin(t * (1.0 + hash1(fi * 2.3) * 3.0) + fi * 7.0);\n    twinkle = twinkle * 0.5 + 0.5;\n\n    sparks += spark * trigger * twinkle * 0.8;\n  }\n  return sparks;\n}\n\nvoid main() {\n  vec2 uv = gl_FragCoord.xy / u_res;\n  // Aspect-corrected UV for wave calculations\n  float aspect = u_res.x / u_res.y;\n  vec2 uvAspect = vec2(uv.x * aspect, uv.y);\n  float t = u_time * u_waveSpeed;\n\n  // ── Deep ocean base color ──\n  // Dark navy-black gradient — darker at top (deep water), slightly lighter near surface\n  vec3 deepColor = vec3(0.017, 0.011, 0.0);\n  vec3 midColor = vec3(0.028, 0.018, 0.001);\n  vec3 surfaceColor = vec3(0.034, 0.024, 0.0);\n  vec3 col = mix(deepColor, surfaceColor, uv.y);\n\n  // ── Subtle underwater caustic light from moonlight ──\n  float caustic1 = noise(uvAspect * 8.0 + vec2(t * 0.12, t * 0.08));\n  float caustic2 = noise(uvAspect * 12.0 + vec2(-t * 0.1, t * 0.15));\n  float causticPattern = caustic1 * caustic2;\n  causticPattern = pow(causticPattern, 2.0) * 3.0;\n  // Caustics only near the surface\n  float surfaceFade = smoothstep(0.3, 0.95, uv.y);\n  col += vec3(0.034, 0.021, 0.005) * causticPattern * surfaceFade;\n\n  // ── Ocean wave structure ──\n  vec2 waves = oceanWaves(uvAspect * 2.5, t);\n  float waveHeight = waves.x;\n  float waveDisturbance = waves.y;\n\n  // Subtle wave shading — dark troughs, slightly lit crests\n  col += vec3(0.02, 0.012, 0.005) * waveHeight * 0.3;\n\n  // ── BIOLUMINESCENCE ──\n  float bio = bioGlow(uvAspect, t) * u_glowIntensity;\n\n  // ── Mouse attraction: brighten glow near cursor ──\n  if (u_mouse.x > 0.0) {\n    vec2 mUV = u_mouse / u_res;\n    vec2 mAspect = vec2(mUV.x * aspect, mUV.y);\n    float mDist = length(uvAspect - mAspect);\n    float attract = exp(-mDist * mDist * 10.0) * 1.2;\n    bio += attract * u_glowIntensity;\n  }\n\n  // Wave-break bioluminescence — brightest at breaking wave lines\n  float breaks = waveBreak(uvAspect, t);\n  bio += breaks * 1.2 * u_glowIntensity;\n\n  // Shape the glow — more concentrated, less uniform\n  bio = pow(max(bio, 0.0), 1.3);\n\n  // Bioluminescent color: electric blue-cyan with green tints\n  vec3 bioColor1 = vec3(0.55, 0.26, 0.0);   // Deep amber (→ cyan-blue via blue filter)\n  vec3 bioColor2 = vec3(0.90, 0.36, 0.41);  // Rose-amber (→ teal via blue filter)\n  vec3 bioColor3 = vec3(1.0, 0.53, 0.37);   // Bright warm (→ bright cyan via blue filter)\n\n  // Vary color across the scene for natural variation\n  float colorVar = noise(uvAspect * 2.0 + t * 0.02);\n  vec3 bioCol = mix(bioColor1, bioColor2, colorVar);\n  bioCol = mix(bioCol, bioColor3, smoothstep(0.5, 1.0, bio));\n\n  // Add the glow — additive blending\n  col += bioCol * bio * 0.7;\n\n  // ── Bright plankton sparks ──\n  float sparks = planktonSparks(uv, t, waveDisturbance);\n  vec3 sparkColor = vec3(1.0, 0.67, 0.52);\n  col += sparkColor * sparks * u_glowIntensity;\n\n  // ── Wave foam with bioluminescent edge ──\n  // Where waves break, there's a bright edge of churned-up plankton\n  float foam = waveBreak(uvAspect, t);\n  float foamDetail = noise(uvAspect * 25.0 + t * 0.3);\n  foam *= foamDetail;\n  col += vec3(0.70, 0.36, 0.28) * foam * 0.4 * u_glowIntensity;\n\n  // ── Flowing current streaks ──\n  // Long horizontal streaks of glow following water flow\n  float streak_uv_y = uv.y * 15.0;\n  float streakNoise = noise(vec2(uvAspect.x * 3.0 + t * 0.15, streak_uv_y));\n  float streak = pow(streakNoise, 5.0) * 2.0;\n  streak *= waveDisturbance;\n  col += vec3(0.38, 0.18, 0.06) * streak * u_glowIntensity;\n\n  // ── Surface reflection / bright zone near top ──\n  float surfaceGlow = smoothstep(0.7, 1.0, uv.y);\n  float surfaceWave = noise(vec2(uvAspect.x * 4.0 + t * 0.1, t * 0.2));\n  col += vec3(0.028, 0.018, 0.001) * surfaceGlow * surfaceWave;\n\n  // ── Depth fog — darker in the deep ──\n  float depthFog = smoothstep(0.6, 0.0, uv.y);\n  col = mix(col, deepColor * 0.5, depthFog * 0.4);\n\n  // ── Moonlight from above ──\n  // Soft diffuse light concentrated at the top-center\n  vec2 moonUV = uv - vec2(0.5, 1.0);\n  float moonDist = length(moonUV * vec2(1.0, 1.5));\n  float moonLight = exp(-moonDist * moonDist * 3.0);\n  col += vec3(0.034, 0.021, 0.005) * moonLight;\n\n  // ── Vignette ──\n  vec2 vigUV = uv - 0.5;\n  float vig = 1.0 - dot(vigUV, vigUV) * 1.8;\n  vig = clamp(vig, 0.0, 1.0);\n  col *= 0.5 + vig * 0.5;\n\n  // ── Tone mapping & color grading ──\n  col = max(col, vec3(0.0));\n\n  col = pow(max(col, 0.0), vec3(0.95, 1.0, 1.02));\n\n  gl_FragColor = vec4(col, 1.0);\n}", "format": "raw", "inputs": [{"name": "u_time", "type": "float", "default": 1}, {"name": "u_res", "type": "vec2", "default": [0.5, 0.5]}, {"name": "u_glowIntensity", "type": "float", "default": 1, "min": 0.3, "max": 2}, {"name": "u_waveSpeed", "type": "float", "default": 1, "min": 0.2, "max": 2}, {"name": "u_mouse", "type": "vec2", "default": [-1, -1]}], "description": "Deep sea jellyfish pulsing with bioluminescent glow and drifting plankton.", "categories": ["fill", "organic", "particles"]}, {"id": "radiant-gothic-filigree", "name": "Gothic Filigree", "kind": "generator", "family": "Radiant", "license": "MIT", "sourceUrl": "https://github.com/pbakaus/radiant/blob/59e9f48c0ad9a3db2fbeb8898b4390d5a1eabb40/static/gothic-filigree.html", "source": "precision highp float;\nuniform float u_time;\nuniform vec2 u_res;\nuniform float u_detail;\nuniform float u_glow;\nuniform vec2 u_mouse;\n\n#define PI 3.14159265359\n#define TAU 6.28318530718\n\nmat2 rot(float a) {\n  float c = cos(a), s = sin(a);\n  return mat2(c, -s, s, c);\n}\n\n// Gothic pointed arch SDF — two overlapping circles\nfloat archSDF(vec2 p, float w, float h) {\n  float sep = w * 0.38;\n  float rad = sqrt(sep * sep + h * h);\n  float d1 = length(p - vec2(-sep, 0.0)) - rad;\n  float d2 = length(p - vec2( sep, 0.0)) - rad;\n  float arch = max(d1, d2);\n  arch = max(arch, -p.y);\n  arch = max(arch, p.y - h * 1.1);\n  return arch;\n}\n\n// ── Main filigree composition ──\nfloat filigree(vec2 uv, float t) {\n  float d = 1e5;\n  float lw = 0.002;  // base line width — very thin\n\n  float angle = atan(uv.y, uv.x);\n  float r = length(uv);\n  vec2 p = abs(uv);  // 4-fold mirror\n\n  // ════════════════════════════════════════════\n  // ZONE 1: Central medallion (r < 0.12)\n  // ════════════════════════════════════════════\n  // Outer ring\n  float mR = 0.10;\n  d = min(d, abs(r - mR) - lw * 1.3);\n  // Inner ring\n  d = min(d, abs(r - 0.055) - lw * 0.8);\n  // Tiny center dot\n  d = min(d, r - 0.012);\n\n  // 8 petals inside medallion\n  float seg8 = TAU / 8.0;\n  float ra8 = mod(angle + seg8 * 0.5, seg8) - seg8 * 0.5;\n  vec2 petal8 = vec2(cos(ra8), sin(ra8)) * r;\n  // Small teardrop petal\n  float petalD = length((petal8 - vec2(0.075, 0.0)) * vec2(1.0, 2.5)) - 0.025;\n  petalD = max(petalD, -(r - 0.055));\n  petalD = max(petalD, r - mR);\n  d = min(d, abs(petalD) - lw * 0.6);\n\n  // ════════════════════════════════════════════\n  // ZONE 2: Inner tracery ring (0.12 — 0.28)\n  // ════════════════════════════════════════════\n  // Bounding rings\n  float r1 = 0.13 + 0.003 * sin(t * 0.5);\n  float r2 = 0.28 + 0.004 * sin(t * 0.4 + 1.0);\n  d = min(d, abs(r - r1) - lw);\n  d = min(d, abs(r - r2) - lw * 1.1);\n  // Mid ring with scallops\n  float midR = 0.205;\n  float scallop = 0.015 * abs(cos(angle * 8.0 + t * 0.08));\n  d = min(d, abs(r - midR - scallop) - lw * 0.7);\n\n  // 8 pointed gothic arches radiating outward\n  float ra8b = mod(angle + seg8 * 0.5, seg8) - seg8 * 0.5;\n  vec2 rp8 = vec2(cos(ra8b), sin(ra8b)) * r;\n  // Arch between r1 and r2\n  vec2 archP = rp8 - vec2(r1 + 0.01, 0.0);\n  archP *= rot(-PI * 0.5);  // rotate so arch points outward\n  float archW = 0.06;\n  float archH = (r2 - r1) * 0.85;\n  float arch = archSDF(archP, archW, archH);\n  d = min(d, abs(arch) - lw * 0.9);\n\n  // Nested inner arch (creates the tracery double-arch look)\n  vec2 archP2 = rp8 - vec2(r1 + 0.015, 0.0);\n  archP2 *= rot(-PI * 0.5);\n  float arch2 = archSDF(archP2, archW * 0.55, archH * 0.7);\n  d = min(d, abs(arch2) - lw * 0.6);\n\n  // Delicate spokes connecting rings (only in this zone)\n  float spoke = abs(ra8b);  // angular distance from spoke center\n  float spokeD = spoke * r - lw * 0.6;\n  spokeD = max(spokeD, -(r - r1));\n  spokeD = max(spokeD, r - r2);\n  d = min(d, spokeD);\n\n  // ════════════════════════════════════════════\n  // ZONE 3: Scrollwork belt (0.28 — 0.46)\n  // ════════════════════════════════════════════\n  float r3 = 0.46 + 0.005 * sin(t * 0.35 + 2.0);\n  d = min(d, abs(r - r3) - lw);\n\n  // Fleur-de-lis / quatrefoil ornaments at 8 positions\n  for (int i = 0; i < 8; i++) {\n    float ia = float(i) * seg8;\n    float ornR = 0.37;\n    vec2 oc = vec2(cos(ia), sin(ia)) * ornR;\n    vec2 op = uv - oc;\n    op *= rot(-ia);\n\n    // Paired arcs forming a heart/fleur shape (mirror on y)\n    vec2 opM = vec2(op.x, abs(op.y));\n\n    // Main lobe — arc curving outward\n    float lobe1 = abs(length(opM - vec2(0.015, 0.012)) - 0.022) - lw * 0.6;\n    lobe1 = max(lobe1, -opM.x + 0.002);  // clip inner edge\n    d = min(d, lobe1);\n\n    // Inner counter-lobe — smaller arc curving inward\n    float lobe2 = abs(length(opM - vec2(-0.008, 0.008)) - 0.015) - lw * 0.5;\n    lobe2 = max(lobe2, opM.x + 0.005);\n    d = min(d, lobe2);\n\n    // Central stem\n    float stem = abs(op.y) - lw * 0.5;\n    stem = max(stem, op.x - 0.035);\n    stem = max(stem, -op.x - 0.025);\n    d = min(d, stem);\n\n    // Tip finial — small circle at outer end\n    d = min(d, length(op - vec2(0.035, 0.0)) - 0.005);\n\n    // Base connecting to inner ring\n    float base = abs(length(op + vec2(0.02, 0.0)) - 0.025) - lw * 0.5;\n    base = max(base, abs(op.y) - 0.018);\n    base = max(base, op.x + 0.008);\n    d = min(d, base);\n  }\n\n  // 16 small cusps on inner edge of scrollwork belt\n  float seg16 = TAU / 16.0;\n  float ra16 = mod(angle + seg16 * 0.5, seg16) - seg16 * 0.5;\n  vec2 rp16 = vec2(cos(ra16), sin(ra16)) * r;\n  float cusp = length((rp16 - vec2(r2 + 0.01, 0.0)) * vec2(1.0, 3.0)) - 0.012;\n  d = min(d, abs(cusp) - lw * 0.5);\n\n  // ════════════════════════════════════════════\n  // ZONE 4: Outer tracery (0.46 — 0.68)\n  // ════════════════════════════════════════════\n  float r4 = 0.68;\n  d = min(d, abs(r - r4) - lw * 1.2);\n\n  // Large gothic arches — 4-fold with half-arch subdivisions\n  float seg4 = TAU / 4.0;\n  float ra4 = mod(angle + seg4 * 0.5, seg4) - seg4 * 0.5;\n  vec2 rp4 = vec2(cos(ra4), sin(ra4)) * r;\n\n  vec2 oArchP = rp4 - vec2(r3 + 0.01, 0.0);\n  oArchP *= rot(-PI * 0.5);\n  float oArch = archSDF(oArchP, 0.16, (r4 - r3) * 0.9);\n  d = min(d, abs(oArch) - lw);\n\n  // Sub-arches (two smaller ones inside each big arch)\n  vec2 subL = oArchP - vec2(-0.04, 0.0);\n  float subArchL = archSDF(subL, 0.06, (r4 - r3) * 0.55);\n  d = min(d, abs(subArchL) - lw * 0.7);\n\n  vec2 subR = oArchP - vec2(0.04, 0.0);\n  float subArchR = archSDF(subR, 0.06, (r4 - r3) * 0.55);\n  d = min(d, abs(subArchR) - lw * 0.7);\n\n  // Trefoil at apex of each big arch\n  vec2 tP = oArchP - vec2(0.0, (r4 - r3) * 0.65);\n  float trefoil = 1e5;\n  for (int j = 0; j < 3; j++) {\n    float ta = float(j) * TAU / 3.0 - PI * 0.5;\n    vec2 tc = vec2(cos(ta), sin(ta)) * 0.016;\n    trefoil = min(trefoil, length(tP - tc) - 0.012);\n  }\n  trefoil = max(trefoil, -(oArch + lw * 2.0));  // keep inside arch\n  d = min(d, abs(trefoil) - lw * 0.5);\n\n  // Diagonal spokes in outer zone (8-fold)\n  float ra8c = mod(angle + seg8 * 0.5 + seg8 * 0.5, seg8) - seg8 * 0.5;\n  float dSpoke = abs(ra8c) * r - lw * 0.5;\n  dSpoke = max(dSpoke, -(r - r3));\n  dSpoke = max(dSpoke, r - r4);\n  d = min(d, dSpoke);\n\n  // ════════════════════════════════════════════\n  // ZONE 5: Corner filigree (using mirror coords)\n  // ════════════════════════════════════════════\n  // Elegant arcs sweeping from edges\n  float cArc1 = abs(length(p - vec2(0.82, 0.0)) - 0.48) - lw * 1.0;\n  float cArc2 = abs(length(p - vec2(0.0, 0.82)) - 0.48) - lw * 1.0;\n  cArc1 = max(cArc1, -(p.y - 0.25));\n  cArc1 = max(cArc1, p.y - 0.72);\n  cArc2 = max(cArc2, -(p.x - 0.25));\n  cArc2 = max(cArc2, p.x - 0.72);\n  d = min(d, cArc1);\n  d = min(d, cArc2);\n\n  // Corner spiral flourishes\n  vec2 cp = p - vec2(0.58, 0.58);\n  float cr = length(cp);\n  float ca = atan(cp.y, cp.x);\n  float cSpiral = abs(cr - 0.015 * (ca / PI + 1.5)) - lw * 0.8;\n  cSpiral = max(cSpiral, cr - 0.10);\n  d = min(d, cSpiral);\n\n  // Mirror corner spiral\n  vec2 cp2 = vec2(cp.y, cp.x);\n  cr = length(cp2);\n  ca = atan(cp2.y, cp2.x);\n  cSpiral = abs(cr - 0.015 * (ca / PI + 1.5)) - lw * 0.8;\n  cSpiral = max(cSpiral, cr - 0.10);\n  d = min(d, cSpiral);\n\n  // ════════════════════════════════════════════\n  // ACCENTS: Dot ornaments at structural intersections\n  // ════════════════════════════════════════════\n  for (int k = 0; k < 8; k++) {\n    float da = float(k) * seg8;\n    // Dots on inner ring\n    d = min(d, length(uv - vec2(cos(da), sin(da)) * r1) - 0.005);\n    // Dots on mid ring\n    d = min(d, length(uv - vec2(cos(da), sin(da)) * r2) - 0.006);\n    // Dots on outer ring\n    d = min(d, length(uv - vec2(cos(da), sin(da)) * r3) - 0.005);\n    // Offset dots\n    float offA = da + seg8 * 0.5;\n    d = min(d, length(uv - vec2(cos(offA), sin(offA)) * midR) - 0.004);\n    d = min(d, length(uv - vec2(cos(offA), sin(offA)) * r4) - 0.005);\n  }\n\n  return d;\n}\n\n// Reveal from center outward\nfloat reveal(vec2 uv, float t) {\n  float r = length(uv);\n  float edge = t * 0.25;  // speed of reveal\n  float mask = smoothstep(edge, edge - 0.15, r);\n  // Fully revealed after a while\n  mask = max(mask, smoothstep(4.0, 5.5, t));\n  return mask;\n}\n\nvoid main() {\n  vec2 uv = (gl_FragCoord.xy - u_res * 0.5) / min(u_res.x, u_res.y);\n  uv = rot(u_mouse.x) * uv;\n\n  float t = u_time;\n  float d = filigree(uv, t);\n  float rev = reveal(uv, t);\n\n  // ── Anti-aliased line from SDF ──\n  float px = 1.2 / min(u_res.x, u_res.y);\n  float line = 1.0 - smoothstep(0.0, px * 1.8, d);\n\n  // ── Subtle glow ──\n  float gSig = 0.014 * u_glow;\n  float glow = exp(-d * d / (gSig * gSig * 2.0)) * 0.32;\n  float outerGlow = exp(-d * d / (gSig * gSig * 10.0)) * 0.10;\n\n  // ── Color ──\n  vec3 gold = vec3(0.90, 0.72, 0.34);\n  vec3 amber = vec3(0.78, 0.55, 0.20);\n  vec3 pale = vec3(1.0, 0.94, 0.76);\n  vec3 bronze = vec3(0.45, 0.28, 0.10);\n\n  float r = length(uv);\n  float ang = atan(uv.y, uv.x);\n  float cv = sin(ang * 4.0 + r * 6.0) * 0.5 + 0.5;\n  vec3 lineCol = mix(amber, gold, cv);\n  lineCol = mix(lineCol, pale, line * 0.25);\n\n  // ── Background ──\n  vec3 bg = vec3(0.028, 0.024, 0.022);\n\n  // ── Composite ──\n  vec3 col = bg;\n  col += bronze * outerGlow * rev;\n  col += amber * 0.5 * glow * rev;\n  col = mix(col, lineCol, line * rev);\n\n  // Vignette\n  float vig = smoothstep(0.0, 0.55, 1.0 - dot(uv * 0.75, uv * 0.75));\n  col *= 0.55 + 0.45 * vig;\n\n  // Gentle pulse once fully revealed\n  col *= 1.0 + 0.025 * sin(t * 0.35) * smoothstep(7.0, 10.0, t);\n\n  col = clamp(col, 0.0, 1.0);\n  col = pow(col, vec3(0.96));\n\n  gl_FragColor = vec4(col, 1.0);\n}", "format": "raw", "inputs": [{"name": "u_time", "type": "float", "default": 1}, {"name": "u_res", "type": "vec2", "default": [0.5, 0.5]}, {"name": "u_detail", "type": "float", "default": 1}, {"name": "u_glow", "type": "float", "default": 1}, {"name": "u_mouse", "type": "vec2", "default": [0, 0]}], "description": "Ornate fractal lace scrollwork growing from corners with dark metallic rendering.", "categories": ["fill", "organic", "geometric"]}, {"id": "radiant-thunder-sermon", "name": "Thunder Sermon", "kind": "generator", "family": "Radiant", "license": "MIT", "sourceUrl": "https://github.com/pbakaus/radiant/blob/59e9f48c0ad9a3db2fbeb8898b4390d5a1eabb40/static/thunder-sermon.html", "source": "precision highp float;\nuniform float u_time;\nuniform vec2 u_res;\nuniform float u_strikeInterval;\nuniform float u_flashIntensity;\nuniform vec2 u_mouse;\n\n#define PI 3.14159265359\n\n// ── Hash functions ──\nfloat hash(vec2 p) {\n  return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);\n}\n\nfloat hash1(float n) {\n  return fract(sin(n) * 43758.5453123);\n}\n\n// ── Smooth value noise ──\nfloat noise(vec2 p) {\n  vec2 i = floor(p);\n  vec2 f = fract(p);\n  f = f * f * (3.0 - 2.0 * f);\n  float a = hash(i);\n  float b = hash(i + vec2(1.0, 0.0));\n  float c = hash(i + vec2(0.0, 1.0));\n  float d = hash(i + vec2(1.0, 1.0));\n  return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);\n}\n\n// ── FBM ──\nfloat fbm(vec2 p, int octaves) {\n  float val = 0.0;\n  float amp = 0.5;\n  float freq = 1.0;\n  for (int i = 0; i < 7; i++) {\n    if (i >= octaves) break;\n    val += amp * noise(p * freq);\n    freq *= 2.03;\n    amp *= 0.5;\n    p += vec2(1.7, 9.2);\n  }\n  return val;\n}\n\n// ── Domain-warped storm clouds ──\nfloat stormClouds(vec2 p, float t) {\n  vec2 drift = vec2(t * 0.03, t * 0.015);\n  vec2 pp = p + drift;\n  vec2 q = vec2(\n    fbm(pp, 5),\n    fbm(pp + vec2(5.2, 1.3), 5)\n  );\n  vec2 r = vec2(\n    fbm(pp + 3.0 * q + vec2(1.7, 9.2) + t * 0.05, 6),\n    fbm(pp + 3.0 * q + vec2(8.3, 2.8) + t * 0.03, 6)\n  );\n  float f = fbm(pp + 2.5 * r, 7);\n  return f * 0.5 + length(q) * 0.3 + length(r) * 0.2;\n}\n\n// ── Point-to-segment distance ──\nfloat segDist(vec2 p, vec2 a, vec2 b) {\n  vec2 pa = p - a;\n  vec2 ba = b - a;\n  float h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);\n  return length(pa - ba * h);\n}\n\n// ── Lightning bolt: fractal jagged path with branches ──\nfloat lightningBolt(vec2 uv, float seed, float startX, float endX) {\n  float minD = 100.0;\n\n  // Main bolt from top to bottom of screen\n  float prevX = startX;\n  float prevY = -0.6;\n\n  for (int i = 1; i <= 14; i++) {\n    float fi = float(i);\n    float frac = fi / 14.0;\n\n    // Jagged lateral displacement\n    float jit = hash1(seed * 13.37 + fi * 7.91) * 2.0 - 1.0;\n    float jit2 = hash1(seed * 29.13 + fi * 3.17) * 2.0 - 1.0;\n    float disp = jit * 0.15 * (1.0 - frac * 0.4) + jit2 * 0.05;\n\n    float targetX = mix(startX, endX, frac);\n    float curX = targetX + disp;\n    float curY = mix(-0.6, 0.55, frac);\n\n    float d = segDist(uv, vec2(prevX, prevY), vec2(curX, curY));\n    minD = min(minD, d);\n\n    // Branches\n    float roll = hash1(seed * 5.71 + fi * 11.3);\n    if (roll > 0.45 && i > 1 && i < 13) {\n      float side = (hash1(seed * 3.3 + fi * 9.1) > 0.5) ? 1.0 : -1.0;\n      float bLen = 0.08 + hash1(seed * 7.7 + fi * 2.3) * 0.12;\n      float bAng = 0.5 + hash1(seed * 2.2 + fi * 5.5) * 0.6;\n\n      float bpx = curX;\n      float bpy = curY;\n      for (int j = 1; j <= 5; j++) {\n        float fj = float(j);\n        float bj = hash1(seed * 17.1 + fi * 3.7 + fj * 11.9) * 2.0 - 1.0;\n        float bnx = bpx + side * bLen * 0.2 + bj * 0.025;\n        float bny = bpy + bLen * 0.2 * bAng;\n        float bd = segDist(uv, vec2(bpx, bpy), vec2(bnx, bny));\n        minD = min(minD, bd * 1.5);\n        bpx = bnx;\n        bpy = bny;\n      }\n\n      // Sub-branch fork\n      if (hash1(seed * 9.9 + fi * 4.1) > 0.55) {\n        float sbx = curX + side * bLen * 0.12;\n        float sby = curY + bLen * 0.12 * bAng;\n        for (int k = 1; k <= 3; k++) {\n          float fk = float(k);\n          float sbj = hash1(seed * 23.7 + fi * 7.3 + fk * 5.1) * 2.0 - 1.0;\n          float sbnx = sbx - side * 0.025 + sbj * 0.015;\n          float sbny = sby + 0.035;\n          float sbd = segDist(uv, vec2(sbx, sby), vec2(sbnx, sbny));\n          minD = min(minD, sbd * 2.2);\n          sbx = sbnx;\n          sby = sbny;\n        }\n      }\n    }\n\n    prevX = curX;\n    prevY = curY;\n  }\n\n  return minD;\n}\n\n// ── Get bolt parameters for a given index ──\nvoid boltParams(int idx, float interval, out float birth, out float seed, out float sx, out float ex) {\n  float fi = float(idx);\n  birth = fi * interval + hash1(fi * 17.31 + 42.0) * interval * 0.5;\n  seed = fi * 7.13 + 1.0;\n  sx = (hash1(fi * 13.37 + 100.0) - 0.5) * 0.8;\n  ex = sx + (hash1(fi * 9.91 + 200.0) - 0.5) * 0.35;\n}\n\nvoid main() {\n  vec2 uv = (gl_FragCoord.xy - u_res * 0.5) / min(u_res.x, u_res.y);\n  vec2 screenUV = gl_FragCoord.xy / u_res;\n  float t = u_time;\n\n  // Mouse as lightning strike target\n  vec2 mouseTarget = vec2(0.0);\n  float mouseActive = 0.0;\n  if (u_mouse.x > 0.0) {\n    vec2 mUV = u_mouse / u_res;\n    mouseTarget = (mUV - 0.5) * vec2(u_res.x / u_res.y, 1.0);\n    mouseActive = 1.0;\n  }\n\n  // ── Storm sky ──\n  vec3 skyTop = vec3(0.015, 0.008, 0.05);\n  vec3 skyMid = vec3(0.025, 0.018, 0.07);\n  vec3 skyBot = vec3(0.01, 0.012, 0.035);\n  vec3 sky = mix(skyTop, skyMid, smoothstep(0.0, 0.5, screenUV.y));\n  sky = mix(sky, skyBot, smoothstep(0.5, 1.0, screenUV.y));\n\n  // ── Storm clouds ──\n  float cloud1 = stormClouds(uv * 1.8, t);\n  float cloud2 = stormClouds(uv * 2.4 + vec2(3.7, 1.2), t * 1.1);\n  float cloudDensity = smoothstep(0.3, 0.75, cloud1) * 0.6 + smoothstep(0.35, 0.8, cloud2) * 0.4;\n\n  // Denser clouds in upper portion\n  float heightBias = smoothstep(0.85, 0.0, screenUV.y);\n  cloudDensity *= 0.4 + heightBias * 0.6;\n\n  vec3 cloudDark = vec3(0.025, 0.02, 0.055);\n  vec3 cloudMid = vec3(0.055, 0.045, 0.09);\n  vec3 cloudLight = vec3(0.09, 0.07, 0.13);\n  vec3 cloudColor = mix(cloudDark, cloudMid, smoothstep(0.1, 0.4, cloudDensity));\n  cloudColor = mix(cloudColor, cloudLight, smoothstep(0.4, 0.8, cloudDensity));\n\n  vec3 col = mix(sky, cloudColor, cloudDensity * 0.85);\n\n  // ── Lightning system ──\n  float interval = u_strikeInterval;\n  float totalFlash = 0.0;\n  vec3 boltLight = vec3(0.0);\n\n  // Cycle through bolt slots\n  float period = interval * 60.0;\n  float ct = mod(t, period);\n  int cycle = int(floor(ct / interval));\n\n  for (int i = -2; i <= 5; i++) {\n    int bi = cycle + i;\n    if (bi < 0) continue;\n\n    float birth, seed, sx, ex;\n    boltParams(bi, interval, birth, seed, sx, ex);\n\n    if (mouseActive > 0.5) {\n      ex = mix(ex, mouseTarget.x, 0.6);\n      sx = mix(sx, mouseTarget.x, 0.3);\n    }\n    float age = ct - birth;\n    if (age < -0.01 || age > 1.5) continue;\n    if (age < 0.0) age = 0.0;\n\n    // Flash lifecycle\n    float flash = 0.0;\n    if (age < 0.06) {\n      flash = 1.0;\n    } else if (age < 0.12) {\n      flash = 0.4 + 0.6 * smoothstep(0.12, 0.06, age);\n    } else if (age < 0.22) {\n      // Restrike\n      float rs = smoothstep(0.12, 0.16, age) * smoothstep(0.22, 0.16, age);\n      flash = 0.15 + rs * 0.7;\n    } else if (age < 0.7) {\n      flash = 0.15 * smoothstep(0.7, 0.22, age);\n    }\n\n    float boltVis = smoothstep(0.45, 0.0, age);\n\n    if (boltVis > 0.001) {\n      float d = lightningBolt(uv, seed, sx, ex);\n\n      // Outer atmospheric bloom\n      float outer = exp(-d * d / 0.012) * boltVis * flash;\n      boltLight += vec3(0.25, 0.25, 0.7) * outer * 0.6;\n\n      // Mid glow\n      float mid = exp(-d * d / 0.003) * boltVis * flash;\n      boltLight += vec3(0.5, 0.6, 1.0) * mid;\n\n      // Hot white core\n      float core = exp(-d * d / 0.0004) * boltVis;\n      float coreI = flash;\n      if (age > 0.06 && age < 0.4) {\n        float flk = 0.5 + 0.5 * sin(age * 130.0 + seed * 10.0);\n        flk *= 0.5 + 0.5 * sin(age * 73.0 + seed * 7.0);\n        coreI *= 0.4 + flk * 0.6;\n      }\n      boltLight += vec3(1.0, 0.97, 0.92) * core * coreI * 3.0;\n\n      // Super bright center\n      float inner = exp(-d * d / 0.00006) * boltVis * flash;\n      boltLight += vec3(1.0) * inner * 4.0;\n    }\n\n    // Cloud illumination\n    if (flash > 0.01) {\n      vec2 bc = vec2(sx, -0.1);\n      float dc = length(uv - bc);\n\n      // Wide area illumination\n      float illum = exp(-dc * dc / 0.45) * flash;\n      illum *= 0.25 + cloudDensity * 0.75;\n      vec3 illumCol = mix(vec3(0.12, 0.1, 0.22), vec3(0.35, 0.3, 0.55), cloudDensity);\n      col += illumCol * illum * 2.2;\n\n      // Close white illumination\n      float close = exp(-dc * dc / 0.08) * flash;\n      col += vec3(0.25, 0.22, 0.32) * close * cloudDensity * 1.5;\n\n      // Ground illumination (bottom of screen)\n      float groundDist = length(uv - vec2(ex, 0.55));\n      float groundGlow = exp(-groundDist * groundDist / 0.1) * flash;\n      col += vec3(0.15, 0.13, 0.22) * groundGlow * 0.8;\n\n      totalFlash += flash * 0.5;\n    }\n\n    // Chromatic aberration shake on fresh strikes\n    if (age < 0.1) {\n      float shake = smoothstep(0.1, 0.0, age) * 0.35;\n      float sn = hash1(seed + floor(age * 60.0)) * 2.0 - 1.0;\n      col.r += sn * shake * 0.06;\n      col.b -= sn * shake * 0.04;\n    }\n  }\n\n  col += boltLight;\n\n  // Global screen flash\n  totalFlash = min(totalFlash, 1.0);\n  col += vec3(0.1, 0.08, 0.16) * totalFlash * u_flashIntensity;\n\n  // ── Sheet lightning (distant cloud flashes) ──\n  float st = t * 0.8;\n  for (int i = 0; i < 3; i++) {\n    float fi = float(i);\n    float ss = fi * 31.7 + 100.0;\n    float sc = hash1(ss + floor(st + fi * 0.37));\n    float sa = fract(st + fi * 0.37);\n\n    if (sc > 0.65) {\n      float sf = smoothstep(0.04, 0.0, sa) + smoothstep(0.12, 0.04, sa) * 0.35;\n      vec2 sp = vec2(\n        (hash1(ss + 1.0) - 0.5) * 1.4,\n        (hash1(ss + 2.0) - 0.5) * 0.5 - 0.15\n      );\n      float sd = length(uv - sp);\n      float sg = exp(-sd * sd / 0.2) * sf;\n      col += vec3(0.07, 0.05, 0.14) * sg * (0.5 + cloudDensity * 1.5);\n    }\n  }\n\n  // ── Rain ──\n  vec2 rainUV = gl_FragCoord.xy / min(u_res.x, u_res.y);\n  vec2 rc = vec2(rainUV.x + rainUV.y * 0.12, rainUV.y);\n  rc.y += t * 3.0;\n  rc.x += t * 0.35;\n\n  float rain = 0.0;\n  for (int i = 0; i < 3; i++) {\n    float fi = float(i);\n    float scale = 35.0 + fi * 20.0;\n    vec2 rv = rc * scale + vec2(fi * 7.3, fi * 11.1);\n    float ry = fract(rv.y);\n    float rx = floor(rv.x);\n    float rs = hash1(rx * 13.7 + fi * 31.0);\n    if (rs > 0.65) {\n      float streak = smoothstep(0.0, 0.008, ry) * smoothstep(0.12 + rs * 0.08, 0.008, ry);\n      rain += streak * (0.018 + fi * 0.006);\n    }\n  }\n  col += vec3(0.35, 0.38, 0.5) * rain * (0.25 + totalFlash * 2.5);\n\n  // ── Vignette ──\n  float vd = length(uv);\n  float vig = 1.0 - smoothstep(0.35, 1.3, vd);\n  col *= 0.5 + vig * 0.5;\n\n  // ── Tone mapping ──\n  col = col / (1.0 + col);\n  col.r = pow(col.r, 1.05);\n  col.b = pow(col.b, 0.93);\n  col = max(col, vec3(0.0));\n\n  gl_FragColor = vec4(col, 1.0);\n}", "format": "raw", "inputs": [{"name": "u_time", "type": "float", "default": 1}, {"name": "u_res", "type": "vec2", "default": [0.5, 0.5]}, {"name": "u_strikeInterval", "type": "float", "default": 1.5, "min": 1, "max": 8}, {"name": "u_flashIntensity", "type": "float", "default": 1}, {"name": "u_mouse", "type": "vec2", "default": [-1, -1]}], "description": "Fractal lightning bolts with Lichtenberg branching and thunder shockwaves.", "categories": ["fill", "physics"]}, {"id": "radiant-vinyl-grooves", "name": "Vinyl Grooves", "kind": "generator", "family": "Radiant", "license": "MIT", "sourceUrl": "https://github.com/pbakaus/radiant/blob/59e9f48c0ad9a3db2fbeb8898b4390d5a1eabb40/static/vinyl-grooves.html", "source": "precision highp float;\nuniform float u_time;\nuniform vec2 u_res;\nuniform float u_rotSpeed;\nuniform float u_grooveDensity;\nuniform vec2 u_mouse;\n\n#define PI 3.14159265359\n#define TAU 6.28318530718\n\n// ── Hash ──\nfloat hash(float n) {\n  return fract(sin(n) * 43758.5453123);\n}\n\nfloat hash2(vec2 p) {\n  return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);\n}\n\n// ── Smooth value noise ──\nfloat vnoise(float x) {\n  float i = floor(x);\n  float f = fract(x);\n  f = f * f * (3.0 - 2.0 * f);\n  return mix(hash(i), hash(i + 1.0), f);\n}\n\nfloat vnoise2(vec2 p) {\n  vec2 i = floor(p);\n  vec2 f = fract(p);\n  f = f * f * (3.0 - 2.0 * f);\n  float a = hash2(i);\n  float b = hash2(i + vec2(1.0, 0.0));\n  float c = hash2(i + vec2(0.0, 1.0));\n  float d = hash2(i + vec2(1.0, 1.0));\n  return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);\n}\n\n// ── HSV to RGB ──\nvec3 hsv2rgb(float h, float s, float v) {\n  vec3 c = vec3(h, s, v);\n  vec3 rgb = clamp(abs(mod(c.x * 6.0 + vec3(0.0, 4.0, 2.0), 6.0) - 3.0) - 1.0, 0.0, 1.0);\n  return c.z * mix(vec3(1.0), rgb, c.y);\n}\n\n// ── Groove micro-structure ──\n// Simulates the V-shaped groove cross-section of a vinyl record.\n// Returns a groove profile value: 1.0 at groove walls, 0.0 at groove floor.\nfloat grooveProfile(float r, float density) {\n  // Primary fine grooves — ~300 lines per inch on a real record\n  float grooveFreq = 280.0 * density;\n  float groove = r * grooveFreq;\n  float grooveFract = fract(groove);\n\n  // V-shaped groove profile: sharp valley, reflective walls\n  float profile = abs(grooveFract - 0.5) * 2.0;\n  // Sharpen the groove walls\n  profile = pow(profile, 0.7);\n\n  return profile;\n}\n\n// ── Groove waveform modulation ──\n// Simulates the audio waveform cut into the groove walls.\n// This creates the characteristic wobble visible under magnification.\nfloat grooveWaveform(float angle, float r) {\n  float wave = 0.0;\n  // Low frequency (bass)\n  wave += sin(angle * 3.0 + r * 47.0) * 0.4;\n  // Mid frequency\n  wave += sin(angle * 7.0 + r * 91.0 + 1.3) * 0.3;\n  // High frequency (treble)\n  wave += sin(angle * 17.0 + r * 157.0 + 2.7) * 0.2;\n  // Ultra-fine detail\n  wave += sin(angle * 31.0 + r * 233.0 + 4.1) * 0.1;\n  return wave;\n}\n\n// ── Diffraction grating color ──\n// Vinyl grooves act as a diffraction grating, splitting white light\n// into spectral colors. The color depends on the angle between\n// the groove tangent, incident light, and viewing direction.\nvec3 diffractionColor(float gratingAngle, float intensity) {\n  // Map the grating angle to a hue — simulates spectral dispersion\n  // Different diffraction orders create different color bands\n  float hue1 = fract(gratingAngle * 0.5 + 0.0);\n  float hue2 = fract(gratingAngle * 0.5 + 0.33);\n  float hue3 = fract(gratingAngle * 0.5 + 0.67);\n\n  // First-order diffraction (strongest)\n  vec3 color1 = hsv2rgb(hue1, 0.7, 1.0) * 0.6;\n  // Second-order (fainter, offset)\n  vec3 color2 = hsv2rgb(hue2, 0.5, 0.8) * 0.25;\n  // Third-order (very faint)\n  vec3 color3 = hsv2rgb(hue3, 0.4, 0.6) * 0.15;\n\n  return (color1 + color2 + color3) * intensity;\n}\n\nvoid main() {\n  vec2 uv = (gl_FragCoord.xy - u_res * 0.5) / min(u_res.x, u_res.y);\n  float t = u_time * u_rotSpeed;\n\n  // ── Record geometry ──\n  float dist = length(uv);\n  float angle = atan(uv.y, uv.x) + u_mouse.x;\n\n  // Record boundaries\n  float recordRadius = 0.44;\n  float labelRadius = recordRadius * 0.27;\n  float grooveInner = labelRadius + 0.01;\n  float grooveOuter = recordRadius - 0.015;\n\n  // ── Background — deep dark ──\n  vec3 col = vec3(0.012, 0.010, 0.010);\n\n  // Subtle warm ambient glow beneath the record\n  float ambientGlow = exp(-dist * dist * 1.8) * 0.03;\n  col += vec3(0.08, 0.05, 0.03) * ambientGlow;\n\n  // ── Record disc ──\n  if (dist < recordRadius) {\n    // Record rotation — the grooves spin under the light\n    float rpm = 33.333;\n    float rotationAngle = t * rpm / 60.0 * TAU;\n    float rotatedAngle = angle + rotationAngle;\n\n    // Normalized radial position within groove area\n    float rNorm = (dist - grooveInner) / (grooveOuter - grooveInner);\n    rNorm = clamp(rNorm, 0.0, 1.0);\n\n    // ── Vinyl base color — very dark with subtle warmth ──\n    vec3 vinylBase = vec3(0.02, 0.018, 0.016);\n    // Slight radial variation\n    vinylBase += vec3(0.005) * vnoise2(vec2(dist * 20.0, angle * 3.0));\n\n    col = vinylBase;\n\n    // ── Groove structure ──\n    if (dist > grooveInner && dist < grooveOuter) {\n      // Groove profile — the V-shaped cross section\n      float profile = grooveProfile(dist, u_grooveDensity);\n\n      // Audio waveform modulation — makes grooves visibly wobble\n      float waveform = grooveWaveform(rotatedAngle, dist) * 0.0004;\n      float modulatedDist = dist + waveform;\n      float modulatedProfile = grooveProfile(modulatedDist, u_grooveDensity);\n\n      // Groove visibility — subtle dark/light alternation\n      float grooveShading = mix(0.015, 0.03, modulatedProfile);\n      col = vec3(grooveShading, grooveShading * 0.95, grooveShading * 0.9);\n\n      // ── Light sources for reflections ──\n      // Primary warm spotlight — upper right, slowly drifting\n      vec2 light1Pos = vec2(0.6, 0.5);\n      // Secondary cool fill light — lower left\n      vec2 light2Pos = vec2(-0.5, -0.4);\n\n      // ── Specular reflection off groove walls ──\n      // The groove walls are angled, creating directional reflections.\n      // As the record rotates, different parts of each groove\n      // catch the light at different angles.\n\n      // Direction from this point to light\n      vec2 toLight1 = normalize(light1Pos - uv);\n      vec2 toLight2 = normalize(light2Pos - uv);\n\n      // Groove tangent direction (perpendicular to radial)\n      vec2 radialDir = normalize(uv);\n      vec2 tangentDir = vec2(-radialDir.y, radialDir.x);\n\n      // Angle between light direction and groove tangent\n      // This determines which spectral color is reflected\n      float lightGrooveAngle1 = dot(toLight1, tangentDir);\n      float lightGrooveAngle2 = dot(toLight2, tangentDir);\n\n      // Distance-based light falloff from each source\n      float lightDist1 = length(light1Pos - uv);\n      float lightDist2 = length(light2Pos - uv);\n      float lightFalloff1 = 1.0 / (1.0 + lightDist1 * lightDist1 * 2.0);\n      float lightFalloff2 = 1.0 / (1.0 + lightDist2 * lightDist2 * 3.0);\n\n      // ── Prismatic diffraction from grooves ──\n      // The fine groove spacing acts as a diffraction grating.\n      // The reflected color depends on the angle.\n\n      // Primary light diffraction\n      float gratingPhase1 = lightGrooveAngle1 + rotatedAngle * 0.05;\n      vec3 diffraction1 = diffractionColor(gratingPhase1, lightFalloff1);\n\n      // Secondary light diffraction\n      float gratingPhase2 = lightGrooveAngle2 + rotatedAngle * 0.05 + 0.5;\n      vec3 diffraction2 = diffractionColor(gratingPhase2, lightFalloff2);\n\n      // Groove walls reflect more when the profile is at the wall angle\n      float wallReflectivity = smoothstep(0.3, 0.8, modulatedProfile);\n\n      // ── Specular highlight bands ──\n      // On a real record, you see bright arcs where the groove angle\n      // perfectly reflects light to the viewer.\n\n      // Primary specular arc\n      float specAngle1 = acos(clamp(lightGrooveAngle1, -1.0, 1.0));\n      float specBand1 = exp(-pow(specAngle1 - PI * 0.25, 2.0) * 8.0);\n      specBand1 += exp(-pow(specAngle1 - PI * 0.75, 2.0) * 8.0) * 0.5;\n\n      // Secondary specular arc\n      float specAngle2 = acos(clamp(lightGrooveAngle2, -1.0, 1.0));\n      float specBand2 = exp(-pow(specAngle2 - PI * 0.3, 2.0) * 6.0) * 0.6;\n\n      // ── Combine reflections ──\n      // Warm ambient reflected light off the vinyl surface\n      vec3 ambientReflection = vec3(0.04, 0.03, 0.025) * lightFalloff1;\n\n      // Prismatic groove reflections\n      vec3 grooveReflection = vec3(0.0);\n      grooveReflection += diffraction1 * specBand1 * wallReflectivity * 1.2;\n      grooveReflection += diffraction2 * specBand2 * wallReflectivity * 0.8;\n\n      // Warm specular highlight — the bright band of reflected light\n      vec3 warmSpec = vec3(0.95, 0.75, 0.5);\n      float specIntensity1 = specBand1 * lightFalloff1 * wallReflectivity;\n      float specIntensity2 = specBand2 * lightFalloff2 * wallReflectivity;\n      vec3 specularHighlight = warmSpec * (specIntensity1 * 0.15 + specIntensity2 * 0.08);\n\n      // ── Broad light sheen ──\n      // The overall warm glow where the spotlight falls on the record\n      float sheen = exp(-lightDist1 * lightDist1 * 3.0) * 0.08;\n      sheen += exp(-lightDist2 * lightDist2 * 4.0) * 0.03;\n      vec3 sheenColor = vec3(0.2, 0.15, 0.1) * sheen;\n\n      // ── Micro-groove detail shimmer ──\n      // Very fine flickering as individual grooves catch light\n      float microGroove = fract(dist * 280.0 * u_grooveDensity);\n      float microFlicker = pow(abs(sin(microGroove * PI)), 12.0);\n      float microAngle = sin(rotatedAngle * 3.0 + dist * 200.0);\n      float microSpec = microFlicker * max(microAngle, 0.0) * lightFalloff1 * 0.1;\n\n      // ── Additional rainbow bands ──\n      // Multiple diffraction orders create concentric rainbow arcs\n      float bandPhase = rotatedAngle + dist * 60.0;\n      float rainbowBand = sin(bandPhase * 2.0) * 0.5 + 0.5;\n      rainbowBand = pow(rainbowBand, 3.0);\n      float rainbowHue = fract(dist * 8.0 + angle * 0.3 + t * 0.02);\n      vec3 rainbowColor = hsv2rgb(rainbowHue, 0.6, 0.4) * rainbowBand;\n      rainbowColor *= specBand1 * lightFalloff1 * 0.3;\n\n      // ── Assemble final groove color ──\n      col += ambientReflection;\n      col += grooveReflection;\n      col += specularHighlight;\n      col += sheenColor;\n      col += vec3(microSpec) * vec3(1.0, 0.9, 0.8);\n      col += rainbowColor;\n\n      // ── Lead-in and run-out grooves ──\n      // Wider spacing at the edges\n      float edgeFade = smoothstep(0.0, 0.03, rNorm) * smoothstep(1.0, 0.97, rNorm);\n      col *= edgeFade * 0.9 + 0.1;\n    }\n\n    // ── Center label ──\n    if (dist < labelRadius) {\n      // Warm amber/gold label — Tyler-inspired earthy tones\n      float labelR = dist / labelRadius;\n      vec3 labelColor = mix(\n        vec3(0.45, 0.30, 0.12),\n        vec3(0.30, 0.18, 0.08),\n        labelR\n      );\n\n      // Subtle paper texture on the label\n      float paperTex = vnoise2(vec2(\n        cos(rotatedAngle) * dist * 50.0,\n        sin(rotatedAngle) * dist * 50.0\n      ));\n      labelColor += vec3(0.03, 0.02, 0.01) * paperTex;\n\n      // Label ring decoration\n      float ring1 = smoothstep(0.72, 0.74, labelR) - smoothstep(0.76, 0.78, labelR);\n      labelColor += vec3(0.1, 0.07, 0.03) * ring1;\n\n      // Spindle hole\n      float spindleHole = smoothstep(0.08, 0.06, labelR);\n      labelColor = mix(labelColor, vec3(0.01), spindleHole);\n\n      // Light reflection on label\n      vec2 light1Pos = vec2(0.6, 0.5);\n      float labelLight = exp(-length(light1Pos - uv) * length(light1Pos - uv) * 4.0);\n      labelColor += vec3(0.15, 0.1, 0.05) * labelLight;\n\n      col = labelColor;\n    }\n\n    // ── Record edge ──\n    float edgeDist = recordRadius - dist;\n    float edgeHighlight = smoothstep(0.008, 0.0, edgeDist) * 0.3;\n    col += vec3(0.15, 0.12, 0.08) * edgeHighlight;\n\n    // Edge shadow/bevel\n    float edgeShadow = smoothstep(0.02, 0.0, edgeDist);\n    col *= 1.0 - edgeShadow * 0.3;\n\n    // Anti-alias the record edge\n    float edgeAA = smoothstep(recordRadius, recordRadius - 0.002, dist);\n    col *= edgeAA;\n  }\n\n  // ── Drop shadow beneath record ──\n  if (dist >= recordRadius) {\n    float shadowDist = dist - recordRadius;\n    float shadow = exp(-shadowDist * shadowDist * 80.0) * 0.25;\n    col = mix(col, vec3(0.0), shadow);\n  }\n\n  // ── Vignette ──\n  float vig = 1.0 - dot(uv * 0.8, uv * 0.8);\n  vig = smoothstep(0.0, 1.0, vig);\n  col *= 0.7 + vig * 0.3;\n\n  // ── Tone mapping ──\n  col = col / (1.0 + col * 0.2);\n\n  // ── Final warmth ──\n  col = pow(max(col, 0.0), vec3(0.95, 0.98, 1.05));\n\n  gl_FragColor = vec4(col, 1.0);\n}", "format": "raw", "inputs": [{"name": "u_time", "type": "float", "default": 1}, {"name": "u_res", "type": "vec2", "default": [0.5, 0.5]}, {"name": "u_rotSpeed", "type": "float", "default": 1}, {"name": "u_grooveDensity", "type": "float", "default": 1}, {"name": "u_mouse", "type": "vec2", "default": [0, 0]}], "description": "Spinning vinyl record with visible grooves, tonearm, and needle spark.", "categories": ["object", "geometric"]}, {"id": "radiant-polaroid-burn", "name": "Polaroid Burn", "kind": "generator", "family": "Radiant", "license": "MIT", "sourceUrl": "https://github.com/pbakaus/radiant/blob/59e9f48c0ad9a3db2fbeb8898b4390d5a1eabb40/static/polaroid-burn.html", "source": "precision highp float;\nuniform float u_time;\nuniform vec2 u_res;\nuniform float u_burnSpeed;\nuniform float u_photoCount;\nuniform vec2 u_mouse;\n\n// --- Hash / noise utilities ---\nfloat hash(float n){ return fract(sin(n)*43758.5453123); }\nfloat hash2(vec2 p){ return fract(sin(dot(p, vec2(127.1,311.7)))*43758.5453123); }\n\nvec2 hash2v(vec2 p){\n  return vec2(hash2(p), hash2(p + vec2(37.0, 91.0)));\n}\n\n// Simplex-like 2D noise\nvec3 mod289(vec3 x){return x-floor(x*(1.0/289.0))*289.0;}\nvec2 mod289v2(vec2 x){return x-floor(x*(1.0/289.0))*289.0;}\nvec3 permute(vec3 x){return mod289(((x*34.0)+1.0)*x);}\n\nfloat snoise(vec2 v){\n  const vec4 C=vec4(0.211324865405187,0.366025403784439,-0.577350269189626,0.024390243902439);\n  vec2 i=floor(v+dot(v,C.yy));\n  vec2 x0=v-i+dot(i,C.xx);\n  vec2 i1=(x0.x>x0.y)?vec2(1.0,0.0):vec2(0.0,1.0);\n  vec4 x12=x0.xyxy+C.xxzz; x12.xy-=i1;\n  i=mod289v2(i);\n  vec3 p=permute(permute(i.y+vec3(0.0,i1.y,1.0))+i.x+vec3(0.0,i1.x,1.0));\n  vec3 m=max(0.5-vec3(dot(x0,x0),dot(x12.xy,x12.xy),dot(x12.zw,x12.zw)),0.0);\n  m=m*m; m=m*m;\n  vec3 x=2.0*fract(p*C.www)-1.0;\n  vec3 h=abs(x)-0.5;\n  vec3 ox=floor(x+0.5);\n  vec3 a0=x-ox;\n  m*=1.79284291400159-0.85373472095314*(a0*a0+h*h);\n  vec3 g;\n  g.x=a0.x*x0.x+h.x*x0.y;\n  g.yz=a0.yz*x12.xz+h.yz*x12.yw;\n  return 130.0*dot(m,g);\n}\n\nfloat fbm(vec2 p){\n  float f=0.0;\n  f+=0.5000*snoise(p); p*=2.02;\n  f+=0.2500*snoise(p); p*=2.03;\n  f+=0.1250*snoise(p); p*=2.01;\n  f+=0.0625*snoise(p);\n  return f;\n}\n\n// Rotation matrix\nmat2 rot(float a){ float c=cos(a), s=sin(a); return mat2(c,-s,s,c); }\n\n// Rounded rectangle SDF\nfloat roundedRectSDF(vec2 p, vec2 halfSize, float radius){\n  vec2 d=abs(p)-halfSize+radius;\n  return length(max(d, 0.0))+min(max(d.x,d.y), 0.0)-radius;\n}\n\n// Get deterministic polaroid properties from index\nvec2 getPhotoPos(float idx){\n  float hx = hash(idx * 73.156);\n  float hy = hash(idx * 127.843);\n  return vec2(hx * 1.2 - 0.6, hy * 0.8 - 0.4);\n}\n\nfloat getPhotoAngle(float idx){\n  return (hash(idx * 231.71) - 0.5) * 0.6;\n}\n\nfloat getPhotoPhase(float idx){\n  return hash(idx * 347.29) * 6.2831853;\n}\n\n// Warm nostalgic gradient for \"photo\" content\nvec3 photoGradient(vec2 localUV, float idx){\n  float n1 = fbm(localUV * 2.0 + vec2(hash(idx*13.0)*10.0, hash(idx*29.0)*10.0));\n  float n2 = fbm(localUV * 1.5 + vec2(hash(idx*53.0)*10.0, hash(idx*67.0)*10.0));\n\n  // Olivia Rodrigo nostalgia palette: faded pinks, amber, soft purple\n  vec3 c1 = vec3(0.85, 0.45, 0.55);  // faded pink\n  vec3 c2 = vec3(0.82, 0.58, 0.32);  // amber\n  vec3 c3 = vec3(0.55, 0.38, 0.65);  // soft purple\n  vec3 c4 = vec3(0.90, 0.72, 0.55);  // warm peach\n  vec3 c5 = vec3(0.65, 0.30, 0.45);  // dusty rose\n\n  float blend = n1 * 0.5 + 0.5;\n  float blend2 = n2 * 0.5 + 0.5;\n  float idxMod = hash(idx * 91.0);\n\n  vec3 colA = mix(c1, c2, blend);\n  vec3 colB = mix(c3, c4, blend2);\n  vec3 col = mix(colA, colB, idxMod);\n  col = mix(col, c5, smoothstep(0.4, 0.9, localUV.y) * 0.3);\n\n  // Add gentle vignette inside the photo\n  float photoVig = 1.0 - length(localUV) * 0.6;\n  col *= 0.7 + 0.3 * clamp(photoVig, 0.0, 1.0);\n\n  return col;\n}\n\n// Compute a single polaroid contribution\n// Returns vec4(rgb, alpha)\nvec4 polaroid(vec2 p, float idx, float time, float px){\n  vec2 center = getPhotoPos(idx);\n  float angle = getPhotoAngle(idx);\n  float phase = getPhotoPhase(idx);\n\n  // Cycle duration and phase\n  float cycleDur = 6.2831853;\n  float t = mod(time * u_burnSpeed + phase, cycleDur);\n  float tNorm = t / cycleDur; // 0..1 cycle\n\n  // Lifecycle phases:\n  // 0.0 - 0.15: fade in from black (develop)\n  // 0.15 - 0.45: full color (peak exposure)\n  // 0.45 - 0.75: overexpose to white + burn edges\n  // 0.75 - 0.95: burn out with embers\n  // 0.95 - 1.0: fade to nothing\n\n  // Overall visibility envelope\n  float appear = smoothstep(0.0, 0.05, tNorm);\n  float disappear = 1.0 - smoothstep(0.90, 1.0, tNorm);\n  float visibility = appear * disappear;\n\n  if(visibility < 0.001) return vec4(0.0);\n\n  // Transform coordinate into polaroid space\n  vec2 lp = p - center;\n  lp = rot(angle) * lp;\n\n  // Polaroid dimensions (photo + border)\n  vec2 outerSize = vec2(0.16, 0.20);  // outer polaroid frame\n  vec2 innerSize = vec2(0.13, 0.13);  // inner photo area (square)\n  vec2 innerOffset = vec2(0.0, -0.02); // photo shifted up (bigger bottom border)\n  float cornerR = 0.006;\n  float aa = px * 2.0;  // pixel-relative anti-aliasing width\n\n  // Outer frame SDF\n  float outerD = roundedRectSDF(lp, outerSize, cornerR);\n  float outerMask = smoothstep(aa, 0.0, outerD);\n\n  if(outerMask < 0.001) return vec4(0.0);\n\n  // Inner photo SDF\n  float innerD = roundedRectSDF(lp - innerOffset, innerSize, 0.003);\n  float innerMask = smoothstep(aa, 0.0, innerD);\n\n  // Photo UV for gradient\n  vec2 photoUV = (lp - innerOffset) / innerSize;\n\n  // --- Develop phase ---\n  float developAmount = smoothstep(0.0, 0.20, tNorm);\n\n  // --- Overexposure phase ---\n  float overexpose = smoothstep(0.40, 0.70, tNorm);\n\n  // --- Burn phase ---\n  float burnPhase = smoothstep(0.50, 0.85, tNorm);\n\n  // Noise-driven burn edge propagation\n  float burnNoise = fbm(lp * 12.0 + vec2(hash(idx*17.0)*5.0, hash(idx*31.0)*5.0));\n  burnNoise += snoise(lp * 20.0 + time * 0.3) * 0.3;\n  float burnEdgeDist = -outerD * 8.0; // distance from edge, normalized\n  float burnMask = smoothstep(0.0, 1.0, burnPhase * 3.0 - burnEdgeDist - burnNoise * 0.5);\n\n  // --- Compose the polaroid ---\n\n  // Paper white with slight warm tint\n  vec3 paperColor = vec3(0.95, 0.93, 0.90);\n\n  // Photo content\n  vec3 photoColor = photoGradient(photoUV, idx);\n\n  // Develop: fade from dark to color\n  photoColor = mix(vec3(0.02, 0.01, 0.02), photoColor, developAmount);\n\n  // Overexpose: push toward blown-out white\n  photoColor = mix(photoColor, vec3(1.0, 0.98, 0.95), overexpose * 0.85);\n\n  // Paper also overexposes\n  paperColor = mix(paperColor, vec3(1.0), overexpose * 0.3);\n\n  // Combine paper border and photo area\n  vec3 polaroidColor = mix(paperColor, photoColor, innerMask);\n\n  // Apply burn: charred black edges with glowing amber embers\n  float emberGlow = burnMask * (1.0 - smoothstep(0.0, 0.5, burnMask));\n  vec3 emberColor = vec3(1.0, 0.5, 0.1) * 2.0; // bright amber-orange glow\n  vec3 charColor = vec3(0.03, 0.02, 0.01);\n\n  // Burning edge: char -> ember glow -> transparent\n  polaroidColor = mix(polaroidColor, charColor, smoothstep(0.0, 0.5, burnMask));\n  polaroidColor += emberColor * emberGlow * 1.5;\n\n  // Subtle paper shadow / depth\n  float shadow = smoothstep(0.0, 0.02, -outerD) * 0.15;\n\n  // Alpha: frame mask, visibility, and burn-through\n  float burnHole = smoothstep(0.6, 1.0, burnMask);\n  float alpha = outerMask * visibility * (1.0 - burnHole);\n\n  // Add subtle shadow under the polaroid\n  float shadowD = roundedRectSDF(lp + vec2(0.004, 0.006), outerSize + 0.01, cornerR);\n  float shadowMask = smoothstep(0.02, 0.0, shadowD) * 0.25 * visibility * (1.0 - burnPhase);\n\n  return vec4(polaroidColor + shadowMask * 0.01, alpha + shadowMask * (1.0 - alpha));\n}\n\nvoid main(){\n  vec2 uv = gl_FragCoord.xy / u_res;\n  vec2 aspect = vec2(u_res.x / u_res.y, 1.0);\n  vec2 p = (uv - 0.5) * aspect;\n  // Mouse: compute heat source at cursor\n  float mouseHeat = 0.0;\n  if (u_mouse.x > 0.0) {\n    vec2 mP = (u_mouse / u_res - 0.5) * aspect;\n    float mDist = length(p - mP);\n    mouseHeat = exp(-mDist * mDist * 8.0);\n  }\n  float t = u_time;\n  float px = 1.0 / min(u_res.x, u_res.y);\n\n  // Background: very subtle animated noise texture\n  vec3 bg = vec3(0.039, 0.039, 0.039);\n  float bgNoise = snoise(p * 3.0 + t * 0.02) * 0.008;\n  bg += bgNoise;\n\n  // Subtle ambient warm glow in background\n  float ambientGlow = exp(-length(p) * 2.5) * 0.03;\n  bg += vec3(0.8, 0.5, 0.3) * ambientGlow;\n\n  vec3 col = bg;\n\n  // Render polaroids back to front\n  int maxPhotos = 8;\n  for(int i = 0; i < 8; i++){\n    if(float(i) >= u_photoCount) break;\n    float idx = float(i);\n    vec4 p4 = polaroid(p, idx, t, px);\n\n    // Premultiplied alpha composite\n    col = mix(col, p4.rgb, p4.a);\n  }\n\n  // Mouse heat: ember glow at cursor\n  if (mouseHeat > 0.01) {\n    col += vec3(1.0, 0.5, 0.1) * mouseHeat * 0.4;\n    col = mix(col, vec3(0.15, 0.05, 0.0), mouseHeat * 0.3);\n  }\n\n  // Global vignette\n  float vig = 1.0 - smoothstep(0.4, 1.2, length(p * vec2(0.85, 1.0)));\n  col *= 0.65 + 0.35 * vig;\n\n  // Film grain\n  float grain = (fract(sin(dot(gl_FragCoord.xy, vec2(12.9898,78.233)) + fract(u_time*0.1)*100.0)*43758.5453) - 0.5) * 0.02;\n  col += grain;\n\n  // Tone mapping: subtle S-curve\n  col = clamp(col, 0.0, 1.0);\n  col = col * col * (3.0 - 2.0 * col);\n\n  gl_FragColor = vec4(col, 1.0);\n}", "format": "raw", "inputs": [{"name": "u_time", "type": "float", "default": 1}, {"name": "u_res", "type": "vec2", "default": [0.5, 0.5]}, {"name": "u_burnSpeed", "type": "float", "default": 0.6, "min": 0.2, "max": 2}, {"name": "u_photoCount", "type": "float", "default": 5, "min": 3, "max": 8}, {"name": "u_mouse", "type": "vec2", "default": [-1, -1]}], "description": "Scattered polaroid photos developing warm abstract memories, overexposing, and burning out with ember edges.", "categories": ["fill", "noise"]}, {"id": "radiant-scream-wave", "name": "Scream Wave", "kind": "generator", "family": "Radiant", "license": "MIT", "sourceUrl": "https://github.com/pbakaus/radiant/blob/59e9f48c0ad9a3db2fbeb8898b4390d5a1eabb40/static/scream-wave.html", "source": "precision highp float;\nuniform float u_time;\nuniform vec2 u_res;\nuniform float u_intensity;\nuniform float u_waveSpeed;\nuniform vec2 u_mouse;\n\n#define PI 3.14159265359\n#define CYCLE 7.0\n\n// ── Hash for noise ──\nfloat hash(float n) {\n  return fract(sin(n) * 43758.5453123);\n}\n\nfloat hash2(vec2 p) {\n  return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);\n}\n\n// ── Value noise ──\nfloat noise(float x) {\n  float i = floor(x);\n  float f = fract(x);\n  f = f * f * (3.0 - 2.0 * f);\n  return mix(hash(i), hash(i + 1.0), f);\n}\n\n// ── 2D noise for visual grain ──\nfloat noise2d(vec2 p) {\n  vec2 i = floor(p);\n  vec2 f = fract(p);\n  f = f * f * (3.0 - 2.0 * f);\n  float a = hash2(i);\n  float b = hash2(i + vec2(1.0, 0.0));\n  float c = hash2(i + vec2(0.0, 1.0));\n  float d = hash2(i + vec2(1.0, 1.0));\n  return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);\n}\n\n// ── Emotional intensity envelope ──\n// Returns 0..1 representing the emotional arc\nfloat emotionCurve(float t) {\n  // Phase timing within 7s cycle:\n  // 0.0 - 1.5: calm (0.0 - 0.214)\n  // 1.5 - 3.5: building (0.214 - 0.5)\n  // 3.5 - 5.0: scream (0.5 - 0.714)\n  // 5.0 - 7.0: collapse (0.714 - 1.0)\n  float phase = fract(t / CYCLE);\n\n  // Calm: gentle sine breathing (wider transitions for smooth blending)\n  float calm = smoothstep(0.0, 0.06, phase) * (1.0 - smoothstep(0.14, 0.25, phase));\n  float calmVal = 0.08 + 0.04 * sin(phase * PI * 20.0);\n\n  // Building: exponential ramp (overlapping transitions)\n  float buildStart = 0.214;\n  float buildEnd = 0.5;\n  float build = smoothstep(buildStart - 0.03, buildStart + 0.04, phase) * (1.0 - smoothstep(buildEnd - 0.04, buildEnd + 0.02, phase));\n  float buildProgress = clamp((phase - buildStart) / (buildEnd - buildStart), 0.0, 1.0);\n  // Smooth the progress curve itself\n  buildProgress = buildProgress * buildProgress * (3.0 - 2.0 * buildProgress);\n  float buildVal = 0.1 + buildProgress * buildProgress * 0.85;\n\n  // Scream: peak with turbulence (wider entry/exit)\n  float screamStart = 0.5;\n  float screamEnd = 0.714;\n  float scream = smoothstep(screamStart - 0.03, screamStart + 0.03, phase) * (1.0 - smoothstep(screamEnd - 0.04, screamEnd + 0.01, phase));\n  float screamProgress = clamp((phase - screamStart) / (screamEnd - screamStart), 0.0, 1.0);\n  float screamVal = 0.95 + 0.05 * sin(screamProgress * PI);\n\n  // Collapse: flash spike then exponential decay with flutter\n  float collapseStart = 0.714;\n  float collapse = smoothstep(collapseStart - 0.04, collapseStart + 0.03, phase);\n  float collapseProgress = clamp((phase - collapseStart) / (1.0 - collapseStart), 0.0, 1.0);\n  // Brief brightness flash at the start of collapse\n  float collapseFlash = exp(-collapseProgress * 20.0) * 0.25;\n  // Decaying flutter/wobble\n  float flutter = sin(collapseProgress * 40.0) * exp(-collapseProgress * 5.0) * 0.08;\n  float collapseVal = (0.95 + collapseFlash) * exp(-collapseProgress * 4.5) + flutter;\n  collapseVal = max(collapseVal, 0.0);\n\n  return calmVal * calm + buildVal * build + screamVal * scream + collapseVal * collapse;\n}\n\n// ── Waveform function ──\n// x: position along wave, t: time, emotion: 0..1 intensity\nfloat waveform(float x, float t, float emotion, float speed) {\n  float baseFreq = 3.0;\n  float timeOsc = t * speed;\n\n  // Base sine wave\n  float wave = sin(x * baseFreq * PI * 2.0 + timeOsc * 4.0);\n\n  // Subtle second harmonic always present (warmth in calm phase)\n  wave += sin(x * baseFreq * 2.0 * PI * 2.0 + timeOsc * 3.0 + 0.8) * 0.12;\n\n  // Add harmonics that increase with emotion\n  float harmonics = emotion * emotion;\n  wave += sin(x * baseFreq * 2.0 * PI * 2.0 + timeOsc * 6.0 + 0.5) * harmonics * 0.5;\n  wave += sin(x * baseFreq * 3.0 * PI * 2.0 + timeOsc * 8.0 + 1.2) * harmonics * harmonics * 0.35;\n  wave += sin(x * baseFreq * 5.0 * PI * 2.0 + timeOsc * 12.0 + 2.1) * harmonics * harmonics * 0.2;\n  wave += sin(x * baseFreq * 7.0 * PI * 2.0 - timeOsc * 5.0 + 3.7) * pow(harmonics, 3.0) * 0.15;\n\n  // High frequency noise at peak emotion\n  float noiseAmt = smoothstep(0.7, 1.0, emotion);\n  wave += (noise(x * 40.0 + timeOsc * 15.0) - 0.5) * 2.0 * noiseAmt * 0.6;\n  wave += (noise(x * 80.0 - timeOsc * 20.0) - 0.5) * 2.0 * noiseAmt * noiseAmt * 0.3;\n\n  // Amplitude scales with emotion\n  float amplitude = 0.05 + emotion * 0.45;\n  wave *= amplitude;\n\n  // Hard clipping at scream peak - creates that harsh distortion\n  float clipThreshold = mix(0.5, 0.12, smoothstep(0.8, 1.0, emotion));\n  wave = clamp(wave, -clipThreshold, clipThreshold);\n\n  return wave;\n}\n\nvoid main() {\n  vec2 fragCoord = gl_FragCoord.xy;\n  vec2 uv = fragCoord / u_res;\n  float aspect = u_res.x / u_res.y;\n  float t = u_time;\n\n  // ── Mouse: shift distortion center ──\n  vec2 mouseShift = vec2(0.0);\n  if (u_mouse.x > 0.0) {\n    vec2 mNorm = u_mouse / u_res;\n    mouseShift = (mNorm - 0.5) * 0.3;\n  }\n\n  // Emotional intensity\n  float emotion = emotionCurve(t) * u_intensity;\n  emotion = clamp(emotion, 0.0, 1.0);\n\n  // ── Background ──\n  // Dark, with subtle color that shifts with emotion\n  vec3 bgCalm = vec3(0.02, 0.01, 0.04);\n  vec3 bgScream = vec3(0.06, 0.01, 0.01);\n  vec3 bg = mix(bgCalm, bgScream, emotion);\n\n  // Subtle radial gradient behind the wave\n  float centerDist = length(uv - vec2(0.5, 0.5));\n  float bgGlow = exp(-centerDist * centerDist * 3.0);\n  vec3 bgGlowColor = mix(vec3(0.05, 0.02, 0.08), vec3(0.12, 0.02, 0.02), emotion);\n  bg += bgGlowColor * bgGlow * (0.3 + emotion * 0.5);\n\n  // ── Screen noise at peak ──\n  float screenNoise = 0.0;\n  float noiseIntensity = smoothstep(0.6, 1.0, emotion);\n  if (noiseIntensity > 0.0) {\n    screenNoise = (noise2d(fragCoord * 0.8 + t * 100.0) - 0.5) * noiseIntensity * 0.15;\n    screenNoise += (noise2d(fragCoord * 2.5 + t * 200.0) - 0.5) * noiseIntensity * noiseIntensity * 0.08;\n  }\n\n  // ── Chromatic aberration offset ──\n  float chromatic = smoothstep(0.5, 1.0, emotion) * 0.025 * u_intensity;\n\n  // Vertical jitter during scream\n  float jitter = smoothstep(0.85, 1.0, emotion) * (noise(t * 30.0) - 0.5) * 0.015;\n\n  // ── Horizontal glitch displacement during scream ──\n  float glitchAmt = smoothstep(0.8, 1.0, emotion);\n  float glitchBand = step(0.92, noise(floor(uv.y * 25.0) + floor(t * 8.0) * 7.3));\n  float glitchOffset = glitchBand * glitchAmt * (noise(t * 50.0 + uv.y * 10.0) - 0.5) * 0.06;\n\n  // ── Compute waveform SDF for each RGB channel ──\n  // Map uv.x to wave x coordinate\n  float waveX = uv.x + glitchOffset - mouseShift.x;\n\n  // Centered y coordinate (-0.5 to 0.5) with mouse shift\n  float yCenter = uv.y - 0.5 + jitter - mouseShift.y;\n\n  // Compute wave value at this x\n  float speed = u_waveSpeed;\n\n  // Red channel - offset for chromatic aberration\n  float waveR = waveform(waveX - chromatic, t, emotion, speed);\n  float distR = abs(yCenter - waveR);\n\n  // Green channel - center\n  float waveG = waveform(waveX, t, emotion, speed);\n  float distG = abs(yCenter - waveG);\n\n  // Blue channel - opposite offset\n  float waveB = waveform(waveX + chromatic, t, emotion, speed);\n  float distB = abs(yCenter - waveB);\n\n  // ── Wave thickness and glow ──\n  // Core line thickness (thicker base for warm calm, thicker still during scream)\n  float lineThickness = 0.003 + emotion * 0.004;\n\n  // Inner glow radius (wider base glow for warmth)\n  float glowRadius = 0.022 + emotion * 0.038;\n\n  // Outer bloom\n  float bloomRadius = 0.08 + emotion * 0.14;\n\n  // ── Color palette based on emotion ──\n  // Calm: warm lavender/purple with golden undertone\n  vec3 calmColor = vec3(0.62, 0.42, 0.88);\n  // Building: hot pink/magenta\n  vec3 buildColor = vec3(0.95, 0.2, 0.6);\n  // Scream: harsh white/red\n  vec3 screamCoreColor = vec3(1.0, 0.95, 0.9);\n  vec3 screamGlowColor = vec3(1.0, 0.25, 0.1);\n\n  // Interpolate colors\n  float buildPhase = smoothstep(0.1, 0.6, emotion);\n  float screamPhase = smoothstep(0.7, 0.95, emotion);\n\n  vec3 coreColor = mix(calmColor, buildColor, buildPhase);\n  coreColor = mix(coreColor, screamCoreColor, screamPhase);\n\n  vec3 glowColor = mix(calmColor * 0.6, buildColor * 0.7, buildPhase);\n  glowColor = mix(glowColor, screamGlowColor, screamPhase);\n\n  // ── Compute per-channel intensities ──\n  // Core line\n  float coreR = smoothstep(lineThickness, 0.0, distR);\n  float coreG = smoothstep(lineThickness, 0.0, distG);\n  float coreB = smoothstep(lineThickness, 0.0, distB);\n\n  // Inner glow\n  float glowR = exp(-distR * distR / (glowRadius * glowRadius));\n  float glowG = exp(-distG * distG / (glowRadius * glowRadius));\n  float glowB = exp(-distB * distB / (glowRadius * glowRadius));\n\n  // Outer bloom\n  float bloomR = exp(-distR * distR / (bloomRadius * bloomRadius));\n  float bloomG = exp(-distG * distG / (bloomRadius * bloomRadius));\n  float bloomB = exp(-distB * distB / (bloomRadius * bloomRadius));\n\n  // ── Compose final color ──\n  vec3 col = bg;\n\n  // When emotion is low, render as single-color (no chromatic split)\n  // When emotion is high, split into RGB channels\n  float splitAmount = smoothstep(0.4, 0.9, emotion);\n\n  // Unified wave (low emotion)\n  float unifiedCore = smoothstep(lineThickness, 0.0, distG);\n  float unifiedGlow = exp(-distG * distG / (glowRadius * glowRadius));\n  float unifiedBloom = exp(-distG * distG / (bloomRadius * bloomRadius));\n\n  // Core brightness increases during scream\n  float coreBright = 2.0 + smoothstep(0.8, 1.0, emotion) * 1.5;\n\n  vec3 unifiedCol = coreColor * unifiedCore * coreBright\n                  + glowColor * unifiedGlow * 0.9\n                  + glowColor * 0.35 * unifiedBloom;\n\n  // Split wave (high emotion) - chromatic aberration\n  vec3 splitCol = vec3(0.0);\n  // Red channel gets the red-shifted wave\n  splitCol.r = coreColor.r * coreR * coreBright + glowColor.r * glowR * 0.9 + glowColor.r * 0.35 * bloomR;\n  // Green channel gets the center wave\n  splitCol.g = coreColor.g * coreG * coreBright + glowColor.g * glowG * 0.9 + glowColor.g * 0.35 * bloomG;\n  // Blue channel gets the blue-shifted wave\n  splitCol.b = coreColor.b * coreB * coreBright + glowColor.b * glowB * 0.9 + glowColor.b * 0.35 * bloomB;\n\n  vec3 waveCol = mix(unifiedCol, splitCol, splitAmount);\n  col += waveCol;\n\n  // ── Reflection: mirrored faded wave below center ──\n  // Mirror the y coordinate around center (0.5)\n  float reflUvY = 1.0 - uv.y;\n  float reflYCenter = reflUvY - 0.5 + jitter;\n  float reflDistG = abs(reflYCenter - waveG);\n  // Fade: strongest just below center, fading to nothing toward bottom\n  float belowCenter = uv.y - 0.5;\n  float reflFade = step(0.0, belowCenter) * (1.0 - smoothstep(0.0, 0.35, belowCenter)) * 0.2;\n  float reflGlow = exp(-reflDistG * reflDistG / (glowRadius * glowRadius * 3.0));\n  float reflBloom = exp(-reflDistG * reflDistG / (bloomRadius * bloomRadius * 2.5));\n  vec3 reflCol = glowColor * reflGlow * 0.45 + glowColor * reflBloom * 0.12;\n  col += reflCol * reflFade;\n\n  // ── Horizontal scan lines during scream (subtle CRT effect) ──\n  float scanline = smoothstep(0.8, 1.0, emotion) * 0.08;\n  float scan = sin(fragCoord.y * 1.5) * 0.5 + 0.5;\n  col *= 1.0 - scanline * scan;\n\n  // ── Screen noise ──\n  col += vec3(screenNoise);\n\n  // ── Subtle edge darkening (vignette) ──\n  vec2 vigUV = uv - 0.5;\n  float vig = 1.0 - dot(vigUV, vigUV) * 1.8;\n  vig = clamp(vig, 0.0, 1.0);\n  col *= 0.5 + vig * 0.5;\n\n  // ── Pulsing brightness at scream peak ──\n  float pulse = 1.0 + smoothstep(0.85, 1.0, emotion) * sin(t * 25.0) * 0.15;\n  col *= pulse;\n\n  // ── Tone mapping ──\n  col = col / (1.0 + col * 0.4);\n  col = pow(col, vec3(0.95));\n  col = max(col, vec3(0.0));\n\n  gl_FragColor = vec4(col, 1.0);\n}", "format": "raw", "inputs": [{"name": "u_time", "type": "float", "default": 1}, {"name": "u_res", "type": "vec2", "default": [0.5, 0.5]}, {"name": "u_intensity", "type": "float", "default": 1, "min": 0.3, "max": 2}, {"name": "u_waveSpeed", "type": "float", "default": 0.8, "min": 0.3, "max": 2}, {"name": "u_mouse", "type": "vec2", "default": [-1, -1]}], "description": "Glowing waveform building from gentle sine to distorted scream with chromatic aberration and collapse.", "categories": ["object", "physics"]}, {"id": "radiant-moire-interference", "name": "Moiré Interference", "kind": "generator", "family": "Radiant", "license": "MIT", "sourceUrl": "https://github.com/pbakaus/radiant/blob/59e9f48c0ad9a3db2fbeb8898b4390d5a1eabb40/static/moire-interference.html", "source": "precision highp float;\nuniform float u_time;\nuniform vec2 u_res;\nuniform float u_ringDensity;\nuniform float u_driftSpeed;\nuniform vec2 u_mouse;\n\n#define PI 3.14159265359\n#define TAU 6.28318530718\n\n// ── Hash for grain texture ──\nfloat hash(vec2 p) {\n  vec3 p3 = fract(vec3(p.xyx) * 0.1031);\n  p3 += dot(p3, p3.yzx + 33.33);\n  return fract((p3.x + p3.y) * p3.z);\n}\n\n// ── Concentric ring pattern from a center point ──\n// Returns a value in [-1, 1] based on sine of distance\nfloat rings(vec2 uv, vec2 center, float freq) {\n  float d = length(uv - center);\n  return sin(d * freq);\n}\n\nvoid main() {\n  vec2 uv = (gl_FragCoord.xy - u_res * 0.5) / min(u_res.x, u_res.y);\n  float t = u_time;\n  float drift = u_driftSpeed;\n  float density = u_ringDensity;\n\n  // ── Ring frequency — controls how tight the concentric circles are ──\n  float baseFreq = 60.0 * density;\n\n  // ── Subtle breathing — ring spacing pulses slowly ──\n  float breathe = 1.0 + 0.04 * sin(t * 0.3) + 0.02 * sin(t * 0.17 + 1.0);\n  float freq = baseFreq * breathe;\n\n  // ── Center points — 4 sources orbiting at different speeds and radii ──\n  // Each center drifts in a unique elliptical/Lissajous path\n  float d = drift;\n\n  vec2 c0 = vec2(\n    0.22 * cos(t * d * 0.31 + 0.0),\n    0.18 * sin(t * d * 0.43 + 0.0)\n  );\n\n  vec2 c1 = vec2(\n    0.25 * cos(t * d * 0.23 + 2.1),\n    0.20 * sin(t * d * 0.37 + 1.4)\n  );\n\n  vec2 c2 = vec2(\n    0.19 * sin(t * d * 0.41 + 4.2),\n    0.24 * cos(t * d * 0.29 + 3.1)\n  );\n\n  vec2 c3 = vec2(\n    0.21 * cos(t * d * 0.19 + 5.7),\n    0.17 * sin(t * d * 0.47 + 0.8)\n  );\n\n  // ── Mouse-driven 5th center — shifts one pattern layer ──\n  if (u_mouse.x > 0.0) {\n    vec2 mUV = (u_mouse - u_res * 0.5) / min(u_res.x, u_res.y);\n    c3 = mUV;\n  }\n\n  // ── Each center generates rings at a slightly different frequency ──\n  // The frequency differences are what create the moiré beats\n  float f0 = freq;\n  float f1 = freq * 1.07;\n  float f2 = freq * 0.93;\n  float f3 = freq * 1.13;\n\n  // ── Compute ring patterns ──\n  float r0 = rings(uv, c0, f0);\n  float r1 = rings(uv, c1, f1);\n  float r2 = rings(uv, c2, f2);\n  float r3 = rings(uv, c3, f3);\n\n  // ── Combine ring patterns through multiplication ──\n  // Multiplying sine patterns produces sum and difference frequencies,\n  // which is exactly the moiré interference effect\n  float moire = r0 * r1 * r2 * r3;\n\n  // ── Also compute additive blend for a secondary interference layer ──\n  float additive = (r0 + r1 + r2 + r3) * 0.25;\n\n  // ── Blend multiplicative and additive for richer pattern ──\n  float pattern = moire * 0.7 + additive * 0.3;\n\n  // ── Normalize pattern to [0, 1] range ──\n  // Multiplicative moiré ranges roughly [-1, 1], additive too\n  float intensity = pattern * 0.5 + 0.5;\n  intensity = clamp(intensity, 0.0, 1.0);\n\n  // ── Color mapping ──\n  // Map interference intensity through a cool blue-violet-teal palette\n\n  // Dark zones: deep warm-black\n  vec3 darkColor = vec3(0.05, 0.035, 0.025);\n\n  // Mid zones: deep amber-brown\n  vec3 midColor = vec3(0.35, 0.22, 0.12);\n\n  // Bright interference zones: warm amber\n  vec3 brightColor = vec3(0.65, 0.42, 0.22);\n\n  // Peak interference: bright gold-white\n  vec3 peakColor = vec3(0.9, 0.78, 0.55);\n\n  // ── Three-stop gradient through the palette ──\n  vec3 col;\n  if (intensity < 0.35) {\n    col = mix(darkColor, midColor, intensity / 0.35);\n  } else if (intensity < 0.65) {\n    col = mix(midColor, brightColor, (intensity - 0.35) / 0.3);\n  } else {\n    col = mix(brightColor, peakColor, (intensity - 0.65) / 0.35);\n  }\n\n  // ── Add subtle luminance boost at interference peaks ──\n  // Where the multiplicative pattern hits strong peaks, push toward warm white\n  float peakMask = smoothstep(0.7, 1.0, intensity);\n  col += peakColor * peakMask * 0.15;\n\n  // ── Secondary interference shimmer ──\n  // Use pairwise products for additional subtle patterns\n  float shimmer = r0 * r2 * 0.5 + 0.5;\n  shimmer = smoothstep(0.4, 0.8, shimmer);\n  col += vec3(0.12, 0.08, 0.04) * shimmer * 0.2;\n\n  // ── Vignette — darken edges to focus attention on center ──\n  float vig = 1.0 - dot(uv * 0.9, uv * 0.9);\n  vig = clamp(vig, 0.0, 1.0);\n  vig = pow(vig, 0.5);\n  col *= vig;\n\n  // ── Fine grain — subtle noise overlay for tactile quality ──\n  float grain = (hash(gl_FragCoord.xy + fract(t * 37.0) * 1000.0) - 0.5) * 0.03;\n  col += grain;\n\n  // ── Tone mapping — keep blacks deep ──\n  col = max(col, vec3(0.0));\n  col = col / (1.0 + col * 0.2);\n\n  gl_FragColor = vec4(col, 1.0);\n}", "format": "raw", "inputs": [{"name": "u_time", "type": "float", "default": 1}, {"name": "u_res", "type": "vec2", "default": [0.5, 0.5]}, {"name": "u_ringDensity", "type": "float", "default": 1, "min": 0.3, "max": 2}, {"name": "u_driftSpeed", "type": "float", "default": 0.5, "min": 0.1, "max": 1.5}, {"name": "u_mouse", "type": "vec2", "default": [-1, -1]}], "description": "Overlapping concentric ring patterns creating hypnotic emergent moiré interference in